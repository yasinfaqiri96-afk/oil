@using PTGOilSystem.Web.Services
@using PTGOilSystem.Web.Models.Accounting
@model PeriodActivityViewModel
@{
    ViewData["Title"] = $"فعالیت‌های دوره {Model.PeriodName}";
    var k = Model.Kpis;

    (IReadOnlyList<PeriodActivityRow> Rows, bool ShowQty, bool ShowUsd) Table(
        IReadOnlyList<PeriodActivityRow> rows, bool qty, bool usd) => (rows, qty, usd);

    // صفحه‌بندی واقعی: فقط بخشِ فعال ورق می‌خورد. سقفِ خاموشِ قبلی (۱۰۰ سطر) برداشته شده،
    // پس هر بخش با «قبلی/بعدی» تا آخرِ داده قابل مرور است و Export همه را می‌گیرد.
    var activeSection = Model.ActiveSection;
    var currentPage = Model.Page;
    var hasMore = Model.HasMoreBySection ?? new Dictionary<string, bool>();
    bool SectionHasMore(string s) => hasMore.TryGetValue(s, out var more) && more;
    int SectionPage(string s) => string.Equals(s, activeSection, StringComparison.Ordinal) ? currentPage : 1;

    // آدرس صفحهٔ قبل/بعدِ همان بخش؛ اندازهٔ صفحه هم حفظ می‌شود.
    var pagerPageSize = ViewData["PageSize"] as int?;
    string SectionUrl(string s, int p)
        => Url.Action("Index", new { periodId = Model.FiscalPeriodId, section = s, page = p, pageSize = pagerPageSize }) ?? "#";

    (string? PreviousUrl, string? NextUrl, int Page, int RowCount) Pager(string s, int rowCount)
    {
        var p = SectionPage(s);
        return (p > 1 ? SectionUrl(s, p - 1) : null,
                SectionHasMore(s) ? SectionUrl(s, p + 1) : null,
                p,
                rowCount);
    }
}

<div class="ak-form-page finance-workspace-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"فعالیت‌های دوره {Model.PeriodName}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       (string?)"بازگشت", (string?)"bi-arrow-right",
                       (string?)Url.Action("Index", "FiscalYears")))" />

    <div class="ak-page-actions">
        <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("Export"))" />
    </div>

    <div class="ak-table-wrap">
        <table class="ak-table" aria-label="مشخصات دوره">
            <tbody>
                <tr><th class="ak-col-grow">شرکت</th><td>@Model.CompanyName</td></tr>
                <tr><th>سال مالی</th><td>@Model.FiscalYearName</td></tr>
                <tr><th>دوره</th><td>@Model.PeriodName</td></tr>
                <tr><th>بازه</th><td>@DateDisplay.Date(Model.StartDate) — @DateDisplay.Date(Model.EndDate)</td></tr>
            </tbody>
        </table>
    </div>

    @* ===== KPI خلاصه ===== *@
    <div class="summary-strip">
        <div class="summary-tile"><div class="summary-tile-label">خرید</div><div class="summary-tile-value ak-num">@k.PurchaseCount<span class="ak-hint"> (@k.PurchaseQuantityMt.ToString("N2") MT)</span></div></div>
        <div class="summary-tile"><div class="summary-tile-label">بارگیری</div><div class="summary-tile-value ak-num">@k.LoadingCount<span class="ak-hint"> (@k.LoadingQuantityMt.ToString("N2") MT)</span></div></div>
        <div class="summary-tile"><div class="summary-tile-label">فروش</div><div class="summary-tile-value ak-num">@NumberDisplay.Money(k.SalesUsd)<span class="ak-hint"> (@k.SalesCount)</span></div></div>
        <div class="summary-tile"><div class="summary-tile-label">دریافت</div><div class="summary-tile-value ak-num">@NumberDisplay.Money(k.ReceiptsUsd)</div></div>
        <div class="summary-tile"><div class="summary-tile-label">پرداخت</div><div class="summary-tile-value ak-num">@NumberDisplay.Money(k.PaymentsUsd)</div></div>
        <div class="summary-tile"><div class="summary-tile-label">مصارف</div><div class="summary-tile-value ak-num">@NumberDisplay.Money(k.ExpensesUsd)</div></div>
        <div class="summary-tile"><div class="summary-tile-label">موجودی خالص</div><div class="summary-tile-value ak-num">@k.InventoryNetMt.ToString("N2") MT</div></div>
        @if (Model.AccountingEnabled)
        {
            <div class="summary-tile"><div class="summary-tile-label">اسناد حسابداری</div><div class="summary-tile-value ak-num">@k.JournalCount</div></div>
        }
    </div>

    @* ===== تب‌های ساده ===== *@
    <ul class="nav nav-tabs finance-activity-tabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Purchases ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-purchases" type="button" role="tab">خرید</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Loadings ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-loadings" type="button" role="tab">بارگیری</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Sales ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-sales" type="button" role="tab">فروش</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Receipts ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-receipts" type="button" role="tab">دریافت</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Payments ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-payments" type="button" role="tab">پرداخت</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Expenses ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-expenses" type="button" role="tab">مصارف</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Movements ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-inventory" type="button" role="tab">موجودی</button></li>
        @if (Model.AccountingEnabled)
        {
            <li class="nav-item" role="presentation"><button class="nav-link @(activeSection == PeriodActivitySections.Journals ? "active" : "")" data-bs-toggle="tab" data-bs-target="#pa-journals" type="button" role="tab">اسناد حسابداری</button></li>
        }
    </ul>

    <div class="tab-content finance-activity-panes">
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Purchases ? "show active" : "")" id="pa-purchases" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Purchases, true, false)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Purchases, Model.Purchases.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Loadings ? "show active" : "")" id="pa-loadings" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Loadings, true, false)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Loadings, Model.Loadings.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Sales ? "show active" : "")" id="pa-sales" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Sales, true, true)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Sales, Model.Sales.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Receipts ? "show active" : "")" id="pa-receipts" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Receipts, false, true)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Receipts, Model.Receipts.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Payments ? "show active" : "")" id="pa-payments" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Payments, false, true)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Payments, Model.Payments.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Expenses ? "show active" : "")" id="pa-expenses" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.Expenses, false, true)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Expenses, Model.Expenses.Count)" />
        </div>
        <div class="tab-pane fade @(activeSection == PeriodActivitySections.Movements ? "show active" : "")" id="pa-inventory" role="tabpanel">
            <partial name="_ActivityTable" model="Table(Model.InventoryMovements, true, false)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Movements, Model.InventoryMovements.Count)" />
        </div>
        @if (Model.AccountingEnabled)
        {
            <div class="tab-pane fade @(activeSection == PeriodActivitySections.Journals ? "show active" : "")" id="pa-journals" role="tabpanel">
                <partial name="_ActivityTable" model="Table(Model.Journals, false, true)" />
            <partial name="_ActivitySectionPager" model="@Pager(PeriodActivitySections.Journals, Model.Journals.Count)" />
            </div>
        }
    </div>
</div>
