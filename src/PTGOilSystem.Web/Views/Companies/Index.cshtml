@model IEnumerable<Company>
@{
    ViewData["Title"] = UiText.T(Context,"شرکت‌ها","Companies");
    var items = Model.ToList();
    var activeCount = items.Count(item => item.IsActive);
    var countryCount = items.Select(item => item.Country).Where(country => !string.IsNullOrWhiteSpace(country)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    var q = ViewData["q"]?.ToString();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="ak-list-page">

    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "شرکت‌ها", "Companies"), true,
                       UiText.T(Context, "شرکت جدید", "New company"), "bi-plus-lg",
                       (string?)Url.Action("Create", new { returnUrl }), (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار شرکت‌ها", "Company statistics")">
        <vc:stat-card title="@UiText.T(Context, "کل شرکت‌ها", "Total companies")" value="@items.Count.ToString("N0")" unit="@UiText.T(Context, "شرکت", "companies")" avatar="partners"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "شرکت‌های فعال", "Active companies")" value="@activeCount.ToString("N0")" unit="@UiText.T(Context, "شرکت", "companies")" avatar="rules-checklist"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "شرکت‌های غیرفعال", "Inactive companies")" value="@((items.Count - activeCount).ToString("N0"))" unit="@UiText.T(Context, "شرکت", "companies")" avatar="losses"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کشورها", "Countries")" value="@countryCount.ToString("N0")" unit="@UiText.T(Context, "کشور", "countries")" avatar="locations"></vc:stat-card>
    </section>

    <partial name="~/Views/Shared/_AkSearchFilter.cshtml"
             model="@AkSearchFilterModel.SearchOnly("q", q, UiText.T(Context, "جستجو یا فیلتر نتایج...", "Search or filter results..."))" />

    <div class="ak-list">
        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-check"><input type="checkbox" class="ak-check" aria-label="@UiText.T(Context, "انتخاب همه", "Select all")" /></th>
                        <th class="ak-col-grow">@UiText.T(Context, "نام", "Name")</th>
                        <th>@UiText.T(Context, "نام فارسی", "Persian name")</th>
                        <th>@UiText.T(Context, "کد", "Code")</th>
                        <th>@UiText.T(Context, "کشور", "Country")</th>
                        <th class="ak-col-spacer"></th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                        <th class="ak-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr data-href="@Url.Action("Details", new { id = p.Id })">
                            <td class="ak-col-check"><input type="checkbox" class="ak-check" aria-label="@UiText.T(Context, "انتخاب", "Select")" /></td>
                            <td class="ak-col-grow"><a asp-action="Details" asp-route-id="@p.Id" class="ak-name">@p.Name</a></td>
                            <td>@(string.IsNullOrWhiteSpace(p.NamePersian) ? "-" : p.NamePersian)</td>
                            <td class="ak-num">@(string.IsNullOrWhiteSpace(p.Code) ? "-" : p.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Country) ? "-" : p.Country)</td>
                            <td class="ak-col-spacer"></td>
                            <td>
                                <span class="ak-status @(p.IsActive ?"is-active" : "is-inactive")">
                                    @(p.IsActive ? UiText.T(Context, "فعال", "Active") : UiText.T(Context, "غیرفعال", "Inactive"))
                                </span>
                                @if (p.IsSystemOwner)
                                {
                                    <span class="ak-status is-active" title="@UiText.T(Context, "دفاتر مالی به نام این شرکت است", "The books belong to this company")">
                                        <i class="bi bi-star-fill" aria-hidden="true"></i>
                                        @UiText.T(Context, "مالک سیستم", "System owner")
                                    </span>
                                }
                            </td>
                            <td class="ak-col-actions">
                                <div class="dropdown ak-row-menu">
                                    <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@UiText.T(Context, "عملیات", "Actions")">
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye" aria-hidden="true"></i>@UiText.T(Context, "جزئیات", "Details")</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil" aria-hidden="true"></i>@UiText.T(Context, "ویرایش", "Edit")</a></li>
                                        @if (!p.IsSystemOwner)
                                        {
                                            <li>
                                                <form asp-action="SetSystemOwner" asp-route-id="@p.Id" asp-route-returnUrl="@returnUrl" method="post" class="ak-form"
                                                      data-ptg-confirm="true"
                                                      data-ptg-confirm-title="تعیین مالک سیستم"
                                                      data-ptg-confirm-message="دفاتر مالی به نام این شرکت ثبت می‌شود و مالک قبلی برداشته می‌شود. ادامه می‌دهید؟"
                                                      data-ptg-confirm-ok-label="تعیین مالک">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item" title="@UiText.T(Context, "تعیین به‌عنوان مالک سیستم", "Set as system owner")">
                                                        <i class="bi bi-star" aria-hidden="true"></i><span>@UiText.T(Context, "تعیین به‌عنوان مالک سیستم", "Set as system owner")</span>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><partial name="~/Views/Shared/Partials/_ToggleActiveButton.cshtml" model="@(("Companies", p.Id, p.IsActive, "dropdown-item ak-danger", (string?)returnUrl))" /></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="ak-empty">
                                    <i class="bi bi-buildings" aria-hidden="true"></i>
                                    @UiText.T(Context, "شرکتی برای نمایش پیدا نشد", "No companies found")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{ ViewData["ShownCount"] = items.Count; }
        <div class="ak-pager">
            @await Html.PartialAsync("_PagedListFooter")
        </div>
    </div>
</div>
