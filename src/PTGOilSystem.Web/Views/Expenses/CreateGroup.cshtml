@model PTGOilSystem.Web.Models.Expenses.GroupExpenseCreateViewModel
@using PTGOilSystem.Web.Models
@using PTGOilSystem.Web.Models.Expenses
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] ="ثبت مصرف گروهی";
    ViewData["HideSectionTabs"] = true;
    var operations = (List<GroupExpenseOperationItem>)ViewBag.Operations;
    var cancelUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Index");
    var selectedItemsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Items?.Select(i => new { kind = i.Kind, id = i.Id, manualAmount = i.ManualAmount }) ?? Enumerable.Empty<object>());
    IReadOnlyList<AkFilterOption> FilterOptions(IEnumerable<string> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .Select(value => new AkFilterOption(value, value))
        .ToList();
    var operationSearchFilter = new AkSearchFilterModel(
        "fQuery",
        null,
        "جستجو در شماره، مسیر یا عملیات...",
        new List<AkFilterDefinition>
        {
            new("fOperation", "نوع عملیات", "select", FilterOptions(operations.Select(item => item.OperationLabel))),
            new("fVehicle", "نوع وسیله", "select", FilterOptions(operations.Select(item => item.VehicleKind))),
            new("fRoute", "مسیر", "select", FilterOptions(operations.Select(item => item.Route))),
            new("fStatus", "وضعیت", "select", FilterOptions(operations.Select(item => item.StatusLabel))),
            new("fFrom", "تاریخ حرکت", "daterange", null, null, "fTo")
        });
}

<div class="ak-form-page ak-group-operation-page ak-group-operation-page--wide ak-group-wizard-page">
    @* data-no-spa: spa-nav submit را در capture قطع می‌کند و handler ساخت Items اجرا نمی‌شد.
       novalidate: fx-rate-field روی input نرخ required می‌گذارد؛ در مرحله ۳ آن input مخفی است و
       native validation مرورگر submit را بی‌صدا بلاک می‌کرد (invalid control not focusable). *@
    @* data-no-submit-guard: گاردِ سراسریِ core.js روی فرمِ novalidate راهِ آزادسازی ندارد
       (رویداد invalid هرگز شلیک نمی‌شود) و دکمه را روی «در حال ثبت…» قفل می‌کرد؛ این فرم
       قفلِ ضدِ دابل‌کلیکِ خودش را با آزادسازیِ امنِ زمان‌دار مدیریت می‌کند. *@
    <form asp-action="CreateGroup" method="post" id="gexpForm" class="ak-form" data-no-spa data-no-submit-guard novalidate>
        @Html.AntiForgeryToken()
        @Html.FormToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div id="gexpItemsContainer"></div>

        <header class="ak-page-header">
            <div class="ak-page-heading">
                <span class="ak-page-icon"><i class="bi bi-journal-plus"></i></span>
                <div>
                    <h1>ثبت مصرف گروهی</h1>
                    <p>ثبت یک مصرف برای چند عملیات به صورت همزمان</p>
                </div>
            </div>
            <a href="@cancelUrl" class="btn btn-light ak-secondary-action" aria-label="بستن"><i class="bi bi-x-lg"></i></a>
        </header>

        <partial name="~/Views/Shared/Components/_WizardSteps.cshtml" model="@(new WizardStepsViewModel("مراحل ثبت مصرف گروهی", "data-step-btn", new[] { new WizardStepItem(1, "انتخاب عملیات", true), new WizardStepItem(2, "مشخصات مصرف"), new WizardStepItem(3, "بررسی و ثبت") }))" />

        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert"></div>

        <!-- مرحله ۱: انتخاب عملیات -->
        <section class="ak-form-section ak-group-wizard-workspace" data-step-panel="1">
            <div class="ak-group-wizard-main">
                <div class="ak-form-section">
                    <h2 class="ak-section-title">انتخاب عملیات در جریان</h2>
                    <partial name="_AkClientSearchFilter" model="@operationSearchFilter" />

                    <label class="ak-field">
                        <input type="checkbox" id="chkAll" />
                        <span>انتخاب همه نتایج (<span id="lblResultCount">0</span> عملیات)</span>
                    </label>

                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-check"></th>
                                    <th>#</th>
                                    <th>عملیات</th>
                                    <th>نوع وسیله</th>
                                    <th>شماره</th>
                                    <th>مسیر</th>
                                    <th>مقدار</th>
                                    <th>واحد</th>
                                    <th>تاریخ حرکت</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody id="opsBody"></tbody>
                        </table>
                        <div class="ak-empty" id="opsEmpty" hidden>
                            <i class="bi bi-inbox"></i>
                            هیچ عملیات در جریانی با این فیلتر یافت نشد
                        </div>
                    </div>

                    <div class="ak-pager">
                        <label class="ak-field">
                            <select class="ak-input" id="pageSize">
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span>تعداد در صفحه</span>
                        </label>
                        <div class="ak-section-desc" id="pageInfo"></div>
                        <div class="ak-pager" id="pager"></div>
                    </div>
                </div>
            </div>

            <aside class="ak-form-section ak-group-wizard-summary">
                <div class="ak-form-section ak-list">
                    <h2 class="ak-section-title">خلاصه انتخاب</h2>
                    <div class="ak-list-row">
                        <span>تعداد عملیات انتخاب شده</span>
                        <strong class="ak-num" id="sumCount">0</strong>
                    </div>
                    <div class="ak-list-row">
                        <span>مجموع مقدار</span>
                        <strong class="ak-num"><span id="sumQty">0</span> تن</strong>
                    </div>
                    <div class="ak-list-row">
                        <span>نوع وسایل</span>
                        <div id="sumVehicles" class="ak-list"></div>
                    </div>
                    <div class="ak-list-row">
                        <span>مسیرها</span>
                        <div id="sumRoutes" class="ak-list"></div>
                    </div>
                </div>
            </aside>
        </section>

        <!-- مرحله ۲: مشخصات مصرف -->
        <section class="ak-form-section" data-step-panel="2" hidden>
            <div>
                <div class="ak-form-section">
                    <h2 class="ak-section-title">مشخصات مصرف</h2>
                    <div class="ak-form-grid">
                        <div class="ak-field">
                            <label asp-for="ManualExpenseTypeName">نوع مصرف <em>*</em></label>
                            <input asp-for="ManualExpenseTypeName"
                                   id="ManualExpenseTypeName"
                                   list="groupExpenseTypeSuggestions"
                                   class="ak-input"
                                   autocomplete="off"
                                   placeholder="کرایه حمل، مصرف بندری، تخلیه، گمرک..." />
                            <datalist id="groupExpenseTypeSuggestions">
                                @foreach (var expenseTypeName in (ViewBag.ExpenseTypeNames as IEnumerable<string> ?? Array.Empty<string>()))
                                {
                                    <option value="@expenseTypeName"></option>
                                }
                            </datalist>
                        </div>
                        <div class="ak-field">
                            <label asp-for="ServiceProviderId">پرداخت شونده</label>
                            <select asp-for="ServiceProviderId" asp-items="ViewBag.ServiceProviders" class="ak-input">
                                <option value="">— بدون شرکت خدماتی —</option>
                            </select>
                        </div>
                        <div class="ak-field">
                            <label asp-for="ExpenseDate">تاریخ مصرف <em>*</em></label>
                            <input asp-for="ExpenseDate" type="date" class="ak-input" />
                        </div>
                        <div class="ak-field">
                            <label asp-for="Currency">ارز <em>*</em></label>
                            <select asp-for="Currency" asp-items="ViewBag.Currencies" class="ak-input" id="currencySelect"></select>
                        </div>
                        <div class="ak-field" data-fx-rate-group data-fx-currency-source="#currencySelect">
                            <div data-fx-rate-field>
                                <label>نرخ دالر به <span data-fx-currency-name>ارز</span></label>
                                <input type="text" inputmode="decimal" class="ak-input" data-fx-rate-input autocomplete="off" placeholder="مثال: ۷۷" />
                                <input asp-for="AppliedFxRateToUsd" type="hidden" data-fx-rate-technical />
                            </div>
                            <div data-fx-usd-note class="d-none">
                                <small class="form-text text-muted"><i class="bi bi-info-circle"></i> پرداخت دالری است؛ نرخ تبدیل لازم نیست.</small>
                            </div>
                        </div>
                        <div class="ak-field">
                            <label asp-for="CostResponsibility">مصرف بدوش کیست</label>
                            <select asp-for="CostResponsibility" class="ak-input">
                                <option value="">— نامشخص —</option>
                                <option value="1">بدوش خریدار</option>
                                <option value="2">بدوش فروشنده</option>
                                <option value="3">مشترک</option>
                            </select>
                        </div>
                        <div class="ak-field ak-col-full">
                            <label asp-for="Description">توضیحات</label>
                            <textarea asp-for="Description" class="ak-input" rows="2" placeholder="توضیحات (اختیاری)..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="ak-form-section">
                    <h2 class="ak-section-title">روش تقسیم مبلغ</h2>
                    <div class="ak-alloc-methods" id="methodGroup" role="radiogroup" aria-label="روش تقسیم مبلغ">
                        <label class="ak-alloc-method">
                            <input type="radio" name="AllocationMethod" value="2" checked="@(Model.AllocationMethod == PTGOilSystem.Web.Models.Entities.ExpenseAllocationMethod.EqualSplit)" />
                            <span class="ak-alloc-method-body">
                                <i class="bi bi-columns-gap" aria-hidden="true"></i>
                                <strong>مساوی</strong>
                                <small>تقسیم مساوی بین عملیات‌ها</small>
                            </span>
                        </label>
                        <label class="ak-alloc-method">
                            <input type="radio" name="AllocationMethod" value="3" checked="@(Model.AllocationMethod == PTGOilSystem.Web.Models.Entities.ExpenseAllocationMethod.ByQuantity)" />
                            <span class="ak-alloc-method-body">
                                <i class="bi bi-box-seam" aria-hidden="true"></i>
                                <strong>بر اساس مقدار</strong>
                                <small>نرخ فی تن × مقدار هر حمل</small>
                            </span>
                        </label>
                        <label class="ak-alloc-method">
                            <input type="radio" name="AllocationMethod" value="1" checked="@(Model.AllocationMethod == PTGOilSystem.Web.Models.Entities.ExpenseAllocationMethod.FixedPerOperation)" />
                            <span class="ak-alloc-method-body">
                                <i class="bi bi-cash-stack" aria-hidden="true"></i>
                                <strong>مبلغ ثابت</strong>
                                <small>یک مبلغ برای هر عملیات</small>
                            </span>
                        </label>
                        <label class="ak-alloc-method">
                            <input type="radio" name="AllocationMethod" value="4" checked="@(Model.AllocationMethod == PTGOilSystem.Web.Models.Entities.ExpenseAllocationMethod.Manual)" />
                            <span class="ak-alloc-method-body">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                <strong>دستی</strong>
                                <small>مبلغ هر عملیات جداگانه</small>
                            </span>
                        </label>
                    </div>

                    <div class="ak-form-grid">
                        <div class="ak-field" id="perOpField" hidden>
                            <label asp-for="AmountPerOperation">مبلغ برای هر عملیات <em>*</em></label>
                            <div class="ak-input-unit">
                                <span data-cur-tag>USD</span>
                                <input asp-for="AmountPerOperation" type="number" step="0.01" min="0" class="ak-input" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="ak-field" id="totalField">
                            <label asp-for="TotalAmount">مبلغ کل برای تقسیم <em>*</em></label>
                            <div class="ak-input-unit">
                                <span data-cur-tag>USD</span>
                                <input asp-for="TotalAmount" type="number" step="0.01" min="0" class="ak-input" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="ak-field" id="rateField" hidden>
                            <label asp-for="RatePerTon">نرخ فی تن <em>*</em></label>
                            <div class="ak-input-unit">
                                <span data-cur-tag>USD</span>
                                <input asp-for="RatePerTon" type="number" step="0.01" min="0" class="ak-input" placeholder="0.00" />
                            </div>
                            <small class="ak-note">سهم هر عملیات = نرخ × مقدار (تن) همان حمل</small>
                        </div>
                        <div class="ak-manual-import" id="rateHint" hidden data-manual-import-url="@Url.Action("ImportGroupAmountsExcel")">
                            <p class="ak-note mb-0">
                                <i class="bi bi-info-circle"></i>
                                برای نرخ متفاوت هر حمل، فایل اکسل (نمبر وسیله + نرخ فی تن) را اپلود کنید؛ نرخ هر حمل در وزن همان حمل ضرب می‌شود. حمل‌های بدون نرخ اختصاصی، نرخ بالا را می‌گیرند.
                            </p>
                            <div class="ak-manual-import-actions">
                                <input type="file" id="rateFile" accept=".xlsx,.xls" hidden />
                                <button type="button" class="btn btn-success btn-sm" id="btnRateImport">
                                    <i class="bi bi-file-earmark-excel"></i> اپلود اکسل نرخ‌ها
                                </button>
                                <span class="ak-manual-import-status" id="rateImportStatus" hidden></span>
                            </div>
                        </div>
                        <div class="ak-manual-import" id="manualHint" hidden data-manual-import-url="@Url.Action("ImportGroupAmountsExcel")">
                            <p class="ak-note mb-0">
                                <i class="bi bi-info-circle"></i>
                                مبلغ هر عملیات را در مرحله «بررسی و ثبت» وارد کنید، یا فایل اکسل (نمبر وسیله + مقدار مصرف) را اپلود کنید.
                            </p>
                            <div class="ak-manual-import-actions">
                                <input type="file" id="manualAmountFile" accept=".xlsx,.xls" hidden />
                                <button type="button" class="btn btn-success btn-sm" id="btnManualImport">
                                    <i class="bi bi-file-earmark-excel"></i> اپلود اکسل مبالغ
                                </button>
                                <span class="ak-manual-import-status" id="manualImportStatus" hidden></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ak-form-section">
                    <h2 class="ak-section-title">مصارف این ثبت</h2>
                    <div class="ak-lines-bar">
                        <button type="button" class="btn ak-secondary-action btn-sm" id="btnAddLine">
                            <i class="bi bi-plus-lg"></i> افزودن این مصرف به لیست
                        </button>
                        <span class="ak-note mb-0">چند مصرف (کرایه، تخلیه، گمرک…) را با همین عملیات‌ها در یک ثبت اضافه کنید؛ برای هر مصرف یک رکورد گروهی جدا ساخته می‌شود.</span>
                    </div>
                    <div class="ak-table-wrap" id="linesWrap" hidden>
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>نوع مصرف</th>
                                    <th>پرداخت شونده</th>
                                    <th>روش تقسیم</th>
                                    <th class="ak-num">مبلغ کل</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="linesBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- مرحله ۳: بررسی و ثبت -->
        <section class="ak-form-section" data-step-panel="3" hidden>
            <div>
                <div class="ak-form-section">
                    <h2 class="ak-section-title">پیش‌نمایش توزیع مبلغ</h2>
                    <div class="ak-list" id="previewMeta"></div>
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr id="previewHead"></tr>
                            </thead>
                            <tbody id="previewBody"></tbody>
                            <tfoot>
                                <tr id="previewFoot"></tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="ak-note">
                        <i class="bi bi-shield-check"></i>
                        برای هر عملیات یک سهم جداگانه با سند حسابداری خودش ثبت می‌شود؛ همه سهم‌ها زیر یک رکورد اصلی گروهی قرار می‌گیرند.
                    </div>
                </div>
            </div>
        </section>

        <footer class="ak-form-section">
            <div class="ak-note">
                <i class="bi bi-info-circle"></i>
                <span id="footerNote">در مرحله بعد، مشخصات مصرف و روش تقسیم را تعیین خواهید کرد.</span>
            </div>
            <div class="ak-footer-actions">
                <a href="@cancelUrl" class="btn ak-secondary-action">انصراف</a>
                <button type="button" class="btn ak-secondary-action" id="btnPrev" hidden>مرحله قبلی</button>
                <button type="button" class="btn ak-primary-action" id="btnNext">مرحله بعدی <i class="bi bi-arrow-left"></i></button>
                <button type="submit" class="btn ak-primary-action" id="btnSubmit" hidden>
                    <i class="bi bi-check2-circle"></i> ثبت نهایی مصرف گروهی
                </button>
            </div>
        </footer>
    </form>

    @{
        var registeredBatches = ViewBag.RegisteredGroupBatches as List<GroupExpenseBatchListItem> ?? new List<GroupExpenseBatchListItem>();
        var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    }
    @if (registeredBatches.Count > 0)
    {
        <section class="ak-form-section" aria-label="مصارف گروهی ثبت‌شده">
            <div class="section-title-row d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 pb-0">
                <div>
                    <h2 class="mb-0">مصارف گروهی ثبت‌شده</h2>
                    <p class="text-muted mb-0">برای برگرداندن یک مصرف گروهی، همان ردیف را لغو کنید؛ همهٔ سهم‌ها و سندهای آن با سند معکوس برمی‌گردند.</p>
                </div>
                <form asp-action="CancelAllGroups" method="post" class="ak-form d-inline"
                      onsubmit="return confirm('همهٔ @registeredBatches.Count.ToString("N0") مصرف گروهی فعال لغو شوند؟ برای هر سهم سند معکوس در لجر ثبت می‌شود و این کار برگشت‌پذیر نیست.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                    <button type="submit" class="btn btn-sm ak-secondary-action">
                        <i class="bi bi-x-octagon"></i> لغو همه
                    </button>
                </form>
            </div>
            <div class="ak-table-wrap p-3 pt-2">
                <table class="ak-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>شماره</th>
                            <th>نوع مصرف</th>
                            <th>شرکت خدماتی</th>
                            <th>تاریخ</th>
                            <th class="text-end">تعداد عملیات</th>
                            <th class="text-end">مبلغ کل</th>
                            <th class="text-end">USD</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var batch in registeredBatches)
                    {
                        <tr>
                            <td><a asp-action="GroupDetails" asp-route-id="@batch.Id">@batch.BatchNumber</a></td>
                            <td>@batch.ExpenseTypeName</td>
                            <td>@(string.IsNullOrWhiteSpace(batch.ServiceProviderName) ?"-" : batch.ServiceProviderName)</td>
                            <td dir="ltr">@batch.ExpenseDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-end">@batch.OperationCount.ToString("N0")</td>
                            <td class="text-end">@batch.TotalAmount.ToString("N2") @batch.Currency</td>
                            <td class="text-end">@batch.TotalAmountUsd.ToString("N2")</td>
                            <td class="text-end">
                                <form asp-action="CancelGroup" method="post" class="ak-form d-inline"
                                      onsubmit="return confirm('مصرف گروهی @batch.BatchNumber لغو شود؟ همهٔ سهم‌های آن با سند معکوس برمی‌گردند.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@batch.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <button type="submit" class="btn btn-sm ak-secondary-action">
                                        <i class="bi bi-x-circle"></i> لغو
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<script id="gexpOpsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(operations.Select(o => new
{
    kind = o.Kind,
    id = o.Id,
    op = o.OperationLabel,
    vehicle = o.VehicleKind,
    number = o.Number,
    alt = o.AltNumber,
    route = o.Route,
    qty = o.QuantityMt,
    status = o.StatusLabel,
    date = o.MoveDate.ToString("yyyy-MM-dd")
})))</script>
<script id="gexpSelectedData" type="application/json">@Html.Raw(selectedItemsJson)</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/fx-rate-field.js" asp-append-version="true" defer></script>
    <script>
    (function () {
        'use strict';
        var ops = JSON.parse(document.getElementById('gexpOpsData').textContent || '[]');
        var preselected = JSON.parse(document.getElementById('gexpSelectedData').textContent || '[]');

        var state = {
            step: 1,
            page: 1,
            pageSize: 10,
            selected: new Map(), // key kind:id -> { op, manualAmount, manualRate }
            lines: [],           // مصارف افزوده‌شده به این ثبت
            filtered: ops.slice()
        };

        function key(o) { return o.kind + ':' + o.id; }
        function fmt(n) { return (Math.round(n * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function fmtQty(n) { return Number(n).toLocaleString('en-US', { maximumFractionDigits: 3 }); }

        // ---------- پیش‌انتخاب بعد از خطای اعتبارسنجی ----------
        preselected.forEach(function (s) {
            var found = ops.find(function (o) { return o.kind === s.kind && o.id === s.id; });
            if (found) state.selected.set(key(found), { op: found, manualAmount: s.manualAmount || null, manualRate: null });
        });

        // ---------- فیلترها ----------
        var $ = function (id) { return document.getElementById(id); };

        // صفحه‌بندی هم‌شکل با کامپوننت مشترک سیستم (_Pagination.cshtml): پنجرهٔ ۵تایی،
        // «/» ابتدا/انتها، «…» و صفحهٔ اول/آخر. کلاینت‌ساید چون داده در همین ویزارد است.
        function renderPager(container, current, pageCount, go) {
            container.innerHTML = '';
            if (pageCount <= 1) { return; }
            var ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm mb-0';
            function li(label, page, active, disabled) {
                var item = document.createElement('li');
                item.className = 'page-item' + (active ? ' active' : '') + (disabled ? ' disabled' : '');
                var link = document.createElement(disabled || active ? 'span' : 'a');
                link.className = 'page-link';
                link.textContent = label;
                if (!disabled && !active && page) {
                    link.href = '#';
                    link.addEventListener('click', function (e) { e.preventDefault(); go(page); });
                }
                item.appendChild(link);
                ul.appendChild(item);
            }
            var start = Math.max(1, current - 2);
            var end = Math.min(pageCount, start + 4);
            if (end - start < 4) { start = Math.max(1, end - 4); }
            li('«', current - 1, false, current === 1);
            if (start > 1) { li('1', 1, false, false); if (start > 2) { li('…', null, false, true); } }
            for (var i = start; i <= end; i++) { li(String(i), i, i === current, false); }
            if (end < pageCount) { if (end < pageCount - 1) { li('…', null, false, true); } li(String(pageCount), pageCount, false, false); }
            li('»', current + 1, false, current === pageCount);
            container.appendChild(ul);
        }

        var operationFilter = document.querySelector('#gexpForm [data-ak-filter-client]');
        function filterValue(key) {
            var field = operationFilter.querySelector('[data-ak-filter-param][name="' + key + '"]');
            return field ? field.value : '';
        }

        function applyFilters() {
            var q = ($('fQuery').value || '').trim().toLowerCase();
            var from = filterValue('fFrom'), to = filterValue('fTo');
            state.filtered = ops.filter(function (o) {
                if (filterValue('fOperation') && o.op !== filterValue('fOperation')) return false;
                if (filterValue('fVehicle') && o.vehicle !== filterValue('fVehicle')) return false;
                if (filterValue('fRoute') && o.route !== filterValue('fRoute')) return false;
                if (filterValue('fStatus') && o.status !== filterValue('fStatus')) return false;
                if (from && o.date < from) return false;
                if (to && o.date > to) return false;
                if (q && (o.number + ' ' + o.route + ' ' + o.op + ' ' + o.vehicle).toLowerCase().indexOf(q) < 0) return false;
                return true;
            });
            state.page = 1;
            renderTable();
        }

        operationFilter.addEventListener('ak:filter-change', applyFilters);

        // ---------- جدول + صفحه‌بندی ----------
        function renderTable() {
            var body = $('opsBody');
            body.innerHTML = '';
            var total = state.filtered.length;
            $('lblResultCount').textContent = total;
            $('opsEmpty').hidden = total > 0;

            var pages = Math.max(1, Math.ceil(total / state.pageSize));
            if (state.page > pages) state.page = pages;
            var start = (state.page - 1) * state.pageSize;
            var slice = state.filtered.slice(start, start + state.pageSize);

            slice.forEach(function (o, idx) {
                var tr = document.createElement('tr');
                var checked = state.selected.has(key(o));
                if (checked) tr.classList.add('is-selected');
                tr.innerHTML =
                    '<td class="ak-col-check"><input type="checkbox" ' + (checked ? 'checked' : '') + ' data-k="' + key(o) + '"></td>' +
                    '<td>' + (start + idx + 1) + '</td>' +
                    '<td>' + o.op + '</td>' +
                    '<td>' + o.vehicle + '</td>' +
                    '<td class="ak-num">' + o.number + '</td>' +
                    '<td>' + o.route + '</td>' +
                    '<td class="ak-num">' + fmtQty(o.qty) + '</td>' +
                    '<td>تن</td>' +
                    '<td class="ak-num">' + o.date + '</td>' +
                    '<td><span class="ak-status is-active">' + o.status + '</span></td>';
                tr.addEventListener('click', function (e) {
                    if (e.target.tagName === 'INPUT') return;
                    toggle(o);
                });
                tr.querySelector('input').addEventListener('change', function () { toggle(o); });
                body.appendChild(tr);
            });

            $('pageInfo').textContent = total === 0 ? '' :
                'نمایش ' + (start + 1) + ' تا ' + Math.min(start + state.pageSize, total) + ' از ' + total + ' مورد';

            renderPager($('pager'), state.page, pages, function (pp) { state.page = pp; renderTable(); });

            var allChecked = slice.length > 0 && slice.every(function (o) { return state.selected.has(key(o)); });
            $('chkAll').checked = state.filtered.length > 0 && state.filtered.every(function (o) { return state.selected.has(key(o)); });
            void allChecked;
            renderSummary();
        }

        function toggle(o) {
            var k = key(o);
            if (state.selected.has(k)) state.selected.delete(k);
            else state.selected.set(k, { op: o, manualAmount: null, manualRate: null });
            renderTable();
        }

        $('chkAll').addEventListener('change', function () {
            if (this.checked) state.filtered.forEach(function (o) { if (!state.selected.has(key(o))) state.selected.set(key(o), { op: o, manualAmount: null, manualRate: null }); });
            else state.filtered.forEach(function (o) { state.selected.delete(key(o)); });
            renderTable();
        });

        $('pageSize').addEventListener('change', function () {
            state.pageSize = parseInt(this.value, 10) || 10;
            state.page = 1;
            renderTable();
        });

        // ---------- خلاصه انتخاب ----------
        function renderSummary() {
            var items = Array.from(state.selected.values()).map(function (s) { return s.op; });
            $('sumCount').textContent = items.length;
            $('sumQty').textContent = fmtQty(items.reduce(function (a, o) { return a + Number(o.qty); }, 0));

            var byVehicle = {};
            items.forEach(function (o) { byVehicle[o.vehicle] = (byVehicle[o.vehicle] || 0) + 1; });
            $('sumVehicles').innerHTML = Object.keys(byVehicle).map(function (v) {
                return '<div><span>' + v + '</span><b>' + byVehicle[v] + ' عملیات</b></div>';
            }).join('') || '<div class="ak-note">—</div>';

            var routes = Array.from(new Set(items.map(function (o) { return o.route; })));
            $('sumRoutes').innerHTML = routes.map(function (r) { return '<div><span>' + r + '</span></div>'; }).join('')
                || '<div class="ak-note">—</div>';
        }

        // ---------- روش تقسیم ----------
        function currentMethod() {
            var el = document.querySelector('#methodGroup input[name="AllocationMethod"]:checked');
            return el ? parseInt(el.value, 10) : 2;
        }

        function syncMethodFields() {
            var m = currentMethod();
            $('perOpField').hidden = m !== 1;
            $('totalField').hidden = m !== 2;
            $('rateField').hidden = m !== 3;
            $('rateHint').hidden = m !== 3;
            $('manualHint').hidden = m !== 4;
        }
        document.querySelectorAll('#methodGroup input').forEach(function (r) { r.addEventListener('change', syncMethodFields); });

        var curSel = document.getElementById('currencySelect');
        function syncCurrencyTags() {
            document.querySelectorAll('[data-cur-tag]').forEach(function (t) { t.textContent = curSel.value || 'USD'; });
        }
        if (curSel) { curSel.addEventListener('change', syncCurrencyTags); syncCurrencyTags(); }

        // ---------- مصارف افزوده‌شده ----------
        var methodNames = { 1: 'مبلغ ثابت هر عملیات', 2: 'تقسیم مساوی', 3: 'بر اساس مقدار', 4: 'دستی' };

        function esc(text) {
            return String(text == null ? '' : text)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // فیلدهای فعلیِ «مشخصات مصرف» + «روش تقسیم» را به یک خط مصرف تبدیل می‌کند.
        function readCurrentLine() {
            var provider = document.querySelector('#gexpForm [name="ServiceProviderId"]');
            var descEl = document.querySelector('#gexpForm [name="Description"]');
            var m = currentMethod();
            var line = {
                typeName: $('ManualExpenseTypeName').value.trim(),
                providerId: provider ? provider.value : '',
                providerName: provider && provider.selectedIndex >= 0 ? provider.options[provider.selectedIndex].text : '',
                method: m,
                perOp: parseFloat(document.getElementById('AmountPerOperation').value) || 0,
                total: parseFloat(document.getElementById('TotalAmount').value) || 0,
                rate: parseFloat(document.getElementById('RatePerTon').value) || 0,
                desc: descEl ? descEl.value.trim() : '',
                manual: {},
                rates: {}
            };
            if (m === 4) {
                state.selected.forEach(function (s) { line.manual[key(s.op)] = parseFloat(s.manualAmount) || 0; });
            }
            if (m === 3) {
                state.selected.forEach(function (s) {
                    var r = parseFloat(s.manualRate);
                    if (r > 0) { line.rates[key(s.op)] = r; }
                });
            }
            return line;
        }

        function validateLine(line) {
            if (!line.typeName) return 'نوع مصرف را وارد کنید.';
            if (line.method === 1 && !(line.perOp > 0)) return 'مبلغ برای هر عملیات را وارد کنید.';
            if (line.method === 2 && !(line.total > 0)) return 'مبلغ کل برای تقسیم را وارد کنید.';
            if (line.method === 3 && !(line.rate > 0)) {
                var missingRate = Array.from(state.selected.values()).some(function (s) {
                    return !(parseFloat(line.rates[key(s.op)]) > 0);
                });
                if (missingRate) return 'نرخ فی تن را وارد کنید یا برای همه حمل‌ها نرخ اختصاصی بدهید.';
            }
            if (line.method === 4) {
                var bad = Array.from(state.selected.values()).some(function (s) {
                    return !(parseFloat(line.manual[key(s.op)]) > 0);
                });
                if (bad) return 'در روش دستی، مبلغ همه عملیات‌ها باید بزرگ‌تر از صفر باشد.';
            }
            return null;
        }

        function clearLineFields() {
            $('ManualExpenseTypeName').value = '';
            document.getElementById('AmountPerOperation').value = '';
            document.getElementById('TotalAmount').value = '';
            document.getElementById('RatePerTon').value = '';
            var descEl = document.querySelector('#gexpForm [name="Description"]');
            if (descEl) descEl.value = '';
            state.selected.forEach(function (s) { s.manualAmount = null; s.manualRate = null; });
        }

        function addCurrentLine() {
            if (state.selected.size === 0) { alert('حداقل یک عملیات را انتخاب کنید.'); return false; }
            var line = readCurrentLine();
            var err = validateLine(line);
            if (err) { alert(err); return false; }
            state.lines.push(line);
            renderLines();
            clearLineFields();
            return true;
        }

        function lineSharesFor(line) {
            var items = Array.from(state.selected.values());
            var n = items.length;
            if (n === 0) return [];
            if (line.method === 1) return items.map(function () { return line.perOp; });
            if (line.method === 3) return items.map(function (s) {
                var rate = parseFloat(line.rates[key(s.op)]);
                if (!(rate > 0)) rate = line.rate;
                return Math.round(rate * Number(s.op.qty) * 100) / 100;
            });
            if (line.method === 4) return items.map(function (s) { return parseFloat(line.manual[key(s.op)]) || 0; });
            var equal = Math.round(line.total / n * 100) / 100;
            var shares = items.map(function () { return equal; });
            var sum = shares.reduce(function (a, b) { return a + b; }, 0);
            shares[n - 1] = Math.round((shares[n - 1] + line.total - sum) * 100) / 100;
            return shares;
        }

        function lineTotal(line) {
            return lineSharesFor(line).reduce(function (a, b) { return a + b; }, 0);
        }

        function renderLines() {
            var body = $('linesBody');
            $('linesWrap').hidden = state.lines.length === 0;
            body.innerHTML = '';
            state.lines.forEach(function (line, index) {
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td>' + (index + 1) + '</td>' +
                    '<td>' + esc(line.typeName) + '</td>' +
                    '<td>' + esc(line.providerId ? line.providerName : '—') + '</td>' +
                    '<td>' + methodNames[line.method] + '</td>' +
                    '<td class="ak-num">' + fmt(lineTotal(line)) + '</td>' +
                    '<td><button type="button" class="btn btn-sm btn-light ak-danger-action" data-remove-line="' + index + '">' +
                    '<i class="bi bi-x-lg"></i></button></td>';
                body.appendChild(tr);
            });
            body.querySelectorAll('[data-remove-line]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    state.lines.splice(parseInt(this.dataset.removeLine, 10), 1);
                    renderLines();
                    if (state.step === 3) renderPreview();
                    syncItemsInputs();
                });
            });
            syncItemsInputs();
        }

        // ---------- پیش‌نمایش ----------
        function renderPreview() {
            var items = Array.from(state.selected.values());
            var lines = state.lines;
            var shares = lines.map(lineSharesFor);
            var multi = lines.length > 1;

            $('previewMeta').innerHTML =
                '<span><b>تعداد مصرف:</b> ' + lines.length + '</span>' +
                '<span><b>تعداد عملیات:</b> ' + items.length + '</span>';

            $('previewHead').innerHTML =
                '<th>#</th><th>عملیات</th><th>نوع وسیله</th><th>شماره</th><th>مسیر</th><th>مقدار (تن)</th>' +
                lines.map(function (line) {
                    return '<th class="ak-num">' + esc(line.typeName) + '</th>';
                }).join('') +
                (multi ? '<th class="ak-num">جمع ردیف</th>' : '');

            var body = $('previewBody');
            body.innerHTML = '';
            items.forEach(function (s, i) {
                var rowTotal = 0;
                var cells = lines.map(function (line, l) {
                    var value = shares[l][i] || 0;
                    rowTotal += value;
                    if (line.method === 4) {
                        return '<td><input type="number" step="0.01" min="0" class="ak-input" data-manual-amount' +
                            ' data-line="' + l + '" data-key="' + esc(key(s.op)) + '"' +
                            ' value="' + (line.manual[key(s.op)] || '') + '" placeholder="0.00"></td>';
                    }
                    if (line.method === 3) {
                        // نرخ هر حمل قابل ویرایش است؛ سهم = نرخ × مقدار همان حمل.
                        return '<td><input type="number" step="0.01" min="0" class="ak-input" data-line-rate' +
                            ' data-line="' + l + '" data-key="' + esc(key(s.op)) + '"' +
                            ' value="' + (line.rates[key(s.op)] || '') + '" placeholder="' + fmt(line.rate) + '">' +
                            '<small class="ak-note d-block">= ' + fmt(value) + '</small></td>';
                    }
                    return '<td class="ak-num">' + fmt(value) + '</td>';
                }).join('');

                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + s.op.op + '</td>' +
                    '<td>' + s.op.vehicle + '</td>' +
                    '<td class="ak-num">' + s.op.number + '</td>' +
                    '<td>' + s.op.route + '</td>' +
                    '<td class="ak-num">' + fmtQty(s.op.qty) + '</td>' +
                    cells +
                    (multi ? '<td class="ak-num">' + fmt(rowTotal) + '</td>' : '');
                body.appendChild(tr);
            });

            renderPreviewFoot();

            body.querySelectorAll('[data-manual-amount]').forEach(function (input) {
                input.addEventListener('input', function () {
                    var line = state.lines[parseInt(this.dataset.line, 10)];
                    if (!line) return;
                    line.manual[this.dataset.key] = this.value;
                    renderPreviewFoot();
                    renderLines();
                });
            });

            body.querySelectorAll('[data-line-rate]').forEach(function (input) {
                input.addEventListener('change', function () {
                    var line = state.lines[parseInt(this.dataset.line, 10)];
                    if (!line) return;
                    var rate = parseFloat(this.value);
                    if (rate > 0) { line.rates[this.dataset.key] = rate; }
                    else { delete line.rates[this.dataset.key]; }
                    renderPreview();
                    renderLines();
                });
            });

            syncItemsInputs();
        }

        function renderPreviewFoot() {
            var lines = state.lines;
            var multi = lines.length > 1;
            var totals = lines.map(lineTotal);
            var grand = totals.reduce(function (a, b) { return a + b; }, 0);
            var currency = (curSel && curSel.value) || 'USD';
            $('previewFoot').innerHTML =
                '<td colspan="6" class="ak-table-total">مبلغ مجموع</td>' +
                totals.map(function (t) { return '<td class="ak-num">' + fmt(t) + '</td>'; }).join('') +
                (multi ? '<td class="ak-num">' + fmt(grand) + ' ' + esc(currency) + '</td>' : '');
        }

        // ---------- ویزارد ----------
        var notes = {
            1: 'در مرحله بعد، مشخصات مصرف و روش تقسیم را تعیین خواهید کرد.',
            2: 'در مرحله بعد، پیش‌نمایش توزیع مبلغ را مشاهده و ثبت نهایی را انجام خواهید داد.',
            3: 'با ثبت نهایی، برای هر عملیات یک سهم جداگانه همراه سند حسابداری ایجاد می‌شود.'
        };

        function goStep(n) {
            if (n < 1 || n > 3) return;
            if (n > 1 && state.selected.size === 0) {
                alert('حداقل یک عملیات را انتخاب کنید.');
                return;
            }
            if (n === 3 && !validateStep2()) return;
            state.step = n;
            document.querySelectorAll('[data-step-panel]').forEach(function (p) {
                p.hidden = parseInt(p.dataset.stepPanel, 10) !== n;
            });
            document.querySelectorAll('[data-step-btn]').forEach(function (b) {
                var bn = parseInt(b.dataset.stepBtn, 10);
                b.classList.toggle('is-active', bn === n);
                b.classList.toggle('is-done', bn < n);
                if (bn === n) b.setAttribute('aria-current', 'step');
                else b.removeAttribute('aria-current');
            });
            $('btnPrev').hidden = n === 1;
            $('btnNext').hidden = n === 3;
            $('btnSubmit').hidden = n !== 3;
            $('footerNote').textContent = notes[n];
            if (n === 3) renderPreview();
        }

        function validateStep2() {
            // ارز غیر دالری → نرخ تبدیل الزامی (فیلد مخفیِ technical باید پر شده باشد)
            var cur = (curSel && curSel.value) || 'USD';
            if (cur !== 'USD') {
                var tech = document.querySelector('[data-fx-rate-technical]');
                if (!tech || !(parseFloat(tech.value) > 0)) {
                    alert('برای ارز ' + cur + ' نرخ تبدیل را وارد کنید.');
                    return false;
                }
            }
            // مصرفِ پرشده ولی افزوده‌نشده هم به لیست می‌رود تا چیزی از قلم نیفتد.
            if ($('ManualExpenseTypeName').value.trim() || state.lines.length === 0) {
                if (!addCurrentLine()) return false;
            }
            if (state.lines.length === 0) {
                alert('حداقل یک مصرف به لیست اضافه کنید.');
                return false;
            }
            return true;
        }

        $('btnAddLine').addEventListener('click', function () { addCurrentLine(); });

        document.querySelectorAll('[data-step-btn]').forEach(function (b) {
            b.addEventListener('click', function () { goStep(parseInt(this.dataset.stepBtn, 10)); });
        });
        $('btnNext').addEventListener('click', function () { goStep(state.step + 1); });
        $('btnPrev').addEventListener('click', function () { goStep(state.step - 1); });

        // ---------- ساخت فیلدهای Items ----------
        // همیشه قبل از submit ساخته شده باشند؛ حتی اگر اسکریپت دیگری submit را
        // زودتر (capture) بگیرد، فیلدها از قبل داخل فرم هستند.
        function syncItemsInputs() {
            var container = document.getElementById('gexpItemsContainer');
            container.innerHTML = '';
            function mk(name, value) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                container.appendChild(input);
            }

            var items = Array.from(state.selected.values());
            items.forEach(function (s, i) {
                mk('Items[' + i + '].Kind', s.op.kind);
                mk('Items[' + i + '].Id', s.op.id);
            });

            state.lines.forEach(function (line, l) {
                var prefix = 'Lines[' + l + '].';
                mk(prefix + 'ManualExpenseTypeName', line.typeName);
                if (line.providerId) mk(prefix + 'ServiceProviderId', line.providerId);
                mk(prefix + 'AllocationMethod', line.method);
                if (line.method === 1) mk(prefix + 'AmountPerOperation', line.perOp);
                if (line.method === 2) mk(prefix + 'TotalAmount', line.total);
                if (line.method === 3) {
                    if (line.rate > 0) mk(prefix + 'RatePerTon', line.rate);
                    items.forEach(function (s, i) {
                        var rate = parseFloat(line.rates[key(s.op)]);
                        mk(prefix + 'RatePerTonOverrides[' + i + ']', rate > 0 ? rate : '');
                    });
                }
                if (line.desc) mk(prefix + 'Description', line.desc);
                if (line.method === 4) {
                    items.forEach(function (s, i) {
                        mk(prefix + 'ManualAmounts[' + i + ']', parseFloat(line.manual[key(s.op)]) || 0);
                    });
                }
            });
        }

        // ---------- ارسال ----------
        document.getElementById('gexpForm').addEventListener('submit', function (e) {
            // اعتبارسنجیِ کامل سمت کلاینت تا submit بی‌صدا به سرور نرود و رد نشود.
            if (state.selected.size === 0) {
                e.preventDefault();
                alert('حداقل یک عملیات را انتخاب کنید.');
                return;
            }
            if (!validateStep2()) { e.preventDefault(); return; }
            syncItemsInputs();

            // قفلِ سادهٔ ضدِ دابل‌کلیک. اگر ناوبری انجام نشد (خطای شبکه/سرور)،
            // بعد از چند ثانیه دکمه آزاد می‌شود تا هرگز روی «در حال ثبت…» گیر نکند.
            var btn = $('btnSubmit');
            if (btn && !btn.disabled) {
                var original = btn.innerHTML;
                setTimeout(function () {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ثبت…';
                }, 0);
                setTimeout(function () {
                    btn.disabled = false;
                    btn.innerHTML = original;
                }, 8000);
            }
        });

        // ---------- اپلود اکسل (نمبر وسیله + مقدار) برای مبالغ دستی و نرخ هر حمل ----------
        function setupExcelImport(options) {
            var box = $(options.boxId);
            var input = $(options.fileId);
            var btn = $(options.btnId);
            var status = $(options.statusId);
            var url = box ? box.getAttribute('data-manual-import-url') : '';
            if (!box || !input || !btn || !url) { return; }

            function normNumber(v) {
                return String(v == null ? '' : v).toLowerCase().replace(/[^0-9a-z؀-ۿ]/g, '');
            }
            function say(text, isError) {
                status.hidden = false;
                status.textContent = text;
                status.classList.toggle('is-error', !!isError);
            }

            // هر ردیف فایل با نمبر واقعی وسیله (و در نبود آن، سیمیر) تطبیق می‌شود؛
            // عملیاتِ انتخاب‌نشده در صورت وجود در لیست، انتخاب می‌شود.
            function applyRows(rows) {
                var matched = 0, added = 0, skipped = 0;
                rows.forEach(function (r) {
                    var n = normNumber(r.vehicleNumber);
                    var amount = parseFloat(r.amount);
                    if (!n || !(amount > 0)) { skipped++; return; }
                    var targets = ops.filter(function (o) { return normNumber(o.number) === n; });
                    if (targets.length === 0) {
                        targets = ops.filter(function (o) { return o.alt && normNumber(o.alt) === n; });
                    }
                    if (targets.length === 0) { skipped++; return; }
                    targets.forEach(function (o) {
                        var k = key(o);
                        if (!state.selected.has(k)) { state.selected.set(k, { op: o, manualAmount: null, manualRate: null }); added++; }
                        state.selected.get(k)[options.field] = String(amount);
                        matched++;
                    });
                });
                return { matched: matched, added: added, skipped: skipped };
            }

            btn.addEventListener('click', function () { input.value = ''; input.click(); });

            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) { return; }
                var fd = new FormData();
                fd.append('file', file);
                var token = document.querySelector('#gexpForm input[name="__RequestVerificationToken"]');
                if (token) { fd.append('__RequestVerificationToken', token.value); }
                btn.disabled = true;
                say('در حال خواندن فایل…', false);
                fetch(url, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data || !data.ok) { say((data && data.message) || 'خواندن فایل ناموفق بود.', true); return; }
                        var result = applyRows(data.rows || []);
                        if (result.matched === 0) { say('هیچ نمبر وسیله‌ای در فایل با عملیات‌های موجود مطابقت نداشت.', true); return; }
                        renderTable();
                        if (state.step === 3) { renderPreview(); } else { syncItemsInputs(); }
                        say(options.label + ' برای ' + result.matched + ' عملیات ثبت شد'
                            + (result.added ? ' — ' + result.added + ' عملیات به انتخاب افزوده شد' : '')
                            + (result.skipped ? ' — ' + result.skipped + ' ردیف بدون تطابق' : '')
                            + ' — برای ثبت، «افزودن این مصرف به لیست» را بزنید.', false);
                    })
                    .catch(function () { say('خطا در ارتباط با سرور.', true); })
                    .then(function () { btn.disabled = false; });
            });
        }

        setupExcelImport({
            boxId: 'manualHint', fileId: 'manualAmountFile', btnId: 'btnManualImport',
            statusId: 'manualImportStatus', field: 'manualAmount', label: 'مبلغ'
        });
        setupExcelImport({
            boxId: 'rateHint', fileId: 'rateFile', btnId: 'btnRateImport',
            statusId: 'rateImportStatus', field: 'manualRate', label: 'نرخ فی تن'
        });

        // شروع
        syncMethodFields();
        renderLines();
        renderTable();
        goStep(1);
    })();
    </script>
}
