@model PTGOilSystem.Web.Models.Expenses.ExpenseDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Expenses") ?? "/Expenses";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var ledgerRecorded = Model.LedgerEntryId.HasValue;
    var ledgerStatus = ledgerRecorded ? T("ثبت شده", "Recorded") : T("ثبت نشده", "Pending");
    var providerText = Model.ServiceProviderName ?? Model.OperationalAssetName;

    ViewData["AkHeaderStatus"] = ledgerStatus;
    ViewData["AkHeaderStatusState"] = ledgerRecorded ? "is-active" : "is-warning";
    ViewData["AkHeaderContext"] = string.Join(" · ", new[]
    {
        Model.ExpenseTypeName,
        providerText,
        Model.ExpenseDate.ToDisplayDate()
    }.Where(part => !string.IsNullOrWhiteSpace(part)));
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = T("ویرایش", "Edit"), Href = Url.Action("Edit", new { id = Model.Id, returnUrl = currentReturnUrl }), Icon = "bi-pencil-square" }
    };

    // وضعیت دفتر در سربرگ نشان داده می‌شود و کارت KPI جدا نمی‌گیرد.
    var kpis = new List<AkKpiItem>
    {
        new() { Title = T("مبلغ سند", "Document amount"), Value = Model.Amount.ToString("N2"), Unit = Model.Currency, Avatar = "expenses" },
        new() { Title = T("معادل دالر", "USD equivalent"), Value = Model.AmountUsd.ToString("N2"), Unit = "USD", Avatar = "payments-out" }
    };

    // نوع مصرف/تاریخ/طرف خدماتی در خط زمینهٔ سربرگ‌اند؛ قرارداد و محموله فقط چیپ مرتبط‌اند.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = T("نرخ تبدیل", "FX rate"), Value = Model.AppliedFxRateToUsd?.ToString("N6"), IsNumeric = true },
        new() { Label = T("ارسال با موتر", "Truck send"), Value = Model.TruckDispatchLabel },
        new() { Label = T("جریان حمل بار", "Cargo flow"), Value = Model.TransportLegLabel },
        new()
        {
            Label = T("مصرف گروهی", "Group expense"),
            Value = Model.ExpenseBatchId.HasValue ? (Model.ExpenseBatchNumber ?? $"#{Model.ExpenseBatchId}") : null,
            Href = Model.ExpenseBatchId.HasValue ? Url.Action("GroupDetails", new { id = Model.ExpenseBatchId }) : null
        },
        new() { Label = T("شرح", "Description"), Value = Model.Description, IsWide = true }
    };

    // ردپای حسابداری و شناسه‌های داخلی — پشت آکاردئون، بدون حذف هیچ عدد مالی.
    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = T("شناسه Ledger", "Ledger id"), Value = ledgerRecorded ? $"#{Model.LedgerEntryId}" : null, IsNumeric = true },
        new() { Label = T("مبلغ سند دفتر", "Ledger amount"), Value = Model.LedgerAmountUsd?.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("سمت", "Side"), Value = Model.LedgerSideName },
        new() { Label = T("مرجع دفتر", "Ledger reference"), Value = Model.LedgerReference },
        new() { Label = T("شرح دفتر", "Ledger description"), Value = Model.LedgerDescription, IsWide = true }
    };

    var relatedRecords = new List<AkRelatedRecord>();
    if (!string.IsNullOrWhiteSpace(Model.ContractNumber)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("قرارداد", "Contract"), Label = Model.ContractNumber, Icon = "bi-file-earmark-text" });
    if (!string.IsNullOrWhiteSpace(Model.ShipmentCode)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("محموله", "Shipment"), Label = Model.ShipmentCode, Icon = "bi-box-seam" });
    if (Model.ServiceProviderId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("شرکت خدماتی", "Service provider"), Label = Model.ServiceProviderName ?? $"#{Model.ServiceProviderId.Value}", Href = Url.Action("Details", "ServiceProviders", new { id = Model.ServiceProviderId.Value, returnUrl = currentReturnUrl }), Icon = "bi-building" });
    if (Model.OperationalAssetId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("دارایی عملیاتی", "Operational asset"), Label = Model.OperationalAssetName ?? $"#{Model.OperationalAssetId.Value}", Href = Url.Action("Details", "OperationalAssets", new { id = Model.OperationalAssetId.Value, returnUrl = currentReturnUrl }), Icon = "bi-truck" });
    if (Model.LedgerEntryId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("سند دفتر کل", "Ledger entry"), Label = $"#{Model.LedgerEntryId.Value}", KeyValue = $"{Model.AmountUsd:N2} USD", Icon = "bi-journal-text" });

    var nextActions = new List<AkHeaderMenuItem>
    {
        new() { Label = T("مصرف جدید", "New expense"), Href = Url.Action("Create", new { returnUrl = backUrl }), Icon = "bi-plus-lg" }
    };

    ViewData["Title"] = T("جزئیات مصرف", "Expense Details");
    ViewData["HideSectionTabs"] = true;
}

<div class="ak-form-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("جزئیات مصرف", "Expense details") + $" #{Model.Id}", false,
                       T("ویرایش", "Edit"), "bi-pencil-square",
                       Url.Action("Edit", new { id = Model.Id, returnUrl = currentReturnUrl }), (string?)null,
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

    <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
             model="@((T("مشخصات مصرف", "Expense profile"), (string?)null, (IReadOnlyList<AkInfoItem>)summaryItems))" />

    @if (relatedRecords.Count > 0)
    {
        <section class="ak-form-section ak-detail-section" aria-labelledby="expense-related-title">
            <h2 class="ak-section-title" id="expense-related-title">@T("رکوردهای مرتبط", "Related records")</h2>
            <partial name="~/Views/Shared/Partials/_RelatedRecords.cshtml" model="@((IReadOnlyList<AkRelatedRecord>)relatedRecords)" />
        </section>
    }

    <partial name="~/Views/Shared/Partials/_DetailAdvancedSection.cshtml"
             model="@(((string?)null, (IReadOnlyList<AkInfoItem>)advancedItems))" />

    <partial name="~/Views/Shared/Partials/_DetailActionBar.cshtml" model="@((IReadOnlyList<AkHeaderMenuItem>)nextActions)" />
</div>
