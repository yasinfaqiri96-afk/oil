@model PTGOilSystem.Web.Models.Payments.PaymentDetailsViewModel
@using PTGOilSystem.Web.Models.Shared
@{
    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : Url.Action("Index") ?? "/Payments";
    var voucherUrl = Url.Action("Payment", "Invoices", new { id = Model.Id }) ?? "#";
    var selfUrl = Url.Action("Details", new { id = Model.Id });
    var counterpartyType = "-";
    var counterpartyName = "-";
    if (Model.CustomerId.HasValue) { counterpartyType = "مشتری"; counterpartyName = Model.CustomerName ?? "-"; }
    else if (Model.SupplierId.HasValue) { counterpartyType = "تأمین‌کننده"; counterpartyName = Model.SupplierName ?? "-"; }
    else if (Model.ServiceProviderId.HasValue) { counterpartyType = "شرکت خدماتی"; counterpartyName = Model.ServiceProviderName ?? "-"; }
    else if (Model.SarrafId.HasValue) { counterpartyType = "صراف"; counterpartyName = Model.SarrafName ?? "-"; }
    else if (Model.DriverId.HasValue) { counterpartyType = "راننده"; counterpartyName = Model.DriverName ?? "-"; }
    else if (Model.EmployeeId.HasValue) { counterpartyType = "کارمند"; counterpartyName = Model.EmployeeName ?? "-"; }

    var fxDisplay = Model.AppliedFxRateToUsd.HasValue && Model.AppliedFxRateToUsd.Value > 0m
        ? (Model.Currency != "USD"
            ? $"{NumberDisplay.Number(1m / Model.AppliedFxRateToUsd.Value, 4)} {Model.Currency} / USD"
            : NumberDisplay.FxRate(Model.AppliedFxRateToUsd.Value))
        : null;

    ViewData["Title"] = "جزئیات پرداخت";
    ViewData["HideSectionTabs"] = true;
    ViewData["AkHeaderStatus"] = Model.DirectionName;
    ViewData["AkHeaderStatusState"] = Model.Direction == PTGOilSystem.Web.Models.Entities.PaymentDirection.In ? "is-active" : "is-warning";
    ViewData["AkHeaderContext"] = $"{Model.PaymentKindName} · {counterpartyType}: {counterpartyName} · {Model.PaymentDate.ToDisplayDate()}";
    var paymentMenu = new List<AkHeaderMenuItem>();
    if (Model.LedgerEntryId.HasValue)
    {
        paymentMenu.Add(new AkHeaderMenuItem { Label = "سند دفتر کل", Href = Url.Action("Details", "Ledger", new { id = Model.LedgerEntryId.Value }), Icon = "bi-journal-text" });
    }
    ViewData["AkHeaderKebab"] = paymentMenu;

    // تب فقط وقتی ساخته می‌شود که بخش تخصیص پیش‌پرداخت واقعاً محتوا داشته باشد.
    // تب‌های «روابط»، «ردیابی» و «ثبت سیستم» حذف شدند: روابط به چیپ رکوردهای مرتبط،
    // ردیابی به کارت خلاصه و ثبت سیستم به آکاردئون اطلاعات فنی منتقل شد.
    var hasAllocationTab = Model.SupportsAdvanceAllocation;
    var activePaymentTab = Context.Request.Query["tab"].ToString().Trim().ToLowerInvariant();
    activePaymentTab = hasAllocationTab && activePaymentTab == "allocations" ? "allocations" : "main";
    var paymentTabs = new[]
    {
        $"main|خلاصه سند||{(activePaymentTab == "main" ? "active" : "")}",
        $"allocations|تخصیص پیش‌پرداخت||{(activePaymentTab == "allocations" ? "active" : "")}"
    };

    var kpis = new List<AkKpiItem>
    {
        new() { Title = "مبلغ", Value = Model.Amount.ToString("N2"), Unit = Model.Currency, Avatar = "payments-out" },
        new() { Title = "معادل USD", Value = Model.AmountUsd.ToString("N2"), Unit = "USD", Avatar = "cash-flow" }
    };
    if (fxDisplay is not null)
    {
        kpis.Add(new AkKpiItem { Title = "نرخ ارز", Value = fxDisplay, Avatar = "exchange-rate" });
    }

    // تاریخ/نوع سند/طرف حساب در خط زمینهٔ سربرگ‌اند و اینجا تکرار نمی‌شوند.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = "مرجع", Value = Model.Reference },
        new() { Label = "حساب نقد / بانک", Value = string.Join(" · ", new[] { Model.CashAccountCode, Model.CashAccountName, Model.CashAccountTypeName }.Where(part => !string.IsNullOrWhiteSpace(part))) },
        new() { Label = "قرارداد", Value = Model.ContractNumber },
        new() { Label = "محموله", Value = Model.ShipmentCode },
        new() { Label = "شرح", Value = Model.Description, IsWide = true }
    };

    var traceItems = new List<AkInfoItem>
    {
        new() { Label = "فروش", Value = Model.SalesInvoiceNumber },
        new() { Label = "مصرف", Value = Model.ExpenseDescription },
        new() { Label = "کمیسیون", Value = Model.CommissionAmount.HasValue ? $"{Model.CommissionAmount.Value:N2} {Model.CommissionCurrency}" : null, IsNumeric = true, Href = Model.CommissionExpenseTransactionId.HasValue ? Url.Action("Details", "Expenses", new { id = Model.CommissionExpenseTransactionId.Value }) : null },
        new() { Label = "ارسال با موتر", Value = Model.TruckDispatchLabel },
        new() { Label = "دفتر کل", Value = Model.LedgerEntryId.HasValue ? $"#{Model.LedgerEntryId} / {UiText.LedgerSource(Context, Model.LedgerSourceType)} / {Model.LedgerSideName}" : null, Href = Model.LedgerEntryId.HasValue ? Url.Action("Details", "Ledger", new { id = Model.LedgerEntryId.Value }) : null }
    };

    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = "شماره سند", Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = "ایجاد", Value = Model.CreatedAtUtc.ToDisplayDateTime() },
        new() { Label = "کاربر ایجادکننده", Value = Model.CreatedByUserId?.ToString(), IsNumeric = true },
        new() { Label = "آخرین ویرایش", Value = Model.UpdatedAtUtc?.ToDisplayDateTime() },
        new() { Label = "کاربر ویرایش‌کننده", Value = Model.UpdatedByUserId?.ToString(), IsNumeric = true }
    };

    // روابط فقط برای طرف‌هایی که واقعاً ثبت شده‌اند — ردیف «-» ساخته نمی‌شود.
    var relatedRecords = new List<AkRelatedRecord>();
    if (Model.CustomerId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "مشتری", Label = Model.CustomerName ?? $"#{Model.CustomerId.Value}", Href = Url.Action("Details", "Customers", new { id = Model.CustomerId.Value }), Icon = "bi-people" });
    if (Model.SupplierId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "تأمین‌کننده", Label = Model.SupplierName ?? $"#{Model.SupplierId.Value}", Href = Url.Action("Details", "Suppliers", new { id = Model.SupplierId.Value }), Icon = "bi-briefcase" });
    if (Model.ServiceProviderId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "شرکت خدماتی", Label = Model.ServiceProviderName ?? $"#{Model.ServiceProviderId.Value}", Href = Url.Action("Details", "ServiceProviders", new { id = Model.ServiceProviderId.Value }), Icon = "bi-building" });
    if (Model.SarrafId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "صراف", Label = Model.SarrafName ?? $"#{Model.SarrafId.Value}", Href = Url.Action("Details", "Sarrafs", new { id = Model.SarrafId.Value }), Icon = "bi-currency-exchange" });
    if (Model.DriverId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "راننده", Label = Model.DriverName ?? $"#{Model.DriverId.Value}", Href = Url.Action("Details", "Drivers", new { id = Model.DriverId.Value }), Icon = "bi-person-vcard" });
    if (Model.EmployeeId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "کارمند", Label = Model.EmployeeName ?? $"#{Model.EmployeeId.Value}", Href = Url.Action("Details", "Employees", new { id = Model.EmployeeId.Value }), Icon = "bi-person-badge" });
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"سند مالی #{Model.Id}", false,
                       "سند چاپی", "bi-receipt-cutoff", voucherUrl, (string?)null,
                       "بازگشت", "bi-arrow-right", (string?)backUrl))" />

    @if (hasAllocationTab)
    {
        <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("تب‌های سند مالی", paymentTabs)" />
    }

    @if (activePaymentTab == "main")
    {
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

        <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
                 model="@(("اطلاعات سند", (string?)null, (IReadOnlyList<AkInfoItem>)summaryItems))" />

        <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
                 model="@(("ردیابی عملیاتی", (string?)null, (IReadOnlyList<AkInfoItem>)traceItems))" />

        if (relatedRecords.Count > 0)
        {
            <section class="ak-form-section ak-detail-section" aria-labelledby="payment-related-title">
                <h2 class="ak-section-title" id="payment-related-title">رکوردهای مرتبط</h2>
                <partial name="~/Views/Shared/Partials/_RelatedRecords.cshtml" model="@((IReadOnlyList<AkRelatedRecord>)relatedRecords)" />
            </section>
        }

        <partial name="~/Views/Shared/Partials/_DetailAdvancedSection.cshtml"
                 model="@(((string?)null, (IReadOnlyList<AkInfoItem>)advancedItems))" />
    }
    else
    {
        var isAdvanceCurrencyUsd = string.Equals(Model.Currency?.Trim(), "USD", StringComparison.OrdinalIgnoreCase);
        var allocationKpis = new List<AkKpiItem>
        {
            new() { Title = "مبلغ پرداخت", Value = Model.Amount.ToString("N2"), Unit = Model.Currency, Avatar = "payments-out" },
            new() { Title = "مصرف‌شده برای قراردادها", Value = Model.AllocatedPaymentAmountTotal.ToString("N2"), Unit = Model.Currency, Avatar = "contract-signed" },
            new() { Title = "مانده قابل تخصیص", Value = Model.AllocatableBalanceAmount.ToString("N2"), Unit = Model.Currency, Avatar = "treasury" }
        };
        if (isAdvanceCurrencyUsd)
        {
            allocationKpis.Add(new AkKpiItem { Title = "تعداد تخصیص فعال", Value = Model.ActiveAllocationCount.ToString("N0"), Unit = "مورد", Avatar = "ledger" });
        }
        else
        {
            // پیش‌پرداخت ارزی: اثر تسعیر جدا از خودِ مانده ارز نمایش داده می‌شود.
            allocationKpis.Add(new AkKpiItem
            {
                Title = Model.AllocationExchangeDifferenceUsd < 0 ? "زیان تسعیر تخصیص‌ها" : "سود تسعیر تخصیص‌ها",
                Value = Math.Abs(Model.AllocationExchangeDifferenceUsd).ToString("N2"),
                Unit = "USD",
                Avatar = "ledger"
            });
        }

        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)allocationKpis)" />

        <section class="ak-form-section ak-detail-section">
            <header class="ak-section-head ak-detail-section-header">
                <h2 class="ak-section-title">تخصیص پیش‌پرداخت به قرارداد</h2>
                @* ثبت تخصیص جدید از این‌جا برداشته شد: انتقال طلب اکنون از «مانده قابل انتقال»
                   در جزئیات تأمین‌کننده انجام می‌شود که مانده واقعی حساب را مبنا می‌گیرد.
                   سوابق و «برگشت تخصیص» این‌جا دست‌نخورده باقی مانده‌اند. *@
                @if (Model.SupplierId.HasValue)
                {
                    <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId"
                       class="btn btn-outline-primary ak-primary-action">
                        <i class="bi bi-arrow-left-right"></i> مانده قابل انتقال تأمین‌کننده
                    </a>
                }
            </header>

            @if (Model.Allocations.Any())
            {
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th>تاریخ تخصیص</th>
                                <th class="ak-col-grow">قرارداد</th>
                                <th class="ak-col-num">مبلغ مصرف‌شده</th>
                                <th class="ak-col-num">نرخ روز تخصیص</th>
                                <th class="ak-col-num">ارزش روز تخصیص USD</th>
                                <th class="ak-col-num">سود/زیان تسعیر</th>
                                <th class="ak-col-num">معادل ارز قرارداد</th>
                                <th>مرجع</th>
                                <th>وضعیت</th>
                                <th class="ak-col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in Model.Allocations)
                        {
                            <tr class="@(a.IsActive ?"" : "ak-row-muted")">
                                <td>@a.AllocationDate.ToDisplayDate()</td>
                                <td class="ak-col-grow"><a asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@a.ContractId" asp-route-returnUrl="@selfUrl">@a.ContractDisplayLabel</a></td>
                                <td class="ak-col-num ak-num">
                                    @a.AllocatedPaymentAmount.ToString("N2") @a.PaymentCurrencyCode
                                    <div class="ak-note">ارزش تاریخی: @a.AllocatedBookAmountUsd.ToString("N2") USD</div>
                                </td>
                                <td class="ak-col-num ak-num">۱ USD = @NumberDisplay.Number(a.PaymentCurrencyPerUsdRateAtAllocation, 4) @a.PaymentCurrencyCode</td>
                                <td class="ak-col-num ak-num">@a.AllocatedValueUsdAtAllocation.ToString("N2")</td>
                                <td class="ak-col-num ak-num">
                                    @if (a.HasExchangeDifference)
                                    {
                                        <span class="@(a.ExchangeDifferenceUsd < 0 ? "ak-number--negative" : "ak-number--positive")">
                                            @Math.Abs(a.ExchangeDifferenceUsd).ToString("N2") USD
                                        </span>
                                        <div class="ak-note">@a.ExchangeDifferenceName</div>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="ak-col-num ak-num">
                                    @a.AllocatedContractCurrencyAmount.ToString("N2") @a.ContractCurrencyCode
                                    <div class="ak-note">نرخ قرارداد: @NumberDisplay.Number(a.ContractCurrencyPerUsdRate, 4) @a.ContractCurrencyCode/USD</div>
                                </td>
                                <td>@(a.ReferenceNumber ?? "—")</td>
                                <td>@a.StatusName</td>
                                <td class="ak-col-actions">
                                    @if (a.IsActive)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reverseAllocationModal-@a.Id">برگشت</button>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(a.ReversalReason))
                                    {
                                        <span class="ak-note">@a.ReversalReason</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @foreach (var a in Model.Allocations.Where(x => x.IsActive))
                {
                    <div class="modal fade" id="reverseAllocationModal-@a.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <form asp-action="ReverseAllocation" method="post" class="modal-content">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="allocationId" value="@a.Id" />
                                <input type="hidden" name="returnUrl" value="@selfUrl" />
                                <div class="modal-header">
                                    <h5 class="modal-title">برگشت تخصیص پیش‌پرداخت</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="ak-note">
                                        تخصیص #@a.Id به قرارداد @a.ContractDisplayLabel به مبلغ @a.AllocatedPaymentAmount.ToString("N2") @a.PaymentCurrencyCode برگشت داده می‌شود.
                                        @if (a.HasExchangeDifference)
                                        {
                                            <text>@a.ExchangeDifferenceName به مبلغ @Math.Abs(a.ExchangeDifferenceUsd).ToString("N2") USD نیز معکوس می‌شود.</text>
                                        }
                                        رکورد اصلی حفظ می‌شود و فقط ثبت‌های معکوس ساخته می‌شوند.
                                    </p>
                                    <label class="ak-label">دلیل برگشت</label>
                                    <textarea name="reason" class="ak-input" rows="2" required></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                                    <button type="submit" class="btn btn-danger">برگشت تخصیص</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@("هنوز هیچ مصرف پیش‌پرداختی برای قرارداد ثبت نشده است.")" />
            }
        </section>
    }
</div>
