@model PTGOilSystem.Web.Models.Loading.LoadingEditViewModel
@{
    ViewData["Title"] = $"ویرایش بارگیری #{Model.Id}";
    var backUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Details", "Loading", new { id = Model.Id }) ?? $"/Loading/Details/{Model.Id}";
}

<div class="ak-form-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(("ویرایش بارگیری", false, (string?)null, (string?)null, (string?)null, (string?)null, "بازگشت", "bi-arrow-right", (string?)backUrl))" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ak-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Version" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert"></div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("خلاصه بارگیری", (string?)"اطلاعات مرجع این ثبت تغییر نمی‌کند."))" />
            <dl class="ak-form-grid">
                <div class="ak-field"><dt class="ak-label">قرارداد</dt><dd>@Model.ContractNumber</dd></div>
                <div class="ak-field"><dt class="ak-label">محصول</dt><dd>@Model.ProductName</dd></div>
                <div class="ak-field"><dt class="ak-label">وسیله حمل</dt><dd>@Model.VehicleSummary</dd></div>
            </dl>
        </section>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("مقدار و قیمت", (string?)null))" />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="LoadedQuantityMt" class="ak-label"></label>
                    <input asp-for="LoadedQuantityMt" class="ak-input ak-num" type="number" min="0.0001" step="0.0001" />
                    @if (Model.TotalReceivedQuantityMt > 0)
                    {
                        <div class="form-text">نمی‌تواند کمتر از مقدار رسیدشده (@NumberDisplay.Quantity(Model.TotalReceivedQuantityMt) MT) باشد.</div>
                    }
                    <span asp-validation-for="LoadedQuantityMt" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="LoadingPriceUsd" class="ak-label"></label>
                    <input asp-for="LoadingPriceUsd" class="ak-input ak-num" type="number" min="0.0001" step="0.0001" />
                    <div class="form-text">اگر نرخ هنوز اعلام نشده، خالی بگذارید تا وضعیت «در انتظار نرخ» بماند.</div>
                    <span asp-validation-for="LoadingPriceUsd" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("وسیله و مسیر", (string?)null))" />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="LoadingDate" class="ak-label"></label>
                    <input asp-for="LoadingDate" class="ak-input" type="date" />
                    <span asp-validation-for="LoadingDate" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="BillOfLadingNumber" class="ak-label"></label>
                    <input asp-for="BillOfLadingNumber" class="ak-input" placeholder="شماره بارنامه" />
                    <span asp-validation-for="BillOfLadingNumber" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="RwbNo" class="ak-label"></label>
                    <input asp-for="RwbNo" class="ak-input" placeholder="شماره RWB" />
                    <span asp-validation-for="RwbNo" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="WagonNumber" class="ak-label"></label>
                    <input asp-for="WagonNumber" class="ak-input" placeholder="شماره واگن یا وسیله" />
                    <span asp-validation-for="WagonNumber" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="RouteDescription" class="ak-label"></label>
                    <input asp-for="RouteDescription" class="ak-input" placeholder="مثال: بندرعباس ← تهران" />
                    <span asp-validation-for="RouteDescription" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="ConsigneeName" class="ak-label"></label>
                    <input asp-for="ConsigneeName" class="ak-input" placeholder="نام گیرنده" />
                    <span asp-validation-for="ConsigneeName" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="DestinationName" class="ak-label"></label>
                    <input asp-for="DestinationName" class="ak-input" placeholder="نام مقصد" />
                    <span asp-validation-for="DestinationName" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="TransitNumber" class="ak-label"></label>
                    <input asp-for="TransitNumber" class="ak-input" placeholder="اختیاری" />
                    <span asp-validation-for="TransitNumber" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="DriverName" class="ak-label"></label>
                    <input asp-for="DriverName" class="ak-input" placeholder="اختیاری" list="loading-edit-driver-options" autocomplete="off" />
                    <datalist id="loading-edit-driver-options">
                        @foreach (var driver in ViewBag.LoadingDriverOptions as IReadOnlyList<PTGOilSystem.Web.Models.Loading.LoadingDriverOption> ?? Array.Empty<PTGOilSystem.Web.Models.Loading.LoadingDriverOption>())
                        {
                            <option value="@driver.FullName">@driver.Phone</option>
                        }
                    </datalist>
                    <div class="form-text">برای «راننده آزاد»: رانندهٔ موجود از روی نام و تماس پیدا می‌شود؛ نام تازه پروفایل راننده می‌سازد.</div>
                    <span asp-validation-for="DriverName" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="DriverPhone" class="ak-label"></label>
                    <input asp-for="DriverPhone" type="tel" dir="ltr" class="ak-input" placeholder="اختیاری" />
                    <span asp-validation-for="DriverPhone" class="ak-field-error"></span>
                </div>

                <div class="ak-field">
                    <label asp-for="LogisticsCompanyName" class="ak-label"></label>
                    <input asp-for="LogisticsCompanyName" class="ak-input" placeholder="نام شرکت لجستیک (در صورت نبود در لیست)" />
                    <div class="form-text">فقط در صورتی که شرکت لجستیک از طریق لیست انتخاب نشده باشد قابل ویرایش است.</div>
                    <span asp-validation-for="LogisticsCompanyName" class="ak-field-error"></span>
                </div>

                <div class="ak-field ak-col-full">
                    <label asp-for="Notes" class="ak-label"></label>
                    <textarea asp-for="Notes" class="ak-input" rows="3" placeholder="یادداشت‌های اضافه برای این بارگیری"></textarea>
                    <span asp-validation-for="Notes" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section" data-loading-edit-freight>
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("کرایه", (string?)(Model.HasExpenseLines
                         ? "مصارف این بارگیری از «ثبت مصارف» در صفحهٔ جزئیات مدیریت می‌شود؛ این بخش اینجا قابل ویرایش نیست."
                         : "تغییر این بخش، راننده یا وزن، سند مصرف کرایه و طلب طرف‌حساب را خودکار هماهنگ می‌کند.")))" />
            @if (!Model.HasExpenseLines)
            {
                var providerOptions = ViewBag.EditServiceProviders as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                    ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                var assetOptions = ViewBag.EditOperationalAssets as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                    ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="LogisticsMode" class="ak-label"></label>
                        <select asp-for="LogisticsMode" class="ak-input">
                            <option value="none">بدون ترانسپورت مشخص</option>
                            <option value="free">ترانسپورت آزاد (شرکت خدماتی)</option>
                            <option value="driver">راننده آزاد</option>
                            <option value="owned">ترانسپورت شخصی شرکت</option>
                        </select>
                        <div class="form-text">تغییر نوعیت، سند کرایهٔ قبلی را لغو و در صورت نیاز سند تازه ثبت می‌کند.</div>
                        <span asp-validation-for="LogisticsMode" class="ak-field-error"></span>
                    </div>

                    <div class="ak-field">
                        <label asp-for="OperationalAssetId" class="ak-label"></label>
                        <select asp-for="OperationalAssetId" asp-items="assetOptions" class="ak-input">
                            <option value=""></option>
                        </select>
                        <div class="form-text">فقط برای «ترانسپورت شخصی شرکت»؛ مصرف داخلی است و بدهی بیرونی نمی‌سازد.</div>
                        <span asp-validation-for="OperationalAssetId" class="ak-field-error"></span>
                    </div>

                    <div class="ak-field">
                        <label asp-for="FreightCostResponsibility" class="ak-label"></label>
                        <select asp-for="FreightCostResponsibility" class="ak-input">
                            <option value=""></option><option value="1">بدوش خریدار</option><option value="2">بدوش فروشنده</option><option value="3">مشترک</option>
                        </select>
                        <div class="form-text">برای ترانسپورت بیرونی اجباری است. فقط «بدوش خریدار» بدهی و هزینهٔ کرایه برای شرکت ما می‌سازد؛ «بدوش فروشنده» و «مشترک» فقط اطلاعاتی‌اند.</div>
                        <span asp-validation-for="FreightCostResponsibility" class="ak-field-error"></span>
                    </div>

                    <div class="ak-field">
                        <label asp-for="FreightRateUsdPerMt" class="ak-label"></label>
                        <input asp-for="FreightRateUsdPerMt" class="ak-input ak-num" type="number" min="0" step="0.0001" />
                        <div class="form-text">خالی‌کردن نرخ، ثبت کرایه را خاموش و سند کرایه را لغو می‌کند.</div>
                        <span asp-validation-for="FreightRateUsdPerMt" class="ak-field-error"></span>
                    </div>

                    <div class="ak-field">
                        <label asp-for="LogisticsServiceProviderId" class="ak-label"></label>
                        <select asp-for="LogisticsServiceProviderId" asp-items="providerOptions" class="ak-input">
                            <option value=""></option>
                        </select>
                        <div class="form-text">فقط برای «ترانسپورت آزاد». «راننده آزاد» از نام و تماس راننده خوانده می‌شود.</div>
                        <span asp-validation-for="LogisticsServiceProviderId" class="ak-field-error"></span>
                    </div>
                </div>
            }
        </section>
        <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml" model="@(("ذخیره تغییرات", backUrl, "انصراف"))" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
