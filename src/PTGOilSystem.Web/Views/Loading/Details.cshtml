@model PTGOilSystem.Web.Models.Loading.LoadingDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    ViewData["Title"] = T("جزئیات بارگیری", "Loading details");
    ViewData["HideSectionTabs"] = true;
    ViewData["LoadingExpenseEditorAssets"] = true;

    var returnUrl = ViewBag.ReturnUrl as string;
    var loadingListReturnUrl = Url.Action("Index", "Loading", new { contractId = Model.ContractId }) ?? "/Loading";
    var effectiveReturnUrl = !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : loadingListReturnUrl;
    var currentPageReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var contractUrl = Url.Action("Index", "ContractJourney", new { contractId = Model.ContractId }) ?? "#";
    var expenseEditorUrl = Url.Action("EditExpenses", "Loading", new { id = Model.Id, returnUrl = currentPageReturnUrl, modal = true });
    var receiptEditorUrl = Model.CanRegisterReceipt
        ? Url.Action("Create", "LoadingReceipts", new { loadingId = Model.Id, returnUrl = currentPageReturnUrl, modal = true })
        : null;

    var loadingComplete = Model.RemainingToReceiveMt <= 0m;
    var statusText = loadingComplete ? T("تکمیل‌شده", "Completed") : T("در انتظار رسید", "Awaiting receipt");
    var statusState = loadingComplete ? "is-active" : "is-warning";
    var documentNumber = string.IsNullOrWhiteSpace(Model.BillOfLadingNumber)
        ? $"LD-{Model.Id:0000}"
        : Model.BillOfLadingNumber;
    var loadingCostsGrandTotal = Model.LoadingCostsGrandTotalUsd;
    var shortageTotal = Model.ChargeableLossTotalMt;
    var isRubSettlement = string.Equals(Model.SettlementCurrencyCode, "RUB", StringComparison.OrdinalIgnoreCase);
    var showRubRateForm = isRubSettlement
        && Model.RubRateStatus == PTGOilSystem.Web.Models.Entities.RubSettlementRateStatus.Pending;

    var headerItems = new List<AkInfoItem>
    {
        new() { Label = T("محصول", "Product"), Value = Model.ProductName },
        new() { Label = T("تاریخ بارگیری", "Loading date"), Value = Model.LoadingDate.ToDisplayDate() },
        new() { Label = T("ترمینل / مبدأ", "Terminal / origin"), Value = Model.OriginLocationName },
        new() { Label = T("شماره سند", "Document no."), Value = documentNumber, IsNumeric = true }
    };

    var pricingMethod = Model.PlattsUsd.HasValue
        ? $"Platts {Model.PlattsUsd.Value:N2}"
        : Model.LoadingPriceUsd.HasValue ? T("قیمت ثابت", "Fixed price") : null;
    var overviewItems = new List<AkInfoItem>
    {
        new() { Label = T("قرارداد خرید", "Purchase contract"), Value = Model.ContractNumber, Href = contractUrl },
        new() { Label = T("مبنای قیمت‌گذاری", "Pricing basis"), Value = pricingMethod },
        new() { Label = T("قیمت فی تن", "Unit price"), Value = Model.LoadingPriceUsd?.ToString("N2"), Unit = "USD/MT", IsNumeric = true },
        new() { Label = T("ارزش بارگیری", "Loading value"), Value = Model.LoadingValueUsd?.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("نوع حمل", "Transport type"), Value = Model.TransportTypeLabel },
        new() { Label = T("وسیله", "Vehicle"), Value = Model.VehicleSummary },
        new() { Label = T("کرایه فی تن", "Freight rate"), Value = NumberDisplay.UnitPrice(Model.FreightRateUsdPerMt, "USD/MT"), IsNumeric = true },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName },
        new() { Label = T("شرکت خدماتی", "Service provider"), Value = Model.LogisticsCompanyName,
                Href = Model.LogisticsServiceProviderId.HasValue
                    ? Url.Action("Details", "ServiceProviders", new { id = Model.LogisticsServiceProviderId.Value, returnUrl = currentPageReturnUrl })
                    : null },
        new() { Label = T("یادداشت", "Notes"), Value = Model.Notes, IsWide = true }
    };
    overviewItems.InsertRange(0, headerItems);
    if (Model.HasFileRub)
    {
        overviewItems.Add(new AkInfoItem { Label = T("ارزش روبلی", "RUB value"), Value = Model.SettlementValueRub?.ToString("N2"), Unit = "RUB", IsNumeric = true });
    }

    var kpis = new List<AkKpiItem>
    {
        new() { Title = T("مقدار بارگیری", "Loaded quantity"), Value = NumberDisplay.Quantity(Model.LoadedQuantityMt), Unit = "MT", Avatar = "loading" },
        new() { Title = T("قابل ارسال / تخصیص", "Available to dispatch"), Value = NumberDisplay.Quantity(Model.RemainingToReceiveMt), Unit = "MT", Avatar = "transported" },
        new() { Title = T("کسری", "Shortage"), Value = NumberDisplay.Quantity(shortageTotal), Unit = "MT", Avatar = "losses", State = shortageTotal > 0m ? "warning" : null },
        new() { Title = T("مجموع مصارف", "Total expenses"), Value = loadingCostsGrandTotal.ToString("N2"), Unit = "USD", Avatar = "expenses" }
    };

    var latestReceipt = Model.ReceiptItems.OrderByDescending(item => item.ReceiptDate).FirstOrDefault();
    var latestCustoms = Model.CustomsItems.OrderByDescending(item => item.DeclarationDate).FirstOrDefault();
    var latestLoss = Model.LossItems.OrderByDescending(item => item.EventDate).FirstOrDefault();
    var activeReceiptCount = Model.ReceiptItems.Count(item => !item.IsCancelled);
    var activityRows = new List<AkDetailActivityRow>
    {
        new() { Label = T("رسیدهای بارگیری", "Loading receipts"), Value = activeReceiptCount.ToString("N0"), Meta = T("مورد", "items"),
                Status = loadingComplete ? T("تکمیل", "Complete") : T("در جریان", "In progress"), StatusTone = loadingComplete ? "success" : "warning",
                Href = latestReceipt is null ? null : Url.Action("Details", "LoadingReceipts", new { id = latestReceipt.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-box-arrow-in-down" },
        new() { Label = T("گمرکات", "Customs"), Value = Model.CustomsItems.Count.ToString("N0"), Meta = T("مورد", "items"),
                Href = latestCustoms is null ? null : Url.Action("Details", "CustomsDeclarations", new { id = latestCustoms.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-shield-check" },
        new() { Label = T("مصارف", "Expenses"), Value = Model.ExpenseEditor.Lines.Count > 0 ? Model.ExpenseEditor.Lines.Count.ToString("N0") : null,
                Meta = Model.ExpenseEditor.Lines.Count > 0 ? T("مورد", "items") : null,
                Status = Model.LoadingExpenseTotalUsd > 0m ? T("ثبت شده", "Recorded") : T("ثبت نشده", "Not recorded"),
                StatusTone = Model.LoadingExpenseTotalUsd > 0m ? "success" : null, Icon = "bi-receipt" },
        new() { Label = T("کسری", "Shortage"), Value = Model.LossItems.Count.ToString("N0"), Meta = T("مورد", "items"),
                Status = Model.LossItems.Count > 0 ? T("ثبت شده", "Recorded") : null, StatusTone = Model.LossItems.Count > 0 ? "warning" : null,
                Href = latestLoss is null ? null : Url.Action("Details", "LossEvents", new { id = latestLoss.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-exclamation-diamond" }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("بارگیری ثبت شد", "Loading registered"), Date = Model.LoadingDate.ToDisplayDate(), Timestamp = Model.LoadingDate,
                Icon = "bi-box-arrow-up", State = "is-current", Meta = $"{NumberDisplay.Quantity(Model.LoadedQuantityMt)} MT" }
    };
    timelineItems.AddRange(Model.ReceiptItems.Where(item => !item.IsCancelled).Select(item => new AkTimelineItem
    {
        Title = T("رسید بارگیری ثبت شد", "Loading receipt recorded"), Date = item.ReceiptDate.ToDisplayDate(), Timestamp = item.ReceiptDate,
        Icon = "bi-box-arrow-in-down", Href = Url.Action("Details", "LoadingReceipts", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{NumberDisplay.Quantity(item.ReceivedQuantityMt)} MT"
    }));
    timelineItems.AddRange(Model.CustomsItems.Select(item => new AkTimelineItem
    {
        Title = T("گمرک ثبت شد", "Customs recorded"), Date = item.DeclarationDate.ToDisplayDate(), Timestamp = item.DeclarationDate,
        Icon = "bi-shield-check", Href = Url.Action("Details", "CustomsDeclarations", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{item.TotalUsd:N2} USD"
    }));
    timelineItems.AddRange(Model.LossItems.Select(item => new AkTimelineItem
    {
        Title = T("کسری ثبت شد", "Shortage recorded"), Date = item.EventDate.ToDisplayDate(), Timestamp = item.EventDate,
        Icon = "bi-exclamation-diamond", Href = Url.Action("Details", "LossEvents", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{NumberDisplay.Quantity(item.ChargeableLossMt)} MT"
    }));

    var nextActions = new List<AkHeaderMenuItem>();
    if (Model.CanRegisterReceipt)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت رسید", "Register receipt"), ModalTarget = "loadingReceiptModal", Icon = "bi-box-arrow-in-down" });
    }
    nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت گمرک", "Register customs"), Href = Url.Action("Create", "CustomsDeclarations", new { loadingRegisterId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-shield-check" });
    nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت مصارف", "Register expenses"), ModalTarget = "loadingExpensesModal", Icon = "bi-receipt-cutoff" });
    nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت کسری", "Register shortage"), Href = Url.Action("Create", "LossEvents", new { contractId = Model.ContractId, loadingRegisterId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-exclamation-diamond" });

    var headerMenu = new List<AkHeaderMenuItem>
    {
        new() { Label = T("ویرایش", "Edit"), Href = Url.Action("Edit", new { id = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-pencil-square" },
        new() { Label = T("نمای قرارداد", "Contract journey"), Href = contractUrl, Icon = "bi-diagram-3" }
    };
    if (showRubRateForm)
    {
        headerMenu.Add(new AkHeaderMenuItem { Label = T("تعیین نرخ روبل", "Set RUB rate"), ModalTarget = "loadingRubleRateModal", Icon = "bi-currency-exchange" });
    }
    ViewData["AkHeaderKebab"] = headerMenu;
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ak-detail-reference-layout" dir="rtl"
     data-loading-details data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = T("جزئیات بارگیری", "Loading details"),
           Eyebrow = $"LD-{Model.Id:0000}",
           Icon = "bi-box-arrow-up",
           Status = statusText,
           StatusState = statusState
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("جزئیات بارگیری", "Loading details"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)effectiveReturnUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailOverview.cshtml"
             model="@(new AkDetailOverviewModel
             {
                 AriaLabel = T("خلاصه اطلاعات بارگیری", "Loading information summary"),
                 Title = T("خلاصه اطلاعات بارگیری", "Loading information summary"),
                 Metrics = kpis,
                 Facts = overviewItems
             })" />

    <partial name="~/Views/Shared/Partials/_DetailActivityList.cshtml" model="@((IReadOnlyList<AkDetailActivityRow>)activityRows)" />
    <partial name="~/Views/Shared/Partials/_DetailSecondary.cshtml"
             model="@(new AkDetailSecondaryModel
             {
                 Timeline = timelineItems,
                 TimelineTitle = T("آخرین فعالیت‌ها", "Latest activity"),
                 TimelineLimit = 4
             })" />
    <partial name="~/Views/Shared/Partials/_DetailActionBar.cshtml" model="@((IReadOnlyList<AkHeaderMenuItem>)nextActions)" />

    <div class="modal fade" id="loadingExpensesModal" tabindex="-1" aria-labelledby="loadingExpensesModalLabel" aria-hidden="true"
         data-loading-expense-remote-modal="true" data-loading-expense-url="@expenseEditorUrl" data-loading-expense-prefetch="false">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="loadingExpensesModalLabel">@T("مصارف بارگیری", "Loading expenses") #@Model.Id</h2>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                </div>
                <div class="modal-body" data-loading-expense-remote-body>
                    <div class="ak-empty"><span>@T("فرم هنگام باز کردن بارگذاری می‌شود.", "The form loads when opened.")</span></div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanRegisterReceipt)
    {
        <div class="modal fade" id="loadingReceiptModal" tabindex="-1" aria-labelledby="loadingReceiptModalLabel" aria-hidden="true"
             data-receipt-remote-modal data-receipt-url="@receiptEditorUrl">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title" id="loadingReceiptModalLabel">@T("ثبت رسید بارگیری", "Register loading receipt") #@Model.Id</h2>
                            <p class="ak-section-desc">@Model.ContractNumber · @Model.ProductName · @T("باقی‌مانده", "Remaining") @NumberDisplay.Quantity(Model.RemainingToReceiveMt) MT</p>
                        </div>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                    </div>
                    <div class="modal-body" data-receipt-remote-body>
                        <div class="ak-empty"><span>@T("فرم هنگام باز کردن بارگذاری می‌شود.", "The form loads when opened.")</span></div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showRubRateForm)
    {
        <div class="modal fade" id="loadingRubleRateModal" tabindex="-1" aria-labelledby="loadingRubleRateModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="SetRubleRate" asp-route-id="@Model.Id" method="post" class="ak-form">
                        @Html.AntiForgeryToken()
                        <input name="Id" value="@Model.RubleRateEditor.Id" type="hidden" />
                        <input name="ReturnUrl" value="@currentPageReturnUrl" type="hidden" />
                        <div class="modal-header">
                            <h2 class="modal-title" id="loadingRubleRateModalLabel">@T("تعیین نرخ روبل", "Set RUB rate")</h2>
                            <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                        </div>
                        <div class="modal-body">
                            <div class="ak-form-grid">
                                <div class="ak-field">
                                    <label class="ak-label" for="RubPerUsdRate">@T("هر ۱ دالر چند روبل؟", "RUB per USD")</label>
                                    <input class="ak-input" id="RubPerUsdRate" name="RubPerUsdRate" value="@(Model.RubleRateEditor.RubPerUsdRate?.ToString("0.######"))" type="number" min="0.000001" step="0.000001" required />
                                </div>
                                <div class="ak-field">
                                    <label class="ak-label" for="RubRateDate">@T("تاریخ نرخ", "Rate date")</label>
                                    <input class="ak-input" id="RubRateDate" name="RubRateDate" value="@(Model.RubleRateEditor.RubRateDate?.ToHtmlDateInput())" type="date" required />
                                </div>
                                <div class="ak-field ak-field-full">
                                    <label class="ak-label" for="RubRateSource">@T("مرجع نرخ", "Rate source")</label>
                                    <input class="ak-input" id="RubRateSource" name="RubRateSource" value="@Model.RubleRateEditor.RubRateSource" type="text" maxlength="200" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">@T("انصراف", "Cancel")</button>
                            <button type="submit" class="btn btn-primary">@T("ثبت نرخ", "Save rate")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var receiptModal = document.querySelector('[data-receipt-remote-modal]');
            if (!receiptModal) { return; }
            receiptModal.addEventListener('show.bs.modal', async function () {
                var body = receiptModal.querySelector('[data-receipt-remote-body]');
                var url = receiptModal.getAttribute('data-receipt-url');
                if (!body || !url || receiptModal.dataset.loaded === 'true' || receiptModal.dataset.loading === 'true') { return; }
                receiptModal.dataset.loading = 'true';
                body.innerHTML = '<div class="ak-empty"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>@T("در حال بارگذاری فرم رسید...", "Loading receipt form...")</span></div>';
                try {
                    var response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) { throw new Error('receipt-form'); }
                    body.innerHTML = await response.text();
                    if (window.PTG && typeof window.PTG.initializeModalDesignSystem === 'function') {
                        window.PTG.initializeModalDesignSystem(body);
                    }
                    if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator.unobtrusive.parse(body);
                    }
                    receiptModal.dataset.loaded = 'true';
                } catch (_) {
                    body.innerHTML = '<div class="alert alert-danger mb-0">@T("بارگذاری فرم رسید انجام نشد.", "Could not load the receipt form.") <a class="alert-link" href="' + url + '">@T("باز کردن صفحه", "Open page")</a></div>';
                } finally {
                    delete receiptModal.dataset.loading;
                }
            });
        })();
    </script>
}
