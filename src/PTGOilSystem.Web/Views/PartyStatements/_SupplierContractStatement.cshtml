@model PTGOilSystem.Web.Models.PartyStatements.PartyStatementViewModel
@using PTGOilSystem.Web.Helpers
@using PTGOilSystem.Web.Models.PartyStatements
@{
    var s = Model.Statement;
    var g = Model.ContractGrouping!;
    var isRub = g.IsRub;
    string Amount(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "–";
    string BaseAmount(decimal? usd, decimal? rub) => Amount(isRub ? rub : usd);

    string DetailsUrl(int contractId) => Url.Action("ContractDetails", "PartyStatements", new
    {
        partyType = s.Party.PartyType,
        id = s.Party.PartyId,
        contractId,
        FromDate = Context.Request.Query["FromDate"],
        ToDate = Context.Request.Query["ToDate"],
        CompanyId = Context.Request.Query["CompanyId"],
        CurrencyCode = Context.Request.Query["CurrencyCode"]
    }) ?? string.Empty;
}

<div class="statement-table-wrap">
    <table class="statement-table statement-table-contracts">
        <thead>
            <tr>
                <th class="statement-col-no">شماره</th>
                <th class="statement-col-contract">قرارداد</th>
                <th>مبلغ کل قرارداد (USD)</th>
                <th>ارزش مقدار بارگیری‌شده</th>
                <th>پرداخت / دریافت</th>
                <th>بیلانس قرارداد</th>
                <th class="statement-col-actions no-print">جزئیات</th>
            </tr>
        </thead>
        <tbody>
            @if (g.Rows.Count == 0)
            {
                <tr><td colspan="7" class="statement-empty">در این دوره قراردادی با گردش مالی ثبت نشده است.</td></tr>
            }
            else
            {
                @foreach (var row in g.PagedRows)
                {
                    <tr class="statement-contract-row">
                        <td class="statement-num">@row.Sequence</td>
                        <td class="statement-contract">
                            <strong class="statement-contract-title">
                                @(row.ContractId.HasValue ? $"قرارداد #{row.ContractNumber}" : row.Title)
                            </strong>
                            @if (row.SharePercent.HasValue)
                            {
                                <small class="statement-contract-sub">سهم شریک @row.SharePercent.Value.ToString("N2")٪</small>
                            }
                        </td>
                        <td class="statement-money">@Amount(row.ContractValueUsd)</td>
                        <td class="statement-money statement-receipt">@BaseAmount(row.ConfirmedValue, row.ConfirmedValueRub)</td>
                        <td class="statement-money statement-outflow">@BaseAmount(row.SettlementTotal, row.SettlementTotalRub)</td>
                        <td class="statement-money statement-balance">
                            @Amount(isRub ? row.BalanceRub : row.Balance)
                        </td>
                        <td class="statement-col-actions no-print">
                            @if (row.ContractId.HasValue)
                            {
                                <button type="button" class="statement-details-toggle"
                                        data-statement-details
                                        data-details-url="@DetailsUrl(row.ContractId.Value)"
                                        aria-expanded="false">
                                    <i class="bi bi-chevron-down"></i> جزئیات
                                </button>
                            }
                        </td>
                    </tr>
                    @if (row.ContractId.HasValue)
                    {
                        <tr class="statement-details-row" hidden>
                            <td colspan="7">
                                <div class="statement-details-slot" data-details-slot></div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">جمع دوره</th>
                <th class="statement-money">–</th>
                <th class="statement-money statement-receipt">@BaseAmount(g.TotalConfirmedValue, g.TotalConfirmedValueRub)</th>
                <th class="statement-money statement-outflow">@BaseAmount(g.TotalSettlement, g.TotalSettlementRub)</th>
                <th class="statement-money statement-balance">
                    @Amount(isRub ? s.Summary.ClosingBalanceRub : s.Summary.ClosingBalance)
                </th>
                <th class="no-print"></th>
            </tr>
        </tfoot>
    </table>
</div>

@if (g.TotalPages > 1)
{
    <nav class="statement-pagination no-print" aria-label="صفحه‌بندی قراردادها">
        @for (var pageNumber = 1; pageNumber <= g.TotalPages; pageNumber++)
        {
            var href = Url.Action("Document", "PartyStatements", new
            {
                partyType = s.Party.PartyType,
                id = s.Party.PartyId,
                view = Model.SupplierView,
                FromDate = Context.Request.Query["FromDate"],
                ToDate = Context.Request.Query["ToDate"],
                ContractId = Context.Request.Query["ContractId"],
                CompanyId = Context.Request.Query["CompanyId"],
                CurrencyCode = Context.Request.Query["CurrencyCode"],
                SourceType = Context.Request.Query["SourceType"],
                Search = Context.Request.Query["Search"],
                PageSize = g.PageSize,
                Page = pageNumber
            });
            <a href="@href" class="@(pageNumber == g.CurrentPage ? "is-active" : null)" aria-current="@(pageNumber == g.CurrentPage ? "page" : null)">@pageNumber</a>
        }
    </nav>
}
