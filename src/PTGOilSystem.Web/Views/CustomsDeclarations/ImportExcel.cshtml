@model PTGOilSystem.Web.Models.Customs.CustomsImportViewModel
@using PTGOilSystem.Web.Models.Customs
@using PTGOilSystem.Web.Models.ExcelImport
@{
    ViewData["Title"] = "اپلود اکسل گروهی گمرک";
    var excelImportOptions = new ExcelImportComponentOptions
    {
        InputId = "customsExcelImportFile",
        FileFieldName = "file",
        Mode = "external",
        AcceptExtensions = ".xlsx,.xls",
        Title = "وارد کردن گروهی گمرک از اکسل",
        Description = "فایل گمرک را انتخاب کنید؛ ابتدا تطبیق و پیش‌نمایش انجام می‌شود و بدون تأیید شما چیزی ثبت نمی‌گردد.",
        StartButtonText = "پیش‌نمایش و بررسی",
        ConfirmButtonText = "ثبت نهایی ردیف‌های معتبر",
        MaxFileSizeMb = 5,
        AllowValidRowsWithErrors = true,
        ViewResultsUrl = Url.Action("Index")
    };
}

<div class="page-stack ak-form-page ak-group-operation-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(("اپلود اکسل گروهی گمرک", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       "بازگشت", "bi-arrow-right", (string?)Url.Action("Index", new { returnUrl = Model.ReturnUrl })))" />

    <form method="post" asp-action="ImportExcel" enctype="multipart/form-data" class="ak-form" data-customs-import data-preview-url="@Url.Action("ImportExcelPreview")" data-save-url="@Url.Action("ImportExcel")" data-details-url="@Url.Action("Details")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert"></div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("تنظیمات ورود", (string?)"نوع عملیات و نرخ تبدیل را مشخص کنید، سپس فایل اکسل را انتخاب نمایید."))" />

            <div class="ak-form-grid">
                <div class="ak-field ak-col-full">
                    <label class="ak-label">این گمرک‌ها برای کدام عملیات است؟</label>
                    <div class="d-flex flex-wrap gap-2">
                        <label class="ak-toggle-field" style="flex:1 1 260px; cursor:pointer;">
                            <input type="radio" asp-for="Scope" value="@((int)CustomsImportScope.InventoryTransport)" />
                            <span>حمل از موجودی‌ها <small class="text-muted d-block">تطبیق با نمبر پلیت + سیمیر</small></span>
                        </label>
                        <label class="ak-toggle-field" style="flex:1 1 260px; cursor:pointer;">
                            <input type="radio" asp-for="Scope" value="@((int)CustomsImportScope.TruckDispatch)" />
                            <span>ارسال‌های موتر <small class="text-muted d-block">تطبیق فقط با نمبر پلیت</small></span>
                        </label>
                    </div>
                </div>

                <div class="ak-field">
                    <label class="ak-label" asp-for="FxRateToUsd"></label>
                    <input asp-for="FxRateToUsd" type="number" step="0.0001" min="0.0001" class="ak-input" placeholder="مثلاً ۷۰" required />
                    <span asp-validation-for="FxRateToUsd" class="ak-field-error"></span>
                    <div class="form-text">همه مبالغ افغانی با این نرخ به دالر تبدیل و به‌صورت USD ثبت می‌شوند.</div>
                </div>

            </div>
        </section>
        <partial name="~/Views/Shared/ExcelImport/_ExcelImport.cshtml" model="excelImportOptions" />
        <div class="ak-note mt-2">
            <strong>ستون‌های شناخته‌شده:</strong> تاریخ، سیمیر، نمبر موتر، وزن، مقصد و ستون‌های مصارف گمرکی.
            فقط ردیف‌های مطابق با عملیات در جریان قابل ثبت‌اند.
        </div>
    </form>

    @if (Model.HasResult)
    {
        <section class="ak-form-section">
            <div class="ak-section-head">
                <h2 class="ak-section-title">نتیجه</h2>
                <span class="text-muted small">
                    ثبت‌شده: <strong class="text-success">@Model.SavedCount</strong> —
                    رد‌شده: <strong class="text-danger">@Model.SkippedCount</strong>
                </span>
            </div>
            <div class="ak-table-wrap">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>سیمیر</th>
                            <th>نمبر موتر</th>
                            <th>وزن</th>
                            <th>مجموع AFN</th>
                            <th>مجموع USD</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@r.RowNumber</td>
                                <td>@r.Simir</td>
                                <td>@r.PlateNumber</td>
                                <td>@(r.WeightMt?.ToString("0.###"))</td>
                                <td>@r.TotalAfn.ToString("0.##")</td>
                                <td>@(r.TotalUsd > 0 ? r.TotalUsd.ToString("0.##") : "—")</td>
                                <td>
                                    @if (r.Matched)
                                    {
                                        <span class="badge bg-success">ثبت شد</span>
                                        @if (r.DeclarationId.HasValue)
                                        {
                                            <a asp-action="Details" asp-route-id="@r.DeclarationId" class="ms-1 small">@r.MatchedLabel</a>
                                        }
                                        else
                                        {
                                            <span class="ms-1 small">@r.MatchedLabel</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">رد شد</span>
                                        <span class="ms-1 small text-muted">@r.SkipReason</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/customs-import.js" asp-append-version="true"></script>
}
