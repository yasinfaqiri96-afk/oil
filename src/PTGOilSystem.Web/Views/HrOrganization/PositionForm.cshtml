@model PTGOilSystem.Web.Models.HumanResources.PositionFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? UiText.T(Context, "بست جدید", "New position") : UiText.T(Context, "ویرایش بست", "Edit position");
    var backUrl = Url.Action("Index", new { tab = "positions" }) ?? "#";
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@(((string)ViewData["Title"]!, true,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

        <form asp-action="EditPosition" method="post" class="ak-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>
            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "اطلاعات بست", "Position details"), (string?)UiText.T(Context, "بست جایگاه کاری است (حسابدار، مدیر عملیات، راننده)، نه نقش دسترسی به سیستم.", "A position is a job in the organization, not a system access role.")))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="Name" class="ak-label">@UiText.T(Context, "نام بست", "Name") <span class="ak-req">*</span></label>
                        <input asp-for="Name" class="ak-input" autocomplete="off" />
                        <span asp-validation-for="Name" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field">
                        <label asp-for="DepartmentId" class="ak-label">@UiText.T(Context, "بخش", "Department")</label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="ak-input">
                            <option value="">@UiText.T(Context, "بدون بخش", "No department")</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field ak-col-full">
                        <label asp-for="Description" class="ak-label">@UiText.T(Context, "توضیح", "Description")</label>
                        <textarea asp-for="Description" class="ak-input" rows="2"></textarea>
                        <span asp-validation-for="Description" class="ak-field-error"></span>
                    </div>
                    <div class="ak-toggle-field">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">@UiText.T(Context, "فعال", "Active")</label>
                        </div>
                    </div>
                </div>
            </section>
            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ذخیره", "Save"), backUrl, UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
