@model PTGOilSystem.Web.Models.HumanResources.DepartmentFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? UiText.T(Context, "بخش جدید", "New department") : UiText.T(Context, "ویرایش بخش", "Edit department");
    var backUrl = Url.Action("Index", new { tab = "departments" }) ?? "#";
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@(((string)ViewData["Title"]!, true,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

        <form asp-action="EditDepartment" method="post" class="ak-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>
            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "اطلاعات بخش", "Department details"), (string?)UiText.T(Context, "مثلاً مالی، عملیات، فروش، اداری یا مدیریت.", "For example Finance, Operations, Sales, Admin or Management.")))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="Name" class="ak-label">@UiText.T(Context, "نام بخش", "Name") <span class="ak-req">*</span></label>
                        <input asp-for="Name" class="ak-input" autocomplete="off" />
                        <span asp-validation-for="Name" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field">
                        <label asp-for="Code" class="ak-label">@UiText.T(Context, "کد", "Code")</label>
                        <input asp-for="Code" class="ak-input" autocomplete="off" />
                        <span asp-validation-for="Code" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field ak-col-full">
                        <label asp-for="Description" class="ak-label">@UiText.T(Context, "توضیح", "Description")</label>
                        <textarea asp-for="Description" class="ak-input" rows="2"></textarea>
                        <span asp-validation-for="Description" class="ak-field-error"></span>
                    </div>
                    <div class="ak-toggle-field">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">@UiText.T(Context, "فعال", "Active")</label>
                        </div>
                    </div>
                </div>
            </section>
            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ذخیره", "Save"), backUrl, UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
