@model PTGOilSystem.Web.Models.Ledger.LedgerDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);
    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : Url.Action("Index") ?? "/Ledger";
    ViewData["Title"] = "جزئیات ثبت دفتر کل";
    ViewData["HideSectionTabs"] = true;
    ViewData["AkHeaderStatus"] = Model.SideName;
    ViewData["AkHeaderStatusState"] = "is-active";
    ViewData["AkHeaderContext"] = $"{UiText.LedgerSource(Context, Model.SourceTypeLabel)} · سند #{Model.SourceId}";

    // سمت در وضعیت سربرگ و شناسه در عنوان صفحه است؛ اینجا تکرار نمی‌شوند.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = "تاریخ ثبت", Value = Model.EntryDate.ToDisplayDate() },
        new() { Label = "مبلغ", Value = Model.AmountUsd.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = "ارز", Value = Model.Currency },
        new() { Label = "مرجع", Value = Model.Reference },
        new() { Label = "شرح ثبت", Value = Model.Description, IsWide = true }
    };

    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = "شناسه دفتر کل", Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = "نوع منبع", Value = UiText.LedgerSource(Context, Model.SourceTypeLabel) },
        new() { Label = "شناسه سند منبع", Value = $"#{Model.SourceId}", IsNumeric = true }
    };

    // روابط متصل به‌جای ردیف‌های همیشه‌خالی، فقط به شکل چیپ رکوردهای موجود.
    var relatedRecords = new List<AkRelatedRecord>();
    if (Model.Contract is not null) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "قرارداد فروش", Label = Model.Contract.Label, KeyValue = $"#{Model.Contract.Id}", Icon = "bi-file-earmark-text" });
    if (Model.Customer is not null) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "مشتری", Label = Model.Customer.Label, Href = Url.Action("Details", "Customers", new { id = Model.Customer.Id }), Icon = "bi-people" });
    if (Model.Supplier is not null) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "تأمین‌کننده", Label = Model.Supplier.Label, Href = Url.Action("Details", "Suppliers", new { id = Model.Supplier.Id }), Icon = "bi-briefcase" });
    if (Model.Employee is not null) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "کارمند", Label = Model.Employee.Label, Href = Url.Action("Details", "Employees", new { id = Model.Employee.Id }), Icon = "bi-person-vcard" });
    if (Model.Shipment is not null) relatedRecords.Add(new AkRelatedRecord { TypeLabel = "محموله", Label = Model.Shipment.Label, Href = Url.Action("Details", "ShipmentPnl", new { id = Model.Shipment.Id }), Icon = "bi-box-seam" });

    var sourceTraceItems = Model.SourceTrace?.Fields
        .Select(field => new AkInfoItem { Label = field.Label, Value = field.Value })
        .ToList() ?? new List<AkInfoItem>();
}

<div class="ak-form-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"ثبت دفتر کل #{Model.Id}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       "بازگشت", "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
             model="@(("اطلاعات اصلی ثبت", (string?)null, (IReadOnlyList<AkInfoItem>)summaryItems))" />

    @if (relatedRecords.Count > 0)
    {
        <section class="ak-form-section ak-detail-section" aria-labelledby="ledger-related-title">
            <h2 class="ak-section-title" id="ledger-related-title">@T("رکوردهای مرتبط", "Related records")</h2>
            <partial name="~/Views/Shared/Partials/_RelatedRecords.cshtml" model="@((IReadOnlyList<AkRelatedRecord>)relatedRecords)" />
        </section>
    }

    @if (Model.SourceTrace is not null)
    {
        <section class="ak-form-section ak-detail-section ak-summary-card">
            <header class="ak-section-head ak-detail-section-header">
                <h2 class="ak-section-title">@Model.SourceTrace.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.SourceTrace.ControllerName))
                {
                    <a asp-controller="@Model.SourceTrace.ControllerName" asp-action="Details" asp-route-id="@Model.SourceTrace.SourceId" class="btn btn-light ak-secondary-action">مشاهده منبع</a>
                }
            </header>
            <partial name="~/Views/Shared/Partials/_DetailInfoGrid.cshtml" model="@((IReadOnlyList<AkInfoItem>)sourceTraceItems)" />
        </section>
    }

    @if (Model.IsViaSarrafSupplierPayment)
    {
        var selfUrl = Url.Action("Details", "Ledger", new { id = Model.Id });
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("قرارداد پرداخت صرافی", (string?)null))" />
            @if (!Model.HasViaSarrafGroup)
            {
                <p class="ak-note">این پرداخت صرافی هنوز به ردیف بدهی صرافِ متناظرش جفت نشده است. برای اتصال قرارداد، ابتدا جفت را تأیید کنید.</p>
                <div class="ak-page-actions">
                    <a asp-controller="ViaSarrafPayments" asp-action="ConfirmPair" asp-route-ledgerEntryId="@Model.Id" asp-route-returnUrl="@selfUrl" class="btn btn-primary">
                        <i class="bi bi-link-45deg"></i> تأیید جفت تراکنش
                    </a>
                </div>
            }
            else if (Model.Contract is null)
            {
                <p class="ak-note">قراردادی برای این پرداخت صرافی ثبت نشده است. می‌توانید آن را به یک قرارداد خرید همان تأمین‌کننده وصل کنید.</p>
                <div class="ak-page-actions">
                    <a asp-controller="ViaSarrafPayments" asp-action="AssignContract" asp-route-ledgerEntryId="@Model.Id" asp-route-returnUrl="@selfUrl" class="btn btn-primary">
                        <i class="bi bi-cash-coin"></i> تخصیص به قرارداد
                    </a>
                </div>
            }
            else
            {
                <p class="ak-note">این پرداخت صرافی به قرارداد <strong>@Model.Contract.Label</strong> وصل است. در صورت اشتباه می‌توانید قرارداد را تغییر دهید.</p>
                <div class="ak-page-actions">
                    <a asp-controller="ViaSarrafPayments" asp-action="AssignContract" asp-route-ledgerEntryId="@Model.Id" asp-route-returnUrl="@selfUrl" class="btn btn-light">
                        <i class="bi bi-pencil-square"></i> تغییر قرارداد
                    </a>
                </div>
            }
        </section>
    }

    <partial name="~/Views/Shared/Partials/_DetailAdvancedSection.cshtml"
             model="@(((string?)null, (IReadOnlyList<AkInfoItem>)advancedItems))" />
</div>
