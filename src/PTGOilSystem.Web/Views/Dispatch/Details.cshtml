@using PTGOilSystem.Web.Models.Entities
@model PTGOilSystem.Web.Models.Dispatch.DispatchDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Dispatch") ?? "/Dispatch";
    var currentPageReturnUrl = Context.Request.Path + Context.Request.QueryString;

    var isDirectFromReceipt = Model.DispatchMode == TruckDispatchMode.DirectFromReceipt;
    var modeText = isDirectFromReceipt ? T("ارسال از رسید", "From receipt") : T("ارسال مستقیم از مخزن", "From tank");

    var statusText = Model.StatusName switch
    {
        "Loaded" => T("بارگیری شده", "Loaded"),
        "InTransit" => T("در مسیر", "In transit"),
        "Delivered" => T("تحویل شده", "Delivered"),
        "Cancelled" => T("لغو شده", "Cancelled"),
        _ => Model.StatusName
    };
    var statusDone = Model.StatusName == "Delivered";
    var isCancelled = Model.StatusName == "Cancelled";

    var productName = Model.ProductName;
    var documentNumber = $"DSP-{Model.Id:0000}";

    // منبع → موتر → مقصد (نمایش‌محور، بدون تغییر منطق موجودی)
    var sourceNodeLabel = Model.SourceStorageTankCode ?? Model.SourceTerminalName ?? T("منبع موجودی", "Inventory source");
    var sourceTypeLabel = Model.SourceStorageTankCode is not null
        ? T("مخزن", "Tank")
        : (Model.SourceTerminalName is not null ? T("ترمینال", "Terminal") : T("منبع موجودی", "Inventory source"));

    // فروش مستقیم موتر: تخلیه ثبت نمی‌شود؛ مقدار فروش‌شده معادل تخلیه است
    var isDirectSale = Model.SalesTransactionId.HasValue && !Model.DeliveryReceipts.Any();
    var loadedQty = Model.LoadedQuantityMt;
    var unloadedQty = Model.DischargedQuantityMt ?? Model.SaleQuantityMt ?? 0m;
    var shortageQty = Model.ShortageMt ?? Math.Max(loadedQty - unloadedQty, 0m);
    var freightUsd = Model.FreightCostUsd ?? 0m;

    // باقی‌مانده منبع فقط از مسیر امن (تخصیص رسید). حالت مخزن داده کافی ندارد.
    decimal? sourceTotalMt = isDirectFromReceipt ? Model.AllocationQuantityMt : null;
    decimal? sourceRemainingMt = isDirectFromReceipt ? Model.AllocationRemainingQuantityMt : null;

    var receiptCount = Model.DeliveryReceipts.Count;
    var payableAmount = Model.DriverShortageChargeUsd ?? Model.PayableUsd;

    var canUnload = !isCancelled && !Model.SalesTransactionId.HasValue;
    // فروش قسمتی مجاز است؛ تا وقتی باقی‌ماندهٔ قابل فروش وجود دارد دکمهٔ فروش باز می‌ماند.
    var canDirectSale = !isCancelled && Model.RemainingSellableQuantityMt > 0m && !Model.DeliveryReceipts.Any();

    // مقدار (وزن) تا ۴ رقم اعشار، بدون صفر اضافه و با جداکنندهٔ هزار
    string Q(decimal v) => v.ToString("#,##0.####");
    string M(decimal v) => v.ToString("N2");
    // صفرها در کارت خلاصه ردیف نمی‌گیرند؛ فقط ارقام واقعی می‌مانند.
    string? NonZeroM(decimal v) => v == 0m ? null : M(v);
    string? NonZeroQ(decimal v) => v == 0m ? null : Q(v);

    var customsCount = Model.Customs.Count;
    var customsTotalUsd = Model.CustomsTotalUsd;
    var expenseCount = Model.Expenses.Count;
    var expenseTotalUsd = Model.ExpenseTotalUsd;
    var hasCustomsOrShortage = customsCount > 0 || shortageQty > 0.0001m;

    ViewData["AkHeaderStatus"] = statusText;
    ViewData["AkHeaderStatusState"] = isCancelled ? "is-danger" : statusDone ? "is-active" : "is-warning";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = T("ویرایش", "Edit"), Href = Url.Action("Edit", new { id = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-pencil-square" },
        new() { Label = T("ارسال جدید", "New dispatch"), Href = Url.Action("Create"), Icon = "bi-plus-lg" }
    };

    var kpis = new List<AkKpiItem>
    {
        new() { Title = T("بارگیری‌شده", "Loaded"), Value = Q(loadedQty), Unit = T("تن", "MT"), Avatar = "loading" },
        new() { Title = isDirectSale ? T("فروخته‌شده", "Sold") : T("تخلیه‌شده", "Unloaded"), Value = Q(unloadedQty), Unit = T("تن", "MT"), Avatar = "sold-quantity" },
        new() { Title = T("کسری", "Shortage"), Value = Q(shortageQty), Unit = T("تن", "MT"), Avatar = "losses", State = shortageQty > 0.0001m ? "warning" : null },
        new() { Title = T("کرایه", "Freight"), Value = M(freightUsd), Unit = "USD", Avatar = "transported" }
    };

    // وضعیت/محصول/پلیت/تاریخ در سربرگ‌اند؛ مقدار بارگیری و کرایه در نوار KPI.
    var routeItems = new List<AkInfoItem>
    {
        new() { Label = T("نوع ارسال", "Dispatch mode"), Value = modeText },
        new() { Label = sourceTypeLabel, Value = sourceNodeLabel },
        new() { Label = T("قابل ارسال منبع", "Source available"), Value = sourceTotalMt.HasValue ? Q(sourceTotalMt.Value) : null, Unit = T("تن", "MT"), IsNumeric = true },
        new() { Label = T("باقی‌مانده منبع", "Source remaining"), Value = sourceRemainingMt.HasValue ? Q(sourceRemainingMt.Value) : null, Unit = T("تن", "MT"), IsNumeric = true },
        new() { Label = T("راننده", "Driver"), Value = Model.DriverName },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName }
    };

    var financeItems = new List<AkInfoItem>
    {
        new() { Label = T("مجموع فروش", "Total sales"), Value = NonZeroM(Model.SaleTotalUsd ?? 0m), Unit = "USD", IsNumeric = true },
        new() { Label = T("مقدار فروش‌شده", "Sold quantity"), Value = NonZeroQ(Model.SaleQuantityMt ?? 0m), Unit = T("تن", "MT"), IsNumeric = true },
        new() { Label = T("گمرکات", "Customs"), Value = NonZeroM(customsTotalUsd), Unit = "USD", IsNumeric = true },
        new() { Label = T("مصارف عملیاتی", "Operational expenses"), Value = NonZeroM(expenseTotalUsd), Unit = "USD", IsNumeric = true },
        new() { Label = T("کسورات (مجرا راننده)", "Deductions (driver charge)"), Value = payableAmount.HasValue ? NonZeroM(payableAmount.Value) : null, Unit = "USD", IsNumeric = true, Tone = "warning" },
        new() { Label = T("تلورانس کسری", "Shortage tolerance"), Value = shortageQty > 0.0001m ? Q(Model.ToleranceMt ?? 0m) : null, Unit = T("تن", "MT"), IsNumeric = true },
        new() { Label = T("کسری قابل کسر", "Chargeable shortage"), Value = shortageQty > 0.0001m ? Q(Model.ChargeableShortageMt ?? 0m) : null, Unit = T("تن", "MT"), IsNumeric = true },
        new() { Label = T("نرخ کسری", "Shortage rate"), Value = shortageQty > 0.0001m ? NonZeroM(Model.ShortageRateUsd ?? 0m) : null, Unit = "USD/MT", IsNumeric = true }
    };

    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new()
        {
            Label = T("مرجع موجودی", "Inventory reference"),
            Value = Model.InventoryReference ?? (isDirectFromReceipt ? T("بدون حرکت موجودی", "No stock movement") : null)
        },
        new() { Label = T("شناسه رسید بارگیری", "Loading receipt id"), Value = Model.LoadingReceiptId.HasValue ? $"#{Model.LoadingReceiptId.Value}" : null, IsNumeric = true },
        new() { Label = T("شناسه فروش", "Sale id"), Value = Model.SalesTransactionId.HasValue ? $"#{Model.SalesTransactionId.Value}" : null, IsNumeric = true }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("ارسال ثبت شد", "Dispatch registered"), Date = Model.DispatchDate.ToDisplayDate(), Icon = "bi-truck-front", State = "is-current", Meta = $"{Q(Model.LoadedQuantityMt)} MT" }
    };
    timelineItems.AddRange(Model.DeliveryReceipts.OrderBy(item => item.ReceiptDate).Select(item => new AkTimelineItem
    {
        Title = T("رسید تحویل", "Delivery receipt"), Date = item.ReceiptDate.ToDisplayDate(), Icon = "bi-box-arrow-in-down", Meta = $"{Q(item.ReceivedQuantityMt)} MT"
    }));
    timelineItems.AddRange(Model.Customs.OrderBy(item => item.DeclarationDate).Select(item => new AkTimelineItem
    {
        Title = T("سند گمرکی", "Customs declaration"), Date = item.DeclarationDate.ToDisplayDate(), Icon = "bi-shield-check",
        Href = Url.Action("Details", "CustomsDeclarations", new { id = item.Id, returnUrl = currentPageReturnUrl }), Meta = $"{M(item.TotalUsd)} USD"
    }));
    var showTimeline = timelineItems.Count > 1;

    var relatedRecords = new List<AkRelatedRecord>
    {
        new() { TypeLabel = T("قرارداد", "Contract"), Label = Model.ContractNumber, KeyValue = productName, Icon = "bi-file-earmark-text" }
    };
    if (Model.SalesTransactionId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("فروش", "Sale"), Label = Model.SaleInvoiceNumber ?? $"#{Model.SalesTransactionId.Value}", Href = Url.Action("Details", "Sales", new { id = Model.SalesTransactionId.Value, returnUrl = currentPageReturnUrl }), KeyValue = $"{M(Model.SaleTotalUsd ?? 0m)} USD", Icon = "bi-receipt" });
    }
    if (Model.LoadingReceiptId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("رسید بارگیری", "Loading receipt"), Label = $"#{Model.LoadingReceiptId.Value}", Href = Url.Action("Details", "LoadingReceipts", new { id = Model.LoadingReceiptId.Value, returnUrl = currentPageReturnUrl }), Icon = "bi-box-arrow-in-down" });
    }

    // اکشن اصلی سربرگ در نوار عملیات پایانی تکرار نمی‌شود.
    var headerIsUnload = canUnload || canDirectSale;
    var nextActions = new List<AkHeaderMenuItem>();
    nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت گمرک", "Register customs"), Href = Url.Action("Create", "CustomsDeclarations", new { truckDispatchId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-file-earmark-check" });
    if (headerIsUnload)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت مصرف / کرایه", "Register expense"), ModalTarget = "dispatchExpensesModal", Icon = "bi-receipt" });
    }
    ViewData["AkHeaderOverflowActions"] = nextActions;

    ViewData["Title"] = T("جزئیات ارسال با موتر", "Truck dispatch details");
    ViewData["HideSectionTabs"] = true;
    ViewData["ContentBodyClass"] = "boltz-content-body-fluid";
    ViewData["LoadingExpenseEditorAssets"] = true;

    var dispatchRecordOptions = new List<(string Slug, string Label)>();
    if (Model.SalesTransactionId.HasValue) dispatchRecordOptions.Add(("sales", T("فروشات", "Sales")));
    if (hasCustomsOrShortage) dispatchRecordOptions.Add(("customs", T("گمرکات و کسورات", "Customs and deductions")));
    if (expenseCount > 0) dispatchRecordOptions.Add(("expenses", T("مصارف و کرایه", "Expenses and freight")));
    if (receiptCount > 0) dispatchRecordOptions.Add(("receipts", T("رسیدها", "Receipts")));

    var requestedDispatchTab = (Context.Request.Query["recordsTab"].ToString() ?? string.Empty).Trim().ToLowerInvariant();
    var dispatchRecordsTab = dispatchRecordOptions.Any(option => option.Slug == requestedDispatchTab)
        ? requestedDispatchTab
        : dispatchRecordOptions.FirstOrDefault().Slug;
    string DispatchRecordsPane(string slug) => "tab-pane ak-detail-subsection" + (dispatchRecordsTab == slug ? " show active" : "");
    var dispatchRecordTabs = dispatchRecordOptions
        .Select(option => $"#dispatch-{option.Slug}|{option.Label}||{(dispatchRecordsTab == option.Slug ? "active" : "")}")
        .ToArray();
}

<div class="page-stack ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page" dir="rtl" data-transport-details data-ak-detail-v2="true" data-ak-operations-detail="true" data-instant-tabs>
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"{T("ارسال", "Dispatch")} {documentNumber}", false,
                       headerIsUnload ? T("ثبت تخلیه / فروش", "Register unload or sale") : T("ثبت مصرف", "Register expense"),
                       headerIsUnload ? "bi-box-arrow-down" : "bi-receipt",
                       headerIsUnload ? Url.Action("Unload", new { id = Model.Id, returnUrl = currentPageReturnUrl }) : (string?)null,
                       headerIsUnload ? (string?)null : "dispatchExpensesModal",
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

    <div class="ak-operations-overview ak-operations-clean-overview" aria-label="@T("نگاه سریع", "Quick scan")">
        <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
                 model="@((T("منبع، مسیر و موتر", "Source, route & truck"), (string?)null, (IReadOnlyList<AkInfoItem>)routeItems))" />

        <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
                 model="@((T("خلاصه مالی ارسال", "Dispatch financial summary"), (string?)null, (IReadOnlyList<AkInfoItem>)financeItems))" />
    </div>

    @if (dispatchRecordTabs.Length > 0)
    {
    <section class="ak-form-section ak-detail-section" aria-labelledby="dispatch-records-title">
        <h2 class="ak-section-title" id="dispatch-records-title">@T("سوابق ارسال", "Dispatch records")</h2>
        <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml"
                 model="@((T("سوابق ارسال", "Dispatch records"), dispatchRecordTabs))" />
        <div class="tab-content ak-detail-content ak-tab-content">
        @if (Model.SalesTransactionId.HasValue)
        {
            <div id="dispatch-sales" class="@DispatchRecordsPane("sales")" role="tabpanel" aria-label="@T("فروشات", "Sales")">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">@T("فروشات", "Sales")</h2>
                    <span class="ak-status">@M(Model.SaleTotalUsd ?? 0m) USD</span>
                </header>
                <div class="ak-list">
                    @{
                        var inv = string.IsNullOrWhiteSpace(Model.SaleInvoiceNumber) ? $"#{Model.SalesTransactionId}" : Model.SaleInvoiceNumber;
                    }
                    <button type="button" class="ak-list-row" data-title="@T("فروش", "Sale") @inv">
                        <span class="ak-field">
                            <strong>@inv</strong>
                            <small>@(isDirectSale ? T("فروش مستقیم", "Direct sale") : T("فروش", "Sale"))</small>
                        </span>
                        <span class="ak-num">@M(Model.SaleTotalUsd ?? 0m) USD</span>
                        <div class="ak-section-desc" hidden>
                            <dl class="ak-list">
                                <div><dt>@T("شماره فاکتور", "Invoice")</dt><dd>@inv</dd></div>
                                <div><dt>@T("کد فروش", "Sale id")</dt><dd>#@Model.SalesTransactionId</dd></div>
                                <div><dt>@T("مقدار فروش", "Quantity")</dt><dd>@Q(Model.SaleQuantityMt ?? 0m) @T("تن", "MT")</dd></div>
                                <div><dt>@T("مبلغ فروش", "Amount")</dt><dd>@M(Model.SaleTotalUsd ?? 0m) USD</dd></div>
                            </dl>
                        </div>
                    </button>
                </div>
            </div>
        }

        @if (hasCustomsOrShortage)
        {
            <div id="dispatch-customs" class="@DispatchRecordsPane("customs")" role="tabpanel" aria-label="@T("گمرکات و کسورات", "Customs and deductions")">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">@T("گمرکات و کسورات", "Customs and deductions")</h2>
                    <span class="ak-status">@M(customsTotalUsd) USD</span>
                </header>
                <div class="ak-list">
                    @foreach (var c in Model.Customs)
                    {
                        var cref = c.DeclarationReference ?? c.WagonOrTruckNumber ?? $"#{c.Id}";
                        <button type="button" class="ak-list-row" data-title="@T("گمرک", "Customs") @cref">
                            <span class="ak-field">
                                <strong>@cref</strong>
                                <small>@T("گمرک", "Customs") · @c.DeclarationDate.ToDisplayDate()</small>
                            </span>
                            <span class="ak-num">@M(c.TotalUsd) USD</span>
                            <div class="ak-section-desc" hidden>
                                <dl class="ak-list">
                                    <div><dt>@T("کد اعلامیه", "Declaration id")</dt><dd>#@c.Id</dd></div>
                                    <div><dt>@T("تاریخ", "Date")</dt><dd>@c.DeclarationDate.ToDisplayDate()</dd></div>
                                    @if (!string.IsNullOrWhiteSpace(c.DeclarationReference))
                                    {
                                        <div><dt>@T("مرجع / ACCD", "Reference")</dt><dd>@c.DeclarationReference</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.WagonOrTruckNumber))
                                    {
                                        <div><dt>@T("شماره موتر", "Truck no.")</dt><dd>@c.WagonOrTruckNumber</dd></div>
                                    }
                                    <div><dt>@T("مجموع (AFN)", "Total AFN")</dt><dd>@M(c.TotalAfn) AFN</dd></div>
                                    <div><dt>@T("مجموع (USD)", "Total USD")</dt><dd>@M(c.TotalUsd) USD</dd></div>
                                </dl>
                            </div>
                        </button>
                    }
                    @if (shortageQty > 0.0001m)
                    {
                        <button type="button" class="ak-list-row" data-title="@T("کسری موتر", "Truck shortage")">
                            <span class="ak-field">
                                <strong>@T("کسری موتر", "Truck shortage")</strong>
                                <small>@T("بارگیری منهای تخلیه", "Loaded minus unloaded")</small>
                            </span>
                            <span class="ak-num">@Q(shortageQty) @T("تن", "MT")</span>
                            <div class="ak-section-desc" hidden>
                                <dl class="ak-list">
                                    <div><dt>@T("کسری کل", "Total shortage")</dt><dd>@Q(shortageQty) @T("تن", "MT")</dd></div>
                                    <div><dt>@T("تلورانس", "Tolerance")</dt><dd>@Q(Model.ToleranceMt ?? 0m) @T("تن", "MT")</dd></div>
                                    <div><dt>@T("قابل کسر", "Chargeable")</dt><dd>@Q(Model.ChargeableShortageMt ?? 0m) @T("تن", "MT")</dd></div>
                                    <div><dt>@T("نرخ کسری", "Shortage rate")</dt><dd>@M(Model.ShortageRateUsd ?? 0m) USD/MT</dd></div>
                                    @if (payableAmount.HasValue)
                                    {
                                        <div><dt>@T("پول مجرا راننده", "Driver charge")</dt><dd>@M(payableAmount.Value) USD</dd></div>
                                    }
                                </dl>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }

        @if (expenseCount > 0)
        {
            <div id="dispatch-expenses" class="@DispatchRecordsPane("expenses")" role="tabpanel" aria-label="@T("مصارف و کرایه", "Expenses and freight")">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">@T("مصارف و کرایه", "Expenses and freight")</h2>
                    <span class="ak-status">@M(expenseTotalUsd) USD</span>
                </header>
                <div class="ak-list">
                    @foreach (var e in Model.Expenses)
                    {
                        var expenseLabel = string.IsNullOrWhiteSpace(e.ExpenseTypeName) ? T("مصرف", "Expense") : e.ExpenseTypeName;
                        <button type="button" class="ak-list-row" data-title="@expenseLabel">
                            <span class="ak-field">
                                <strong>@expenseLabel</strong>
                                <small>@e.ExpenseDate.ToDisplayDate()</small>
                            </span>
                            <span class="ak-num">@M(e.AmountUsd) USD</span>
                            <div class="ak-section-desc" hidden>
                                <dl class="ak-list">
                                    <div><dt>@T("نوع مصرف", "Expense type")</dt><dd>@expenseLabel</dd></div>
                                    <div><dt>@T("تاریخ", "Date")</dt><dd>@e.ExpenseDate.ToDisplayDate()</dd></div>
                                    <div><dt>@T("مبلغ", "Amount")</dt><dd>@M(e.Amount) @e.Currency</dd></div>
                                    <div><dt>@T("معادل (USD)", "USD equivalent")</dt><dd>@M(e.AmountUsd) USD</dd></div>
                                    @if (!string.IsNullOrWhiteSpace(e.Description))
                                    {
                                        <div><dt>@T("شرح", "Description")</dt><dd>@e.Description</dd></div>
                                    }
                                </dl>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }

        @if (receiptCount > 0)
        {
            <div id="dispatch-receipts" class="@DispatchRecordsPane("receipts")" role="tabpanel" aria-label="@T("رسیدهای تحویل", "Delivery receipts")">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">@T("رسیدهای تحویل / تخلیه", "Delivery receipts")</h2>
                    <span class="ak-status">@receiptCount</span>
                </header>
                <div class="ak-list">
                    @foreach (var r in Model.DeliveryReceipts)
                    {
                        var reff = r.DocumentReference ?? r.ReceivedBy ?? $"#{r.Id}";
                        <button type="button" class="ak-list-row" data-title="@T("رسید", "Receipt") #@r.Id">
                            <span class="ak-field">
                                <strong>@T("رسید", "Receipt") #@r.Id</strong>
                                <small>@r.ReceiptDate.ToDisplayDate()</small>
                            </span>
                            <span class="ak-num">@Q(r.ReceivedQuantityMt) @T("تن", "MT")</span>
                            <div class="ak-section-desc" hidden>
                                <dl class="ak-list">
                                    <div><dt>@T("شماره رسید", "Receipt")</dt><dd>#@r.Id</dd></div>
                                    <div><dt>@T("تاریخ", "Date")</dt><dd>@r.ReceiptDate.ToDisplayDate()</dd></div>
                                    <div><dt>@T("مقدار تخلیه", "Quantity")</dt><dd>@Q(r.ReceivedQuantityMt) @T("تن", "MT")</dd></div>
                                    @if (!string.IsNullOrWhiteSpace(r.ReceivedBy))
                                    {
                                        <div><dt>@T("تحویل‌گیرنده", "Received by")</dt><dd>@r.ReceivedBy</dd></div>
                                    }
                                    <div><dt>@T("مرجع سند", "Reference")</dt><dd>@reff</dd></div>
                                </dl>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }
        </div>
    </section>
    }

    <partial name="~/Views/Shared/Partials/_OperationsDetailMore.cshtml"
             model="@((showTimeline ? (IReadOnlyList<AkTimelineItem>)timelineItems : Array.Empty<AkTimelineItem>(),
                        (IReadOnlyList<AkRelatedRecord>)relatedRecords,
                        (IReadOnlyList<AkInfoItem>)advancedItems))" />

    <div class="modal fade loading-expense-modal" id="dispatchExpensesModal" tabindex="-1"
         aria-labelledby="dispatchExpensesModalLabel" aria-hidden="true" data-loading-expense-remote-modal>
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content ak-modal-content">
                <div class="ak-modal-head">
                    <h2 class="modal-title" id="dispatchExpensesModalLabel">@T("ثبت مصارف ارسال موتر", "Register dispatch expenses") — @documentNumber</h2>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                </div>
                <div class="ak-modal-body" data-loading-expense-remote-body>
                    <div class="loading-expense-modal-placeholder">
                        <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                        <span>@T("در حال بارگذاری فرم مصارف...", "Loading expense form...")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade ptcd-detail-modal" id="ptcdDetailModal" tabindex="-1" aria-labelledby="ptcdDetailTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ak-modal-content">
                <div class="ak-modal-head">
                    <h2 class="modal-title" id="ptcdDetailTitle"></h2>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                </div>
                <div class="ak-modal-body" id="ptcdDetailBody"></div>
            </div>
        </div>
    </div>

    <button type="button" class="visually-hidden" data-bs-toggle="modal" data-bs-target="#dispatchExpensesModal"
            data-expense-url="@Url.Action("CreateExpenseModal", "Dispatch", new { id = Model.Id, returnUrl = currentPageReturnUrl })" tabindex="-1" aria-hidden="true"></button>

</div>

@section Scripts {
    <script>
        (function () {
            var root = document.querySelector('[data-transport-details]');
            if (!root) { return; }

            // --- row click -> detail modal (resolve bootstrap lazily; bundle is deferred) ---
            var modalEl = document.getElementById('ptcdDetailModal');
            var titleEl = document.getElementById('ptcdDetailTitle');
            var bodyEl = document.getElementById('ptcdDetailBody');

            root.querySelectorAll('.ak-list-row').forEach(function (row) {
                row.addEventListener('click', function () {
                    var detail = row.querySelector('.ak-section-desc');
                    if (!detail || !modalEl || !window.bootstrap) { return; }
                    titleEl.textContent = row.getAttribute('data-title') || '';
                    bodyEl.innerHTML = detail.innerHTML;
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
            });

        })();
    </script>
}
