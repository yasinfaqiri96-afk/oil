@model PTGOilSystem.Web.Models.OperationalAssets.OperationalAssetFormViewModel
@{
    var isEdit = Model.Id > 0;
    var actionName = isEdit ? "Edit" : "Create";
}

<form asp-action="@actionName" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="ak-form"
      data-operational-asset-form="true"
      data-asset-transport-types="@((int)OperationalAssetType.Truck) @((int)OperationalAssetType.Trailer) @((int)OperationalAssetType.TankerTruck) @((int)OperationalAssetType.Wagon)"
      data-asset-storage-types="@((int)OperationalAssetType.StorageTank) @((int)OperationalAssetType.Warehouse) @((int)OperationalAssetType.Terminal)">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

    <section class="ak-form-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "اطلاعات دارایی", "Asset Information"), (string?)UiText.T(Context, "کد، نام و نوع دارایی را ثبت کنید.", "Record the asset code, name and type.")))" />
        <div class="ak-form-grid">
            <div class="ak-field">
                <label asp-for="AssetCode" class="ak-label">@UiText.T(Context, "کد دارایی", "Asset Code")</label>
                <input asp-for="AssetCode" class="ak-input" />
                <span asp-validation-for="AssetCode" class="ak-field-error"></span>
            </div>
            <div class="ak-field">
                <label asp-for="Name" class="ak-label">@UiText.T(Context, "نام", "Name") <span class="ak-req">*</span></label>
                <input asp-for="Name" class="ak-input" />
                <span asp-validation-for="Name" class="ak-field-error"></span>
            </div>
            <div class="ak-field">
                <label asp-for="AssetType" class="ak-label">@UiText.T(Context, "نوع دارایی", "Asset Type") <span class="ak-req">*</span></label>
                <select asp-for="AssetType" asp-items="ViewBag.AssetTypes" class="ak-input"></select>
                <span asp-validation-for="AssetType" class="ak-field-error"></span>
            </div>
            <div class="ak-field">
                <label asp-for="OperationalStatus" class="ak-label">@UiText.T(Context, "وضعیت عملیاتی", "Operational Status")</label>
                <select asp-for="OperationalStatus" asp-items="ViewBag.OperationalStatuses" class="ak-input"></select>
            </div>
            <div class="ak-field"><label asp-for="AcquisitionDate" class="ak-label">@UiText.T(Context, "تاریخ خرید", "Acquisition Date")</label><input asp-for="AcquisitionDate" type="date" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="AcquisitionCostUsd" class="ak-label">@UiText.T(Context, "قیمت خرید (دالر)", "Acquisition Cost (USD)")</label><input asp-for="AcquisitionCostUsd" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="InServiceDate" class="ak-label">@UiText.T(Context, "تاریخ شروع کار", "In-Service Date")</label><input asp-for="InServiceDate" type="date" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="DisposalDate" class="ak-label">@UiText.T(Context, "تاریخ خروج", "Disposal Date")</label><input asp-for="DisposalDate" type="date" class="ak-input" /></div>
        </div>
    </section>

    <section class="ak-form-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "منبع و موقعیت", "Resource and location"), (string?)UiText.T(Context, "وسیله فنی مرتبط، ظرفیت و موقعیت جاری.", "Linked technical resource, capacity and current location.")))" />
        <div class="ak-form-grid">
            <div class="ak-field"><label asp-for="LinkedTruckId" class="ak-label">@UiText.T(Context, "موتر مرتبط", "Linked Truck")</label><select asp-for="LinkedTruckId" asp-items="ViewBag.Trucks" class="ak-input"><option value="">-</option></select></div>
            <div class="ak-field"><label asp-for="LinkedStorageTankId" class="ak-label">@UiText.T(Context, "مخزن مرتبط", "Linked Tank")</label><select asp-for="LinkedStorageTankId" asp-items="ViewBag.StorageTanks" class="ak-input"><option value="">-</option></select></div>
            <div class="ak-field"><label asp-for="CapacityMt" class="ak-label">@UiText.T(Context, "ظرفیت MT", "Capacity MT")</label><input asp-for="CapacityMt" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="LocationId" class="ak-label">@UiText.T(Context, "موقعیت جاری", "Current Location")</label><select asp-for="LocationId" asp-items="ViewBag.Locations" class="ak-input"><option value="">-</option></select></div>
            <div class="ak-field"><label asp-for="TerminalId" class="ak-label">@UiText.T(Context, "ترمینال", "Terminal")</label><select asp-for="TerminalId" asp-items="ViewBag.Terminals" class="ak-input"><option value="">-</option></select></div>
        </div>
    </section>

    <section class="ak-form-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "مالکیت و وضعیت", "Ownership and Status"), (string?)UiText.T(Context, "سهم‌های مالکیت بعد از ذخیره از پروفایل دارایی مدیریت می‌شود.", "Ownership shares are managed from the asset profile after saving.")))" />
        <div class="ak-form-grid">
            <div class="ak-field">
                <label asp-for="OwnershipMode" class="ak-label">@UiText.T(Context, "نوع مالکیت", "Ownership Mode")</label>
                <select asp-for="OwnershipMode" asp-items="ViewBag.OwnershipModes" class="ak-input"></select>
                <span asp-validation-for="OwnershipMode" class="ak-field-error"></span>
            </div>
            <div class="ak-field"><label asp-for="MonthlyDepreciationUsd" class="ak-label">@UiText.T(Context, "استهلاک ماهانه (دالر)", "Monthly Depreciation (USD)")</label><input asp-for="MonthlyDepreciationUsd" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="DefaultInternalRateUsd" class="ak-label">@UiText.T(Context, "نرخ داخلی پیش‌فرض", "Default Internal Rate")</label><input asp-for="DefaultInternalRateUsd" class="ak-input" /></div>
            <div class="ak-field"><label asp-for="DefaultExternalRateUsd" class="ak-label">@UiText.T(Context, "نرخ بیرونی پیش‌فرض", "Default External Rate")</label><input asp-for="DefaultExternalRateUsd" class="ak-input" /></div>
            <div class="ak-field ak-col-full">
                <label asp-for="Notes" class="ak-label">@UiText.T(Context, "یادداشت", "Notes")</label>
                <textarea asp-for="Notes" class="ak-input"></textarea>
                <span asp-validation-for="Notes" class="ak-field-error"></span>
            </div>
            <div class="ak-toggle-field">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">@UiText.T(Context, "فعال", "Active")</label>
                </div>
            </div>
        </div>
    </section>

    <div class="ak-footer-actions">
        <button type="submit" class="ak-save">@UiText.T(Context, "ذخیره", "Save")</button>
        <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model.Id : null)" class="ak-cancel">@UiText.T(Context, "انصراف", "Cancel")</a>
    </div>
</form>
