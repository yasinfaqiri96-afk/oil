    @* مودال‌ها بیرون از tab-pane نگه داشته می‌شوند تا با hidden شدن تب از دسترس خارج نشوند. *@
    <div class="modal fade oa-action-modal" id="oaOwnershipModal" tabindex="-1" aria-labelledby="oaOwnershipModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="oaOwnershipModalLabel">@UiText.T(Context, "افزودن سهم مالکیت", "Add ownership share")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@UiText.T(Context, "بستن", "Close")"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="AddOwnershipShare" method="post" class="ak-form-section ak-detail-section ak-form" data-oa-owner-form>
                        @Html.AntiForgeryToken()
                        <input name="OperationalAssetId" value="@Model.Id" type="hidden" />
                        <div class="ak-form-grid">
                            <div class="ak-field">
                                <label asp-for="NewOwnershipShare.OwnerType" class="ak-label">@UiText.T(Context, "نوع مالک", "Owner Type")</label>
                                <select asp-for="NewOwnershipShare.OwnerType" name="OwnerType" asp-items="ViewBag.OwnerTypes" class="ak-input" data-oa-owner-type></select>
                            </div>
                            <div class="ak-field" data-oa-owner-field="company">
                                <label asp-for="NewOwnershipShare.CompanyId" class="ak-label">@UiText.T(Context, "شرکت", "Company")</label>
                                <select asp-for="NewOwnershipShare.CompanyId" name="CompanyId" asp-items="ViewBag.Companies" class="ak-input">
                                    <option value="">@UiText.T(Context, "انتخاب کنید...", "Select...")</option>
                                </select>
                            </div>
                            <div class="ak-field" data-oa-owner-field="partner">
                                <label asp-for="NewOwnershipShare.PartnerId" class="ak-label">@UiText.T(Context, "شریک", "Partner")</label>
                                <select asp-for="NewOwnershipShare.PartnerId" name="PartnerId" asp-items="ViewBag.Partners" class="ak-input">
                                    <option value="">@UiText.T(Context, "انتخاب کنید...", "Select...")</option>
                                </select>
                            </div>
                            <div class="ak-field" data-oa-owner-field="other">
                                <label asp-for="NewOwnershipShare.OwnerName" class="ak-label">@UiText.T(Context, "نام مالک دیگر", "Other Owner Name")</label>
                                <input asp-for="NewOwnershipShare.OwnerName" name="OwnerName" class="ak-input" placeholder="@UiText.T(Context, "برای مالک بیرونی یا حساب دیگر", "For external owner or other account")" />
                            </div>
                            <div class="ak-field">
                                <label asp-for="NewOwnershipShare.SharePercent" class="ak-label">@UiText.T(Context, "درصد سهم (%)", "Share Percent (%)")</label>
                                <input asp-for="NewOwnershipShare.SharePercent" name="SharePercent" class="ak-input" placeholder="@UiText.T(Context, "مثلاً 20", "For example 20")" />
                            </div>
                            <div class="ak-field">
                                <label asp-for="NewOwnershipShare.EffectiveFrom" class="ak-label">@UiText.T(Context, "تاریخ اجرا", "Effective Date")</label>
                                <input asp-for="NewOwnershipShare.EffectiveFrom" name="EffectiveFrom" type="date" class="ak-input" />
                            </div>
                        </div>
                        <div class="ak-field">
                            <label asp-for="NewOwnershipShare.Notes" class="ak-label">@UiText.T(Context, "یادداشت", "Notes")</label>
                            <textarea asp-for="NewOwnershipShare.Notes" name="Notes" rows="2" class="ak-input"></textarea>
                        </div>
                        <div class="oa-modal-actions">
                            <button type="button" class="btn btn-light ak-secondary-action" data-bs-dismiss="modal">@UiText.T(Context, "انصراف", "Cancel")</button>
                            <button type="submit" class="ak-save">@UiText.T(Context, "ثبت سهم", "Save Share")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade oa-action-modal" id="oaRentModal" tabindex="-1" aria-labelledby="oaRentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="oaRentModalLabel">@UiText.T(Context, "ثبت کرایه به بیرون", "Record outside rent")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@UiText.T(Context, "بستن", "Close")"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="CreateRent" method="post" class="ak-form-section ak-detail-section ak-form" data-oa-rent-form="true">
                        @Html.AntiForgeryToken()
                        <input name="OperationalAssetId" value="@Model.Id" type="hidden" />
                        <input name="ChargedToType" value="@((int)Model.NewRent.ChargedToType)" type="hidden" data-oa-charged-to-type />
                        <input name="Rate" value="@Model.NewRent.Rate" type="hidden" />
                        <input name="Currency" value="@Model.NewRent.Currency" type="hidden" />
                        <input name="FxRateToUsd" value="@Model.NewRent.FxRateToUsd" type="hidden" />
                        <div class="ak-field">
                            <label class="ak-label">@UiText.T(Context, "نوع استفاده", "Kind of use")</label>
                            <div class="ptg-tabs-rail ak-detail-tabs oa-choice-rail">
                                <label>
                                    <input type="radio" name="UsageType" value="@((int)AssetRentUsageType.ExternalCustomerRental)" checked data-oa-rent-usage />
                                    <span>@UiText.T(Context, "کرایه به بیرون", "Rented out")</span>
                                </label>
                                <label>
                                    <input type="radio" name="UsageType" value="@((int)AssetRentUsageType.InternalCompanyUse)" data-oa-rent-usage />
                                    <span>@UiText.T(Context, "استفاده داخلی شرکت", "Company internal use")</span>
                                </label>
                            </div>
                        </div>
                        <div data-oa-rent-external-party>
                            <div class="ak-form-grid">
                                <div class="ak-field" data-oa-rent-party-field="customer">
                                    <label asp-for="NewRent.ChargedToCustomerId" class="ak-label">@UiText.T(Context, "مشتری موجود", "Existing Customer")</label>
                                    <select asp-for="NewRent.ChargedToCustomerId" name="ChargedToCustomerId" asp-items="ViewBag.Customers" class="ak-input">
                                        <option value="">@UiText.T(Context, "از لیست انتخاب کنید...", "Select from list...")</option>
                                    </select>
                                </div>
                                <div class="ak-field">
                                    <label asp-for="NewRent.NewCustomerName" class="ak-label">@UiText.T(Context, "نام مشتری جدید", "New Customer Name")</label>
                                    <input asp-for="NewRent.NewCustomerName" name="NewCustomerName" class="ak-input" placeholder="@UiText.T(Context, "اگر در لیست نیست، نام را وارد کنید", "Enter name if not in the list")" />
                                </div>
                            </div>
                        </div>
                        <div data-oa-rent-internal-party hidden>
                            <div class="ak-form-grid">
                                <div class="ak-field">
                                    <label class="ak-label">@UiText.T(Context, "نوع طرف حساب داخلی", "Internal Counterparty Type")</label>
                                    <select class="ak-input" data-oa-internal-party-type>
                                        <option value="@((int)AssetRentChargedToType.CompanyInternal)">@UiText.T(Context, "شرکت", "Company")</option>
                                        <option value="@((int)AssetRentChargedToType.Partner)">@UiText.T(Context, "شریک", "Partner")</option>
                                        <option value="@((int)AssetRentChargedToType.Customer)">@UiText.T(Context, "مشتری", "Customer")</option>
                                        <option value="@((int)AssetRentChargedToType.Other)">@UiText.T(Context, "شرکت خدماتی", "Service Company")</option>
                                    </select>
                                </div>
                                <div class="ak-field" data-oa-rent-party-field="company">
                                    <label asp-for="NewRent.ChargedToCompanyId" class="ak-label">@UiText.T(Context, "شرکت", "Company")</label>
                                    <select asp-for="NewRent.ChargedToCompanyId" name="ChargedToCompanyId" asp-items="ViewBag.Companies" class="ak-input">
                                        <option value="">@UiText.T(Context, "شرکت را انتخاب کنید...", "Select company...")</option>
                                    </select>
                                </div>
                                <div class="ak-field" data-oa-rent-party-field="partner">
                                    <label asp-for="NewRent.ChargedToPartnerId" class="ak-label">@UiText.T(Context, "شریک", "Partner")</label>
                                    <select asp-for="NewRent.ChargedToPartnerId" name="ChargedToPartnerId" asp-items="ViewBag.Partners" class="ak-input">
                                        <option value="">@UiText.T(Context, "شریک را انتخاب کنید...", "Select partner...")</option>
                                    </select>
                                </div>
                                <div class="ak-field" data-oa-rent-party-field="internal-customer">
                                    <label asp-for="NewRent.ChargedToCustomerId" class="ak-label">@UiText.T(Context, "مشتری", "Customer")</label>
                                    <select name="ChargedToCustomerId" asp-items="ViewBag.Customers" class="ak-input">
                                        <option value="">@UiText.T(Context, "مشتری را انتخاب کنید...", "Select customer...")</option>
                                    </select>
                                </div>
                                <div class="ak-field" data-oa-rent-party-field="service-provider">
                                    <label asp-for="NewRent.ChargedToServiceProviderId" class="ak-label">@UiText.T(Context, "شرکت خدماتی", "Service Company")</label>
                                    <select asp-for="NewRent.ChargedToServiceProviderId" name="ChargedToServiceProviderId" asp-items="ViewBag.ServiceProviders" class="ak-input">
                                        <option value="">@UiText.T(Context, "شرکت خدماتی را انتخاب کنید...", "Select service company...")</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="ak-form-grid">
                            <div class="ak-field">
                                <label asp-for="NewRent.AmountOriginal" class="ak-label">@UiText.T(Context, "مبلغ (دالر)", "Amount (USD)")</label>
                                <input asp-for="NewRent.AmountOriginal" name="AmountOriginal" class="ak-input" placeholder="@UiText.T(Context, "مثلاً 5000", "For example 5000")" />
                            </div>
                            <div class="ak-field">
                                <label asp-for="NewRent.RentDate" class="ak-label">@UiText.T(Context, "از تاریخ", "From Date")</label>
                                <input asp-for="NewRent.RentDate" name="RentDate" type="date" class="ak-input" />
                            </div>
                            <div class="ak-field">
                                <label asp-for="NewRent.ReferenceDocument" class="ak-label">@UiText.T(Context, "شماره سند", "Document No.")</label>
                                <input asp-for="NewRent.ReferenceDocument" name="ReferenceDocument" class="ak-input" />
                            </div>
                        </div>
                        <div class="ak-field">
                            <label asp-for="NewRent.Description" class="ak-label">@UiText.T(Context, "شرح مختصر", "Short Note")</label>
                            <textarea asp-for="NewRent.Description" name="Description" rows="2" class="ak-input"></textarea>
                        </div>
                        <div class="oa-modal-actions">
                            <a class="btn btn-light ak-secondary-action" href="@rentUrl">@UiText.T(Context, "فورم کامل", "Full form")</a>
                            <button type="submit" class="ak-save">
                                @UiText.T(Context, "ثبت و تأیید نهایی", "Save and confirm") <i class="bi bi-check-circle" aria-hidden="true"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade oa-action-modal" id="oaExpenseModal" tabindex="-1" aria-labelledby="oaExpenseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="oaExpenseModalLabel">@UiText.T(Context, "ثبت مصرف", "Record expense")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@UiText.T(Context, "بستن", "Close")"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Expenses" asp-action="Create" method="post" class="ak-form-section ak-detail-section ak-form">
                        @Html.AntiForgeryToken()
                        <input name="OperationalAssetId" value="@Model.Id" type="hidden" />
                        <input name="Currency" value="USD" type="hidden" />
                        <input name="AppliedFxRateToUsd" value="1" type="hidden" />
                        <input name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" type="hidden" />
                        <div class="ak-form-grid">
                            <div class="ak-field">
                                <label class="ak-label">@UiText.T(Context, "نوع مصرف", "Expense Type")</label>
                                <input name="ManualExpenseTypeName" class="ak-input" placeholder="@UiText.T(Context, "مثلاً تعمیر و نگهداری", "For example maintenance")" />
                            </div>
                            <div class="ak-field">
                                <label class="ak-label">@UiText.T(Context, "مبلغ (دالر)", "Amount (USD)")</label>
                                <input name="Amount" class="ak-input" placeholder="@UiText.T(Context, "مثلاً 2500", "For example 2500")" />
                            </div>
                            <div class="ak-field">
                                <label class="ak-label">@UiText.T(Context, "تاریخ مصرف", "Expense Date")</label>
                                <input name="ExpenseDate" type="date" class="ak-input" value="@BusinessClock.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">@UiText.T(Context, "شرح / مرجع", "Description / Reference")</label>
                            <textarea name="Description" rows="2" class="ak-input"></textarea>
                        </div>
                        <div class="oa-modal-actions">
                            <button type="button" class="btn btn-light ak-secondary-action" data-bs-dismiss="modal">@UiText.T(Context, "انصراف", "Cancel")</button>
                            <button type="submit" class="ak-save">
                                @UiText.T(Context, "ثبت مصرف", "Save Expense") <i class="bi bi-check-circle" aria-hidden="true"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
