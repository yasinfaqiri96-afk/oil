@model PTGOilSystem.Web.Models.OperationalAssets.OperationalAssetProfileViewModel
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] = Model.Name;
    ViewData["FinanceFormAssets"] = true;

    // هشت بخش مصوب پرونده دارایی.
    var activeShareTotal = Model.ActiveOwnershipPercent;
    var ownershipComplete = Math.Abs(activeShareTotal - 100m) <= 0.0001m;
    var internalIncomeUsd = Model.InternalRentUsd + Model.FreightIncomeUsd;
    var externalIncomeUsd = Model.ExternalRentUsd;
    var totalIncomeUsd = internalIncomeUsd + externalIncomeUsd;
    var isNetPositive = Model.NetResultUsd >= 0;

    var activeAssetTab = Context.Request.Query["tab"].ToString().Trim().ToLowerInvariant();
    activeAssetTab = activeAssetTab switch
    {
        "ownership" or "responsibility" or "work" or "costs" or "income" or "maintenance" or "documents" => activeAssetTab,
        // نشانی‌های قدیمی نباید خطا بدهند: به بخش هم‌معنی خودشان می‌روند.
        "rents" or "profit" or "shares" => "income",
        "expenses" => "costs",
        _ => "overview"
    };

    // بازه فقط برای بخش‌هایی معنا دارد که ردیف‌هایشان از تاریخ فیلتر می‌شوند.
    var isPeriodTab = activeAssetTab is "overview" or "work" or "costs" or "income";
    var editUrl = Url.Action("Edit", new { id = Model.Id }) ?? "#";
    var rentUrl = Url.Action("CreateRent", new { assetId = Model.Id }) ?? "#";

    ViewData["AkHeaderStatus"] = Model.IsActive ? UiText.T(Context, "فعال", "Active") : UiText.T(Context, "غیرفعال", "Inactive");
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = $"{Model.AssetCode} · {OperationalAssetLabels.AssetType(Model.AssetType, Context)}";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = UiText.T(Context, "ثبت مصرف", "Record expense"), Href = Url.Action("Create", "Expenses", new { operationalAssetId = Model.Id, returnUrl = Context.Request.Path }), Icon = "bi-receipt-cutoff" },
        new() { Label = UiText.T(Context, "ویرایش", "Edit"), Href = editUrl, Icon = "bi-pencil" }
    };

    var assetTabs = new[]
    {
        $"overview|{UiText.T(Context, "نمای کلی", "Overview")}||{(activeAssetTab == "overview" ? "active" : "")}",
        $"ownership|{UiText.T(Context, "مالکیت", "Ownership")}||{(activeAssetTab == "ownership" ? "active" : "")}",
        $"responsibility|{UiText.T(Context, "مسئولیت", "Responsibility")}||{(activeAssetTab == "responsibility" ? "active" : "")}",
        $"work|{UiText.T(Context, "کارکرد", "Work")}||{(activeAssetTab == "work" ? "active" : "")}",
        $"costs|{UiText.T(Context, "مصارف", "Costs")}||{(activeAssetTab == "costs" ? "active" : "")}",
        $"income|{UiText.T(Context, "عواید", "Income")}||{(activeAssetTab == "income" ? "active" : "")}",
        $"maintenance|{UiText.T(Context, "ترمیم و سرویس", "Maintenance")}||{(activeAssetTab == "maintenance" ? "active" : "")}",
        $"documents|{UiText.T(Context, "اسناد", "Documents")}||{(activeAssetTab == "documents" ? "active" : "")}"
    };

    // نوع و کد دارایی در AkHeaderContext هدر صفحه نمایش داده می‌شوند و اینجا تکرار نمی‌شوند.
    // فقط واقعیت‌های عملیاتی روزمره اینجا می‌مانند؛ ارقام خرید و نرخ‌های پیش‌فرض به Advanced رفته‌اند.
    var assetIdentityItems = new List<AkInfoItem>
    {
        new() { Label = UiText.T(Context, "منبع مرتبط", "Linked resource"), Value = Model.LinkedResourceText },
        new() { Label = UiText.T(Context, "نوع مالکیت", "Ownership mode"), Value = OperationalAssetLabels.OwnershipMode(Model.OwnershipMode, Context) },
        new() { Label = UiText.T(Context, "ظرفیت", "Capacity"), Value = Model.CapacityMt?.ToString("N0"), Unit = "MT", IsNumeric = true },
        new() { Label = UiText.T(Context, "موقعیت", "Location"), Value = Model.LocationName },
        new() { Label = UiText.T(Context, "ترمینال", "Terminal"), Value = Model.TerminalName },
        new() { Label = UiText.T(Context, "وضعیت عملیاتی", "Operational status"), Value = OperationalAssetLabels.Status(Model.OperationalStatus, Context) }
    };

    var assetAdvancedItems = new List<AkInfoItem>
    {
        new() { Label = UiText.T(Context, "تاریخ خرید", "Acquisition date"), Value = Model.AcquisitionDate?.ToDisplayDate() },
        new() { Label = UiText.T(Context, "قیمت خرید", "Acquisition cost"), Value = Model.AcquisitionCostUsd?.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = UiText.T(Context, "شروع کار", "In service"), Value = Model.InServiceDate?.ToDisplayDate() },
        new() { Label = UiText.T(Context, "تاریخ خروج", "Disposal date"), Value = Model.DisposalDate?.ToDisplayDate() },
        new() { Label = UiText.T(Context, "استهلاک ماهانه", "Monthly depreciation"), Value = Model.MonthlyDepreciationUsd.ToString("N0"), Unit = "USD", IsNumeric = true },
        new() { Label = UiText.T(Context, "نرخ داخلی پیش‌فرض", "Default internal rate"), Value = Model.DefaultInternalRateUsd?.ToString("N0"), Unit = "USD", IsNumeric = true },
        new() { Label = UiText.T(Context, "نرخ بیرونی پیش‌فرض", "Default external rate"), Value = Model.DefaultExternalRateUsd?.ToString("N0"), Unit = "USD", IsNumeric = true },
        new() { Label = UiText.T(Context, "شناسه دارایی", "Asset id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = UiText.T(Context, "یادداشت", "Notes"), Value = Model.Notes }
    };

    // آمار هر تب از همان ردیف‌هایی می‌آید که پایین همان تب نمایش داده می‌شوند؛ هیچ عدد تازه‌ای ساخته نمی‌شود.
    var activeOwnerCount = Model.OwnershipShares.Count(row => row.IsActiveNow);
    var currentAssignmentCount = Model.Assignments.Count(row => row.IsCurrent);
    var workQuantityMt = Model.WorkRows.Sum(row => row.QuantityMt ?? 0m);
    var internalWorkCount = Model.WorkRows.Count(row => row.IsInternalUse);
    var costTotalUsd = Model.CostRows.Sum(row => row.AmountUsd);
    var openMaintenanceCount = Model.MaintenanceJobs.Count(row => row.CompletedDate is null);
    var expiredDocumentCount = Model.Documents.Count(row => row.IsExpired);
    var expiringDocumentCount = Model.Documents.Count(row => !row.IsExpired && row.ExpiresSoon);

    var tabKpis = activeAssetTab switch
    {
        "ownership" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "مالکین فعال", "Active owners"), Value = activeOwnerCount.ToString("N0"), Unit = UiText.T(Context, "مالک", "owners"), Avatar = "partners" },
            new() { Title = UiText.T(Context, "مجموع سهم فعال", "Active share total"), Value = activeShareTotal.ToString("N0"), Unit = "%", Avatar = "rules-checklist", State = ownershipComplete ? null : "warning" }
        },
        "responsibility" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "مسئول فعلی", "Current responsible"), Value = currentAssignmentCount.ToString("N0"), Unit = UiText.T(Context, "نفر", "people"), Avatar = "employees" },
            new() { Title = UiText.T(Context, "کل واگذاری‌ها", "All assignments"), Value = Model.Assignments.Count.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "rules-checklist" }
        },
        "work" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "عملیات این بازه", "Operations this period"), Value = Model.WorkRows.Count.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "transported" },
            new() { Title = UiText.T(Context, "مقدار جابه‌جاشده", "Quantity handled"), Value = workQuantityMt.ToString("N2"), Unit = "MT", Avatar = "flow-weight-mt" },
            new() { Title = UiText.T(Context, "استفاده داخلی شرکت", "Company internal use"), Value = internalWorkCount.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "equipment" }
        },
        "costs" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "مصارف این بازه", "Costs this period"), Value = costTotalUsd.ToString("N2"), Unit = "USD", Avatar = "expenses" },
            new() { Title = UiText.T(Context, "تعداد ردیف", "Rows"), Value = Model.CostRows.Count.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "documents" }
        },
        "income" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "عواید استفاده داخلی", "Internal use income"), Value = internalIncomeUsd.ToString("N2"), Unit = "USD", Avatar = "equipment" },
            new() { Title = UiText.T(Context, "عواید کرایه به بیرون", "Rented-out income"), Value = externalIncomeUsd.ToString("N2"), Unit = "USD", Avatar = "receipts" },
            new() { Title = UiText.T(Context, "مجموع عواید", "Total income"), Value = totalIncomeUsd.ToString("N2"), Unit = "USD", Avatar = "profit-loss" }
        },
        "maintenance" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "کارهای باز", "Open jobs"), Value = openMaintenanceCount.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "rules-checklist", State = openMaintenanceCount > 0 ? "warning" : null },
            new() { Title = UiText.T(Context, "کل سرویس و ترمیم", "All maintenance"), Value = Model.MaintenanceJobs.Count.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "equipment" },
            new() { Title = UiText.T(Context, "عدد کارکرد ثبت‌شده", "Meter readings"), Value = Model.MeterReadings.Count.ToString("N0"), Unit = UiText.T(Context, "مورد", "records"), Avatar = "analysis" }
        },
        "documents" => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "کل اسناد", "All documents"), Value = Model.Documents.Count.ToString("N0"), Unit = UiText.T(Context, "سند", "documents"), Avatar = "documents" },
            new() { Title = UiText.T(Context, "منقضی", "Expired"), Value = expiredDocumentCount.ToString("N0"), Unit = UiText.T(Context, "سند", "documents"), Avatar = "security", State = expiredDocumentCount > 0 ? "warning" : null },
            new() { Title = UiText.T(Context, "نزدیک انقضا", "Expiring soon"), Value = expiringDocumentCount.ToString("N0"), Unit = UiText.T(Context, "سند", "documents"), Avatar = "rules-checklist", State = expiringDocumentCount > 0 ? "warning" : null }
        },
        _ => new List<AkKpiItem>
        {
            new() { Title = UiText.T(Context, "مجموع عواید", "Total income"), Value = totalIncomeUsd.ToString("N2"), Unit = "USD", Avatar = "receipts" },
            new() { Title = UiText.T(Context, "مصارف", "Costs"), Value = Model.DirectExpensesUsd.ToString("N2"), Unit = "USD", Avatar = "expenses" },
            new() { Title = UiText.T(Context, "استهلاک محاسباتی", "Calculated depreciation"), Value = Model.DepreciationUsd.ToString("N2"), Unit = "USD", Avatar = "losses" },
            new() { Title = UiText.T(Context, "نتیجه این بازه", "Result this period"), Value = Model.NetResultUsd.ToString("N2"), Unit = "USD", Avatar = "profit-loss", State = isNetPositive ? null : "warning" }
        }
    };
}

<div class="ak-form-page ak-detail-page operational-asset-details-page" data-ak-detail-v2="true" data-operational-asset-details>
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.Name, false,
                       UiText.T(Context, "ثبت کرایه به بیرون", "Record outside rent"), "bi-calendar-plus", rentUrl, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)Url.Action("Index")))" />

    <section class="ak-form-section ak-detail-section" aria-label="@UiText.T(Context, "پرونده دارایی عملیاتی", "Operational asset profile")">
        <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml"
                 model="@(UiText.T(Context, "بخش‌های دارایی", "Asset sections"), assetTabs)" />

        @* آمار همان تب فعال، از کامپوننت مشترک صفحات Details. *@
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)tabKpis)" />

        @* یک بازه برای بخش‌های وابسته به تاریخ (نمای کلی، کارکرد، مصارف، عواید). پیش‌فرض دوازده ماه
           گذشته است. مالکیت، مسئولیت، ترمیم و اسناد به این بازه وابسته نیستند و فیلتر را نمی‌بینند. *@
        @if (isPeriodTab)
        {
            <form method="get" class="ak-detail-toolbar no-print" aria-label="@UiText.T(Context, "بازه گزارش دارایی", "Asset report period")">
                <input name="tab" value="@activeAssetTab" type="hidden" />
                <div class="ak-field">
                    <label class="ak-label" for="assetPeriodFrom">@UiText.T(Context, "از تاریخ", "From date")</label>
                    <input id="assetPeriodFrom" class="ak-input" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" type="date" />
                </div>
                <div class="ak-field">
                    <label class="ak-label" for="assetPeriodTo">@UiText.T(Context, "تا تاریخ", "To date")</label>
                    <input id="assetPeriodTo" class="ak-input" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" type="date" />
                </div>
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>@UiText.T(Context, "اعمال", "Apply")</span>
                </button>
                <a class="btn btn-light ak-secondary-action" href="@(Url.Action("Details", new { id = Model.Id, tab = activeAssetTab }))">
                    @UiText.T(Context, "دوازده ماه گذشته", "Last 12 months")
                </a>
            </form>
        }

        <div class="tab-content ak-detail-content">
            <div class="tab-pane fade @(activeAssetTab == "overview" ? "show active" : "")" id="asset-overview" role="tabpanel" hidden="@(activeAssetTab != "overview")">
                @* ارقام بازه در نوار آمار بالای همین تب‌اند و اینجا دوباره جدول نمی‌شوند.
                   مالکین هم بخش خودشان را دارند. *@
                <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
                         model="@((UiText.T(Context, "مشخصات دارایی", "Asset profile"), (string?)null, (IReadOnlyList<AkInfoItem>)assetIdentityItems))" />

                <p class="ak-note">
                    @UiText.T(Context,
                        "عواید استفاده داخلی شرکت پرداخت بیرونی ندارد و طلبی نمی‌سازد. استهلاک فقط برای گزارش مدیریت است و در دفتر حساب ثبت نمی‌شود.",
                        "Income from company internal use has no outside payment and creates no receivable. Depreciation is management reporting only and is not recorded in the accounts.")
                </p>
            </div>

            <div class="tab-pane fade @(activeAssetTab == "ownership" ? "show active" : "")" id="asset-ownership" role="tabpanel" hidden="@(activeAssetTab != "ownership")">
                <div class="ak-section-head ak-detail-section-header oa-block-head">
                    <h3>@UiText.T(Context, "مالکیت دارایی", "Asset ownership")</h3>
                    <button type="button" class="btn btn-primary oa-modal-trigger" data-bs-toggle="modal" data-bs-target="#oaOwnershipModal">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>@UiText.T(Context, "افزودن سهم", "Add share")</span>
                    </button>
                </div>

                @if (Model.OwnershipShares.Any() && !ownershipComplete)
                {
                    <p class="oa-warning-line">
                        @UiText.T(Context, "مجموع سهم مالکین فعال", "Active owner shares total")
                        <b dir="ltr">@activeShareTotal.ToString("N0")%</b>
                        @UiText.T(Context, "است. تا وقتی این عدد ۱۰۰٪ نشود، تقسیم عواید بین مالکین درست انجام نمی‌شود.", "It must reach 100%, otherwise income is not divided correctly between the owners.")
                    </p>
                }

                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th>@UiText.T(Context, "نام مالک / شرکت", "Owner / Company")</th>
                                <th>@UiText.T(Context, "نوعیت", "Type")</th>
                                <th class="text-end">@UiText.T(Context, "درصد سهم", "Share Percent")</th>
                                <th>@UiText.T(Context, "از تاریخ", "From")</th>
                                <th>@UiText.T(Context, "تا تاریخ", "To")</th>
                                <th>@UiText.T(Context, "وضعیت", "Status")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.OwnershipShares)
                        {
                            <tr>
                                <td><strong>@row.OwnerName</strong></td>
                                <td><span class="ak-status">@OperationalAssetLabels.OwnerType(row.OwnerType, Context)</span></td>
                                <td class="text-end"><span>@row.SharePercent.ToString("N0")%</span></td>
                                <td>@row.EffectiveFrom.ToDisplayDate()</td>
                                <td>@(row.EffectiveTo?.ToDisplayDate() ?? "-")</td>
                                <td>
                                    <span class="ak-status @(row.IsActiveNow ? "is-active" : "is-inactive")">
                                        @(row.IsActiveNow ? UiText.T(Context, "فعال", "Active") : UiText.T(Context, "منقضی", "Expired"))
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!Model.OwnershipShares.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@UiText.T(Context, "سهم مالکیت ثبت نشده است؛ قبل از ثبت کرایه، سهم مالکین را اضافه کنید.", "No ownership share recorded; add owner shares before recording rent.")" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade @(activeAssetTab == "responsibility" ? "show active" : "")" id="asset-responsibility" role="tabpanel" hidden="@(activeAssetTab != "responsibility")">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "مسئولیت دارایی", "Asset responsibility"), (string?)null))" />
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead><tr>
                            <th>@UiText.T(Context, "مسئول", "Responsible")</th><th>@UiText.T(Context, "نقش", "Role")</th>
                            <th>@UiText.T(Context, "از تاریخ", "From")</th><th>@UiText.T(Context, "تا تاریخ", "To")</th>
                            <th>@UiText.T(Context, "پایگاه / راننده", "Base / Driver")</th><th>@UiText.T(Context, "وضعیت", "Status")</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var row in Model.Assignments)
                        {
                            <tr>
                                <td><strong>@row.ResponsibleName</strong></td><td>@row.Role</td>
                                <td>@row.FromDate.ToDisplayDate()</td><td>@(row.ToDate?.ToDisplayDate() ?? "-")</td>
                                <td>@(row.BaseTerminalName ?? row.DriverName ?? "-")</td>
                                <td><span class="ak-status @(row.IsCurrent ? "is-active" : "is-inactive")">@(row.IsCurrent ? UiText.T(Context, "فعلی", "Current") : UiText.T(Context, "پایان‌یافته", "Ended"))</span></td>
                            </tr>
                        }
                        @if (!Model.Assignments.Any())
                        {
                            <tr><td colspan="6"><partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@UiText.T(Context, "هنوز مسئولیتی ثبت نشده است.", "No assignment has been recorded.")" /></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context, "ثبت مسئولیت جدید", "New assignment"), (string?)null))" />
                <form asp-action="AddAssignment" method="post" class="ak-form ak-form-section">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OperationalAssetId" value="@Model.Id" />
                    <div class="ak-form-grid">
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "مسئول", "Responsible")</label><select name="ResponsiblePartyKey" asp-items="ViewBag.ResponsibleParties" class="ak-input" required><option value="">@UiText.T(Context, "انتخاب کنید...", "Select...")</option></select></div>
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "نقش", "Role")</label><input name="Role" value="@Model.NewAssignment.Role" class="ak-input" required /></div>
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "از تاریخ", "From")</label><input name="FromDate" value="@Model.NewAssignment.FromDate.ToString("yyyy-MM-dd")" type="date" class="ak-input" required /></div>
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "ترمینال پایه", "Base terminal")</label><select name="BaseTerminalId" asp-items="ViewBag.AssignmentTerminals" class="ak-input"><option value="">-</option></select></div>
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "راننده (اختیاری)", "Driver (optional)")</label><select name="DriverId" asp-items="ViewBag.AssignmentDrivers" class="ak-input"><option value="">-</option></select></div>
                        <div class="ak-field"><label class="ak-label">@UiText.T(Context, "یادداشت", "Notes")</label><input name="Notes" class="ak-input" /></div>
                    </div>
                    <div class="ak-footer-actions"><button type="submit" class="ak-save">@UiText.T(Context, "ثبت مسئولیت جدید", "Save new assignment")</button></div>
                </form>
            </div>

            <div class="tab-pane fade @(activeAssetTab == "work" ? "show active" : "")" id="asset-work" role="tabpanel" hidden="@(activeAssetTab != "work")">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "کارکرد دارایی", "Asset work"), (string?)null))" />

                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th>@UiText.T(Context, "تاریخ", "Date")</th>
                                <th>@UiText.T(Context, "نوع عملیات", "Operation")</th>
                                <th>@UiText.T(Context, "سند مرتبط", "Source document")</th>
                                <th>@UiText.T(Context, "قرارداد / محموله", "Contract / Shipment")</th>
                                <th class="text-end">@UiText.T(Context, "مقدار", "Quantity")</th>
