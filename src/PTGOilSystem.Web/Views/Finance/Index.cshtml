@inject PTGOilSystem.Web.Security.ClientModuleProfile ClientModules
@{
    ViewData["Title"] = UiText.T(Context, "مالی", "Finance");

    // هاب مالی فقط مسیرهای اصلی و روزمره را نگه می‌دارد. گزارش‌ها، تعاریف پایه،
    // مصارف عملیاتی و ابزارهای مدیریتی از بخش‌های تخصصی خودشان باز می‌شوند.
    // هر کارت با همان قاعدهٔ دسترسیِ سایدبار فیلتر می‌شود تا کاربر کارتی را نبیند
    // که بعد از کلیک به خطای دسترسی می‌رسد.
    bool CanOpen(string controller)
        => PTGOilSystem.Web.Security.RoleAccessRules.CanAccessController(User, controller, ClientModules);

    var groups = new[]
    {
        new
        {
            TitleFa = "کارهای روزانه",
            TitleEn = "Daily Finance",
            Items = new[]
            {
                new { Controller = "Payments", Action = "Index", TitleFa = "روزنامچه (رسید و پرداخت)", TitleEn = "Journal (Receipts & Payments)", DescriptionFa = "ثبت پولی که گرفته‌اید و پولی که داده‌اید.", DescriptionEn = "Record money received and money paid.", Icon = "bi-journal-text" },
                new { Controller = "CashAccounts", Action = "Index", TitleFa = "صندوق و بانک", TitleEn = "Cash & Bank", DescriptionFa = "حساب‌های نقده و بانکی شرکت با مانده هرکدام.", DescriptionEn = "Company cash and bank accounts with each balance.", Icon = "bi-cash-coin" },
            }
        },
        new
        {
            TitleFa = "تسویه و طرف‌حساب‌ها",
            TitleEn = "Settlements & Parties",
            Items = new[]
            {
                new { Controller = "ThreeWaySettlement", Action = "Index", TitleFa = "تسویه سه‌طرفه", TitleEn = "Three-way Settlement", DescriptionFa = "تصفیه بین مشتری، صراف و تأمین‌کننده در یک سند.", DescriptionEn = "Settle customer, sarraf and supplier in one document.", Icon = "bi-arrow-left-right" },
                new { Controller = "PartySettlements", Action = "Index", TitleFa = "تسویه بین طرف‌حساب‌ها", TitleEn = "Party-to-Party Settlement", DescriptionFa = "بدهکار شرکت مستقیماً به طلبکار شرکت می‌پردازد؛ بدون صندوق و بانک.", DescriptionEn = "A debtor pays a creditor of the company directly; no cash or bank.", Icon = "bi-arrow-left-right" },
                new { Controller = "Sarrafs", Action = "Index", TitleFa = "صراف‌ها", TitleEn = "Sarrafs", DescriptionFa = "مانده و حواله‌های هر صراف.", DescriptionEn = "Balance and transfers of each sarraf.", Icon = "bi-currency-exchange" },
                new { Controller = "Customers", Action = "Index", TitleFa = "صورت‌حساب مشتریان", TitleEn = "Customer Statements", DescriptionFa = "مانده و گردش هر مشتری.", DescriptionEn = "Balance and activity of each customer.", Icon = "bi-people" },
                new { Controller = "Suppliers", Action = "Index", TitleFa = "صورت‌حساب تأمین‌کنندگان", TitleEn = "Supplier Statements", DescriptionFa = "مانده و گردش هر تأمین‌کننده.", DescriptionEn = "Balance and activity of each supplier.", Icon = "bi-briefcase" }
            }
        },
        new
        {
            TitleFa = "حسابداری",
            TitleEn = "Accounting",
            Items = new[]
            {
                new { Controller = "Ledger", Action = "Index", TitleFa = "دفتر حساب‌ها", TitleEn = "Ledger", DescriptionFa = "تمام حرکت‌های ثبت‌شدهٔ هر حساب.", DescriptionEn = "Every recorded movement of each account.", Icon = "bi-bank" }
            }
        },
    };

    var visibleGroups = groups
        .Select(g => new
        {
            g.TitleFa,
            g.TitleEn,
            Items = g.Items.Where(i => CanOpen(i.Controller)).ToArray()
        })
        .Where(g => g.Items.Length > 0)
        .ToArray();

    var avatarMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Payments|Index"] = "/images/stat-cards/finance-hub/journal.png",
        ["CashAccounts|Index"] = "/images/stat-cards/finance-hub/cash-bank.png",
        ["ThreeWaySettlement|Index"] = "/images/stat-cards/finance-hub/settlement.png",
        ["PartySettlements|Index"] = "/images/stat-cards/finance-hub/settlement.png",
        ["Sarrafs|Index"] = "/images/stat-cards/finance-hub/cash-bank.png",
        ["Customers|Index"] = "/images/stat-cards/finance-hub/customer-statements.png",
        ["Suppliers|Index"] = "/images/stat-cards/finance-hub/supplier-settlements.png",
        ["Ledger|Index"] = "/images/stat-cards/finance-hub/ledger.png",
    };
}

@{
    var financeItems = visibleGroups.SelectMany(group => group.Items).ToArray();
}
<div class="akrep-page rephub-page finance-workspace-page" dir="@(UiText.IsEn(Context) ? "ltr" : "rtl")">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "مالی", "Finance"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <div class="rephub-grid">
        @foreach (var item in financeItems)
        {
            var key = $"{item.Controller}|{item.Action}";
            var avatar = avatarMap.TryGetValue(key, out var mapped) ? mapped : "/images/stat-cards/finance-hub/ledger.png";
            <a class="rephub-card" asp-controller="@item.Controller" asp-action="@item.Action">
                <span class="rephub-card-art">
                    <img src="@avatar" alt="" aria-hidden="true" width="128" height="128" loading="eager" decoding="async" />
                </span>
                <span class="rephub-card-title">@UiText.T(Context, item.TitleFa, item.TitleEn)</span>
            </a>
        }
    </div>
</div>
