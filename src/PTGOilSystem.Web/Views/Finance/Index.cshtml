@{
    ViewData["Title"] = UiText.T(Context, "مالی", "Finance");

    // هاب مالی فقط مسیرهای اصلی و روزمره را نگه می‌دارد. گزارش‌ها، تعاریف پایه،
    // مصارف عملیاتی و ابزارهای مدیریتی از بخش‌های تخصصی خودشان باز می‌شوند.
    // هر کارت با همان قاعدهٔ دسترسیِ سایدبار فیلتر می‌شود تا کاربر کارتی را نبیند
    // که بعد از کلیک به خطای دسترسی می‌رسد.
    bool CanOpen(string controller)
        => PTGOilSystem.Web.Security.RoleAccessRules.CanAccessController(User, controller);

    var groups = new[]
    {
        new
        {
            TitleFa = "کارهای روزانه",
            TitleEn = "Daily Finance",
            Items = new[]
            {
                new { Controller = "Payments", Action = "Index", TitleFa = "روزنامچه (رسید و پرداخت)", TitleEn = "Journal (Receipts & Payments)", DescriptionFa = "ثبت پولی که گرفته‌اید و پولی که داده‌اید.", DescriptionEn = "Record money received and money paid.", Icon = "bi-journal-text" },
                new { Controller = "CashAccounts", Action = "Index", TitleFa = "صندوق و بانک", TitleEn = "Cash & Bank", DescriptionFa = "حساب‌های نقده و بانکی شرکت با مانده هرکدام.", DescriptionEn = "Company cash and bank accounts with each balance.", Icon = "bi-cash-coin" }
            }
        },
        new
        {
            TitleFa = "تسویه‌ها",
            TitleEn = "Settlements",
            Items = new[]
            {
                new { Controller = "ThreeWaySettlement", Action = "Index", TitleFa = "تسویه سه‌طرفه", TitleEn = "Three-way Settlement", DescriptionFa = "تصفیه بین مشتری، صراف و تأمین‌کننده در یک سند.", DescriptionEn = "Settle customer, sarraf and supplier in one document.", Icon = "bi-arrow-left-right" },
                new { Controller = "ContractBalanceTransfers", Action = "Index", TitleFa = "انتقال مانده قرارداد", TitleEn = "Balance Transfer", DescriptionFa = "بردن مانده از یک قرارداد به قرارداد دیگر.", DescriptionEn = "Move a balance from one contract to another.", Icon = "bi-arrow-repeat" }
            }
        },
        new
        {
            TitleFa = "حسابداری",
            TitleEn = "Accounting",
            Items = new[]
            {
                new { Controller = "Ledger", Action = "Index", TitleFa = "دفتر حساب‌ها", TitleEn = "Ledger", DescriptionFa = "تمام حرکت‌های ثبت‌شدهٔ هر حساب.", DescriptionEn = "Every recorded movement of each account.", Icon = "bi-bank" },
                new { Controller = "ChartOfAccounts", Action = "Index", TitleFa = "سرفصل حساب‌ها", TitleEn = "Chart of Accounts", DescriptionFa = "ساختار سرفصل‌های حساب‌داری.", DescriptionEn = "Accounting chart-of-accounts structure.", Icon = "bi-diagram-3" },
                new { Controller = "FiscalYears", Action = "Index", TitleFa = "سال مالی و بستن سال", TitleEn = "Fiscal Year & Closing", DescriptionFa = "مدیریت سال مالی و مراحل بستن سال.", DescriptionEn = "Manage the fiscal year and the closing steps.", Icon = "bi-calendar-check" }
            }
        }
    };

    var visibleGroups = groups
        .Select(g => new
        {
            g.TitleFa,
            g.TitleEn,
            Items = g.Items.Where(i => CanOpen(i.Controller)).ToArray()
        })
        .Where(g => g.Items.Length > 0)
        .ToArray();
}

<div class="akrep-page finance-workspace-page" dir="@(UiText.IsEn(Context) ? "ltr" : "rtl")">
    @foreach (var group in visibleGroups)
    {
        <section class="akrep-group" aria-label="@UiText.T(Context, group.TitleFa, group.TitleEn)">
            <h2 class="akrep-group-title">@UiText.T(Context, group.TitleFa, group.TitleEn)</h2>
            <div class="akrep-grid">
                @foreach (var item in group.Items)
                {
                    <a class="akrep-item" asp-controller="@item.Controller" asp-action="@item.Action">
                        <span class="akrep-ico" aria-hidden="true"><i class="bi @item.Icon"></i></span>
                        <span class="akrep-copy">
                            <strong>@UiText.T(Context, item.TitleFa, item.TitleEn)</strong>
                            <small>@UiText.T(Context, item.DescriptionFa, item.DescriptionEn)</small>
                        </span>
                    </a>
                }
            </div>
        </section>
    }
</div>
