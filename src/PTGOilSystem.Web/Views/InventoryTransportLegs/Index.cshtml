@model PTGOilSystem.Web.Models.InventoryTransport.InventoryTransportLegIndexViewModel
@using PTGOilSystem.Web.Models.Entities
@{
    ViewData["Title"] = UiText.T(Context, "حمل‌ها", "Transports");
}

<main class="ak-form-page ak-list-page" data-operations-list dir="rtl">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "حمل‌ها", "Transports"), true,
                       UiText.T(Context, "+ ثبت حمل", "+ New transport"), "bi-plus-lg", Url.Action("Create", "Transports"),
                       (string?)null,
                       UiText.T(Context, "تسویه موترها", "Truck settlements"), "bi-cash-coin", Url.Action("Index", "TruckSettlements")))" />

    @{
        var sumQuantity = (decimal)(ViewBag.SumQuantity ?? 0m);
        var activeCount = (int)(ViewBag.ActiveCount ?? 0);
        var postedCount = (int)(ViewBag.PostedCount ?? 0);
    }
    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار حمل‌ها", "Transport statistics")">
        <vc:stat-card title="@UiText.T(Context, "کل حمل‌ها", "Total transports")" value="@Model.TotalCount.ToString("N0")" unit="@UiText.T(Context, "حمل", "transports")" avatar="transported"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کل مقدار", "Total quantity")" value="@NumberDisplay.Quantity(sumQuantity)" unit="MT" avatar="total-inventory"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "حمل‌های فعال", "Active transports")" value="@activeCount.ToString("N0")" unit="@UiText.T(Context, "حمل", "transports")" avatar="in-transit"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "ثبت‌شده در موجودی", "Posted to inventory")" value="@postedCount.ToString("N0")" unit="@UiText.T(Context, "حرکت", "movements")" avatar="warehouse"></vc:stat-card>
    </section>

    @* وضعیت حمل از همان فیلتر «وضعیت» در نوار جست‌وجو انتخاب می‌شود؛ نوار حالت تکراری حذف شد. *@
    <div class="ak-list">
        @{
            List<AkFilterOption> Options(object? source) => (source as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            string? QueryValue(string key)
            {
                var value = Context.Request.Query[key].ToString();
                return string.IsNullOrEmpty(value) ? null : value;
            }
            var filter = new AkSearchFilterModel("Filter.Query", Model.Filter.Query,
                UiText.T(Context, "شماره حمل، وسیله، محصول یا قرارداد", "Transport, vehicle, product or contract"),
                new List<AkFilterDefinition>
                {
                    new("Filter.WorkflowState", UiText.T(Context, "وضعیت", "Status"), "select", Options(ViewBag.WorkflowStateOptions), QueryValue("Filter.WorkflowState")),
                    new("Filter.TransportType", UiText.T(Context, "نوع وسیله", "Vehicle type"), "select", Options(ViewBag.TransportTypeOptions), QueryValue("Filter.TransportType")),
                    new("Filter.ProductId", UiText.T(Context, "محصول", "Product"), "select", Options(ViewBag.Products), QueryValue("Filter.ProductId")),
                    new("Filter.ContractId", UiText.T(Context, "قرارداد/منبع", "Contract/source"), "select", Options(ViewBag.Contracts), QueryValue("Filter.ContractId")),
                    new("Filter.StorageTankId", UiText.T(Context, "مخزن", "Tank"), "select", Options(ViewBag.StorageTanks), QueryValue("Filter.StorageTankId")),
                    new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd"))
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="filter" />
            <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("Export"))" />
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table transport-workflow-table">
                <thead>
                    <tr>
                        <th>@UiText.T(Context, "شماره حمل / تاریخ", "Transport / date")</th>
                        <th>@UiText.T(Context, "محصول / منبع", "Product / source")</th>
                        <th class="text-end">@UiText.T(Context, "مقدار", "Quantity")</th>
                        <th class="text-end">@UiText.T(Context, "ارزش حمل", "Transport value")</th>
                        <th>@UiText.T(Context, "وسیله", "Vehicle")</th>
                        <th>@UiText.T(Context, "مبدأ", "Origin")</th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                        <th class="ak-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    var typeText = item.TransportType switch
                    {
                        LoadingTransportType.Truck => UiText.T(Context, "موتر", "Truck"),
                        LoadingTransportType.Wagon => UiText.T(Context, "واگن", "Wagon"),
                        LoadingTransportType.Vessel => UiText.T(Context, "کشتی", "Vessel"),
                        _ => UiText.T(Context, "وسیله", "Vehicle")
                    };
                    // ستون وسیله فقط نام/نمبر خود وسیله را نشان می‌دهد؛ اگر ثبت نشده باشد نوع وسیله جای آن می‌نشیند.
                    var vehicleName = item.TransportType switch
                    {
                        LoadingTransportType.Truck or LoadingTransportType.Wagon => item.WagonNumber,
                        LoadingTransportType.Vessel => item.VesselName,
                        _ => item.WagonNumber ?? item.VesselName
                    };
                    if (string.IsNullOrWhiteSpace(vehicleName))
                    {
                        vehicleName = typeText;
                    }
                    var statusClass = item.PhysicalStatusText switch
                    {
                        "تکمیل‌شده" => "is-active",
                        "لغوشده" => "is-inactive",
                        "بخشی تکمیل‌شده" => "is-warning",
                        "پیش‌نویس" => "is-info",
                        _ => "is-pending"
                    };
                    // ارزش حمل = مقدار حمل‌شده × قیمت خرید واحد همان حمل (بدون تغییر در منطق قیمت‌گذاری).
                    var transportValueUsd = item.PurchaseUnitCostUsd.HasValue
                        ? item.QuantityMt * item.PurchaseUnitCostUsd.Value
                        : (decimal?)null;
                    <tr data-href="@Url.Action("Details", new { id = item.Id })">
                        <td>
                            <strong class="ak-num">TR-@item.Id.ToString("0000")</strong>
                            <span class="ak-section-desc">@item.LoadedDate.ToDisplayDate()</span>
                        </td>
                        <td>
                            <strong>@item.ProductName</strong>
                            <span class="ak-section-desc">@item.SourceContractsLabel</span>
                        </td>
                        <td class="text-end">
                            <strong class="ak-num">@NumberDisplay.Quantity(item.QuantityMt) MT</strong>
                        </td>
                        <td class="text-end">
                            @if (transportValueUsd.HasValue)
                            {
                                <strong class="ak-num">@NumberDisplay.Money(transportValueUsd.Value, "USD")</strong>
                                <span class="ak-section-desc">@NumberDisplay.UnitPrice(item.PurchaseUnitCostUsd) USD/MT</span>
                            }
                            else
                            {
                                <span class="ak-section-desc">@UiText.T(Context, "قیمت خرید ثبت نشده", "Purchase cost not set")</span>
                            }
                        </td>
                        <td>
                            <strong>@vehicleName</strong>
                        </td>
                        <td><span class="ak-label">@item.SourceLabel</span></td>
                        <td>
                            <span class="ak-status @statusClass">@item.PhysicalStatusText</span>
                        </td>
                        <td class="ak-col-actions no-print">
                            @* منوی سه‌نقطه در CSS پنهان است؛ tables.js از همین آیتم‌ها جعبهٔ عملیات هاور را می‌سازد. *@
                            <div class="ak-row-menu dropdown">
                                <button class="ak-row-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@UiText.T(Context, "عملیات", "Actions")"><i class="bi bi-three-dots"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item"><i class="bi bi-eye"></i> @(string.IsNullOrWhiteSpace(item.NextActionText) ? UiText.T(Context, "جزئیات", "Details") : item.NextActionText)</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="ak-empty"><i class="bi bi-truck-front" aria-hidden="true"></i> @UiText.T(Context, "حمل مطابق فیلتر پیدا نشد.", "No matching transport found.")</div></td></tr>
                }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_OperationsListFooter", (Model.CurrentPage, Model.PageCount, Model.TotalCount, 15))
        </div>
    </div>
</main>
