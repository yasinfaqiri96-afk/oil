@using Microsoft.AspNetCore.Html
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.TruckSettlements
@model PTGOilSystem.Web.Models.InventoryTransport.InventoryTransportLegDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);
    string Q(decimal value) => value.ToString("#,##0.####");
    string U(decimal value) => value.ToString("N2");

    ViewData["Title"] = T("جزئیات حمل", "Transport details");
    ViewData["HideSectionTabs"] = true;
    ViewData["LoadingExpenseEditorAssets"] = true;
    ViewData["LoadingCreateAssets"] = true;

    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "InventoryTransportLegs") ?? "/InventoryTransportLegs";
    var currentPageReturnUrl = Context.Request.Path + Context.Request.QueryString;

    var hasOutboundMovement = Model.OutboundInventoryMovementId.HasValue;
    var canMarkLoaded = Model.Status == InventoryTransportLegStatus.Draft && !hasOutboundMovement;
    var canCreateReceipt = Model.RemainingQuantityMt > 0.0001m
        && Model.Status is InventoryTransportLegStatus.Loaded or InventoryTransportLegStatus.InTransit;
    var canAddRelatedRecord = Model.Status != InventoryTransportLegStatus.Cancelled;
    var canSettleFreight = canAddRelatedRecord && !Model.IsFreightSettled
        && Model.Status is InventoryTransportLegStatus.Loaded or InventoryTransportLegStatus.InTransit or InventoryTransportLegStatus.Received;
    var canDetailedVehicleSettlement = canSettleFreight
        && Model.TransportType is LoadingTransportType.Truck or LoadingTransportType.Wagon
        && Model.Status is InventoryTransportLegStatus.Loaded or InventoryTransportLegStatus.InTransit
        && Model.RemainingQuantityMt > 0.0001m;
    var canSimpleFreightSettlement = canSettleFreight && !canDetailedVehicleSettlement;

    var statusText = Model.Status switch
    {
        InventoryTransportLegStatus.Draft => T("پیش‌نویس", "Draft"),
        InventoryTransportLegStatus.Loaded => T("بارگیری شده", "Loaded"),
        InventoryTransportLegStatus.InTransit => T("در مسیر", "In transit"),
        InventoryTransportLegStatus.Received => T("تکمیل‌شده", "Completed"),
        InventoryTransportLegStatus.Cancelled => T("لغو شده", "Cancelled"),
        _ => Model.Status.ToString()
    };
    var statusState = Model.Status switch
    {
        InventoryTransportLegStatus.Received => "is-active",
        InventoryTransportLegStatus.Cancelled => "is-danger",
        InventoryTransportLegStatus.Loaded or InventoryTransportLegStatus.InTransit => "is-warning",
        _ => "is-inactive"
    };
    var transportTypeName = Model.TransportType switch
    {
        LoadingTransportType.Truck => T("حمل با موتر", "Transport by truck"),
        LoadingTransportType.Wagon => T("حمل با واگن", "Transport by wagon"),
        LoadingTransportType.Vessel => T("حمل با کشتی", "Transport by vessel"),
        _ => T("حمل", "Transport")
    };
    var transportHeroIcon = Model.TransportType switch
    {
        LoadingTransportType.Wagon => "bi-train-front",
        LoadingTransportType.Vessel => "bi-life-preserver",
        _ => "bi-truck-front"
    };

    var sourceLabel = Model.SourceTankCode ?? Model.SourceTerminalName;
    var destinationLabel = Model.DestinationLocationName ?? Model.DestinationTerminalName ?? Model.DestinationTankCode;
    var documentNumber = string.IsNullOrWhiteSpace(Model.OutboundReferenceDocument)
        ? $"TR-{Model.Id:0000}"
        : Model.OutboundReferenceDocument;
    // حمل‌کنندهٔ شخصی نه شرکت دارد و نه دارایی؛ در آن حالت خودِ راننده متصدی حمل است.
    var carrierName = Model.ServiceProviderName ?? Model.OperationalAssetName ?? Model.DriverName;
    var vehicleName = Model.Chain.FirstOrDefault(step => step.IsCurrent)?.VehicleLabel
        ?? Model.OperationalAssetName
        ?? Model.WagonNumber;
    var contractLabel = !string.IsNullOrWhiteSpace(Model.ContractNumber)
        ? Model.ContractNumber
        : (!string.IsNullOrWhiteSpace(Model.SourceContractsLabel) ? Model.SourceContractsLabel : Model.ShipmentCode);

    // نوار خلاصهٔ بالای صفحه: هویت رکورد در یک ردیف افقی.
    var stripItems = new List<AkInfoItem>
    {
        new() { Label = T("قرارداد", "Contract"), Value = contractLabel, IsNumeric = true },
        new() { Label = T("محصول", "Product"), Value = Model.ProductName },
        new() { Label = T("مقدار", "Quantity"), Value = $"{Q(Model.QuantityMt)} MT", IsNumeric = true },
        new() { Label = T("تاریخ", "Date"), Value = Model.LoadedDate.ToDisplayDate(), IsNumeric = true }
    };

    // کارت اطلاعات اصلی: هویت وسیله و متصدی، همان فیلدهای قبلی صفحه.
    var mainItems = new List<AkInfoItem>();
    if (Model.TransportType == LoadingTransportType.Truck)
    {
        mainItems.Add(new() { Label = T("نمبر پلیت", "Plate no."), Value = Model.WagonNumber, IsNumeric = true });
        if (!string.IsNullOrWhiteSpace(Model.DriverName))
        {
            mainItems.Add(new() { Label = T("راننده", "Driver"), Value = Model.DriverName });
        }
        mainItems.Add(new() { Label = T("متصدی حمل", "Carrier"), Value = carrierName });
        mainItems.Add(new() { Label = T("شرکت حمل‌کننده", "Transport company"), Value = Model.ServiceProviderName });
        mainItems.Add(new() { Label = T("نمبر CMR", "CMR no."), Value = Model.RwbNo, IsNumeric = true });
        mainItems.Add(new() { Label = T("نوع موتر", "Truck type"), Value = vehicleName ?? transportTypeName });
    }
    else if (Model.TransportType == LoadingTransportType.Wagon)
    {
        mainItems.Add(new() { Label = T("نمبر واگن", "Wagon no."), Value = Model.WagonNumber, IsNumeric = true });
        mainItems.Add(new() { Label = T("متصدی حمل", "Carrier"), Value = carrierName });
        mainItems.Add(new() { Label = T("شرکت حمل‌کننده", "Transport company"), Value = Model.ServiceProviderName });
        mainItems.Add(new() { Label = T("نمبر RWB", "RWB no."), Value = Model.RwbNo, IsNumeric = true });
        mainItems.Add(new() { Label = T("وسیله", "Vehicle"), Value = vehicleName });
    }
    else if (Model.TransportType == LoadingTransportType.Vessel)
    {
        mainItems.Add(new() { Label = T("کشتی", "Vessel"), Value = Model.OperationalAssetName ?? vehicleName });
        mainItems.Add(new() { Label = T("متصدی حمل", "Carrier"), Value = Model.ServiceProviderName });
        mainItems.Add(new() { Label = T("بارنامه", "Bill of lading"), Value = Model.BillOfLadingNumber, IsNumeric = true });
    }
    mainItems.Add(new() { Label = T("نوع حمل", "Transport type"), Value = transportTypeName });

    // مراحل مسیر = همان چرخهٔ وضعیت رکورد؛ معنی وضعیت تغییر نمی‌کند.
    var isCancelled = Model.Status == InventoryTransportLegStatus.Cancelled;
    var isLoadedOrLater = !isCancelled && Model.Status is InventoryTransportLegStatus.Loaded
        or InventoryTransportLegStatus.InTransit or InventoryTransportLegStatus.Received;
    var isReceived = Model.Status == InventoryTransportLegStatus.Received;
    var routeSteps = new List<AkDetailStep>
    {
        new() { Label = T("بارگیری", "Loading"), State = isLoadedOrLater ? "is-done" : (isCancelled ? "is-pending" : "is-current") },
        new() { Label = T("در مسیر", "In transit"), State = isReceived ? "is-done" : (isLoadedOrLater ? "is-current" : "is-pending") },
        new() { Label = T("تخلیه", "Unloading"), State = isReceived ? "is-done" : "is-pending" }
    };

    var shortageQuantity = Model.Pnl.ShortageQuantityMt > 0m
        ? Model.Pnl.ShortageQuantityMt
        : Model.DestinationReceipts.Sum(item => item.ShortageQuantityMt);

    // مصارف: همان برچسب‌های موجود در Journey؛ هیچ محاسبه‌ای بازتعریف نشده.
    var costMetrics = new List<AkKpiItem>
    {
        new() { Title = T("کرایه رسید مقصد", "Destination freight"), Value = U(Model.Pnl.ReceiptFreightExpenseUsd), Unit = "USD", Avatar = "flow-truck" },
        new() { Title = T("گمرک", "Customs"), Value = U(Model.Pnl.CustomsUsd), Unit = "USD", Avatar = "flow-docs-plus" },
        new() { Title = T("مجموع مصارف", "Total expenses"), Value = U(Model.Pnl.OperationalExpensesUsd), Unit = "USD", State = "accent", Avatar = "flow-calculator" }
    };

    var cargoMetrics = new List<AkKpiItem>
    {
        new() { Title = T("محصول", "Product"), Value = Model.ProductName, Avatar = "flow-drop" },
        new() { Title = T("مقدار بارگیری", "Loaded quantity"), Value = Q(Model.QuantityMt), Unit = "MT", Avatar = "flow-weight-mt" },
        new() { Title = T("تحویل‌شده", "Received"), Value = Q(Model.Pnl.ReceivedQuantityMt), Unit = "MT", Avatar = "flow-stock-in" },
        new() { Title = T("کسری", "Shortage"), Value = Q(shortageQuantity), Unit = "MT", State = shortageQuantity > 0m ? "warning" : null, Avatar = "flow-warning" },
        new() { Title = T("باقی‌مانده", "Remaining"), Value = Q(Model.RemainingQuantityMt), Unit = "MT", Avatar = "flow-tank-gauge" }
    };

    var latestReceipt = Model.DestinationReceipts.OrderByDescending(item => item.ReceiptDate).FirstOrDefault();
    var latestCustoms = Model.CustomsDeclarations.OrderByDescending(item => item.DeclarationDate).FirstOrDefault();
    var latestLoss = Model.Losses.OrderByDescending(item => item.EventDate).FirstOrDefault();
    var latestExpense = Model.Expenses.OrderByDescending(item => item.ExpenseDate).FirstOrDefault();
    var latestSale = Model.Pnl.Sales.OrderByDescending(item => item.SaleDate).FirstOrDefault();
    var activityRows = new List<AkDetailActivityRow>
    {
        new() { Label = T("رسیدها", "Receipts"), Value = Model.DestinationReceipts.Count.ToString("N0"), Meta = T("مورد", "items"),
                Status = latestReceipt is null ? T("ثبت نشده", "Not recorded") : T("ثبت شده", "Recorded"), StatusTone = latestReceipt is null ? null : "success", Icon = "bi-box-arrow-in-down" },
        new() { Label = T("گمرک", "Customs"), Value = Model.CustomsDeclarations.Count.ToString("N0"), Meta = T("مورد", "items"),
                Href = latestCustoms is null ? null : Url.Action("Details", "CustomsDeclarations", new { id = latestCustoms.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-shield-check" },
        new() { Label = T("مصارف و کرایه", "Expenses & freight"), Value = Model.Expenses.Count.ToString("N0"), Meta = T("مورد", "items"),
                Status = Model.IsFreightSettled ? T("کرایه تسویه شده", "Freight settled") : T("کرایه تسویه نشده", "Freight unsettled"),
                StatusTone = Model.IsFreightSettled ? "success" : "warning",
                Href = latestExpense is null ? null : Url.Action("Details", "Expenses", new { id = latestExpense.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-receipt" },
        new() { Label = T("کسری", "Shortage"), Value = Q(shortageQuantity), Unit = "MT",
                Href = latestLoss is null ? null : Url.Action("Details", "LossEvents", new { id = latestLoss.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-exclamation-diamond" },
        new() { Label = T("فروش", "Sales"), Value = U(Model.Pnl.SalesUsd), Unit = "USD",
                Href = latestSale is null ? null : Url.Action("Details", "Sales", new { id = latestSale.SaleId, returnUrl = currentPageReturnUrl }), Icon = "bi-receipt-cutoff" }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("حمل از مبدأ آغاز شد", "Transport started"), Date = Model.LoadedDate.ToDisplayDate(), Timestamp = Model.LoadedDate,
                Icon = transportHeroIcon, State = Model.Status == InventoryTransportLegStatus.InTransit ? "is-current" : null, Meta = carrierName }
    };
    timelineItems.AddRange(Model.CustomsDeclarations.Select(item => new AkTimelineItem
    {
        Title = T("گمرک ثبت شد", "Customs recorded"), Date = item.DeclarationDate.ToDisplayDate(), Timestamp = item.DeclarationDate,
        Icon = "bi-shield-check", Href = Url.Action("Details", "CustomsDeclarations", new { id = item.Id, returnUrl = currentPageReturnUrl }), Meta = $"{U(item.TotalUsd)} USD"
    }));
    timelineItems.AddRange(Model.Losses.Select(item => new AkTimelineItem
    {
        Title = T("کسری ثبت شد", "Shortage recorded"), Date = item.EventDate.ToDisplayDate(), Timestamp = item.EventDate,
        Icon = "bi-exclamation-diamond", Href = Url.Action("Details", "LossEvents", new { id = item.Id, returnUrl = currentPageReturnUrl }), Meta = $"{Q(item.ChargeableLossMt)} MT"
    }));
    timelineItems.AddRange(Model.Expenses.Select(item => new AkTimelineItem
    {
        Title = T("مصرف ثبت شد", "Expense recorded"), Date = item.ExpenseDate.ToDisplayDate(), Timestamp = item.ExpenseDate,
        Icon = "bi-receipt", Href = Url.Action("Details", "Expenses", new { id = item.Id, returnUrl = currentPageReturnUrl }), Meta = $"{U(item.AmountUsd)} USD"
    }));
    timelineItems.AddRange(Model.DestinationReceipts.Select(item => new AkTimelineItem
    {
        Title = T("تحویل در مقصد ثبت شد", "Destination delivery recorded"), Date = item.ReceiptDate.ToDisplayDate(), Timestamp = item.ReceiptDate,
        Icon = "bi-box-arrow-in-down", State = Model.Status == InventoryTransportLegStatus.Received ? "is-current" : null, Meta = $"{Q(item.ReceivedQuantityMt)} MT"
    }));

    var nextActions = new List<AkHeaderMenuItem>();
    if (canMarkLoaded)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("تأیید خروج", "Confirm outbound"), PostUrl = Url.Action("MarkLoaded", "InventoryTransportLegs", new { id = Model.Id }), Icon = "bi-check2-circle",
            ConfirmTitle = T("تأیید خروج بار", "Confirm outbound"),
            ConfirmMessage = T("خروج بار از مبدأ تأیید و حرکت موجودی ثبت می‌شود. ادامه می‌دهید؟", "Outbound movement will be posted. Continue?")
        });
    }
    if (canCreateReceipt)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("تحویل در مقصد", "Deliver at destination"), Href = Url.Action("Create", "InventoryTransportReceipts", new { transportLegId = Model.Id, destination = (int)InventoryTransportReceiptDestination.ToInventory, focused = true }), Icon = "bi-box-arrow-in-down" });
    }
    if (canDetailedVehicleSettlement)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("ثبت وزن، کسری و کرایه", "Record weight, shortage & freight"),
            Href = Url.Action("Index", "TruckSettlements", new { kind = TruckSettlementSourceKind.Leg, sourceId = Model.Id }),
            Icon = "bi-calculator"
        });
    }
    else if (canSimpleFreightSettlement)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("تسویه کرایه", "Settle freight"), ModalTarget = "freightSettlementModal", Icon = "bi-cash-coin" });
    }

    // «ویرایش» فقط وقتی نشان داده می‌شود که سرور هم آن را بپذیرد؛ وگرنه کلیک حتماً به خطا
    // می‌خورد و کاربر به صفحهٔ جریان پرت می‌شود.
    var editUrl = Model.CanEditDocument
        ? Url.Action("Edit", new { id = Model.Id, returnUrl = currentPageReturnUrl })
        : null;
    if (!string.IsNullOrWhiteSpace(editUrl))
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("ویرایش", "Edit"), Href = editUrl, Icon = "bi-pencil" });
    }
    var overflowActions = new List<AkHeaderMenuItem>();
    if (Model.ShipmentId.HasValue)
    {
        overflowActions.Add(new AkHeaderMenuItem { Label = T("نمای محموله", "Shipment details"), Href = Url.Action("Details", "ShipmentPnl", new { id = Model.ShipmentId.Value, returnUrl = currentPageReturnUrl }), Icon = "bi-box-seam" });
    }
    if (canAddRelatedRecord)
    {
        overflowActions.Add(new AkHeaderMenuItem { Label = T("ثبت گمرک", "Register customs"), Href = Url.Action("Create", "CustomsDeclarations", new { transportLegId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-shield-check" });
        overflowActions.Add(new AkHeaderMenuItem { Label = T("ثبت مصارف", "Register expenses"), ModalTarget = "transportExpensesModal", Icon = "bi-receipt" });
    }
    if (canCreateReceipt)
    {
        overflowActions.Add(new AkHeaderMenuItem { Label = T("فروش مستقیم بار", "Sell load directly"), Href = Url.Action("Create", "InventoryTransportReceipts", new { transportLegId = Model.Id, destination = (int)InventoryTransportReceiptDestination.DirectSale }), Icon = "bi-cart-check" });
        overflowActions.Add(new AkHeaderMenuItem { Label = T("انتقال به وسیله دیگر", "Transfer to another vehicle"), Href = Url.Action("Continue", "Transports", new { transportLegId = Model.Id }), Icon = "bi-arrow-left-right" });
        overflowActions.Add(new AkHeaderMenuItem
        {
            Label = T("ثبت کسری مستقل (بدون تخلیه)", "Record standalone shortage (without unloading)"),
            Href = Url.Action("Create", "LossEvents", new { transportLegId = Model.Id, returnUrl = currentPageReturnUrl }),
            Icon = "bi-exclamation-diamond"
        });
    }
    if (Model.Status != InventoryTransportLegStatus.Cancelled && Model.CompatibilityDispatchId.HasValue)
    {
        overflowActions.Add(new AkHeaderMenuItem
        {
            Label = T("لغو / برگشت", "Cancel / reverse"), PostUrl = Url.Action("Cancel", "Dispatch", new { id = Model.CompatibilityDispatchId.Value, returnUrl = currentPageReturnUrl }),
            Icon = "bi-arrow-counterclockwise", IsDestructive = true,
            ConfirmTitle = T("لغو این مرحلهٔ حمل", "Cancel this transport step"),
            ConfirmMessage = T("اگر عملیات بعدی ثبت شده باشد، لغو مسدود می‌شود. این مرحله را لغو می‌کنید؟", "Cancellation is blocked when downstream activity exists. Cancel this step?")
        });
    }
    // لغو سند حمل بسته‌ای: موجودی مبدأ برمی‌گردد و سند و همهٔ مرحله‌هایش لغو می‌شوند.
    if (Model.CanCancelDocument && Model.InventoryTransportBatchId.HasValue)
    {
        overflowActions.Add(new AkHeaderMenuItem
        {
            Label = T("لغو سند حمل", "Cancel transport document"),
            PostUrl = Url.Action("CancelBatch", new { id = Model.InventoryTransportBatchId.Value, returnUrl = currentPageReturnUrl }),
            Icon = "bi-arrow-counterclockwise", IsDestructive = true,
            ConfirmTitle = T("لغو این سند حمل", "Cancel this transport document"),
            ConfirmMessage = T(
                "موجودی کسرشدهٔ مبدأ برگشت داده می‌شود و همهٔ مرحله‌های این سند لغو می‌شوند. ادامه می‌دهید؟",
                "Source inventory will be restored and every leg of this document will be cancelled. Continue?")
        });
    }
    // «ویرایش» در نوار اقدامات سریع دیده می‌شود، پس در kebab تکرار نمی‌شود.
    ViewData["AkHeaderOverflowActions"] = overflowActions;

    var cardsModel = new AkDetailCardsModel
    {
        Code = documentNumber,
        CodeLabel = T("کد حمل", "Transport code"),
        Status = statusText,
        StatusState = statusState,
        StripItems = stripItems,
        PrimaryLabel = null,
        PrimaryHref = null,
        Cards = new List<AkDetailCard>
        {
            new()
            {
                Title = T("اطلاعات اصلی", "Main information"),
                Icon = "bi-info-circle",
                Rows = mainItems
            },
            new()
            {
                Title = T("مسیر و وضعیت", "Route & status"),
                Icon = "bi-map",
                RouteNodes = new List<AkInfoItem>
                {
                    new() { Label = T("مبدأ", "Source"), Value = sourceLabel },
                    new() { Label = T("مقصد", "Destination"), Value = destinationLabel }
                },
                Steps = routeSteps,
                Footer = new List<AkInfoItem>
                {
                    new() { Label = T("تاریخ حرکت", "Departure date"), Value = Model.LoadedDate.ToDisplayDate(), IsNumeric = true },
                    new() { Label = T("رسیدن تخمینی", "Expected arrival"), Value = Model.ExpectedArrivalDate?.ToDisplayDate(), IsNumeric = true }
                },
                Text = Model.RouteDescription
            },
            new()
            {
                Title = T("مصارف عملیاتی", "Operational expenses"),
                Icon = "bi-cash-coin",
                Metrics = costMetrics
            },
            new()
            {
                Title = T("محموله و وزن", "Cargo & weight"),
                Icon = "bi-box-seam",
                Metrics = cargoMetrics
            },
            new()
            {
                Title = T("یادداشت", "Notes"),
                Icon = "bi-journal-text",
                Text = Model.Notes,
                IsWide = true
            }
        }
    };

    // زنجیرهٔ حمل هویت همین بار است: کدام وسیله‌ها آن را بردند و از کدام حملِ قبلی
    // Split یا Merge شده است. داخل «نمایش موارد بیشتر» تا می‌شود تا صفحه پیش‌فرض شلوغ
    // نباشد، ولی از صفحه حذف نمی‌شود؛ وگرنه باری که بین دو موتر شکسته، منبعِ خود را
    // در هیچ صفحه‌ای نشان نمی‌داد.
    Func<object, IHtmlContent>? transportChainSection = Model.Chain.Count == 0 ? null : @<section class="ak-form-section transport-chain-section" aria-labelledby="transport-chain-title">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((T("مسیر حمل", "Transport timeline"), (string?)T("وسیله‌ها، Split و Merge این بار", "Vehicles, splits and merges for this load")))" />
            <div class="transport-chain-timeline" id="transport-chain-title">
                @foreach (var step in Model.Chain)
                {
                    var stepType = step.TransportType switch
                    {
                        LoadingTransportType.Truck => T("موتر", "Truck"),
                        LoadingTransportType.Wagon => T("واگن", "Wagon"),
                        LoadingTransportType.Vessel => T("کشتی", "Vessel"),
                        _ => T("وسیله", "Vehicle")
                    };
                    <article class="transport-chain-step @(step.IsCurrent ? "is-current" : null)">
                        @if (step.ParentLegIds.Count > 0)
                        {
                            <div class="transport-chain-parent">
                                <span>@(step.ParentLegIds.Count > 1 ? T("ادغام از", "Merged from") : T("ادامه از", "Continued from"))</span>
                                @foreach (var parentId in step.ParentLegIds)
                                {
                                    <a asp-action="Details" asp-route-id="@parentId">TR-@parentId.ToString("0000")</a>
                                }
                            </div>
                        }
                        <div class="transport-chain-node">
                            <span class="transport-chain-icon"><i class="bi @(step.TransportType == LoadingTransportType.Vessel ? "bi-life-preserver" : step.TransportType == LoadingTransportType.Wagon ? "bi-train-front" : "bi-truck-front")" aria-hidden="true"></i></span>
                            <div>
                                <strong>@stepType — @step.VehicleLabel</strong>
                                <span>TR-@step.Id.ToString("0000") · @step.LoadedDate.ToDisplayDate()</span>
                            </div>
                            <div class="transport-chain-quantity"><bdi>@Q(step.QuantityMt)</bdi> MT <small>@T("باقی", "remaining") <bdi>@Q(step.RemainingQuantityMt)</bdi></small></div>
                        </div>
                    </article>
                }
            </div>
        </section>;

    var moreModel = new AkDetailMoreModel
    {
        Activity = activityRows,
        ExtraSection = transportChainSection,
        Secondary = new AkDetailSecondaryModel
        {
            Timeline = timelineItems,
            TimelineTitle = T("آخرین فعالیت‌ها", "Latest activity"),
            TimelineLimit = 4
        }
        // نوار «اقدامات سریع» دیگر اینجا نیست: پای بخش «مسیر حمل» در انتهای صفحه
        // رندر می‌شود تا باز کردن disclosure برای رسیدن به عملیات بعدی لازم نباشد.
    };
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ptg-record-detail ptg-transport-detail" dir="rtl"
     data-transport-details data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = T("جزئیات حمل", "Transport details"),
           Eyebrow = transportTypeName,
           Icon = transportHeroIcon
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("جزئیات حمل", "Transport details"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailCards.cshtml" model="@cardsModel" />

    <partial name="~/Views/Shared/Partials/_DetailMore.cshtml" model="@moreModel" />

    @* «اقدامات سریع» بیرون از disclosure می‌ماند: عملیات بعدی نباید پشت یک toggle پنهان شود. *@
    <partial name="~/Views/Shared/Partials/_DetailActionBar.cshtml"
             model="@((IReadOnlyList<AkHeaderMenuItem>)nextActions)" />

    @if (canAddRelatedRecord)
    {
        <div class="modal fade" id="transportExpensesModal" tabindex="-1" aria-labelledby="transportExpensesModalLabel" aria-hidden="true"
             data-loading-expense-remote-modal data-loading-expense-url="@Url.Action("CreateGroupExpenseModal", "InventoryTransportLegs", new { legId = Model.Id, returnUrl = currentPageReturnUrl })">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content ak-modal-content">
                    <div class="ak-modal-head">
                        <h2 class="modal-title" id="transportExpensesModalLabel">@T("ثبت مصارف حمل", "Register transport expenses") — @documentNumber</h2>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                    </div>
                    <div class="ak-modal-body" data-loading-expense-remote-body>
                        <div class="ak-empty ak-detail-empty-state"><span>@T("فرم هنگام باز کردن بارگذاری می‌شود.", "The form loads when opened.")</span></div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (canSimpleFreightSettlement)
    {
        <div class="modal fade no-print" id="freightSettlementModal" tabindex="-1" aria-labelledby="freightSettlementModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content ak-modal-content">
                    <form asp-controller="Transports" asp-action="SettleFreight" method="post" data-loading-form>
                        @Html.AntiForgeryToken()
                        @* PTG-P3-B — این فرم مصرف واقعی می‌سازد؛ ارسال دوم نباید دو برابرش کند. *@
                        @Html.FormToken()
                        <input type="hidden" name="TransportLegId" value="@Model.Id" />
                        <div class="ak-modal-head">
                            <h2 class="modal-title" id="freightSettlementModalLabel">@T("تسویه کرایه", "Settle freight")</h2>
                            <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                        </div>
                        <div class="ak-modal-body">
                            <div class="ak-form-grid">
                                <div class="ak-field">
                                    <label class="form-label" for="freightSettlementDate">@T("تاریخ", "Date")</label>
                                    <input id="freightSettlementDate" class="ak-input" type="date" name="SettlementDate"
                                           value="@PTGOilSystem.Web.Services.Time.AfghanistanBusinessClock.SystemToday.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="ak-field">
                                    <label class="form-label" for="freightRate">@T("نرخ فی‌تن (USD)", "Rate per MT (USD)")</label>
                                    <input id="freightRate" class="ak-input ak-num" type="number" name="FreightRateUsdPerMt" min="0" step="0.0001" inputmode="decimal" />
                                </div>
                                <div class="ak-field">
                                    <label class="form-label" for="freightTotal">@T("مبلغ کل (USD)", "Total amount (USD)")</label>
                                    <input id="freightTotal" class="ak-input ak-num" type="number" name="FreightCostUsd" min="0" step="0.0001" inputmode="decimal" />
                                </div>
                                <div class="ak-field ak-field-full">
                                    <label class="form-label" for="freightNotes">@T("یادداشت", "Notes")</label>
                                    <textarea id="freightNotes" class="ak-input" name="Notes" rows="2" maxlength="500"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer ak-modal-actions">
                            <button type="button" class="btn btn-light ak-secondary-action" data-bs-dismiss="modal">@T("انصراف", "Cancel")</button>
                            <button type="submit" class="btn btn-primary" data-loading-text="@T("در حال ثبت...", "Saving...")">@T("ثبت تسویه", "Settle")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
