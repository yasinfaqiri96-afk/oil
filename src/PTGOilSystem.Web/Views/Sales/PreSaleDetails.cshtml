@model PTGOilSystem.Web.Models.Sales.PreSaleDetailsViewModel
@using PTGOilSystem.Web.Models.Sales
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    ViewData["Title"] = $"پیش‌فروش {Model.OrderNumber}";
    ViewData["HideSectionTabs"] = true;

    var backUrl = Url.Action("PreSales", "Sales") ?? "/Sales/PreSales";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var statusText = PreSaleOrderStatusLabels.ToPersian(Model.Status);
    // The hero pill uses the four canonical states of the detail header, so the
    // status reads the same here as on every other Operations detail page.
    var statusState = Model.Status switch
    {
        PreSaleOrderStatus.Cancelled => "is-danger",
        PreSaleOrderStatus.Closed => "is-inactive",
        PreSaleOrderStatus.FullyDelivered => "is-active",
        _ => "is-warning"
    };
    var isOpenOrder = Model.Status != PreSaleOrderStatus.Cancelled && Model.Status != PreSaleOrderStatus.Closed;
    var canRecordDelivery = Model.CanDeliver && Model.RemainingMt > 0m;
    var canAllocatePayment = Model.AllocatablePayments.Count > 0 && Model.UnallocatedOrderUsd > 0m;

    ViewData["AkHeaderStatus"] = statusText;
    ViewData["AkHeaderStatusState"] = statusState;

    // Kebab: state transitions and the destructive action only.
    var presaleKebab = new List<AkHeaderMenuItem>();
    if (Model.Status == PreSaleOrderStatus.FullyDelivered)
    {
        presaleKebab.Add(new AkHeaderMenuItem
        {
            Label = T("بستن پیش‌فروش", "Close pre-sale"),
            PostUrl = Url.Action("PreSaleClose", new { id = Model.Id }),
            Icon = "bi-check2-circle",
            ConfirmTitle = T("بستن پیش‌فروش", "Close pre-sale"),
            ConfirmMessage = T("این پیش‌فروش بسته شود؟", "Close this pre-sale?")
        });
    }
    if (Model.CanDeliver && Model.DeliveredMt <= 0m)
    {
        presaleKebab.Add(new AkHeaderMenuItem
        {
            Label = T("لغو پیش‌فروش", "Cancel pre-sale"),
            PostUrl = Url.Action("PreSaleCancel", new { id = Model.Id }),
            Icon = "bi-x-circle",
            IsDestructive = true,
            ConfirmTitle = T("لغو پیش‌فروش", "Cancel pre-sale"),
            ConfirmMessage = T("این پیش‌فروش لغو شود؟", "Cancel this pre-sale?")
        });
    }
    ViewData["AkHeaderKebab"] = presaleKebab;

    var kpis = new List<AkKpiItem>
    {
        new() { Title = T("مقدار کل", "Ordered"), Value = Model.QuantityMt.ToString("N4"), Unit = T("تن", "MT"), Avatar = "sold-quantity" },
        new() { Title = T("تحویل‌شده", "Delivered"), Value = Model.DeliveredMt.ToString("N4"), Unit = T("تن", "MT"), Avatar = "dispatch-station" },
        new() { Title = T("باقی‌مانده", "Remaining"), Value = Model.RemainingMt.ToString("N4"), Unit = T("تن", "MT"), Avatar = "warehouse", State = Model.RemainingMt > 0m ? "warning" : null },
        new() { Title = T("طلب باقی‌مانده", "Outstanding"), Value = Model.OutstandingUsd.ToString("N2"), Unit = "USD", Avatar = "receivables", State = Model.OutstandingUsd > 0m ? "warning" : null }
    };

    var identityItems = new List<AkInfoItem>
    {
        new() { Label = T("مشتری", "Customer"), Value = Model.CustomerName },
        new() { Label = T("کالا", "Product"), Value = Model.ProductName },
        new() { Label = T("تاریخ سفارش", "Order date"), Value = Model.OrderDate.ToDisplayDate(), IsNumeric = true },
        new() { Label = T("ارز", "Currency"), Value = Model.Currency },
        new() { Label = T("قیمت قفل‌شده هر تن", "Locked unit price"), Value = Model.UnitPriceInCurrency.ToString("N2"), Unit = Model.Currency, IsNumeric = true }
    };

    var overviewItems = new List<AkInfoItem>
    {
        new() { Label = T("مبلغ کل", "Total amount"), Value = Model.TotalInCurrency.ToString("N2"), Unit = Model.Currency, IsNumeric = true },
        new() { Label = T("ارزش تحویل‌شده", "Delivered value"), Value = Model.DeliveredValueUsd.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("پیش‌دریافت تخصیص‌یافته", "Advance allocated"), Value = Model.ReceivedUsd.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("پیش‌دریافت مصرف‌شده", "Advance consumed"), Value = Model.ConsumedAdvanceUsd.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("پیش‌دریافت باقی‌مانده", "Advance remaining"), Value = Model.RemainingAdvanceUsd.ToString("N2"), Unit = "USD", IsNumeric = true },
        new()
        {
            Label = T("تحویل تقریبی", "Expected delivery"),
            Value = Model.ExpectedDeliveryFrom.HasValue || Model.ExpectedDeliveryTo.HasValue
                ? $"{Model.ExpectedDeliveryFrom?.ToDisplayDate() ?? "—"} — {Model.ExpectedDeliveryTo?.ToDisplayDate() ?? "—"}"
                : null
        },
        new() { Label = T("یادداشت", "Notes"), Value = Model.Notes, IsWide = true }
    };

    var activityRows = new List<AkDetailActivityRow>
    {
        new()
        {
            Label = T("تحویل‌ها", "Deliveries"),
            Value = Model.Deliveries.Count > 0 ? Model.Deliveries.Count.ToString("N0") : null,
            Meta = Model.Deliveries.Count > 0 ? $"{Model.DeliveredMt:N4} {T("تن", "MT")}" : T("بدون تحویل", "No delivery"),
            Status = Model.RemainingMt > 0m ? T("باز", "Open") : T("تکمیل", "Complete"),
            StatusTone = Model.RemainingMt > 0m ? "warning" : "success",
            Href = "#presale-deliveries",
            Icon = "bi-truck"
        },
        new()
        {
            Label = T("پرداخت‌ها", "Payments"),
            Value = Model.Payments.Count > 0 ? Model.Payments.Count.ToString("N0") : null,
            Meta = Model.Payments.Count > 0 ? $"{Model.ReceivedUsd:N2} USD" : T("بدون تخصیص", "No allocation"),
            Status = Model.OutstandingUsd > 0m ? T("باز", "Open") : T("تسویه", "Settled"),
            StatusTone = Model.OutstandingUsd > 0m ? "warning" : "success",
            Href = "#presale-payments",
            Icon = "bi-cash-coin"
        }
    };

    // Next operations of this order; the first is the single CTA.
    var nextActions = new List<AkHeaderMenuItem>();
    if (canRecordDelivery)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("ثبت تحویل", "Record delivery"), Href = "#presale-delivery", Icon = "bi-truck" });
    }
    if (canAllocatePayment)
    {
        nextActions.Add(new AkHeaderMenuItem { Label = T("تخصیص دریافت", "Allocate receipt"), Href = "#presale-allocation", Icon = "bi-cash-coin" });
    }

    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = T("شماره سفارش", "Order number"), Value = Model.OrderNumber, IsNumeric = true },
        new() { Label = T("مانده مالی تخصیص‌نیافته", "Unallocated order value"), Value = Model.UnallocatedOrderUsd.ToString("N2"), Unit = "USD", IsNumeric = true }
    };
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail" dir="rtl" data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = $"{T("پیش‌فروش", "Pre-sale")} {Model.OrderNumber}",
           Eyebrow = T("پیش‌فروش", "Pre-sale"),
           Meta = $"{Model.CustomerName} · {Model.ProductName} · {Model.OrderDate.ToDisplayDate()}",
           Icon = "bi-calendar-check",
           Status = statusText,
           StatusState = statusState,
           Items = identityItems
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"{T("پیش‌فروش", "Pre-sale")} {Model.OrderNumber}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                        T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success">@TempData["ok"]</div>
    }
    @if (TempData["err"] != null)
    {
        <div class="alert alert-danger">@TempData["err"]</div>
    }
    @if (isOpenOrder)
    {
        @* موقتی: تا زمان پیاده‌سازی رزرو موجودی. *@
        <div class="alert alert-warning">
            این پیش‌فروش هنوز موجودی را رزرو نمی‌کند و مقدار آن از موجودی قابل فروش سایر عملیات کم نمی‌شود.
        </div>
    }

    <partial name="~/Views/Shared/Partials/_DetailOverview.cshtml"
             model="@(new AkDetailOverviewModel { AriaLabel = T("نمای اصلی پیش‌فروش", "Pre-sale overview"), Metrics = kpis, Facts = overviewItems })" />

    <partial name="~/Views/Shared/Partials/_DetailActivityList.cshtml" model="@((IReadOnlyList<AkDetailActivityRow>)activityRows)" />

    <partial name="~/Views/Shared/Partials/_DetailActionBar.cshtml" model="@((IReadOnlyList<AkHeaderMenuItem>)nextActions)" />

    <section class="ak-form-section ak-detail-section" id="presale-deliveries">
        <header class="ak-section-head ak-detail-section-header">
            <h2 class="ak-section-title">@T("تحویل‌ها", "Deliveries")</h2>
            <span class="ak-status">@Model.Deliveries.Count</span>
        </header>
        @if (Model.Deliveries.Count == 0)
        {
            <partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@T("هنوز تحویلی ثبت نشده است.", "No delivery recorded yet.")" />
        }
        else
        {
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th>@T("فاکتور", "Invoice")</th>
                            <th>@T("تاریخ", "Date")</th>
                            <th class="ak-col-num">@T("مقدار (تن)", "Quantity (MT)")</th>
                            <th class="ak-col-grow">@T("منبع", "Source")</th>
                            <th class="ak-col-num">@T("مبلغ", "Amount")</th>
                            <th class="ak-col-num">@T("معادل USD", "USD")</th>
                            <th>@T("وضعیت", "Status")</th>
                            <th class="ak-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Deliveries)
                        {
                            <tr>
                                <td class="ak-num">@d.InvoiceNumber</td>
                                <td>@d.DeliveryDate.ToDisplayDate()</td>
                                <td class="ak-col-num ak-num">@d.QuantityMt.ToString("N4")</td>
                                <td class="ak-col-grow">@d.SourceLabel</td>
                                <td class="ak-col-num ak-num">@d.TotalInCurrency.ToString("N2") @Model.Currency</td>
                                <td class="ak-col-num ak-num">@d.TotalUsd.ToString("N2")</td>
                                <td>
                                    <span class="ak-status @(d.IsCancelled ? "is-inactive" : "is-active")">
                                        @(d.IsCancelled ? T("لغوشده", "Cancelled") : d.StageLabel)
                                    </span>
                                </td>
                                <td class="ak-col-actions">
                                    <a class="ak-row-menu-btn" asp-action="Details" asp-route-id="@d.SalesTransactionId" asp-route-returnUrl="@currentReturnUrl"
                                       title="@T("سند فروش", "Sale document")" aria-label="@T("سند فروش", "Sale document")"><i class="bi bi-eye"></i></a>
                                    @if (!d.IsCancelled)
                                    {
                                        <form asp-action="PreSaleDeliveryCancel" asp-route-id="@Model.Id"
                                              asp-route-salesTransactionId="@d.SalesTransactionId" method="post" class="d-inline"
                                              data-no-spa="true" data-ptg-confirm="true"
                                              data-ptg-confirm-title="@T("لغو تحویل", "Cancel delivery")"
                                              data-ptg-confirm-message="@T("این تحویل لغو و اسناد معکوس (لجر و موجودی) ثبت می‌شود. ادامه می‌دهید؟", "This delivery is cancelled and the ledger and inventory documents are reversed. Continue?")">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ak-row-menu-btn text-danger"
                                                    title="@T("لغو تحویل", "Cancel delivery")" aria-label="@T("لغو تحویل", "Cancel delivery")"><i class="bi bi-x-octagon"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (canRecordDelivery)
        {
            <div class="ak-detail-subsection" id="presale-delivery">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((T("ثبت تحویل جدید", "Record a delivery"), (string?)null))" />
                <form asp-action="PreSaleDeliver" method="post" class="ak-form" data-presale-delivery-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PreSaleOrderId" value="@Model.Id" />
                    <input type="hidden" name="Kind" value="TerminalStock" data-presale-kind />
                    <input type="hidden" name="Id" value="0" data-presale-id />
                    <input type="hidden" name="TerminalId" value="0" data-presale-terminal />
                    <input type="hidden" name="StorageTankId" value="0" data-presale-tank />
                    <input type="hidden" name="SourcePurchaseContractId" value="0" data-presale-contract />

                    <div class="ak-form-grid">
                        <div class="ak-field">
                            <label class="ak-label">تاریخ تحویل <span class="ak-req">*</span></label>
                            <input type="date" name="DeliveryDate" class="ak-input" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">منبع محصول <span class="ak-req">*</span></label>
                            <select class="ak-input" data-presale-source>
                                <option value="">انتخاب منبع</option>
                                @foreach (var s in Model.Sources)
                                {
                                    <option value="@s.Key"
                                            data-kind="@s.Kind"
                                            data-id="@s.Id"
                                            data-terminal="@s.TerminalId"
                                            data-tank="@s.StorageTankId"
                                            data-contract="@s.SourcePurchaseContractId"
                                            data-available="@s.AvailableMt"
                                            data-full="@(s.IsFullVehicle ? "1" : "0")">
                                        @s.KindLabel — @s.Number — @s.ProductName — موجود @s.AvailableMt.ToString("N4") تن
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">مقدار این تحویل (تن)</label>
                            <input type="number" step="0.0001" name="QuantityMt" class="ak-input" data-presale-qty />
                            <div class="form-text">
                                مانده پیش‌فروش: <span class="ak-num">@Model.RemainingMt.ToString("N4")</span> تن —
                                مانده پس از تحویل: <span class="ak-num" data-presale-after>@Model.RemainingMt.ToString("N4")</span> تن
                            </div>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">توضیحات</label>
                            <input type="text" name="Notes" class="ak-input" />
                        </div>
                    </div>
                    <div class="ak-footer-actions">
                        <button type="submit" class="btn btn-primary ak-save">ثبت تحویل</button>
                    </div>
                </form>
            </div>
        }
    </section>

    <section class="ak-form-section ak-detail-section" id="presale-payments">
        <header class="ak-section-head ak-detail-section-header">
            <h2 class="ak-section-title">@T("پرداخت‌ها", "Payments")</h2>
            <span class="ak-status">@Model.Payments.Count</span>
        </header>
        @if (Model.Payments.Count == 0)
        {
            <partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@T("هیچ دریافتی به این پیش‌فروش تخصیص نیافته است.", "No receipt is allocated to this pre-sale.")" />
        }
        else
        {
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th>@T("تاریخ دریافت", "Payment date")</th>
                            <th>@T("تاریخ تخصیص", "Allocation date")</th>
                            <th class="ak-col-num">@T("مبلغ تخصیص", "Allocated amount")</th>
                            <th class="ak-col-num">@T("معادل USD", "USD")</th>
                            <th>@T("نوع", "Type")</th>
                            <th class="ak-col-grow">@T("مرجع", "Reference")</th>
                            <th class="ak-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@p.PaymentDate.ToDisplayDate()</td>
                                <td>@p.AllocationDate.ToDisplayDate()</td>
                                <td class="ak-col-num ak-num">@p.AllocatedAmount.ToString("N2") @p.Currency</td>
                                <td class="ak-col-num ak-num">@p.AllocatedAmountUsd.ToString("N2")</td>
                                <td>@(p.IsAdvance ? T("پیش‌دریافت", "Advance") : T("دریافت", "Receipt"))</td>
                                <td class="ak-col-grow">@p.Reference</td>
                                <td class="ak-col-actions">
                                    <form asp-action="PreSaleReverseAllocation" asp-route-id="@Model.Id"
                                          asp-route-allocationId="@p.AllocationId" method="post" class="d-inline"
                                          data-no-spa="true" data-ptg-confirm="true"
                                          data-ptg-confirm-title="@T("برگشت تخصیص", "Reverse allocation")"
                                          data-ptg-confirm-message="@T("این تخصیص برگشت بخورد و مانده دریافت آزاد شود؟", "Reverse this allocation and free the receipt balance?")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="ak-row-menu-btn"
                                                title="@T("برگشت تخصیص", "Reverse allocation")" aria-label="@T("برگشت تخصیص", "Reverse allocation")"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (canAllocatePayment)
        {
            <div class="ak-detail-subsection" id="presale-allocation">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((T("تخصیص دریافت مشتری", "Allocate a customer receipt"), (string?)null))" />
                <form asp-action="PreSaleAllocatePayment" asp-route-id="@Model.Id" method="post" class="ak-form"
                      data-presale-allocation-form>
                    @Html.AntiForgeryToken()
                    <div class="ak-form-grid">
                        <div class="ak-field">
                            <label class="ak-label">دریافت با مانده قابل تخصیص</label>
                            <select name="paymentTransactionId" class="ak-input" data-presale-payment>
                                @foreach (var p in Model.AllocatablePayments)
                                {
                                    <option value="@p.PaymentTransactionId" data-allocatable="@p.AllocatableAmount">
                                        @p.PaymentDate.ToString("yyyy-MM-dd") — مانده @p.AllocatableAmount.ToString("N2") از @p.Amount.ToString("N2") @p.Currency@(p.IsAdvance ? " (پیش‌دریافت)" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">مبلغ تخصیص</label>
                            <input type="number" step="0.01" name="amount" class="ak-input" data-presale-alloc-amount
                                   value="@Model.AllocatablePayments[0].AllocatableAmount.ToString("0.####")" />
                            <div class="form-text">
                                مانده مالی تخصیص‌نیافتهٔ این پیش‌فروش: <span class="ak-num">@Model.UnallocatedOrderUsd.ToString("N2")</span> USD
                            </div>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label">تاریخ تخصیص</label>
                            <input type="date" name="allocationDate" class="ak-input" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="ak-footer-actions">
                        <button type="submit" class="btn btn-primary ak-save">تخصیص به این پیش‌فروش</button>
                    </div>
                </form>
            </div>
        }
    </section>

    <partial name="~/Views/Shared/Partials/_DetailSecondary.cshtml"
             model="@(new AkDetailSecondaryModel { Technical = advancedItems })" />
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('[data-presale-delivery-form]');
            if (!form) { return; }
            var source = form.querySelector('[data-presale-source]');
            var qty = form.querySelector('[data-presale-qty]');
            var after = form.querySelector('[data-presale-after]');
            var remaining = @Model.RemainingMt.ToString(System.Globalization.CultureInfo.InvariantCulture);

            function apply() {
                var option = source.options[source.selectedIndex];
                var kind = option ? (option.getAttribute('data-kind') || 'TerminalStock') : 'TerminalStock';
                form.querySelector('[data-presale-kind]').value = kind;
                form.querySelector('[data-presale-id]').value = option ? (option.getAttribute('data-id') || 0) : 0;
                form.querySelector('[data-presale-terminal]').value = option ? (option.getAttribute('data-terminal') || 0) : 0;
                form.querySelector('[data-presale-tank]').value = option ? (option.getAttribute('data-tank') || 0) : 0;
                form.querySelector('[data-presale-contract]').value = option ? (option.getAttribute('data-contract') || 0) : 0;

                // حملِ کشتی (TransportLeg) مثل مخزن جزئی است: قفل/پرکردن خودکار نمی‌شود و
                // مقدار دستی کاربر با تغییر منبع بازنویسی نمی‌گردد. موتر و واگن کل‌وسیله می‌مانند.
                var isFull = option && option.getAttribute('data-full') === '1' && kind !== 'TransportLeg';
                if (isFull) {
                    qty.value = option.getAttribute('data-available') || '';
                    qty.readOnly = true;
                } else {
                    qty.readOnly = false;
                }
                preview();
            }

            function preview() {
                var value = parseFloat(qty.value || '0');
                if (isNaN(value)) { value = 0; }
                after.textContent = (remaining - value).toFixed(4);
            }

            source.addEventListener('change', apply);
            qty.addEventListener('input', preview);
        })();

        (function () {
            var form = document.querySelector('[data-presale-allocation-form]');
            if (!form) { return; }
            var payment = form.querySelector('[data-presale-payment]');
            var amount = form.querySelector('[data-presale-alloc-amount]');

            payment.addEventListener('change', function () {
                var option = payment.options[payment.selectedIndex];
                amount.value = option ? (option.getAttribute('data-allocatable') || '') : '';
            });
        })();
    </script>
}
