@*
    انتخاب نوع تحویلِ فروش. هر گزینه فقط فرمِ خودش را باز می‌کند: «تحویل کامل» همان
    فرمِ فاکتور فروش و «تحویل مرحله‌ای» همان فرمِ تعهدِ فروش با تحویل‌های چندباره.
    اینجا هیچ منطق مالی، موجودی یا محاسبه‌ای نیست؛ فقط مسیر کاربر.
    Model: (Mode, FullUrl, StagedUrl) — Mode = "full" | "staged".
*@
@model (string Mode, string FullUrl, string StagedUrl)
@{
    var isStaged = string.Equals(Model.Mode, "staged", StringComparison.OrdinalIgnoreCase);
    var modeGroupLabel = UiText.T(Context, "نوع تحویل", "Delivery type");
    // یک خط کوتاه، فقط برای گزینهٔ انتخاب‌شده.
    var modeHint = isStaged
        ? UiText.T(Context, "مقدار و قیمت کل یک‌بار ثبت می‌شود؛ هر تحویل بعداً جداگانه ثبت می‌شود.", "Total quantity and price are recorded once; each delivery is recorded later.")
        : UiText.T(Context, "کل مقدار همین حالا تحویل و یک فاکتور ثبت می‌شود.", "The full quantity is delivered now on a single invoice.");
}
<section class="ak-form-section" aria-label="@modeGroupLabel">
    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
             model="@((modeGroupLabel, (string?)modeHint))" />
    <div class="ak-choice-grid ak-choice-grid--2 ak-choice-grid--compact" role="group" aria-label="@modeGroupLabel">
        <a href="@Model.FullUrl"
           class="ak-choice @(isStaged ? null : "is-selected")"
           aria-current="@(isStaged ? null : "page")">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <span>@UiText.T(Context, "تحویل کامل", "Full delivery")</span>
        </a>
        <a href="@Model.StagedUrl"
           class="ak-choice @(isStaged ? "is-selected" : null)"
           aria-current="@(isStaged ? "page" : null)">
            <i class="bi bi-list-check" aria-hidden="true"></i>
            <span>@UiText.T(Context, "تحویل مرحله‌ای", "Staged delivery")</span>
        </a>
    </div>
</section>
