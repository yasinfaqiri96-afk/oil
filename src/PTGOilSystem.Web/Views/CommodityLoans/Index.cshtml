@model PTGOilSystem.Web.Models.CommodityLoans.CommodityLoanIndexViewModel
@using PTGOilSystem.Web.Models.CommodityLoans
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.StatCards
@{
    ViewData["Title"] = UiText.T(Context, "قرض تیل", "Commodity loans");
    var canManage = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User);
    var open = Model.Loans.Where(l => l.OutstandingMt > 0m).ToList();
    var tabs = new (CommodityLoanDirection? Value, string Label)[]
    {
        (null, UiText.T(Context, "همه", "All")),
        (CommodityLoanDirection.Lend, UiText.T(Context, "تیل قرض دادیم", "Lent")),
        (CommodityLoanDirection.Borrow, UiText.T(Context, "تیل قرض گرفتیم", "Borrowed"))
    };
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "قرض تیل", "Commodity loans"), true,
                       canManage ? UiText.T(Context, "قرض دادن تیل", "Lend") : (string?)null, "bi-box-arrow-up",
                       canManage ? (string?)Url.Action("Create", new { direction = CommodityLoanDirection.Lend }) : (string?)null, (string?)null,
                       canManage ? UiText.T(Context, "قرض گرفتن تیل", "Borrow") : (string?)null, "bi-box-arrow-in-down",
                       canManage ? (string?)Url.Action("Create", new { direction = CommodityLoanDirection.Borrow }) : (string?)null))" />

    <p class="ak-note">
        @UiText.T(Context,
            "تیلی که قرض دادیم از موجودی کم می‌شود و باید برگردد؛ تیلی که قرض گرفتیم به موجودی اضافه می‌شود و باید پس بدهیم.",
            "Company stock lent out, or stock borrowed with an in-kind return obligation. Separate from custody.")
    </p>

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "خلاصه قرض تیل", "Loan summary")">
        <vc:stat-card title="@UiText.T(Context, "باقی قرض داده‌شده", "Lent outstanding")"
                      value="@StatCardFormatter.Number(open.Where(l => l.Direction == CommodityLoanDirection.Lend).Sum(l => l.OutstandingMt), 2)"
                      unit="MT"
                      avatar="shipment-remaining"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "باقی قرض گرفته‌شده", "Borrowed outstanding")"
                      value="@StatCardFormatter.Number(open.Where(l => l.Direction == CommodityLoanDirection.Borrow).Sum(l => l.OutstandingMt), 2)"
                      unit="MT"
                      avatar="total-inventory"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "وقت برگشت گذشته", "Overdue")"
                      value="@StatCardFormatter.Count(open.Count(l => l.IsOverdue(Model.Today)))"
                      unit="@UiText.T(Context, "قرض", "loans")"
                      avatar="warning"></vc:stat-card>
    </section>

    <nav class="ptg-tabs-rail" role="tablist" aria-label="@UiText.T(Context, "نوع قرض", "Loan direction")">
        @foreach (var tab in tabs)
        {
            var isActive = Model.Direction == tab.Value;
            <a class="ptg-tab-item @(isActive ? "is-active" : null)" asp-action="Index" asp-route-direction="@tab.Value"
               aria-current="@(isActive ? "page" : null)"><span>@tab.Label</span></a>
        }
    </nav>

    <div class="ak-list">
        <div class="ak-list-toolbar">
            <div class="ak-list-toolbar-actions">
                <a class="btn btn-light ak-secondary-action" asp-action="Report">
                    <i class="bi bi-clipboard-data" aria-hidden="true"></i>
                    <span>@UiText.T(Context, "راپور باقی قرض تیل", "In-kind receivables & payables")</span>
                </a>
                @if (Model.IncludeCancelled)
                {
                    <a class="btn btn-light ak-secondary-action" asp-action="Index" asp-route-direction="@Model.Direction">@UiText.T(Context, "پنهان‌کردن لغوشده‌ها", "Hide cancelled")</a>
                }
                else
                {
                    <a class="btn btn-light ak-secondary-action" asp-action="Index" asp-route-direction="@Model.Direction" asp-route-cancelled="true">@UiText.T(Context, "نمایش لغوشده‌ها", "Show cancelled")</a>
                }
            </div>
        </div>
        <div class="ak-table-wrap">
            <table class="ak-table" aria-label="@UiText.T(Context, "قرض‌های تیل", "Commodity loans")">
                <thead><tr>
                    <th>@UiText.T(Context, "قرض", "Loan")</th>
                    <th class="ak-col-grow">@UiText.T(Context, "طرف / جنس", "Counterparty / product")</th>
                    <th class="ak-col-num">@UiText.T(Context, "مقدار (MT)", "Qty (MT)")</th>
                    <th class="ak-col-num">@UiText.T(Context, "باقی قرض (MT)", "Open (MT)")</th>
                    <th>@UiText.T(Context, "وقت برگشت", "Due")</th>
                </tr></thead>
                <tbody>
                    @foreach (var l in Model.Loans)
                    {
                        <tr class="@(l.Status == CommodityLoanStatus.Cancelled ? "text-muted" : null)">
                            <td>
                                <a asp-action="Details" asp-route-id="@l.Id"><strong>@l.LoanNumber</strong></a>
                                <div class="ak-cell-note">@CommodityLoanLabels.Direction(l.Direction)</div>
                            </td>
                            <td class="ak-col-grow">
                                @l.CounterpartyName
                                <div class="ak-cell-note">@l.ProductName@(string.IsNullOrWhiteSpace(l.QualitySpec) ? "" : " · " + l.QualitySpec)</div>
                            </td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(l.QuantityMt)</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(l.OutstandingMt)</td>
                            <td>
                                @l.DueDate.ToDisplayDate()
                                @if (l.Status == CommodityLoanStatus.Cancelled)
                                {
                                    <span class="ak-status is-inactive">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                }
                                else if (l.IsOverdue(Model.Today))
                                {
                                    <span class="ak-status is-danger">@UiText.T(Context, "وقت برگشت گذشته", "Overdue")</span>
                                }
                                else if (l.IsSettled)
                                {
                                    <span class="ak-status is-active">@UiText.T(Context, "قرض خلاص شده", "Settled")</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Loans.Any())
                    {
                        <tr><td colspan="5"><div class="ak-empty">@UiText.T(Context, "قرض تیل ثبت نشده است.", "No commodity loans.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
