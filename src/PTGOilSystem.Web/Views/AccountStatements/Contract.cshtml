@model PTGOilSystem.Web.Models.AccountStatements.ContractAccountStatementViewModel
@{
    ViewData["Title"] = $"دفتر حساب قرارداد {Model.ContractDisplayLabel}";
    ViewData["HideSectionTabs"] = true;
    ViewData["AkHeaderStatus"] = Model.ContractCurrency;
    ViewData["AkHeaderStatusState"] = "is-active";
    ViewData["AkHeaderContext"] = $"جنس: {Model.ProductName} · طرف حساب: {Model.CounterpartyName} · مقدار: {Model.QuantityMt:N4} تن";

    string Money(decimal? value, string? currency = null)
        => value.HasValue ? $"{value.Value:N2}{(string.IsNullOrWhiteSpace(currency) ? string.Empty : " " + currency)}" : "-";
    string Quantity(decimal? value) => value.HasValue ? $"{value.Value:N4}" : "-";
    string Rate(decimal? value) => value.HasValue ? value.Value.ToString("N6") : "-";
    string BadgeState(string? badge) => badge switch
    {
        "Operational only" => "",
        _ => "is-inactive"
    };
}

<div class="ak-form-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"دفتر حساب قرارداد {Model.ContractDisplayLabel}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       "بازگشت به قرارداد", "bi-arrow-right", Url.Action("Details", "ContractJourney", new { contractId = Model.ContractId })))" />

    <div class="ak-stat-grid" aria-label="خلاصه دفتر حساب">
        <vc:stat-card title="مجموع رسیدگی" value="@Model.Totals.TotalReceiptUsd.ToString("N2")" unit="USD" avatar="receipts"></vc:stat-card>
        <vc:stat-card title="مجموع بردگی" value="@Model.Totals.TotalOutflowUsd.ToString("N2")" unit="USD" avatar="payments-out"></vc:stat-card>
        <vc:stat-card title="بیلانس فعلی" value="@Model.Totals.BalanceUsd.ToString("N2")" unit="USD" avatar="ledger"></vc:stat-card>
    </div>

    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context, "بیلانس به تفکیک ارز اصلی", "Balance by source currency"), (string?)null))" />
        @if (Model.Totals.BalancesByCurrency.Any())
        {
            <dl class="ak-list ak-list--flush">
                @foreach (var balance in Model.Totals.BalancesByCurrency)
                {
                    <div class="ak-list-row"><dt>@balance.Currency</dt><dd class="ak-num">@balance.BalanceOriginal.ToString("N2")</dd></div>
                }
            </dl>
        }
        else
        {
            <div class="ak-empty"><i class="bi bi-cash-coin"></i> داده‌ای ثبت نشده است.</div>
        }
    </section>

    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("ردیف‌های دفتر حساب", (string?)null))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th class="ak-col-grow">جزئیات</th>
                        <th class="ak-col-num">مبلغ ارز اصلی</th>
                        <th class="ak-col-num">رسیدگی USD</th>
                        <th class="ak-col-num">بردگی USD</th>
                        <th class="ak-col-num">بیلانس USD</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="@(row.IsOperationalOnly ? "ak-row-muted" : string.Empty)">
                        <td>@row.Date.ToDisplayDate()</td>
                        <td class="ak-col-grow">
                            <div>@row.Description</div>
                            <div class="ak-cell-note">
                                @row.SourceType #@row.SourceId
                                @if (!string.IsNullOrWhiteSpace(row.Reference))
                                {
                                    <span> · مرجع: @row.Reference</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.RelatedContractNumber))
                                {
                                    <span> · قرارداد مرتبط: @row.RelatedContractNumber</span>
                                }
                            </div>
                            @if (row.QuantityMt.HasValue || row.UnitPrice.HasValue)
                            {
                                <div class="ak-cell-note">
                                    @if (row.QuantityMt.HasValue)
                                    {
                                        <span>مقدار: @Quantity(row.QuantityMt) تن</span>
                                    }
                                    @if (row.UnitPrice.HasValue)
                                    {
                                        <span> · قیمت واحد: @Money(row.UnitPrice, "USD")</span>
                                    }
                                </div>
                            }
                            @if (row.IsReversalRow)
                            {
                                <span class="ak-status is-inactive">@CompanyFlowText.Reversal(Context)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.WarningBadge))
                            {
                                <span class="ak-status @BadgeState(row.WarningBadge)">@row.WarningBadge</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.Notes)
                                && !string.Equals(row.Notes, "Posted in Ledger", StringComparison.Ordinal))
                            {
                                <div class="ak-cell-note">@row.Notes</div>
                            }
                        </td>
                        <td class="ak-col-num ak-num">
                            @if (row.ReceiptOriginal.HasValue)
                            {
                                <div>@Money(row.ReceiptOriginal, row.SourceCurrency)</div>
                                <div class="ak-cell-note">رسیدگی</div>
                            }
                            else if (row.OutflowOriginal.HasValue)
                            {
                                <div>@Money(row.OutflowOriginal, row.SourceCurrency)</div>
                                <div class="ak-cell-note">بردگی</div>
                            }
                            else
                            {
                                <span>-</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.SourceCurrency)
                                && !string.Equals(row.SourceCurrency, "USD", StringComparison.OrdinalIgnoreCase)
                                && row.FxRateToUsd.HasValue)
                            {
                                <div class="ak-cell-note">نرخ به USD: @Rate(row.FxRateToUsd)</div>
                            }
                        </td>
                        <td class="ak-col-num ak-num">@Money(row.ReceiptUsd, row.ReceiptUsd.HasValue ? "USD" : null)</td>
                        <td class="ak-col-num ak-num">@Money(row.OutflowUsd, row.OutflowUsd.HasValue ? "USD" : null)</td>
                        <td class="ak-col-num ak-num">@row.BalanceUsd.ToString("N2") USD</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="6"><div class="ak-empty"><i class="bi bi-journal-text"></i> داده‌ای ثبت نشده است.</div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
