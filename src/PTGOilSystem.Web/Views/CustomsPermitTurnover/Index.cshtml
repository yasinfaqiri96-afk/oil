@model PTGOilSystem.Web.Models.Customs.CustomsPermitTurnoverViewModel
@{
    ViewData["Title"] = UiText.T(Context, "گزارش جوازهای گمرکی", "Customs Permit Report");
    string T(string fa, string en) => UiText.T(Context, fa, en);

    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var selUsd = string.Equals(Model.SelectedCurrency, "USD", StringComparison.OrdinalIgnoreCase);
    string Amount(decimal value, string currency)
        => string.Equals(currency, "USD", StringComparison.OrdinalIgnoreCase) ? value.ToString("N2") : value.ToString("N0");

    var mahsooliTotal = selUsd ? Model.TotalMahsooliUsd : Model.TotalMahsooliAfn;
    var mahsooliEquivalent = selUsd ? Model.TotalMahsooliAfn : Model.TotalMahsooliUsd;
    var equivalentCurrency = selUsd ? "AFN" : "USD";
}

@*
    همان الگوی صفحات گزارش: سربرگ ← کارت‌ها ← فیلتر و خروجی ← جدول ← صفحه‌بندی.
    هر مبلغ به ارز انتخاب‌شده نمایش داده می‌شود و معادلش زیر همان عدد دیده می‌شود (بدون کلیک).
*@
<div class="ak-list-page" data-operations-list>
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("گزارش جوازهای گمرکی", "Customs Permit Report"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index", "Reports")))" />

    <section class="ak-stat-grid" aria-label="@T("آمار جوازهای گمرکی", "Customs permit metrics")">
        <vc:stat-card title="@T("تعداد موترها", "Vehicles")" value="@Model.VehicleCount.ToString("N0")" unit="@T("موتر", "vehicles")" avatar="transported"></vc:stat-card>
        <vc:stat-card title="@T("مجموع مقدار", "Total quantity")" value="@NumberDisplay.Quantity(Model.TotalQuantityMt)" unit="MT" avatar="total-inventory"></vc:stat-card>
        <vc:stat-card title="@T("محصولی (مالیه‌پذیر)", "Taxable duty")" value="@Amount(mahsooliTotal, Model.SelectedCurrency)" unit="@Model.SelectedCurrency" avatar="dispatch-station"></vc:stat-card>
        <vc:stat-card title="@T("کل گمرکی", "Total customs")" value="@Amount(Model.TotalCustomsDisplayAmount, Model.TotalCustomsDisplayCurrency)" unit="@Model.TotalCustomsDisplayCurrency" avatar="documents"></vc:stat-card>
    </section>

    @if (Model.TaxPercent > 0m)
    {
        <p class="ak-note">
            @string.Format(T("مالیهٔ تخمینی {0}% از محصولی: {1} AFN", "Estimated tax at {0}% of taxable duty: {1} AFN"),
                Model.TaxPercent.ToString("0.##"), Model.EstimatedTaxAfn.ToString("N0"))
        </p>
    }

    <div class="ak-list">
        @{
            var permitFilter = new AkSearchFilterModel("", null, T("فیلتر جوازهای گمرکی...", "Filter customs permits..."),
                new List<AkFilterDefinition>
                {
                    new("fromDate", T("بازه تاریخ", "Date range"), "daterange", null,
                        Model.FromDate?.ToString("yyyy-MM-dd"), "toDate", Model.ToDate?.ToString("yyyy-MM-dd")),
                    new("permitHolder", T("صاحب جواز", "Permit holder"), "text", null, Model.PermitHolderName),
                    new("permitNumber", T("نمبر جواز", "Permit number"), "text", null, Model.PermitNumber),
                    new("vehicle", T("نمبر موتر", "Vehicle number"), "text", null, Model.VehicleNumber),
                    new("accd", T("نمبر ACCD", "ACCD number"), "text", null, Model.AccdNumber),
                    new("type", T("نوع", "Type"), "text", null, Model.CustomsType),
                    new("goods", T("جنس", "Goods"), "text", null, Model.GoodsName),
                    new("route", T("مسیر", "Route"), "text", null, Model.Route),
                    new("taxPercent", T("فیصدی مالیه (%)", "Tax percent (%)"), "text", null,
                        Model.TaxPercent == 0m ? null : Model.TaxPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                    new("displayCurrency", T("ارز نمایش", "Display currency"), "select",
                        new List<AkFilterOption> { new("USD", "USD"), new("AFN", "AFN") },
                        string.IsNullOrEmpty(Context.Request.Query["displayCurrency"]) ? null : Context.Request.Query["displayCurrency"].ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="permitFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("Export"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th>@T("تاریخ", "Date")</th>
                        <th>@T("نمبر ACCD", "ACCD")</th>
                        <th>@T("موتر", "Vehicle")</th>
                        <th class="ak-col-grow">@T("جواز / صاحب جواز", "Permit / holder")</th>
                        <th>@T("نوع / جنس", "Type / goods")</th>
                        <th class="ak-col-num">@T("مقدار (MT)", "Quantity (MT)")</th>
                        <th class="ak-col-num">@T("محصولی (مالیه‌پذیر)", "Taxable duty")</th>
                        <th class="ak-col-num">@T("کل گمرکی", "Total customs")</th>
                        <th>@T("مسیر", "Route")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.DeclarationDate.ToDisplayDate()</td>
                            <td>
                                <a class="ak-name" asp-controller="CustomsDeclarations" asp-action="Details" asp-route-id="@row.Id" asp-route-returnUrl="@currentUrl">@(row.AccdNumber ?? "—")</a>
                                @if (!string.IsNullOrWhiteSpace(row.Notes))
                                {
                                    <div class="ak-cell-note">@row.Notes</div>
                                }
                            </td>
                            <td>@(row.VehicleNumber ?? "—")</td>
                            <td class="ak-col-grow">
                                @(row.PermitNumber ?? "—")
                                @if (!string.IsNullOrWhiteSpace(row.PermitHolderName))
                                {
                                    <div class="ak-cell-note">@row.PermitHolderName</div>
                                }
                            </td>
                            <td>
                                @(row.CustomsType ?? "—")
                                @if (!string.IsNullOrWhiteSpace(row.GoodsName))
                                {
                                    <div class="ak-cell-note">@row.GoodsName</div>
                                }
                            </td>
                            <td class="ak-col-num ak-num">@(row.QuantityMt.HasValue ? NumberDisplay.Quantity(row.QuantityMt.Value) : "—")</td>
                            <td class="ak-col-num ak-num">
                                @Amount(row.MahsooliDisplayAmount, row.MahsooliDisplayCurrency) <span class="ak-cell-note">@row.MahsooliDisplayCurrency</span>
                                <div class="ak-cell-note">@Amount(row.MahsooliEquivalentAmount, row.MahsooliEquivalentCurrency) @row.MahsooliEquivalentCurrency</div>
                            </td>
                            <td class="ak-col-num ak-num">
                                @Amount(row.TotalCustomsDisplayAmount, row.TotalCustomsDisplayCurrency) <span class="ak-cell-note">@row.TotalCustomsDisplayCurrency</span>
                                <div class="ak-cell-note">@Amount(row.TotalCustomsEquivalentAmount, row.TotalCustomsEquivalentCurrency) @row.TotalCustomsEquivalentCurrency</div>
                            </td>
                            <td>@(row.Route ?? "—")</td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="9"><div class="ak-empty"><i class="bi bi-clipboard-data"></i> @T("جوازی پیدا نشد؛ بازهٔ تاریخ یا فیلترها را تغییر دهید.", "No permit found; change the date range or filters.")</div></td>
                        </tr>
                    }
                </tbody>
                @if (Model.Rows.Count > 0)
                {
                    <tfoot>
                        <tr class="ak-table-total">
                            <td colspan="5">@T("جمع کل نتایج فیلترشده", "Total of filtered results")</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(Model.TotalQuantityMt)</td>
                            <td class="ak-col-num ak-num">
                                @Amount(mahsooliTotal, Model.SelectedCurrency) <span class="ak-cell-note">@Model.SelectedCurrency</span>
                                <div class="ak-cell-note">@Amount(mahsooliEquivalent, equivalentCurrency) @equivalentCurrency</div>
                            </td>
                            <td class="ak-col-num ak-num">
                                @Amount(Model.TotalCustomsDisplayAmount, Model.TotalCustomsDisplayCurrency) <span class="ak-cell-note">@Model.TotalCustomsDisplayCurrency</span>
                                <div class="ak-cell-note">@Amount(Model.TotalCustomsEquivalentAmount, Model.TotalCustomsEquivalentCurrency) @Model.TotalCustomsEquivalentCurrency</div>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_OperationsListFooter", (Model.CurrentPage, Model.PageCount, Model.VehicleCount, 50))
        </div>
    </div>
</div>
