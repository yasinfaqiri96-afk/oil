@*
    Where the record stands — one line per aspect: what it is, how much of it
    there is, and its state.

    This block deliberately does NOT list events. The history below is the only
    place a reader finds individual receipts, customs entries or shortages, so
    the same fact is never told twice in two shapes. The figure and its meta
    share one cell for the same reason: "3" and "items" are one statement, not
    two columns.

    Model: IReadOnlyList<AkDetailActivityRow>
*@
@model IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkDetailActivityRow>
@{
    var rows = (Model ?? Array.Empty<PTGOilSystem.Web.Models.Shared.AkDetailActivityRow>())
        .Where(row => row.HasValue)
        .ToList();
}
@if (rows.Count > 0)
{
    <section class="ak-detail-activity" aria-labelledby="ak-detail-activity-title">
        <h2 id="ak-detail-activity-title">@UiText.T(Context, "وضعیت", "Status")</h2>
        <p class="ak-detail-zone-note">@UiText.T(Context, "این رکورد در چه مرحله‌ای است.", "Where this record stands.")</p>
        <div class="ak-detail-activity-list">
            @foreach (var row in rows)
            {
                <div class="ak-detail-activity-row">
                    <span class="ak-detail-activity-label">
                        @if (!string.IsNullOrWhiteSpace(row.Icon))
                        {
                            <i class="bi @row.Icon" aria-hidden="true"></i>
                        }
                        <strong>@row.Label</strong>
                    </span>
                    @* Empty cells are not rendered: the row is a flex line on a phone,
                       so a blank span would reserve a whole wrapped line for nothing. *@
                    @if (!string.IsNullOrWhiteSpace(row.Value) || !string.IsNullOrWhiteSpace(row.Meta))
                    {
                        <span class="ak-detail-activity-value@(string.IsNullOrWhiteSpace(row.Value) ? null : " ak-num")">
                            @if (!string.IsNullOrWhiteSpace(row.Value))
                            {
                                <bdi>@row.Value</bdi>
                                @if (!string.IsNullOrWhiteSpace(row.Unit))
                                {
                                    <small>@row.Unit</small>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(row.Meta))
                            {
                                <small class="ak-detail-activity-meta">@row.Meta</small>
                            }
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(row.Status))
                    {
                        <span class="ak-detail-activity-status @row.StatusClass">@row.Status</span>
                    }
                    @* A chevron, not a second "View" button: the history below already
                       links every event, so this only needs to read as "open", quietly. *@
                    @if (!string.IsNullOrWhiteSpace(row.Href))
                    {
                        <a class="ak-detail-activity-link" href="@row.Href"
                           aria-label="@string.Format(UiText.T(Context, "مشاهدهٔ {0}", "Open {0}"), row.Label)">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}
