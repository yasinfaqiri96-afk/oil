@*
    Shared secondary context for Operations detail pages.

    Timeline, related records and technical identifiers remain available, but
    stay outside the initial three-second scan. Empty groups are omitted. Print
    styles in 73-detail-system.css expose the body even while the disclosure is
    closed on screen.

    Model: (TimelineItems, RelatedRecords, TechnicalItems)
*@
@model (IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkTimelineItem> TimelineItems, IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkRelatedRecord> RelatedRecords, IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkInfoItem> TechnicalItems)
@{
    var timelineItems = Model.TimelineItems
        ?? Array.Empty<PTGOilSystem.Web.Models.Shared.AkTimelineItem>();
    var relatedRecords = Model.RelatedRecords
        ?? Array.Empty<PTGOilSystem.Web.Models.Shared.AkRelatedRecord>();
    var technicalItems = (Model.TechnicalItems
            ?? Array.Empty<PTGOilSystem.Web.Models.Shared.AkInfoItem>())
        .Where(item => item.HasValue)
        .ToList();
    var groupCount = (timelineItems.Count > 0 ? 1 : 0)
        + (relatedRecords.Count > 0 ? 1 : 0)
        + (technicalItems.Count > 0 ? 1 : 0);
}
@if (groupCount > 0)
{
    <details class="ak-operations-more">
        <summary class="ak-operations-more-summary">
            <span class="ak-operations-more-heading">
                <strong>@UiText.T(Context, "اطلاعات بیشتر", "More information")</strong>
                <small>@UiText.T(Context, "سوابق، رکوردهای مرتبط و جزئیات فنی", "History, related records and technical details")</small>
            </span>
            <span class="ak-operations-more-count" dir="ltr">@groupCount</span>
        </summary>

        <div class="ak-operations-more-body">
            @if (timelineItems.Count > 0)
            {
                <section class="ak-operations-more-group" aria-labelledby="operations-more-timeline-title">
                    <h2 class="ak-operations-more-title" id="operations-more-timeline-title">
                        @UiText.T(Context, "روند عملیات", "Operation timeline")
                    </h2>
                    <partial name="~/Views/Shared/Partials/_DetailTimeline.cshtml"
                             model="@((IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkTimelineItem>)timelineItems)" />
                </section>
            }

            @if (relatedRecords.Count > 0)
            {
                <section class="ak-operations-more-group" aria-labelledby="operations-more-related-title">
                    <h2 class="ak-operations-more-title" id="operations-more-related-title">
                        @UiText.T(Context, "رکوردهای مرتبط", "Related records")
                    </h2>
                    <partial name="~/Views/Shared/Partials/_RelatedRecords.cshtml"
                             model="@((IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkRelatedRecord>)relatedRecords)" />
                </section>
            }

            @if (technicalItems.Count > 0)
            {
                <section class="ak-operations-more-group" aria-labelledby="operations-more-technical-title">
                    <h2 class="ak-operations-more-title" id="operations-more-technical-title">
                        @UiText.T(Context, "جزئیات فنی", "Technical details")
                    </h2>
                    <partial name="~/Views/Shared/Partials/_DetailInfoGrid.cshtml"
                             model="@((IReadOnlyList<PTGOilSystem.Web.Models.Shared.AkInfoItem>)technicalItems)" />
                </section>
            }
        </div>
    </details>
}
