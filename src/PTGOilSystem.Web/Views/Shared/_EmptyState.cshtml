@model (string Title, string? Subtitle, string? IconClass)
@{
    @* چرتکه حالت خالی را یک خط خاکستری با آیکون درون‌خطی نشان می‌دهد. *@
    var iconClass = string.IsNullOrWhiteSpace(Model.IconClass) ? "bi-info-circle" : Model.IconClass;
}
<div class="ak-empty">
    <i class="bi @iconClass" aria-hidden="true"></i>
    <span class="ak-empty-copy">
        <span class="ak-empty-title">@Model.Title</span>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <span class="ak-empty-sub">@Model.Subtitle</span>
        }
    </span>
</div>
