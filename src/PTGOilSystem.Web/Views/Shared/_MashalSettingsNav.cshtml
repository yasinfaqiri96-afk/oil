@inject PTGOilSystem.Web.Security.ClientModuleProfile Modules
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var groups = new[] {
        (Label: "عمومی", Items: new[] { ("Auth", "ChangePassword", "حساب کاربری", "nav-user"), ("Companies", "Index", "کسب‌وکار", "nav-briefcase"), ("Users", "Index", "مدیریت کاربران", "nav-users") }),
        (Label: "مالی", Items: new[] { ("ChartOfAccounts", "Mapping", "حسابداری", "nav-chart"), ("FiscalYears", "Index", "سال مالی", "nav-calendar"), ("Currencies", "Index", "ارزها و نرخ تبدیل", "nav-dollar"), ("CashAccounts", "Index", "صندوق و بانک", "nav-finance") }),
        (Label: "سیستم", Items: new[] { ("SystemSettings", "Index", "تقویم و تنظیمات", "nav-settings"), ("Backups", "Index", "نسخه پشتیبان", "nav-cloud"), ("AuditLogs", "Index", "رویدادهای سیستم", "nav-clock") })
    };
}
<aside class="mashal-settings-nav" aria-label="تنظیمات">
    <label class="mashal-settings-search"><svg class="mashal-ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#nav-search"></use></svg><input type="search" placeholder="جستجو در تنظیمات…" aria-label="جستجو در تنظیمات" data-mashal-settings-search /></label>
    @foreach (var group in groups)
    {
        <div class="mashal-settings-group">
            <h2>@group.Label</h2>
            @foreach (var item in group.Items)
            {
                if (item.Item1 != "Auth" && !PTGOilSystem.Web.Security.RoleAccessRules.CanAccessController(User, item.Item1, Modules)) { continue; }
                var active = controller == item.Item1 && (action == item.Item2 || controller == "Companies");
                <a asp-controller="@item.Item1" asp-action="@item.Item2" aria-current="@(active ? "page" : null)" class="mashal-settings-link @(active ? "is-active" : null)"><svg class="mashal-ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#@item.Item4"></use></svg><span>@item.Item3</span></a>
            }
        </div>
    }
</aside>
