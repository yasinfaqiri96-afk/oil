@model PTGOilSystem.Web.Models.ExcelImport.ExcelImportComponentOptions
@* Collapsible وقتی روشن است که کامپوننت داخل یک فرم ثبت قرار می‌گیرد: فقط یک دکمهٔ سبز
   دیده می‌شود و پنل کامل با کلیک باز می‌شود. صفحات اختصاصی import همان حالت باز را دارند. *@
@if (Model.Collapsible)
{
    var modalId = $"{Model.InputId}Modal";
    var modalLabelId = $"{modalId}Label";
    <button type="button" class="btn btn-success excel-import-toggle__button"
            data-bs-toggle="modal" data-bs-target="#@modalId"
            aria-controls="@modalId">
            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
            <span>@Model.ToggleText</span>
    </button>
    <div class="modal fade ak-modal excel-import-modal" id="@modalId" tabindex="-1"
         aria-labelledby="@modalLabelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content ak-modal-content">
                <div class="ak-modal-head">
                    <div>
                        <h2 class="ak-modal-title" id="@modalLabelId">@Model.Title</h2>
                        <p class="ak-modal-subtitle">@Model.Description</p>
                    </div>
                    <button type="button" class="ak-modal-close" data-bs-dismiss="modal" aria-label="بستن">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-body ak-modal-body">
                    <partial name="~/Views/Shared/ExcelImport/_ExcelImportBody.cshtml" model="Model" />
                </div>
            </div>
        </div>
    </div>
}
else
{
    <partial name="~/Views/Shared/ExcelImport/_ExcelImportBody.cshtml" model="Model" />
}
