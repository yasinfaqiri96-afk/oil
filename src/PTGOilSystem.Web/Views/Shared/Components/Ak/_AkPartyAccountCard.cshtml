@*
    Counterparty account status card — summary tab of every .ak-party-page profile
    (supplier, customer, sarraf, partner, service provider, employee).

    The money figures are rendered by the shared stat cards of _DetailKpiStrip right
    above this card; what stays here is the plain-language direction sentence, the
    optional settled-share bar, the low-priority facts as small chips and the
    identity reference rows — account state and identity share one panel so the
    summary tab is a single card. Display only: every value arrives already
    formatted from the page and nothing here recalculates money.
*@
@model PTGOilSystem.Web.Models.Shared.AkPartyAccountCard
@{
    var visibleFacts = Model.Facts.Where(f => f.HasValue).ToList();
    var identityRows = Model.Identity.Where(item => item.HasValue).ToList();
    var meaningIcon = Model.MeaningTone switch
    {
        "danger" => "bi-arrow-up-left-circle",
        "success" => "bi-arrow-down-right-circle",
        _ => "bi-check-circle"
    };
}
<section class="ak-form-section ak-detail-section ak-party-account">
    <header class="ak-section-head ak-party-account-head">
        <h2 class="ak-section-title">@Model.Title</h2>
        @if (Model.ToggleOptions.Count > 0)
        {
            <div class="ak-party-switch" role="group" aria-label="@Model.ToggleLabel">
                @foreach (var option in Model.ToggleOptions)
                {
                    <a class="ak-party-switch-option @(option.IsActive ? "is-active" : null)"
                       href="@option.Href"
                       aria-current="@(option.IsActive ? "true" : null)">@option.Label</a>
                }
            </div>
        }
    </header>

    <div class="ak-party-account-body">
        <p class="ak-party-meaning @Model.MeaningToneClass">
            <i class="bi @meaningIcon" aria-hidden="true"></i>
            <span>@Model.Meaning</span>
        </p>

        @if (Model.SettledPercent.HasValue)
        {
            <div class="ak-party-settled">
                <progress class="ak-party-settled-bar"
                          value="@Model.SettledPercent.Value"
                          max="100"
                          aria-label="@Model.SettledCaption"></progress>
                @if (!string.IsNullOrWhiteSpace(Model.SettledCaption))
                {
                    <p class="ak-party-settled-caption">@Model.SettledCaption</p>
                }
            </div>
        }
    </div>

    @if (visibleFacts.Count > 0)
    {
        <dl class="ak-party-facts">
            @foreach (var fact in visibleFacts)
            {
                <div class="ak-party-fact">
                    <dt>@fact.Label</dt>
                    <dd class="@(fact.IsNumeric ? "is-num" : null)">
                        <bdi>@fact.Value</bdi>
                        @if (!string.IsNullOrWhiteSpace(fact.Unit))
                        {
                            <span class="ak-party-fact-unit">@fact.Unit</span>
                        }
                    </dd>
                </div>
            }
        </dl>
    }

    @if (identityRows.Count > 0)
    {
        <div class="ak-party-identity-block">
            <h3 class="ak-party-subhead">@Model.IdentityTitle</h3>
            <dl class="ak-list ak-list--flush ak-identity-list">
                @foreach (var item in identityRows)
                {
                    @* Identity is one strip; a value longer than its cell is clipped,
                       so the full text stays reachable through the native tooltip. *@
                    <div class="ak-list-row @(item.IsWide ? "is-wide" : null)">
                        <dt title="@item.Label">@item.Label</dt>
                        <dd class="@(item.IsNumeric ? "ak-num" : null)" title="@item.Value">@item.Value</dd>
                    </div>
                }
            </dl>
        </div>
    }
</section>
