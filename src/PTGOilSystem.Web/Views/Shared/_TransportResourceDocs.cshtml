@model TransportResourceProfileViewModel
@{
    // صفحه‌بندی سمت DB در TransportResourceProfileBuilder انجام شده؛ اینجا فقط صفحهٔ جاری می‌آید.
    const string PageKey = "docsPage";
    var totalCount = Model.DocumentTotalCount;
    var visibleDocuments = Model.Documents;
    var hasExpiry = visibleDocuments.Any(d => d.ExpiryDate.HasValue);
    bool CanOpen(TransportResourceDocumentItem item)
        => !string.IsNullOrWhiteSpace(item.Controller) && !string.IsNullOrWhiteSpace(item.Action) && item.RouteId.HasValue
           && PTGOilSystem.Web.Security.RoleAccessRules.CanAccessController(User, item.Controller);

    string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToDisplayDate() : "بدون تاریخ";
}

<div id="resource-docs">
    @await Html.PartialAsync("~/Views/Shared/Components/Ak/_AkSectionHead.cshtml", ("پرونده اسناد", (string?)$"{totalCount:N0} سند"))

    @if (visibleDocuments.Any())
    {
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>نوع سند</th>
                        <th>شماره</th>
                        <th class="ak-col-grow ak-col-priority-2">منبع</th>
                        @if (hasExpiry)
                        {
                            <th>انقضا</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in visibleDocuments)
                    {
                        <tr>
                            <td class="ak-num">@FormatDate(item.Date)</td>
                            <td>@item.Type</td>
                            <td>
                                @if (CanOpen(item))
                                {
                                    <a asp-controller="@item.Controller" asp-action="@item.Action" asp-route-id="@item.RouteId"><bdi>@item.Number</bdi></a>
                                }
                                else
                                {
                                    <bdi>@item.Number</bdi>
                                }
                            </td>
                            <td class="ak-col-grow ak-col-priority-2">@item.Source</td>
                            @if (hasExpiry)
                            {
                                <td class="ak-num">
                                    @if (item.ExpiryDate.HasValue)
                                    {
                                        <span class="ak-status @(item.IsExpired ? "is-danger" : "is-active")">@item.ExpiryDate.Value.ToDisplayDate()</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Partials/_DetailPager.cshtml" model="@((Model.DocumentPage, Model.DocumentPageCount, PageKey, (string?)"resource-docs"))" />
    }
    else
    {
        <div class="ak-empty">برای این مورد هنوز سند مرجع، رسید یا بارنامه ثبت نشده است.</div>
    }
</div>
