@model PTGOilSystem.Web.Services.Exports.ExportMenuModel
@using Microsoft.AspNetCore.Routing
@using PTGOilSystem.Web.Helpers
@{
    // فیلترِ چندانتخابی همان نام پارامتر را تکرار می‌کند (key=1&key=2). نشانی خروجی
    // دستی ساخته می‌شود تا تکرارها حفظ شوند؛ RouteValueDictionary آن‌ها را با کاما
    // در یک مقدار ادغام می‌کرد و خروجی با فهرست فرق می‌کرد.
    var overrides = Model.RouteValues is null
        ? new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase)
        : Model.RouteValues.ToDictionary(item => item.Key, item => (object?)item.Value, StringComparer.OrdinalIgnoreCase);

    var exportQuery = new List<string>();
    foreach (var item in Context.Request.Query)
    {
        if (string.Equals(item.Key, "page", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Key, "format", StringComparison.OrdinalIgnoreCase)
            || overrides.ContainsKey(item.Key))
        {
            continue;
        }

        foreach (var value in item.Value)
        {
            exportQuery.Add($"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
        }
    }

    foreach (var item in overrides)
    {
        var text = item.Value?.ToString();
        if (string.IsNullOrEmpty(text)) continue;
        exportQuery.Add($"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(text)}");
    }

    string ExportUrl(string format)
    {
        var parts = new List<string>(exportQuery) { $"format={format}" };
        return $"{Url.Action(Model.Action, Model.Controller)}?{string.Join("&", parts)}";
    }

    var excelUrl = ExportUrl("excel");
    var pdfUrl = ExportUrl("pdf");
}

<div class="dropdown ak-export-menu" data-export-menu>
    <button type="button"
            class="btn btn-light ak-secondary-action dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="@UiText.T(Context, "دریافت خروجی", "Export")">
        <i class="bi bi-download" aria-hidden="true"></i>
        <span>@UiText.T(Context, "خروجی", "Export")</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <a class="dropdown-item" href="@excelUrl" data-export-link>
                <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                <span>@UiText.T(Context, "خروجی Excel", "Excel export")</span>
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="@pdfUrl" data-export-link>
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                <span>@UiText.T(Context, "خروجی PDF", "PDF export")</span>
            </a>
        </li>
    </ul>
</div>

