@model PTGOilSystem.Web.Models.Inventory.InventoryIndexViewModel
@using PTGOilSystem.Web.Models.Entities
@{
    ViewData["Title"] = UiText.T(Context,"موجودی","Inventory");
    string T(string fa, string en) => UiText.T(Context, fa, en);
    var movements = Model.Items.ToList();
    var canManage = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User);

    (string Text, string Tone) DirectionBadge(MovementDirection direction) => direction switch
    {
        MovementDirection.In => (T("ورود", "In"), "is-active"),
        MovementDirection.Out => (T("خروج", "Out"), "is-inactive"),
        MovementDirection.Transfer => (T("انتقال", "Transfer"), "is-pending"),
        _ => (T("اصلاح موجودی", "Adjustment"), "is-pending")
    };
}

@* الگوی مشترک فهرست: سربرگ ← لیست (جست‌وجو و میان‌بُرها در یک نوار) ← جدول ← صفحه‌بندی. *@
<div class="ak-form-page ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("حرکت‌های موجودی", "Inventory Movements"), true,
                       canManage ? T("ثبت سند موجودی", "New Movement") : (string?)null, "bi-plus-lg",
                       canManage ? (string?)Url.Action("Create") : (string?)null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <p class="ak-note">@T("گردش تیل ملکی شرکت. تیل دیگران در تب «امانی» ثبت می‌شود.", "Movements of company-owned stock. Others' stock is recorded under Custody.")</p>

    <div class="ak-list">
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml"
                     model="@AkSearchFilterModel.SearchOnly(
                         "q",
                         Model.Query,
                         T("جنس، ترمینال، قرارداد یا شماره سند...", "Product, terminal, contract or reference..."))" />
            <div class="ak-list-toolbar-actions">
                <a class="btn btn-light ak-secondary-action" asp-action="StockSummary">
                    <i class="bi bi-bar-chart" aria-hidden="true"></i>
                    <span>@T("خلاصه موجودی", "Stock summary")</span>
                </a>
                <a class="btn btn-light ak-secondary-action" asp-action="StockCard">
                    <i class="bi bi-card-list" aria-hidden="true"></i>
                    <span>@T("کارت موجودی", "Stock card")</span>
                </a>
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th>@T("تاریخ", "Date")</th>
                        <th>@T("نوع حرکت", "Movement Type")</th>
                        <th>@T("جنس", "Product")</th>
                        <th>@T("ترمینال / مخزن", "Terminal / tank")</th>
                        <th>@T("قرارداد منبع", "Source Contract")</th>
                        <th class="ak-col-num">@T("مقدار (MT)", "Qty (MT)")</th>
                        <th class="ak-col-grow">@T("شماره سند / یادداشت", "Reference / note")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in movements)
                    {
                        var badge = DirectionBadge(item.Direction);
                        <tr>
                            <td>@item.MovementDate.ToDisplayDate()</td>
                            <td><span class="ak-status @badge.Tone">@badge.Text</span></td>
                            <td>@item.ProductName</td>
                            <td>
                                @item.TerminalName
                                @if (!string.IsNullOrWhiteSpace(item.StorageTankCode))
                                {
                                    <div class="ak-cell-note">@item.StorageTankCode</div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.ContractDisplayLabel) ? "—" : item.ContractDisplayLabel)</td>
                            <td class="ak-col-num ak-num fw-semibold">@NumberDisplay.Quantity(item.QuantityMt)</td>
                            @* برچسب کوتاه؛ مرجع کامل و یادداشت در tooltip همین سلول. *@
                            <td class="ak-col-grow" title="@string.Join(Environment.NewLine, new[] { item.ReferenceDocument, item.Notes }.Where(v => !string.IsNullOrWhiteSpace(v)))">
                                @MovementReferenceDisplay.Short(item.ReferenceDocument, T)
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <i class="bi bi-info-circle text-muted" aria-hidden="true"></i>
                                }
                            </td>
                        </tr>
                    }
                    @if (!movements.Any())
                    {
                        <tr>
                            <td colspan="7">
                                @await Html.PartialAsync("_EmptyState", (T("هنوز هیچ حرکت موجودی ثبت نشده است","No inventory movements recorded yet"), T("پس از ثبت سند موجودی معلومات این بخش کامل می‌شود.","After recording a movement, this section will be populated."), "bi-boxes"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>
