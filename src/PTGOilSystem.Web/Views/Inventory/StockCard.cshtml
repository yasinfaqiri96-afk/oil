@model PTGOilSystem.Web.Models.Inventory.InventoryStockCardViewModel
@using PTGOilSystem.Web.Models.Entities
@{
    ViewData["Title"] = UiText.T(Context, "کارت موجودی", "Stock card");
    string T(string fa, string en) => UiText.T(Context, fa, en);

    (string Text, string Tone) DirectionBadge(MovementDirection direction) => direction switch
    {
        MovementDirection.In => (T("ورود", "In"), "is-active"),
        MovementDirection.Out => (T("خروج", "Out"), "is-inactive"),
        MovementDirection.Transfer => (T("انتقال", "Transfer"), "is-pending"),
        _ => (T("اصلاح موجودی", "Adjustment"), "is-pending")
    };
}

@* هر حرکت با اثرش (+/−) و باقی موجودی پس از آن، برای همان محدودهٔ فیلتر. *@
<div class="ak-form-page ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("کارت موجودی", "Stock card"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("حرکت‌های موجودی", "Inventory movements"), "bi-arrow-right", Url.Action("Index")))" />

    @* خطای بازهٔ تاریخ نامعتبر از کنترلر می‌آید و باید بالای نوار فیلتر دیده شود. *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0"></div>

    <div class="ak-list">
        @{
            List<AkFilterOption> StockCardOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var stockCardFilter = new AkSearchFilterModel("", null,
                T("فیلتر کارت موجودی...", "Filter stock card..."),
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", T("بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("Filter.ProductId", T("جنس", "Product"), "select", StockCardOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("Filter.ContractId", T("قرارداد منبع موجودی", "Stock source contract"), "select", StockCardOpts(ViewBag.Contracts),
                        Model.Filter.ContractId?.ToString()),
                    new("Filter.TerminalId", T("ترمینال", "Terminal"), "select", StockCardOpts(ViewBag.Terminals),
                        Model.Filter.TerminalId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="stockCardFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("StockCardExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th>@T("تاریخ", "Date")</th>
                        <th>@T("نوع حرکت", "Movement Type")</th>
                        <th>@T("جنس", "Product")</th>
                        <th>@T("ترمینال / مخزن", "Terminal / tank")</th>
                        <th>@T("قرارداد منبع", "Source contract")</th>
                        <th class="ak-col-num">@T("اثر روی موجودی (MT)", "Effect (MT)")</th>
                        <th class="ak-col-num">@T("باقی موجودی (MT)", "Balance (MT)")</th>
                        <th class="ak-col-grow">@T("شماره سند / یادداشت", "Reference / note")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var badge = DirectionBadge(row.Direction);
                        <tr>
                            <td>@row.MovementDate.ToDisplayDate()</td>
                            <td><span class="ak-status @badge.Tone">@badge.Text</span></td>
                            <td>@row.ProductName</td>
                            <td>
                                @row.TerminalName
                                @if (!string.IsNullOrWhiteSpace(row.StorageTankCode))
                                {
                                    <div class="ak-cell-note">@row.StorageTankCode</div>
                                }
                            </td>
                            <td>@(row.ContractNumber ?? "—")</td>
                            <td class="ak-col-num ak-num @(row.SignedQuantityMt < 0 ? "ak-number--negative" : "ak-number--positive")">@NumberDisplay.Quantity(row.SignedQuantityMt)</td>
                            <td class="ak-col-num ak-num fw-semibold">@NumberDisplay.Quantity(row.RunningBalanceMt)</td>
                            @* برچسب کوتاه؛ مرجع کامل و یادداشت در tooltip همین سلول. *@
                            <td class="ak-col-grow" title="@string.Join(Environment.NewLine, new[] { row.ReferenceDocument, row.Notes }.Where(v => !string.IsNullOrWhiteSpace(v)))">
                                @MovementReferenceDisplay.Short(row.ReferenceDocument, T)
                                @if (!string.IsNullOrWhiteSpace(row.Notes))
                                {
                                    <i class="bi bi-info-circle text-muted" aria-hidden="true"></i>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="8">
                                @await Html.PartialAsync("_EmptyState", (T("حرکتی برای فیلتر انتخابی یافت نشد", "No movement for the selected filter"), T("بازه یا محدوده فیلتر را تغییر دهید و دوباره تلاش کنید.", "Change the range or filter and try again."), "bi-funnel"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>
