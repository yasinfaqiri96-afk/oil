@model PTGOilSystem.Web.Models.Inventory.InventoryStockSummaryIndexViewModel
@{
    ViewData["Title"] = UiText.T(Context, "خلاصه موجودی", "Stock summary");
    string T(string fa, string en) => UiText.T(Context, fa, en);
    var canManage = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User);
}

@* موجودی ملکی هر جنس در هر ترمینال، از همان StockService؛ برگشت به «حرکت‌های موجودی». *@
<div class="ak-form-page ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("خلاصه موجودی ملکی", "Owned stock summary"), canManage,
                       canManage ? T("ثبت حرکت جدید", "New movement") : (string?)null, "bi-plus-lg",
                       canManage ? (string?)Url.Action("Create") : (string?)null, (string?)null,
                       T("حرکت‌های موجودی", "Inventory movements"), "bi-arrow-right", Url.Action("Index")))" />

    <div class="ak-list">
        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@T("جنس", "Product")</th>
                        <th>@T("ترمینال", "Terminal")</th>
                        <th>@T("قرارداد خرید منبع", "Source purchase contract")</th>
                        <th class="ak-col-num">@T("موجودی ملکی (MT)", "Owned stock (MT)")</th>
                        <th class="ak-col-num">@T("تعداد حرکت", "Movements")</th>
                        <th>@T("آخرین حرکت", "Last movement")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ak-col-grow">
                                @row.ProductName
                                <div class="ak-cell-note">@row.ProductCode</div>
                            </td>
                            <td>@row.TerminalName</td>
                            <td>@(row.ContractNumber ?? "—")</td>
                            <td class="ak-col-num ak-num fw-semibold">@NumberDisplay.Quantity(row.FreeQuantityMt)</td>
                            <td class="ak-col-num ak-num">@row.MovementCount.ToString("N0")</td>
                            <td>@row.LastMovementDate.ToDisplayDate()</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="6">
                                @await Html.PartialAsync("_EmptyState", (T("برای این بخش هنوز حرکتی ثبت نشده است", "No movement recorded yet"), T("پس از ثبت اسناد موجودی، خلاصه موجودی در این صفحه نمایش داده می‌شود.", "After recording movements, the stock summary appears here."), "bi-bar-chart"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>
