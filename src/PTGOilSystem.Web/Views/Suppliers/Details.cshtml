@model PTGOilSystem.Web.Models.Suppliers.SupplierProfileViewModel
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] = "پروفایل تأمین‌کننده";
    ViewData["HideSectionTabs"] = true;
    var notRecorded = "ثبت نشده";
    var supplierReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var officialSummary = ViewData["PartyStatementSummary"] as PTGOilSystem.Web.Models.PartyStatements.PartyStatementSummary;
    var endingUsd = officialSummary?.ClosingBalance ?? Model.SupplierRemainingClaimUsd;
    // معادل روبلی مانده — همیشه از مدل (اگر داده روبل موجود باشد) تا کنار USD نمایش داده شود.
    var endingRub = Model.SupplierRemainingClaimRub;
    var isRubView = Model.IsRubDisplay;

    // سوییچ ارز نمایش: بقیهٔ پارامترهای صفحه (tab، contractId، …) حفظ می‌شوند.
    string CurrencyHref(string code)
    {
        var queryParts = new List<string>();
        foreach (var pair in Context.Request.Query)
        {
            if (string.Equals(pair.Key, "currency", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            foreach (var value in pair.Value)
            {
                queryParts.Add($"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
            }
        }

        queryParts.Add($"currency={Uri.EscapeDataString(code)}");
        return $"{Context.Request.Path}?{string.Join("&", queryParts)}";
    }

    // مبلغ روبلی: نبودِ منبع روبلی «ثبت نشده» است، نه صفر. رقمی که از نرخ قرارداد ساخته
    // شده «تخمینی» علامت می‌خورد تا با رقم واقعیِ بارگیری اشتباه نشود.
    string RubText(decimal? value, bool isEstimated)
        => value.HasValue
            ? NumberDisplay.Money(value.Value, "RUB") + (isEstimated ? " (تخمینی)" : string.Empty)
            : notRecorded;

    var endingRubAbs = endingRub.HasValue ? Math.Abs(endingRub.Value) : (decimal?)null;
    var balanceLabel = officialSummary?.ClosingBalanceMeaningFor(UiText.IsEn(Context))
        ?? (endingUsd > 0 ? "قابل پرداخت به تأمین‌کننده" : endingUsd < 0 ? "پیش‌پرداخت / طلب ما از تأمین‌کننده" : "حساب تسویه است");
    // رنگ باید از همان علامتی بیاید که متن معنی از آن ساخته شده: صورت‌حساب رسمی مثبت را
    // «طلبکار» می‌داند (سبز). فقط وقتی صورت‌حساب نیست، علامتِ مدل خودِ صفحه (مثبت = قابل
    // پرداخت به تأمین‌کننده = سرخ) به کار می‌رود.
    var balanceTone = officialSummary is not null
        ? officialSummary.ClosingBalanceTone
        : endingUsd > 0 ? "danger" : endingUsd < 0 ? "success" : null;

    // سه تب: خلاصه (پیش‌فرض) · قراردادها (شامل پرداخت‌ها) · صورت‌حساب.
    var activeTab = Model.ActiveTab;
    var showContracts = activeTab is "contracts" or "payments" or "sarraf";
    var showStatement = activeTab == "statement";
    var showOverview = !showContracts && !showStatement;

    var newPaymentUrl = Url.Action("Create", "Payments", new { supplierId = Model.SupplierId, returnUrl = supplierReturnUrl }) ?? "#";
    var editUrl = Url.Action("Edit", new { id = Model.SupplierId }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";
    ViewData["AkHeaderStatus"] = Model.IsActive ? "فعال" : "غیرفعال";
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = $"کد: {(string.IsNullOrWhiteSpace(Model.Code) ? notRecorded : Model.Code)} · {balanceLabel}";
    // «ثبت پرداخت» از دکمهٔ اصلی هدر برداشته شد تا جای سوییچ ارز باز شود؛ خود اقدام
    // حذف نشده و در منوی سه‌نقطه می‌ماند.
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = "ثبت پرداخت", Href = newPaymentUrl, Icon = "bi-cash-coin" },
        new() { Label = "صورت‌حساب رسمی", Href = Url.Action("Supplier", "PartyStatements", new { id = Model.SupplierId, CurrencyCode = Model.IsRubDisplay ? "RUB" : null }), Icon = "bi-file-earmark-text" },
        new() { Label = "ویرایش", Href = editUrl, Icon = "bi-pencil" }
    };

    // سوییچ ارز نمایش (USD/RUB) در هدر، کنار «فهرست تأمین‌کننده‌ها» — همان لینک‌های قبلیِ
    // کارت وضعیت حساب؛ فقط جایش عوض شده و هیچ مبلغی دوباره محاسبه نمی‌شود.
    var displayCurrencyOptions = new List<AkPartyToggleOption>
    {
        new() { Label = "USD", Href = CurrencyHref("USD"), IsActive = !isRubView },
        new() { Label = "RUB", Href = CurrencyHref("RUB"), IsActive = isRubView }
    };
    ViewData["AkHeaderToggle"] = displayCurrencyOptions;
    ViewData["AkHeaderToggleLabel"] = "ارز نمایش";

    var supplierTabs = new[]
    {
        $"overview|خلاصه|bi-clipboard-data|{(showOverview ? "active" : "")}",
        $"contracts|قراردادها|bi-file-earmark-text|{(showContracts ? "active" : "")}",
        $"statement|صورت‌حساب|bi-journal-text|{(showStatement ? "active" : "")}"
    };

    // کارت‌های آماری تب خلاصه — فقط ارزِ انتخاب‌شده در سوییچ بالای کارت حساب:
    // USD یعنی فقط دالر، RUB یعنی فقط روبل. هیچ مبلغی دوباره محاسبه نمی‌شود.
    (string Value, string? Unit) SupplierKpi(decimal? rub, bool rubIsEstimated, decimal usd)
    {
        if (!isRubView)
        {
            return (NumberDisplay.Money(usd), "USD");
        }

        if (!rub.HasValue)
        {
            return (notRecorded, "RUB");
        }

        return (NumberDisplay.Money(rub.Value), rubIsEstimated ? "RUB (تخمینی)" : "RUB");
    }

    var supplierBalanceKpi = SupplierKpi(endingRubAbs, Model.SupplierRemainingClaimRubIsEstimated, Math.Abs(endingUsd));
    var supplierPurchaseKpi = SupplierKpi(Model.LoadedPurchaseValueRub, Model.LoadedPurchaseValueRubIsEstimated, Model.LoadedPurchaseValueUsd);
    var supplierPaidKpi = SupplierKpi(Model.TotalPaidRub, false, Model.TotalPaidUsd);

    // «پیش‌پرداخت آزاد» در تب خلاصه باید همان عددی باشد که کارت تب قراردادها نشان می‌دهد:
    // مانده قابل انتقالِ زندهٔ SupplierTransferableBalanceService. مدل AdvanceFreeUsd فقط
    // پرداخت‌هایی را می‌شمرد که «پیش‌پرداخت» علامت خورده‌اند یا تخصیص Legacy دارند، پس برای
    // اضافه‌پرداختِ عادی صفر می‌ماند. وقتی سرویس در دسترس نیست، همان عدد قبلی می‌ماند.
    var transferableBalance = ViewData["SupplierTransferableBalance"]
        as PTGOilSystem.Web.Models.Suppliers.SupplierTransferableBalanceCardViewModel;
    var freePrepaymentUsd = transferableBalance?.TransferableTotalUsd ?? Model.AdvanceFreeUsd;

    var supplierKpis = new List<AkKpiItem>
    {
        new() { Title = "مانده حساب", Value = supplierBalanceKpi.Value, Unit = supplierBalanceKpi.Unit, Avatar = "receivables" },
        new() { Title = "خرید بارگیری‌شده", Value = supplierPurchaseKpi.Value, Unit = supplierPurchaseKpi.Unit, Avatar = "purchase-value" },
        new() { Title = "پرداخت‌شده", Value = supplierPaidKpi.Value, Unit = supplierPaidKpi.Unit, Avatar = "payments-out" }
    };

    // کارت وضعیت حساب تب خلاصه. درصد تسویه یک نسبت نمایشی از دو رقمِ بالاست
    // و هیچ مبلغی دوباره محاسبه نمی‌شود.
    int? supplierPaidShare = Model.LoadedPurchaseValueUsd > 0m
        ? (int)Math.Clamp(Math.Round(Model.TotalPaidUsd / Model.LoadedPurchaseValueUsd * 100m, MidpointRounding.AwayFromZero), 0m, 100m)
        : null;

    var supplierAccountCard = new AkPartyAccountCard
    {
        Meaning = balanceLabel,
        MeaningTone = balanceTone,
        SettledPercent = supplierPaidShare,
        SettledCaption = supplierPaidShare.HasValue
            ? $"{supplierPaidShare.Value:N0}٪ پرداخت شده"
            : null,
        Facts = new List<AkInfoItem>
        {
            new() { Label = "پیش‌پرداخت آزاد", Value = NumberDisplay.Money(freePrepaymentUsd, "USD"), IsNumeric = true },
            new() { Label = "قرارداد فعال", Value = Model.ActivePurchaseContractsCount.ToString("N0"), IsNumeric = true },
            new() { Label = "آخرین پرداخت", Value = Model.LastPaymentDate.HasValue ? Model.LastPaymentDate.Value.ToDisplayDate() : null }
        },
        Identity = new List<AkInfoItem>
        {
            new() { Label = "کد", Value = string.IsNullOrWhiteSpace(Model.Code) ? notRecorded : Model.Code },
            new() { Label = "کشور", Value = string.IsNullOrWhiteSpace(Model.Country) ? notRecorded : Model.Country },
            new() { Label = "طرف تماس", Value = string.IsNullOrWhiteSpace(Model.ContactPerson) ? notRecorded : Model.ContactPerson },
            new() { Label = "تلفن", Value = string.IsNullOrWhiteSpace(Model.Phone) ? notRecorded : Model.Phone },
            new() { Label = "آدرس", Value = string.IsNullOrWhiteSpace(Model.Address) ? notRecorded : Model.Address, IsWide = true },
            new() { Label = "یادداشت", Value = string.IsNullOrWhiteSpace(Model.Notes) ? notRecorded : Model.Notes, IsWide = true }
        }
    };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.Name, false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       "فهرست تأمین‌کننده‌ها", "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("بخش‌های پروفایل تأمین‌کننده", supplierTabs)" />

    @* ===== تب خلاصه: کارت‌های آماری، بعد یک کارت واحدِ وضعیت حساب + هویت ===== *@
    <div class="ak-form-grid ak-overview-grid" hidden="@(!showOverview)">
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)supplierKpis)" />

        <partial name="~/Views/Shared/Components/Ak/_AkPartyAccountCard.cshtml" model="@supplierAccountCard" />
    </div>

    @* ===== تب ۱: قراردادها + پرداخت‌ها =====
       هر موضوع پنل مستقل خودش را دارد تا سکشن‌ها روی هم نریزند؛ گرید تک‌ستونی
       همان ریتم تب خلاصه است. فقط چیدمان است: داده و رفتار تغییر نمی‌کند. *@
    @{
        var transferable = transferableBalance;

        // گروه‌بندی پرداخت‌ها فقط نمایشی است؛ هیچ مبلغی دوباره محاسبه نمی‌شود.
        var payByContract = Model.PaymentLines
            .Where(p => !string.IsNullOrWhiteSpace(p.ContractNumber))
            .GroupBy(p => p.ContractNumber!)
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.Ordinal);
        var unallocatedPayments = Model.PaymentLines
            .Where(p => string.IsNullOrWhiteSpace(p.ContractNumber))
            .ToList();
    }
    <div class="ak-form-grid ak-party-tab-grid" hidden="@(!showContracts)">
    <section id="supplier-contracts" class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("قراردادهای خرید", $"{Model.Contracts.Count:N0} قرارداد"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">قرارداد</th>
                        <th>جنس</th>
                        <th class="ak-col-num">مقدار MT</th>
                        <th class="ak-col-num">بارگیری‌شده MT</th>
                        <th class="ak-col-num">قابل پرداخت @(isRubView ? "RUB" : "USD")</th>
                        <th class="ak-col-num">پرداخت‌شده @(isRubView ? "RUB" : "USD")</th>
                        <th class="ak-col-num">مانده @(isRubView ? "RUB" : "USD")</th>
                        <th>وضعیت</th>
                        <th class="ak-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Contracts)
                {
                    var cps = payByContract.TryGetValue(c.ContractNumber, out var _cl) ? _cl : new();
                    <tr>
                        <td class="ak-col-grow">
                            @if (cps.Any())
                            {
                                <button type="button" class="ak-pay-toggle" data-pay-toggle="@c.ContractId" aria-expanded="false" aria-label="نمایش پرداخت‌ها">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </button>
                            }
                            <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@c.ContractId">@c.ContractNumber</a>
                            @if (cps.Any())
                            {
                                <span class="ak-pay-count">@cps.Count.ToString("N0") پرداخت</span>
                            }
                        </td>
                        <td>@c.Product</td>
                        @* واحد MT در هدر ستون آمده؛ تکرار آن روی هر رقم فقط ردیف را شلوغ می‌کند. *@
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(c.QuantityMt)</td>
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(c.LoadedQuantityMt)</td>
                        @if (isRubView)
                        {
                            <td class="ak-col-num ak-num">@RubText(c.LoadedValueRub, c.LoadedValueRubIsEstimated)</td>
                            <td class="ak-col-num ak-num">@RubText(c.PaidRub, false)</td>
                            @* مانده بدون علامت؛ جهت در عنوان می‌آید — همان متنِ صورت‌حساب، PDF و Excel. *@
                            <td class="ak-col-num ak-num">
                                @RubText(c.BalanceAbsoluteFor(true), c.LoadedValueRubIsEstimated)
                                @if (c.BalanceTitleFor(true) is { } rubBalanceTitle)
                                {
                                    <span class="ak-cell-note">@rubBalanceTitle</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="ak-col-num ak-num">@AkUnit.Money(c.LoadedValueUsd, "USD")</td>
                            <td class="ak-col-num ak-num">@AkUnit.Money(c.PaidUsd, "USD")</td>
                            <td class="ak-col-num ak-num">
                                @AkUnit.Money(c.BalanceAbsoluteFor(false) ?? 0m, "USD")
                                <span class="ak-cell-note">@c.BalanceTitleFor(false)</span>
                            </td>
                        }
                        <td><span class="ak-status">@c.StatusName</span></td>
                        <td class="ak-col-actions">
                            <div class="dropdown ak-row-menu">
                                <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="عملیات">
                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@c.ContractId"><i class="bi bi-diagram-3"></i> جریان قرارداد</a></li>
                                    <li><a class="dropdown-item" href="@newPaymentUrl"><i class="bi bi-cash-coin"></i> ثبت پرداخت</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    @if (cps.Any())
                    {
                        foreach (var p in cps)
                        {
                            @* ردیف پرداخت زیرمجموعهٔ همان قرارداد است: سلول‌ها با ستون‌های هدر
                               هم‌تراز می‌مانند و رقم USD دقیقاً زیر ستون «پرداخت‌شده» می‌نشیند.
                               مبلغ سند در همان سلول به‌عنوان خط دوم حفظ می‌شود. *@
                            <tr class="ak-subrow" data-pay-group="@c.ContractId" hidden>
                                <td class="ak-col-grow">↳ پرداخت @(p.Method)</td>
                                <td>@p.Date.ToDisplayDate()</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="ak-col-num ak-num">
                                    @AkUnit.Money(p.AmountUsd, "USD")
                                    <span class="ak-subrow-sub">@AkUnit.Money(p.Amount, p.Currency)</span>
                                </td>
                                <td></td>
                                <td>
                                    @if (p.IsLedgerOnlyViaSarraf)
                                    {
                                        <span>@p.Reference</span>
                                    }
                                    else if (p.IsSarraf)
                                    {
                                        <a asp-controller="SarrafSettlements" asp-action="Details" asp-route-id="@p.SarrafSettlementId">@p.Reference</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Payments" asp-action="Details" asp-route-id="@p.PaymentId">@p.Reference</a>
                                    }
                                </td>
                                <td class="ak-col-actions"></td>
                            </tr>
                        }
                    }
                }
                @if (!Model.Contracts.Any())
                {
                    <tr><td colspan="9"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-file-earmark-text"></i> برای این تأمین‌کننده هنوز قرارداد خرید ثبت نشده است.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    @* کارت به‌محض وجود هر سطل مانده (شرکت اثبات‌شده یا سطح گروه) رندر می‌شود. شرطِ قبلی
       مانده‌های سطح گروه را کامل از UI حذف می‌کرد و کاربر پولش را نمی‌دید. *@
    @if (transferable is not null
        && (transferable.HasTransferable || transferable.HasAnyPool || transferable.HasUnknownCompany || transferable.ActiveTransferCount > 0))
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Suppliers/_SupplierTransferableBalanceCard.cshtml" model="transferable" />
        </section>
    }

    @if (unallocatedPayments.Any())
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("پیش‌پرداخت آزاد / بدون قرارداد", $"جمع {NumberDisplay.Money(Model.UnallocatedPaymentTotalUsd, "USD")}"))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th class="ak-col-grow">روش</th>
                            <th class="ak-col-num">مبلغ سند</th>
                            <th class="ak-col-num">معادل USD</th>
                            <th>رسید / حواله</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in unallocatedPayments)
                    {
                        <tr>
                            <td>@p.Date.ToDisplayDate()</td>
                            <td class="ak-col-grow">@p.Method</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Money(p.Amount, p.Currency)</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Money(p.AmountUsd, "USD")</td>
                            <td>
                                @if (p.IsSarraf)
                                {
                                    <a asp-controller="SarrafSettlements" asp-action="Details" asp-route-id="@p.SarrafSettlementId">@p.Reference</a>
                                }
                                else
                                {
                                    <a asp-controller="Payments" asp-action="Details" asp-route-id="@p.PaymentId">@p.Reference</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.HasAdvances)
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("پیش‌پرداخت تفصیلی", (string?)null))" />
            <dl class="ak-list">
                <div class="ak-list-row"><dt>مجموع پیش‌پرداخت</dt><dd class="ak-num">@Model.AdvanceTotalUsd.ToString("N2") USD</dd></div>
                <div class="ak-list-row"><dt>مصرف‌شده برای قراردادها</dt><dd class="ak-num">@Model.AdvanceAllocatedUsd.ToString("N2") USD</dd></div>
                <div class="ak-list-row"><dt>مانده آزاد</dt><dd class="ak-num">@Model.AdvanceFreeUsd.ToString("N2") USD</dd></div>
            </dl>
            @if (Model.AdvanceAllocations.Any())
            {
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th>تاریخ</th>
                                <th class="ak-col-grow">پرداخت</th>
                                <th>قرارداد</th>
                                <th class="ak-col-num">مبلغ مصرف‌شده USD</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in Model.AdvanceAllocations)
                        {
                            <tr>
                                <td>@a.AllocationDate.ToDisplayDate()</td>
                                <td class="ak-col-grow"><a asp-controller="Payments" asp-action="Details" asp-route-id="@a.PaymentTransactionId">@a.PaymentReference</a></td>
                                <td><a asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@a.ContractId" asp-route-returnUrl="@supplierReturnUrl">@a.ContractNumber</a></td>
                                <td class="ak-col-num ak-num">@a.AllocatedBookAmountUsd.ToString("N2")</td>
                                <td><span class="ak-status @(a.IsActive ?"is-active" : "is-inactive")">@a.StatusName</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (Model.SarrafSettlements.Any())
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("تسویه‌های صراف", (string?)null))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th class="ak-col-grow">صراف</th>
                            <th>قرارداد</th>
                            <th>مرجع</th>
                            <th class="ak-col-num">کاهش بدهی USD</th>
                            <th class="ak-col-num">اختلاف USD</th>
                            <th>وضعیت</th>
                            <th class="ak-col-actions">سند</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.SarrafSettlements)
                    {
                        <tr>
                            <td>@row.SettlementDate.ToDisplayDate()</td>
                            <td class="ak-col-grow">@row.SarrafName</td>
                            <td>@(row.ContractNumber ?? "-")</td>
                            <td>@(row.ReferenceNumber ?? $"#{row.Id}")</td>
                            <td class="ak-col-num ak-num">@row.SupplierReductionAmountUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num @(row.DifferenceAmountUsd >= 0 ?"ak-num" : "ak-num")">@row.DifferenceAmountUsd.ToString("N2")</td>
                            <td><span class="ak-status @(row.Status == SarrafSettlementStatus.Posted ?"is-active" : row.Status == SarrafSettlementStatus.Cancelled ? "is-inactive" : "")">@SarrafSettlementLabels.ToPersian(row.Status)</span></td>
                            <td class="ak-col-actions"><a asp-controller="SarrafSettlements" asp-action="Details" asp-route-id="@row.Id">مشاهده</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
    </div>

    @* ===== تب ۳: صورت‌حساب ===== *@
    <section id="supplier-statement" class="ak-form-section ak-detail-section" hidden="@(!showStatement)">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("صورت‌حساب رسمی تأمین‌کننده", "مانده، نرخ تاریخی و اطلاعات نفتی در موتور مشترک محاسبه می‌شود."))" />
        @* ارز نمایش صفحه به صورت‌حساب رسمی هم پاس می‌شود (CurrencyCode = RUB یعنی نمایش روبلی
           در PartyStatementReadService). در نمای USD چیزی پاس نمی‌شود تا فیلترِ ارز اعمال نشود. *@
        <div class="ak-party-statement-embed" data-party-statement-embed="@(Url.Action("Supplier", "PartyStatements", new { id = Model.SupplierId, CurrencyCode = isRubView ? "RUB" : null }))">
            <div class="ak-empty ak-detail-empty-state">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <p>در حال بارگذاری صورت‌حساب…</p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @* ظاهر ak-pay-toggle / ak-pay-count در 63-party-details.css است. *@
    <script>
        (function () {
            var root = document.getElementById('supplier-contracts');
            if (!root) return;
            root.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-pay-toggle]');
                if (!btn) return;
                var key = btn.getAttribute('data-pay-toggle');
                var rows = root.querySelectorAll('.ak-subrow[data-pay-group="' + key + '"]');
                var open = btn.getAttribute('aria-expanded') === 'true';
                rows.forEach(function (r) { r.hidden = open; });
                btn.setAttribute('aria-expanded', open ? 'false' : 'true');
                btn.classList.toggle('is-open', !open);
            });
        })();
    </script>
}
