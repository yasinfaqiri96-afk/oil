@model PTGOilSystem.Web.Models.ContractJourney.ContractJourneyInventoryTabViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);
    string UnitMt() => T("تن", "MT");
    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    // جهت حرکت از علامت SignedQuantityMt خوانده می‌شود (ورود و تعدیل مثبت، خروج و انتقال منفی).
    // DirectionName متن نمایشی فارسی است و نباید مبنای محاسبه باشد.
    // گروه‌بندی حرکات بر اساس ترمینال + مخزن
    var allTankGroups = Model.Items
        .GroupBy(i => new { Terminal = i.TerminalName, Tank = i.StorageTankCode ?? "" })
        .Select(g => new {
            TerminalName = g.Key.Terminal,
            TankName = g.Key.Tank,
            // مانده هر مخزن = جمع مقادیر علامت‌دار همان مخزن (RunningBalanceMt سطح قرارداد است، نه سطح مخزن).
            CurrentBalance = g.Sum(i => i.SignedQuantityMt),
            TotalIn  = g.Where(i => i.SignedQuantityMt >= 0m).Sum(i => i.QuantityMt),
            TotalOut = g.Where(i => i.SignedQuantityMt < 0m).Sum(i => i.QuantityMt),
            InCount  = g.Count(i => i.SignedQuantityMt >= 0m),
            OutCount = g.Count(i => i.SignedQuantityMt < 0m),
        })
        .OrderByDescending(g => g.CurrentBalance)
        .ToList();
    var inventorySearch = Context.Request.Query["inventoryQ"].ToString().Trim();
    var tankGroups = allTankGroups
        .Where(group => string.IsNullOrWhiteSpace(inventorySearch)
            || group.TerminalName.Contains(inventorySearch, StringComparison.CurrentCultureIgnoreCase)
            || group.TankName.Contains(inventorySearch, StringComparison.CurrentCultureIgnoreCase))
        .ToList();
}

<div id="journey-tab-lists" class="ak-tab-panel">
    <section class="ak-form-section">
        <div class="ak-section-head">
            <div>
                <h2 class="ak-section-title">@T("وضعیت موجودی", "Inventory status")</h2>
            </div>
        </div>

        <div class="ak-list-toolbar">
            <partial name="_ContractJourneyListFilter"
                     model="@(("inventoryQ", (string?)Context.Request.Query["inventoryQ"].ToString(), T("جستجو در وضعیت موجودی...", "Search inventory status..."), "inventoryPage"))" />
            <div class="ak-list-toolbar-actions no-print">
                <a href="@Model.StockCardUrl" class="btn btn-primary ak-primary-action">
                    <i class="bi bi-card-list" aria-hidden="true"></i>
                    <span>@T("کارت موجودی", "Stock card")</span>
                </a>
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@T("ترمینال", "Terminal")</th>
                        <th>@T("مخزن", "Tank")</th>
                        <th class="ak-col-num">@T("موجودی", "Balance")</th>
                        <th class="ak-col-num">@T("ورودی", "In")</th>
                        <th class="ak-col-num">@T("خروجی", "Out")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var tank in tankGroups)
                {
                    <tr>
                        <td class="ak-col-grow">@TextOrDash(tank.TerminalName)</td>
                        <td>@TextOrDash(tank.TankName)</td>
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(tank.CurrentBalance) @UnitMt()</td>
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(tank.TotalIn) @UnitMt() (@tank.InCount)</td>
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(tank.TotalOut) @UnitMt() (@tank.OutCount)</td>
                    </tr>
                }
                @if (!tankGroups.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="ak-empty">
                                <i class="bi bi-inbox"></i>
                                @Model.NoRecordsText
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
