                             model="@((T("کشتی‌های مرتبط", "Related shipments"), (string?)null))" />
                    <partial name="_ContractJourneyListFilter"
                             model="@(("shipmentsQ", (string?)shipmentsSearch, T("جستجو در کشتی‌های مرتبط...", "Search related shipments..."), "shipmentsPage"))" />
                    <div class="ak-table-wrap">
