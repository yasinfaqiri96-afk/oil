                                    <th class="ak-col-num">@T("تعداد سند", "Records")</th>
                                    <th>@T("آخرین تاریخ", "Last date")</th>
                                    <th class="ak-col-num">@T("جمع مبلغ", "Total amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var group in pagedExpenseGroups)
                            {
                                var groupDetailId = $"journey-expense-group-{group.Slug}";
                                <tr>
                                    <td class="ak-col-actions no-print">
                                        <button type="button" class="ak-row-menu-btn" data-bs-toggle="collapse" data-bs-target="#@groupDetailId" aria-expanded="false" aria-controls="@groupDetailId" title="@T("جزئیات", "Details")">
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                    <td class="ak-col-grow"><span class="ak-name">@group.TypeName</span></td>
                                    <td class="ak-col-num ak-num">@group.Items.Count.ToString("N0")</td>
                                    <td>@group.LastDate.ToDisplayDate()</td>
                                    <td class="ak-col-num ak-num">@group.TotalUsd.ToString("N2") @UnitUsd()</td>
                                </tr>
                                <tr class="collapse" id="@groupDetailId">
                                    <td colspan="5">
                                        <table class="ak-table ak-detail-table">
                                            <thead>
                                                <tr>
                                                    <th class="ak-col-grow">@T("شرح", "Description")</th>
                                                    <th>@T("تاریخ", "Date")</th>
                                                    <th class="ak-col-num">@T("مبلغ", "Amount")</th>
                                                    <th class="ak-col-actions">@T("عملیات", "Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var item in group.Items)
                                            {
                                                <tr>
                                                    <td class="ak-col-grow">
                                                        <a asp-controller="Expenses" asp-action="Details" asp-route-id="@item.ExpenseTransactionId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)" class="ak-name">
                                                            @(!string.IsNullOrWhiteSpace(item.Description) ? item.Description : item.ExpenseTypeName)
                                                        </a>
                                                    </td>
                                                    <td>@item.ExpenseDate.ToDisplayDate()</td>
                                                    <td class="ak-col-num ak-num">@item.AmountUsd.ToString("N2") @UnitUsd()</td>
                                                    <td class="ak-col-actions">
                                                        <div class="dropdown ak-row-menu">
                                                            <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T("عملیات", "Actions")">
                                                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><a asp-controller="Expenses" asp-action="Details" asp-route-id="@item.ExpenseTransactionId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)" class="dropdown-item"><i class="bi bi-eye"></i> @T("جزئیات", "Details")</a></li>
                                                                @if (!contractIsClosed)
                                                                {
                                                                    <li><a asp-controller="Expenses" asp-action="Edit" asp-route-id="@item.ExpenseTransactionId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)" class="dropdown-item"><i class="bi bi-pencil-square"></i> @T("ویرایش", "Edit")</a></li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                            @if (!filteredExpenseItems.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="ak-empty ak-detail-empty-state">
                                            <i class="bi bi-receipt-cutoff"></i>
                                            @T("داده‌ای ثبت نشده است.", "No records yet.")
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            @if (filteredExpenseItems.Any())
                            {
                                <tfoot>
                                    <tr>
                                        <td class="no-print"></td>
                                        <td class="ak-col-grow">@T("مجموع اسناد مصرف", "Expense documents total")</td>
                                        <td class="ak-col-num ak-num">@filteredExpenseItems.Count.ToString("N0")</td>
                                        <td></td>
                                        <td class="ak-col-num ak-num">@filteredExpenseTotalUsd.ToString("N2") @UnitUsd()</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                    @await DetailPager("expensesPage", expensesPage, expensesPageCount)
                    <p class="ak-note">
                        @T("مصرف عمومی هر 1 تن بارگیری", "General expense per 1 MT loaded"):
                        @(expensePerLoadedMt.HasValue ? $"{expensePerLoadedMt.Value:N2} {UnitUsd()}/{UnitMt()}" : T("نیاز به بارگیری", "Loading required")) ·
                        @T("مصرف عمومی قرارداد", "Contract-level expenses"): @contractLevelExpenseTotalUsd.ToString("N2") @UnitUsd() ·
                        @T("مصارف جریان حمل بار", "Cargo flow expenses"): @inventoryTransportExpenseTotalUsd.ToString("N2") @UnitUsd()
                    </p>
                    @if (transportLegExpenseBreakdown.Any())
                    {
                        <details class="ak-advanced" data-journey-leg-expense-breakdown>
                            <summary class="ak-advanced-summary">@T("نمایش جزئیات مصارف به تفکیک حمل", "Show expense details by transport")</summary>
                            <div class="ak-advanced-body ak-table-wrap">
                                <table class="ak-table ak-detail-table">
                                    <thead>
                                        <tr>
                                            <th class="ak-col-grow">@T("حمل", "Transport")</th>
                                            <th class="ak-col-num">@T("مجموع مصرف", "Expense total")</th>
                                            <th class="ak-col-num">@T("مصرف هر تن", "Expense per MT")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var allocation in transportLegExpenseBreakdown)
                                    {
                                        <tr>
                                            <td class="ak-col-grow">
                                                <a asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@allocation.TransportLegId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)" class="ak-name">@allocation.TransportTypeName / @allocation.TransportReference</a>
                                            </td>
                                            <td class="ak-col-num ak-num">@allocation.ExpenseTotalUsd.ToString("N2") @UnitUsd()</td>
                                            <td class="ak-col-num ak-num">@(allocation.ExpensePerMtUsd.HasValue ? $"{allocation.ExpensePerMtUsd.Value:N2} {UnitUsd()}/{UnitMt()}" : "-")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </section>

                @if (Model.InternalTransportCostItems.Any())
                {
                    <section class="ak-form-section ak-detail-section" data-journey-internal-transport-costs>
                        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                                 model="@((T("کرایه/مصرف داخلی ترانسپورت", "Internal transport cost"), (string?)T("ترانسپورت شخصی شرکت؛ بدون بدهی بیرونی و بدون Ledger. همین مبلغ یک‌بار در کارت «هزینه‌ها»ی تب خلاصه و در مفاد قرارداد حساب شده است؛ در جدول اسناد مصرف بالا نیست چون سند مصرف ندارد.", "Company-owned transport; no external payable or ledger. Counted once in the Expenses card of the Summary tab and in contract P&L; not in the expense documents table because it has no expense document.")))" />
                        <div class="ak-table-wrap">
                            <table class="ak-table ak-detail-table">
                                <thead>
                                    <tr>
                                        <th class="ak-col-grow">@T("دارایی / وسیله", "Asset")</th>
                                        <th>@T("بارگیری", "Loading")</th>
                                        <th>@T("تاریخ", "Date")</th>
                                        <th class="ak-col-num">@T("مقدار", "Quantity")</th>
                                        <th class="ak-col-num">@T("نرخ", "Rate")</th>
                                        <th class="ak-col-num">@T("مبلغ", "Amount")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var rent in Model.InternalTransportCostItems)
                                {
                                    <tr>
                                        <td class="ak-col-grow"><span class="ak-name">@(string.IsNullOrWhiteSpace(rent.AssetName) ? "-" : rent.AssetName)</span></td>
                                        <td>
                                            @if (rent.LoadingRegisterId.HasValue)
                                            {
                                                <a asp-controller="Loading" asp-action="Details" asp-route-id="@rent.LoadingRegisterId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)">LD-@rent.LoadingRegisterId.Value.ToString("0000")</a>
                                            }
                                        </td>
                                        <td>@rent.RentDate.ToDisplayDate()</td>
                                        <td class="ak-col-num ak-num">@(rent.QuantityMt.HasValue ? $"{NumberDisplay.Quantity(rent.QuantityMt.Value)} {UnitMt()}" : "-")</td>
                                        <td class="ak-col-num ak-num">@(rent.RateUsdPerMt.HasValue ? $"{rent.RateUsdPerMt.Value:N2} {UnitUsd()}/{UnitMt()}" : "-")</td>
                                        <td class="ak-col-num ak-num">@rent.AmountUsd.ToString("N2") @UnitUsd()</td>
                                    </tr>
                                }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="ak-col-grow" colspan="5">@T("مجموع", "Total")</td>
                                        <td class="ak-col-num ak-num">@Model.InternalTransportCostItems.Sum(r => r.AmountUsd).ToString("N2") @UnitUsd()</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </section>
                }

                @* Loss records share the expenses tab; legacy loss links remain valid. *@
                @* ضایعهٔ فزیکی/قابل‌جبران/بخشیده‌شده در کارت‌های آماری بالای همین تب است. *@
                <section class="ak-form-section ak-detail-section" data-journey-losses>
                    <h2 class="ak-section-title">@T("ضایعات", "Losses")</h2>
                    <div class="ak-list-toolbar">
                        <partial name="_ContractJourneyListFilter"
                                 model="@(("lossesQ", (string?)lossesSearch, T("جستجو در کسری و ضایعات...", "Search losses and wastage..."), "lossesPage"))" />
                        @if (!contractIsClosed)
                        {
                            <div class="ak-list-toolbar-actions no-print">
