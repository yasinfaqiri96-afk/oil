                                        <li><a class="dropdown-item" asp-controller="Expenses" asp-action="CustomsBatch" asp-route-contractId="@Model.ContractId" asp-route-returnUrl="@ReturnUrl(ContractJourneyTabs.Details.Costs)"><i class="bi bi-file-earmark-spreadsheet"></i> @T("مصارف گمرکی", "Customs expenses")</a></li>
                                    </ul>
                                </div>
                            </div>
