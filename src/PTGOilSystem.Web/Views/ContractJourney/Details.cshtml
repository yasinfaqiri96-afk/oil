@using PTGOilSystem.Web.Models.ContractJourney
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using PTGOilSystem.Web.Security
@inject IAuthorizationService AuthorizationService
@model PTGOilSystem.Web.Models.ContractJourney.ContractJourneyDetailsViewModel
@{
    var isAjaxTabRequest = string.Equals(Context.Request.Headers["X-Requested-With"], "XMLHttpRequest", StringComparison.OrdinalIgnoreCase);
    Layout = isAjaxTabRequest ? null : "_Layout";
    ViewData["HideSectionTabs"] = true;
    ViewData["ContractJourneyAssets"] = true;
    ViewData["Title"] = $"مرکز عملیات قرارداد {Model.ContractName}";

    var partnerLabel = Model.IsPurchaseContract ? "تأمین‌کننده" : "مشتری";
    var partnerName = Model.IsPurchaseContract
        ? Model.SupplierName ?? "-"
        : Model.CustomerName ?? "-";
    var summaryMetrics = Model.SummaryMetrics;
    var useSummaryMetrics = Model.IsInitialSummaryPayload && summaryMetrics.HasValues;
    var salesCount = useSummaryMetrics ? summaryMetrics.SaleCount : Model.SalesItems.Count;
    var soldQuantityMt = useSummaryMetrics ? summaryMetrics.SaleQuantityMt : Model.SalesItems.Sum(s => s.QuantityMt);
    var salesTotalUsd = useSummaryMetrics ? summaryMetrics.SaleTotalUsd : Model.SalesItems.Sum(s => s.AmountUsd);
    var expenseTotalUsd = useSummaryMetrics ? summaryMetrics.ExpenseTotalUsd : Model.ExpenseItems.Sum(e => e.AmountUsd);
    var inventoryTransportExpenseTotalUsd = useSummaryMetrics ? summaryMetrics.InventoryTransportExpenseTotalUsd : Model.InventoryTransportExpenseAllocations.Sum(e => e.ExpenseTotalUsd);
    var contractLevelExpenseTotalUsd = Math.Max(expenseTotalUsd - inventoryTransportExpenseTotalUsd, 0m);
    var paymentTotalUsd = useSummaryMetrics ? summaryMetrics.PaymentTotalUsd : Model.PaymentItems.Sum(p => p.AmountUsd);
    var dispatchQuantityMt = useSummaryMetrics ? summaryMetrics.DispatchQuantityMt : Model.DispatchItems.Sum(d => d.LoadedQuantityMt);
    var loadingQuantityMt = useSummaryMetrics ? summaryMetrics.LoadingQuantityMt : Model.LoadingItems.Sum(l => l.LoadedQuantityMt);
    var loadingCount = useSummaryMetrics ? summaryMetrics.LoadingCount : Model.LoadingItems.Count;
    var receiptCount = useSummaryMetrics ? summaryMetrics.ReceiptCount : Model.ReceiptItems.Count;
    var dispatchCount = useSummaryMetrics ? summaryMetrics.DispatchCount : Model.DispatchItems.Count;
    var transportLegCount = useSummaryMetrics ? summaryMetrics.InventoryTransportLegCount : Model.InventoryTransportLegItems.Count;
    var transportLegQuantityMt = useSummaryMetrics ? summaryMetrics.InventoryTransportQuantityMt : Model.InventoryTransportLegItems.Sum(l => l.QuantityMt);
    var transportLegReceivedMt = useSummaryMetrics ? summaryMetrics.InventoryTransportReceivedMt : Model.InventoryTransportLegItems.Sum(l => l.ReceivedQuantityMt);
    var transportLegShortageMt = useSummaryMetrics ? summaryMetrics.InventoryTransportShortageMt : Model.InventoryTransportLegItems.Sum(l => l.ShortageQuantityMt);
    var transportLegInTransitMt = useSummaryMetrics ? summaryMetrics.InventoryTransportInTransitMt : Model.InventoryTransportLegItems
        .Where(l => !string.Equals(l.StatusName, "Received", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(l.StatusName, "Cancelled", StringComparison.OrdinalIgnoreCase))
        .Sum(l => Math.Max(l.QuantityMt - l.ReceivedQuantityMt - l.ShortageQuantityMt, 0m));
    var expenseCount = useSummaryMetrics ? summaryMetrics.ExpenseCount : Model.ExpenseItems.Count;
    var lossEventCount = useSummaryMetrics ? summaryMetrics.LossCount : Model.LossItems.Count;
    var paymentCount = useSummaryMetrics ? summaryMetrics.PaymentCount : Model.PaymentItems.Count;
    var inventoryMovementCount = useSummaryMetrics ? summaryMetrics.InventoryMovementCount : Model.InventoryMovementItems.Count;
    decimal DisplayLossQuantityMt(ContractJourneyLossItemViewModel loss)
        => loss.DifferenceQuantityMt > 0m ? loss.DifferenceQuantityMt : Math.Max(loss.ChargeableLossMt, 0m);
    var totalDisplayLossMt = useSummaryMetrics ? summaryMetrics.LossQuantityMt : Model.LossItems.Sum(DisplayLossQuantityMt);
    decimal? salesAverageUsd = soldQuantityMt > 0m ? salesTotalUsd / soldQuantityMt : null;
    decimal? expensePerLoadedMt = loadingQuantityMt > 0m ? contractLevelExpenseTotalUsd / loadingQuantityMt : null;
    // مصارف و ارزش ضایعات مستقیم از موتور مفاد قرارداد: گمرکی که هم اظهارنامه و هم سند مصرف دارد
    // یک بار شمرده می‌شود و ارزش ضایعات باقی‌ماندهٔ دو جمع نیست.
    var summaryExpenseTotalUsd = Model.MiniPnl.RecordedExpensesUsd;
    var summaryLossCostUsd = Model.MiniPnl.LossCostUsd;
    decimal? summaryExpensePerLoadedMt = loadingQuantityMt > 0m ? summaryExpenseTotalUsd / loadingQuantityMt : null;
    // ضایعهٔ فزیکی = قابل‌جبران (بر عهدهٔ حمل‌کننده) + بخشیده‌شده (در حد تلورانس)؛ کسریِ بدون سند ضایعه
    // در هیچ‌کدام نیست.
    decimal LossChargeableMt(ContractJourneyLossItemViewModel loss)
        => Math.Min(Math.Max(loss.ChargeableLossMt, 0m), DisplayLossQuantityMt(loss));
    decimal LossAllowedMt(ContractJourneyLossItemViewModel loss)
        => Math.Max(DisplayLossQuantityMt(loss) - Math.Max(loss.ChargeableLossMt, 0m), 0m);
    var summaryChargeableLossMt = useSummaryMetrics ? summaryMetrics.ChargeableLossQuantityMt : Model.LossItems.Sum(LossChargeableMt);
    var summaryAllowedLossMt = useSummaryMetrics ? summaryMetrics.AllowedLossQuantityMt : Model.LossItems.Sum(LossAllowedMt);
    var remainingToLoadMt = Math.Max(Model.ContractQuantityMt - loadingQuantityMt, 0m);
    var receiptQuantityMt = useSummaryMetrics ? summaryMetrics.ReceiptQuantityMt : Model.ReceiptItems.Sum(r => r.ReceivedQuantityMt);
    var remainingToReceiveMt = Math.Max(loadingQuantityMt - receiptQuantityMt, 0m);
    var currentStockMt = Model.Kpis.CurrentStockQuantityMt;
    // کارت‌های تب موجودی و نقل و انتقالات فقط از ردیف‌هایی ساخته می‌شوند که مسیر سبک همان تب
    // می‌خواند؛ Kpis و ردیف‌های حمل در آن مسیرها پر نمی‌شوند و صفر نشان می‌دادند.
    var inventoryBookBalanceMt = Model.InventoryMovementItems.Sum(m => m.SignedQuantityMt);
    var inventoryTotalInMt = Model.InventoryMovementItems.Where(m => m.SignedQuantityMt >= 0m).Sum(m => m.QuantityMt);
    var inventoryTotalOutMt = Model.InventoryMovementItems.Where(m => m.SignedQuantityMt < 0m).Sum(m => m.QuantityMt);
    var dispatchDischargedMt = Model.DispatchItems.Sum(d => d.DischargedQuantityMt ?? 0m);
    // مفاد تحقق‌یافته: فقط فروش‌های انجام‌شده منهای بهای تمام‌شدهٔ همان مقدار (موتور مفاد قرارداد؛
    // همان رقمِ تب پرداخت‌ها، PDF، راپور مفاد قرارداد و حساب شرکا).
    var pnlOperationalMarginUsd = Model.MiniPnl.RealizedNetProfitUsd;
    var lifecycleProfitUsd = Model.MiniPnl.LifecycleMarginUsd;
    var pnlToneClass = pnlOperationalMarginUsd >= 0m ? "text-success" : "text-danger";
    var profitIsEstimate = Model.MiniPnl.Confidence != PTGOilSystem.Web.Services.Reporting.PnlConfidence.Verified;
    // پرداختِ تأمین‌کننده یک تعریف دارد (ViewModel)؛ PDF هم همان را می‌خواند.
    var supplierPayableTotalUsd = Model.SupplierPayableTotalUsd;
    var supplierPaidNetUsd = Model.SupplierPaidNetUsd;
    var supplierRemainingUsd = Model.SupplierRemainingUsd;
    var supplierRemainingToneClass = supplierRemainingUsd > 0m
        ? "text-danger"
        : "text-success";
    var firstLoading = Model.LoadingItems.FirstOrDefault();
    var bulkReceiptCandidates = Model.BulkReceiptCandidates;
    var bulkReceiptDefaultQuantityMt = bulkReceiptCandidates.Sum(l => l.RemainingQuantityMt);
    var bulkReceiptTerminals = ViewBag.BulkReceiptTerminals as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var bulkReceiptStorageTanks = ViewBag.BulkReceiptStorageTanks as IEnumerable<ContractJourneyBulkReceiptStorageTankOptionViewModel> ?? Enumerable.Empty<ContractJourneyBulkReceiptStorageTankOptionViewModel>();
    const string LossesPresentationTab = "losses";
    var activeTab = Model.ActiveTab;
    // «کسری و ضایعات» تب نمایشیِ جدا روی همان دادهٔ تب مصارف است: مسیرش tab=costs&lossesView=true
    // است تا کنترلر و payload تب مصارف بدون تغییر بمانند.
    var isLossesView = string.Equals(activeTab, LossesPresentationTab, StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.Query["lossesView"].ToString(), "true", StringComparison.OrdinalIgnoreCase);
    if (string.Equals(activeTab, LossesPresentationTab, StringComparison.OrdinalIgnoreCase))
    {
        activeTab = ContractJourneyTabs.Details.Costs;
    }
    string T(string fa, string en) => UiText.T(Context, fa, en);
    string UnitMt() => T("تن", "MT");
    string UnitUsd() => T("دالر", "USD");
    string LocalizeDisplay(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        var text = value.Trim();
        var fa = text switch
        {
            "Direct Sale from Receipt Allocation" => "فروش مستقیم از تخصیص رسید",
            "Direct Sale from Inventory Transport Receipt" => "فروش مستقیم از رسید حمل موجودی",
            "Sale from Direct Truck Dispatch" => "فروش از ارسال مستقیم با موتر",
            "Direct Truck Dispatch from Receipt Allocation" => "ارسال با موتر از تخصیص رسید",
            "Loaded" => "بارگیری‌شده",
            "InTransit" => "در مسیر",
            "Delivered" => "تحویل‌شده",
            "Cancelled" => "لغوشده",
            "Sale" => "فروش",
            "Expense" => "مصرف",
            "CustomerReceipt" => "دریافت از مشتری",
            "SupplierPayment" => "پرداخت به تأمین‌کننده",
            "SupplierReceipt" => "دریافت از تأمین‌کننده",
            "CustomerPayment" => "پرداخت به مشتری",
            "ExpensePayment" => "پرداخت مصرف",
            "TruckPayment" => "پرداخت موتر",
            "ManualPayment" => "پرداخت دستی",
            "ManualReceipt" => "دریافت دستی",
            "EmployeeReturn" => "برگشت از کارمند",
            "Stock" => "موجودی",
            _ => text
        };

        fa = fa.Replace("USD/MT", "دالر/تن", StringComparison.OrdinalIgnoreCase)
            .Replace("USD", "دالر", StringComparison.OrdinalIgnoreCase)
            .Replace("MT", "تن", StringComparison.OrdinalIgnoreCase)
            .Replace("Platt's", "پلتس", StringComparison.OrdinalIgnoreCase)
            .Replace("Platts", "پلتس", StringComparison.OrdinalIgnoreCase)
            .Replace("Reference", "مرجع", StringComparison.OrdinalIgnoreCase)
            .Replace("Manual", "دستی", StringComparison.OrdinalIgnoreCase)
            .Replace("Daily", "روزانه", StringComparison.OrdinalIgnoreCase)
            .Replace("Monthly", "ماهانه", StringComparison.OrdinalIgnoreCase);

        return T(fa, text);
    }

    string BuildTabUrl(string tab)
    {
        if (string.Equals(tab, LossesPresentationTab, StringComparison.OrdinalIgnoreCase))
        {
            return Url.Action("Details", "ContractJourney", new { contractId = Model.ContractId, tab = ContractJourneyTabs.Details.Costs, lossesView = true, lockContract = Model.LockContract })
                ?? $"/ContractJourney/Details?contractId={Model.ContractId}&tab={ContractJourneyTabs.Details.Costs}&lossesView=true&lockContract={Model.LockContract.ToString().ToLowerInvariant()}";
        }

        return Url.Action("Details", "ContractJourney", new { contractId = Model.ContractId, tab, lockContract = Model.LockContract })
            ?? $"/ContractJourney/Details?contractId={Model.ContractId}&tab={tab}&lockContract={Model.LockContract.ToString().ToLowerInvariant()}";
    }

    string SidebarPageIcon(string section)
        => section switch
        {
            "summary" => "bi-grid-1x2",
            "contract" => "bi-file-earmark-text",
            "loading" => "bi-arrow-down-circle",
            "receipt" => "bi-inbox",
            "inventoryTransport" => "bi-truck-front",
            "inventory" => "bi-boxes",
            "dispatch" => "bi-arrow-left-right",
            "sales" => "bi-cart-check",
            "costs" => "bi-receipt-cutoff",
            "finance" => "bi-bank",
            "ledger" => "bi-journal-bookmark",
            "loss" => "bi-exclamation-diamond",
            "profit" => "bi-graph-up",
            "status" => "bi-check-circle",
            _ => "bi-circle"
        };

    var pageDirection = T("rtl", "ltr");

    // Artwork is displayed directly from the user's reference; figures remain live Razor data.
    string ReferenceAvatarViewBox(int stage) => stage switch
    {
        1 => "1238 175 126 146",
        2 => "795 178 114 133",
        3 => "322 185 133 108",
        4 => "334 379 123 132",
        5 => "794 377 112 142",
        6 => "1238 379 119 140",
        7 => "1237 586 117 137",
        _ => "62 591 111 111"
    };

    var detailTabs = Model.IsPurchaseContract
        ? new ContractJourneyDetailTabLinkViewModel[]
        {
            new() { Key = ContractJourneyTabs.Details.Summary, Label = T("خلاصه", "Summary"), Icon = SidebarPageIcon("summary") },
            new() { Key = ContractJourneyTabs.Details.Loadings, Label = T("بارگیری و رسید", "Loading & receipts"), Icon = SidebarPageIcon("loading") },
            new() { Key = ContractJourneyTabs.Details.Inventory, Label = T("موجودی", "Inventory"), Icon = SidebarPageIcon("inventory") },
            new() { Key = ContractJourneyTabs.Details.InventoryTransport, Label = T("حمل و نقل", "Transport"), Icon = SidebarPageIcon("inventoryTransport") },
            new() { Key = ContractJourneyTabs.Details.Sales, Label = T("فروشات", "Sales"), Icon = SidebarPageIcon("sales") },
            new() { Key = ContractJourneyTabs.Details.Costs, Label = T("مصارف و ضایعات", "Expenses & losses"), Icon = SidebarPageIcon("costs") },
            new() { Key = ContractJourneyTabs.Details.Finance, Label = T("حساب قرارداد", "Contract account"), Icon = SidebarPageIcon("finance") }
        }
        : new ContractJourneyDetailTabLinkViewModel[]
        {
            new() { Key = ContractJourneyTabs.Details.Summary, Label = T("خلاصه", "Summary"), Icon = SidebarPageIcon("summary") },
            new() { Key = ContractJourneyTabs.Details.Sales, Label = T("فروشات", "Sales"), Icon = SidebarPageIcon("sales") },
            new() { Key = ContractJourneyTabs.Details.Finance, Label = T("پرداخت‌ها", "Payments"), Icon = SidebarPageIcon("finance") }
        };

    // گروه‌بندی فقط نمایشی است؛ URLها و payloadهای مستقل هر عملیات حفظ می‌شوند.
    var activeGroupTab = Model.IsPurchaseContract
        ? activeTab switch
        {
            ContractJourneyTabs.Details.Receipts => ContractJourneyTabs.Details.Loadings,
            ContractJourneyTabs.Details.Dispatch => ContractJourneyTabs.Details.InventoryTransport,
            _ => activeTab
        }
        : activeTab;
    if (!detailTabs.Any(t => t.Key == activeGroupTab))
    {
        activeTab = ContractJourneyTabs.Details.Summary;
        activeGroupTab = activeTab;
    }
    isLossesView = isLossesView && activeTab == ContractJourneyTabs.Details.Costs;

    var groupedSection = Model.IsPurchaseContract && !isLossesView
        ? activeTab switch
        {
            ContractJourneyTabs.Details.Loadings => (Tab: ContractJourneyTabs.Details.Receipts, Title: T("رسید بارگیری", "Loading receipts"), Before: false),
            ContractJourneyTabs.Details.Receipts => (Tab: ContractJourneyTabs.Details.Loadings, Title: T("سوابق بارگیری", "Loading records"), Before: true),
            ContractJourneyTabs.Details.InventoryTransport => (Tab: ContractJourneyTabs.Details.Dispatch, Title: T("انتقال با موتر", "Truck transfers"), Before: false),
            ContractJourneyTabs.Details.Dispatch => (Tab: ContractJourneyTabs.Details.InventoryTransport, Title: T("حمل بین ترمینال‌ها", "Transport between terminals"), Before: true),
            _ => (Tab: (string?)null, Title: string.Empty, Before: false)
        }
        : (Tab: (string?)null, Title: string.Empty, Before: false);
    var primarySectionTitle = activeTab switch
    {
        ContractJourneyTabs.Details.Loadings => T("سوابق بارگیری", "Loading records"),
        ContractJourneyTabs.Details.Receipts => T("رسید بارگیری", "Loading receipts"),
        ContractJourneyTabs.Details.InventoryTransport => T("حمل بین ترمینال‌ها", "Transport between terminals"),
        ContractJourneyTabs.Details.Dispatch => T("انتقال با موتر", "Truck transfers"),
        ContractJourneyTabs.Details.Costs => T("مصارف و ضایعات", "Expenses & losses"),
        ContractJourneyTabs.Details.Finance => T("پرداخت‌ها و تسویه‌ها", "Payments & settlements"),
        _ => string.Empty
    };

    string FormatMt(decimal value) => $"{NumberDisplay.Quantity(value)} {UnitMt()}";
    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    string? TransportDestinationTerminal(ContractJourneyTransportLegItemViewModel item)
        => item.DestinationReceipt?.DestinationTerminalName ?? item.DestinationTerminalName;

    decimal TransportInTransitQuantity(ContractJourneyTransportLegItemViewModel item)
    {
        if (string.Equals(item.StatusName, "Received", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.StatusName, "Cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return 0m;
        }

        return Math.Max(item.QuantityMt - item.ReceivedQuantityMt - item.ShortageQuantityMt, 0m);
    }

    string TransportTypeDisplay(string? value)
    {
        var text = value?.Trim() ?? string.Empty;
        if (text.Equals("Truck", StringComparison.OrdinalIgnoreCase))
        {
            return T("موتر", "Truck");
        }

        if (text.Equals("Wagon", StringComparison.OrdinalIgnoreCase))
        {
            return T("واگن", "Wagon");
        }

        if (text.Equals("Vessel", StringComparison.OrdinalIgnoreCase) || text.Equals("Ship", StringComparison.OrdinalIgnoreCase))
        {
            return T("کشتی", "Vessel");
        }

        return LocalizeDisplay(text);
    }

    string TransportStatusToneClass(string? status)
    {
        var text = status?.Trim() ?? string.Empty;
        return text.Equals("Received", StringComparison.OrdinalIgnoreCase)
            || text.Equals("Delivered", StringComparison.OrdinalIgnoreCase)
            ? "is-active"
            : "is-inactive";
    }

    var loadingValueUsd = useSummaryMetrics ? summaryMetrics.LoadingValueUsd : Model.LoadingItems.Sum(l => l.LoadingValueUsd ?? 0m);
    // ارزش روبلی از منبع مشترک (LoadingRubValuation) می‌آید تا با پروفایل تأمین‌کننده یکسان باشد.
    // null یعنی هیچ منبع روبلی موجود نیست و به‌جای صفر «ثبت نشده» نشان داده می‌شود.
    var loadingValueRub = Model.RubSettlementSummary.LoadingValueRub;
    var loadingValueRubIsEstimated = Model.RubSettlementSummary.LoadingValueRubIsEstimated;
    var loadingWastageMt = Model.LoadingDifferenceLossMt;
    var receiptShortageWastageMt = Model.ReceiptShortageLossMt;
    var dispatchShortageWastageMt = Model.DispatchShortageLossMt;
    var marginPercent = salesTotalUsd > 0m
        ? Math.Round((pnlOperationalMarginUsd / salesTotalUsd) * 100m, 2, MidpointRounding.AwayFromZero)
        : 0m;
    var returnOnInvestmentPercent = Model.MiniPnl.CostOfGoodsSoldUsd > 0m
        ? Math.Round((pnlOperationalMarginUsd / Model.MiniPnl.CostOfGoodsSoldUsd) * 100m, 2, MidpointRounding.AwayFromZero)
        : 0m;
    // اعداد این تب از NumberDisplay می‌آیند تا صفرهای بی‌معنی آخر عدد نمایش داده
    // نشوند (۱۲٬۳۴۵ نه ۱۲٬۳۴۵٫۰۰۰)؛ فقط قالب پرانتز برای مقدار منفی و واحد
    // اینجا اضافه می‌شود. هیچ گرد کردن تازه‌ای انجام نمی‌شود.
    string FormatLifecycleQuantity(decimal value, int decimals = 3)
    {
        var absolute = NumberDisplay.Raw(Math.Abs(value), decimals);
        return value < 0m ? $"({absolute}) {UnitMt()}" : $"{absolute} {UnitMt()}";
    }
    string FormatLifecycleUsd(decimal value)
    {
        var absolute = NumberDisplay.Raw(Math.Abs(value), 2);
        return value < 0m ? $"($ {absolute})" : $"$ {absolute}";
    }
    Microsoft.AspNetCore.Html.IHtmlContent LifecycleQuantityMarkup(string formatted)
    {
        var suffix = $" {UnitMt()}";
        var number = formatted.EndsWith(suffix, StringComparison.Ordinal) ? formatted[..^suffix.Length] : formatted;
        return new Microsoft.AspNetCore.Html.HtmlContentBuilder()
            .AppendHtml("<bdi dir=\"ltr\">").Append(number).AppendHtml("</bdi><span>")
            .Append(UnitMt()).AppendHtml("</span>");
    }
    string FormatRubRate(decimal? value)
        => value.HasValue ? $"{NumberDisplay.FxRate(value.Value)} RUB/USD" : "-";
    string FormatLifecycleRate(decimal? value)
        => value.HasValue ? FormatLifecycleUsd(value.Value) : "-";

    // ضایعهٔ فزیکی دیگر قابل فروش نیست.
    var lifecycleSaleableQuantityMt = Model.ContractQuantityMt - soldQuantityMt - totalDisplayLossMt;
    var contractNetLabel = pnlOperationalMarginUsd < 0m
        ? T("زیان تحقق‌یافته", "Realized loss")
        : T("مفاد تحقق‌یافته", "Realized profit");
    // قیمت هر بارگیری مستقل است: وقتی بارگیری‌ها قیمت‌های متفاوت دارند، ارزش قرارداد
    // جمع ارزش بارگیری‌ها است، نه مقدار قرارداد × نرخ قرارداد.
    var contractDisplayValueUsd = Model.HasMixedLoadingPrices && Model.LoadingsValueUsd > 0m
        ? Model.LoadingsValueUsd
        : Model.PricingFinalUnitPriceUsd.HasValue && Model.PricingFinalUnitPriceUsd.Value > 0m
            ? Model.PricingFinalUnitPriceUsd.Value * Model.ContractQuantityMt
            : Model.MiniPnl.TraceablePurchaseCostUsd;
    var rubSettlement = Model.RubSettlementSummary;
    var rubPendingStatusText = rubSettlement.PendingRateLoadingCount > 0
        ? T("در انتظار نرخ", "Pending rate")
        : rubSettlement.LockedLoadingCount > 0 ? T("همه قفل شده", "All locked") : T("بدون بارگیری روبلی", "No RUB loading");
    string FormatHeaderValueUsd(decimal value)
        => value > 0m ? FormatLifecycleUsd(value) : T("در انتظار نرخ", "Pending price");
    var contractCurrencyText = rubSettlement.IsRubSettlement
        ? $"USD / RUB · {FormatRubRate(rubSettlement.ContractRubPerUsdRate)}"
        : $"USD · {(Model.PricingFinalUnitPriceUsd.HasValue && Model.PricingFinalUnitPriceUsd.Value > 0m ? $"{Model.PricingFinalUnitPriceUsd.Value:N2} {UnitUsd()}/{UnitMt()}" : T("در انتظار نرخ", "Pending price"))}";
    var contractStatusToneClass = Model.StatusBadgeClass.Contains("success", StringComparison.OrdinalIgnoreCase) ? "is-active" : "is-inactive";

    var inventoryTransferUrl = Url.Action("Create", "InventoryTransportLegs", new { returnUrl = BuildTabUrl(ContractJourneyTabs.Details.InventoryTransport) })
        ?? "/InventoryTransportLegs/Create";
    // بازگشت به همان صفحه‌ای که کاربر از آن آمده (لیست قراردادها با فیلترها)؛ در نبود returnUrl به فهرست قراردادها
    var contractsListBackUrl = Context.Request.Query.TryGetValue("returnUrl", out var backReturnValues)
        && !string.IsNullOrWhiteSpace(backReturnValues) && Url.IsLocalUrl(backReturnValues.ToString())
            ? backReturnValues.ToString()
            : Url.Action("Index", "Contracts") ?? "/Contracts";
    var contractStatementUrl = Url.Action("Contract", "AccountStatements", new { contractId = Model.ContractId }) ?? "#";
    var contractEditUrl = Url.Action("Edit", "Contracts", new { id = Model.ContractId }) ?? "#";
    var contractPricingUrl = Url.Action("EditPricing", "Contracts", new { id = Model.ContractId }) ?? "#";
    ViewData["AkHeaderStatus"] = LocalizeDisplay(Model.StatusName);
    ViewData["AkHeaderStatusState"] = contractStatusToneClass;
    var headerUnitPriceText = Model.PricingFinalUnitPriceUsd.HasValue && Model.PricingFinalUnitPriceUsd.Value > 0m
        ? $"{Model.PricingFinalUnitPriceUsd.Value:N2} {UnitUsd()}/{UnitMt()}"
        : T("در انتظار نرخ", "Pending price");
    ViewData["AkHeaderContext"] = $"{partnerLabel}: {partnerName} · {T("جنس", "Product")}: {TextOrDash(Model.ProductName)} · {T("قیمت هر تن", "Unit price")}: {headerUnitPriceText}";
    // قرارداد بسته فقط قابل مشاهده است: عملیات ثبت/ویرایش از منو برداشته می‌شوند.
    var contractIsClosed = ViewData["ContractIsClosed"] is true;
    var isAdminUser = (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.AdminOnly)).Succeeded;
    var closureReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var headerKebabItems = new List<PTGOilSystem.Web.Models.Shared.AkHeaderMenuItem>
    {
        new() { Label = T("دفتر حساب قرارداد", "Contract statement"), Href = contractStatementUrl, Icon = "bi-journal-text" }
    };
    if (!contractIsClosed)
    {
        headerKebabItems.Add(new() { Label = T("انتقال از موجودی", "Inventory transfer"), Href = inventoryTransferUrl, Icon = "bi-truck-front" });
        headerKebabItems.Add(new() { Label = T("قیمت‌گذاری قرارداد", "Contract pricing"), Href = contractPricingUrl, Icon = "bi-tag" });
        headerKebabItems.Add(new() { Label = T("ویرایش قرارداد", "Edit contract"), Href = contractEditUrl, Icon = "bi-pencil-square" });
        headerKebabItems.Add(new()
        {
            Label = T("بستن قرارداد", "Close contract"),
            Href = Url.Action("Close", "Contracts", new { id = Model.ContractId, returnUrl = closureReturnUrl }),
            Icon = "bi-lock"
        });
    }
    else if (isAdminUser)
    {
        headerKebabItems.Add(new()
        {
            Label = T("بازگشایی قرارداد", "Reopen contract"),
            Href = Url.Action("Reopen", "Contracts", new { id = Model.ContractId, returnUrl = closureReturnUrl }),
            Icon = "bi-unlock"
        });
    }
    // «حذف گروهی بارگیری» فقط برای ادمین و فقط روی قرارداد خرید معنا دارد (بارگیری مالِ خرید است).
    if (Model.IsPurchaseContract && !contractIsClosed && isAdminUser)
    {
        headerKebabItems.Add(new PTGOilSystem.Web.Models.Shared.AkHeaderMenuItem
        {
            Label = T("حذف گروهی بارگیری", "Bulk delete loadings"),
            Href = Url.Action(
                "BulkDelete",
                "Loading",
                new { contractId = Model.ContractId, returnUrl = Context.Request.Path + Context.Request.QueryString }),
            Icon = "bi-trash3",
            IsDestructive = true
        });
    }

    ViewData["AkHeaderKebab"] = headerKebabItems;

    // خروجی Excel/PDF جای دکمهٔ «دفتر حساب قرارداد» در نوار عملیات هدر می‌نشیند؛
    // دفتر حساب به منوی سه‌نقطه منتقل شده است.
    ViewData["AkHeaderExport"] = new PTGOilSystem.Web.Services.Exports.ExportMenuModel(
        "DetailsExport",
        RouteValues: new Dictionary<string, string?>
        {
            ["contractId"] = Model.ContractId.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["tab"] = activeTab,
            ["lockContract"] = Model.LockContract.ToString().ToLowerInvariant()
        });

    var detailTabsRailModel = new ContractJourneyDetailTabsRailViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        ActiveTab = activeGroupTab,
        AriaLabel = T("تب‌های مرکز عملیات قرارداد", "Contract operations center tabs"),
        Tabs = detailTabs
    };

    string ReturnUrl(string tab) => BuildTabUrl(tab);

    const int journeyListPageSize = 8;
    const int loadingListPageSize = 15;
    const int receiptListPageSize = 15;

    int ReadPositivePage(string key)
    {
        if (Context.Request.Query.TryGetValue(key, out var values)
            && int.TryParse(values.FirstOrDefault(), out var page)
            && page > 0)
        {
            return page;
        }

        return 1;
    }

    int PageCountFor(int totalCount, int pageSize = journeyListPageSize)
        => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    string ReadListSearch(string key)
        => Context.Request.Query.TryGetValue(key, out var values) ? values.ToString().Trim() : string.Empty;

    bool MatchesListSearch(string search, params object?[] values)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        return values.Any(value => value is not null
            && Convert.ToString(value, System.Globalization.CultureInfo.CurrentCulture)?
                .Contains(search, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    async Task<Microsoft.AspNetCore.Html.IHtmlContent> DetailPager(string pageKey, int currentPage, int pageCount)
        => await Html.PartialAsync(
            "~/Views/Shared/Partials/_DetailPager.cshtml",
            (currentPage, pageCount, pageKey, (string?)"journey-tab-lists"));

    var subContractsSearch = ReadListSearch("subContractsQ");
    var filteredSubContractItems = Model.SubContractItems
        .Where(item => MatchesListSearch(subContractsSearch, item.ContractId, item.ContractNumber, item.StatusName, item.QuantityMt, item.LoadedQuantityMt, item.RemainingQuantityMt, item.LoadingsValueUsd))
        .ToList();
    var shipmentsSearch = ReadListSearch("shipmentsQ");
    var filteredShipmentScenarios = Model.ShipmentScenarios
        .Where(item => MatchesListSearch(shipmentsSearch, item.ShipmentId, item.ShipmentCode, item.VesselName, item.OriginName, item.DestinationName, item.AllocatedQuantityMt, item.SoldQuantityMt))
        .ToList();

    var loadingsSearch = ReadListSearch("loadingsQ");
    var filteredLoadingItems = Model.LoadingItems
        .Where(item => MatchesListSearch(loadingsSearch, item.Id, item.LoadingDate.ToDisplayDate(), item.ProductName, item.BillOfLadingNumber, item.RwbNo, item.WagonNumber, item.TransportTypeLabel, item.DocumentSummary, item.RouteDescription, item.LogisticsCompanyName))
        .ToList();
    var loadingPageCount = PageCountFor(filteredLoadingItems.Count, loadingListPageSize);
    var loadingPage = Math.Min(ReadPositivePage("loadingsPage"), loadingPageCount);
    var pagedLoadingItems = filteredLoadingItems
        .Skip((loadingPage - 1) * loadingListPageSize)
        .Take(loadingListPageSize)
        .ToList();

    var pendingReceiptsSearch = ReadListSearch("pendingReceiptsQ");
    var filteredBulkReceiptCandidates = bulkReceiptCandidates
        .Where(item => MatchesListSearch(pendingReceiptsSearch, item.LoadingRegisterId, item.VehicleNumber, item.LoadingDate.ToDisplayDate(), item.ProductName, item.TransportTypeLabel, item.LoadedQuantityMt, item.LoadingPriceUsd, item.LoadingValueUsd, item.BillOfLadingNumber, item.RwbNo, item.WagonNumber))
        .ToList();
    var pendingReceiptPageCount = PageCountFor(filteredBulkReceiptCandidates.Count, receiptListPageSize);
    var pendingReceiptPage = Math.Min(ReadPositivePage("pendingReceiptsPage"), pendingReceiptPageCount);
    var pagedBulkReceiptCandidates = filteredBulkReceiptCandidates
        .Skip((pendingReceiptPage - 1) * receiptListPageSize)
        .Take(receiptListPageSize)
        .ToList();
    var receiptsSearch = ReadListSearch("receiptsQ");
    var filteredReceiptItems = Model.ReceiptItems
        .Where(item => MatchesListSearch(receiptsSearch, item.Id, item.LoadingRegisterId, item.ReceiptDate.ToDisplayDate(), item.TerminalName, item.StorageTankCode, item.ReferenceDocument))
        .ToList();
    var receiptPageCount = PageCountFor(filteredReceiptItems.Count, receiptListPageSize);
    var receiptPage = Math.Min(ReadPositivePage("receiptsPage"), receiptPageCount);
    var pagedReceiptItems = filteredReceiptItems
        .Skip((receiptPage - 1) * receiptListPageSize)
        .Take(receiptListPageSize)
        .ToList();

    var dispatchSearch = ReadListSearch("dispatchQ");
    var filteredDispatchItems = Model.DispatchItems
        .Where(item => MatchesListSearch(dispatchSearch, item.Id, item.DispatchDate.ToDisplayDate(), item.TruckPlateNumber, item.DriverName, item.DestinationName, item.StatusName, item.ReferenceDocument))
        .ToList();
    var dispatchPageCount = PageCountFor(filteredDispatchItems.Count);
    var dispatchPage = Math.Min(ReadPositivePage("dispatchPage"), dispatchPageCount);
    var pagedDispatchItems = filteredDispatchItems
        .Skip((dispatchPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    var transportLegsSearch = ReadListSearch("transportLegsQ");
    var transportJourneyItems = Model.InventoryTransportLegItems
        .Where(item => MatchesListSearch(transportLegsSearch, item.Id, item.LoadedDate.ToDisplayDate(), item.TransportTypeName, item.WagonNumber, item.VehicleNumber, item.RwbNo, item.SourceTerminalName, item.SourceTankCode, item.DestinationTerminalName, item.DestinationTankCode, item.StatusName))
        .OrderBy(l => l.LoadedDate)
        .ThenBy(l => l.Id)
        .ToList();
    var transportLegPageCount = PageCountFor(transportJourneyItems.Count);
    var transportLegPage = Math.Min(ReadPositivePage("transportLegPage"), transportLegPageCount);
    var pagedTransportLegItems = transportJourneyItems
        .Skip((transportLegPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    var salesSearch = ReadListSearch("salesQ");
    var filteredSalesItems = Model.SalesItems
        .Where(item => MatchesListSearch(salesSearch, item.SalesTransactionId, item.InvoiceNumber, item.SaleDate.ToDisplayDate(), item.CustomerName, item.SalesContractDisplay, item.SourcePurchaseContractNumber, item.InventoryTransportReference))
        .ToList();
    var salesPageCount = PageCountFor(filteredSalesItems.Count);
    var salesPage = Math.Min(ReadPositivePage("salesPage"), salesPageCount);
    var pagedSalesItems = filteredSalesItems
        .Skip((salesPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    var preSaleCount = Model.PreSaleItems.Count;
    var preSalesPageCount = PageCountFor(preSaleCount);
    var preSalesPage = Math.Min(ReadPositivePage("preSalesPage"), preSalesPageCount);
    var pagedPreSaleItems = Model.PreSaleItems
        .Skip((preSalesPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    var expensesSearch = ReadListSearch("expensesQ");
    var filteredExpenseItems = Model.ExpenseItems
        .Where(item => MatchesListSearch(expensesSearch, item.ExpenseTransactionId, item.ExpenseDate.ToDisplayDate(), item.ExpenseTypeName, item.ShipmentCode, item.DispatchLabel, item.TransportLegLabel, item.Description, item.VehicleNumber, item.TraceKind))
        .ToList();
    // نمای مصارف به‌صورت تجمیعی بر اساس «نوع مصرف» است؛ ردیف‌های دانه‌دانه داخل هر گروه
    // با دکمه «جزئیات» باز می‌شوند. صفحه‌بندی روی گروه‌ها اعمال می‌شود، نه روی تک‌تک اسناد.
    var expenseGroups = filteredExpenseItems
        .GroupBy(item => string.IsNullOrWhiteSpace(item.ExpenseTypeName) ? "-" : item.ExpenseTypeName)
        .Select(group => new
        {
            TypeName = group.Key,
            Items = group.OrderByDescending(item => item.ExpenseDate).ThenByDescending(item => item.ExpenseTransactionId).ToList(),
            TotalUsd = group.Sum(item => item.AmountUsd),
            LastDate = group.Max(item => item.ExpenseDate)
        })
        .OrderByDescending(group => group.TotalUsd)
        .Select((group, index) => new
        {
            group.TypeName,
            group.Items,
            group.TotalUsd,
            group.LastDate,
            // شناسه پایدار برای collapse؛ نام نوع مصرف فارسی است و در id قابل استفاده نیست.
            Slug = index + 1
        })
        .ToList();
    var filteredExpenseTotalUsd = filteredExpenseItems.Sum(item => item.AmountUsd);
    var expensesPageCount = PageCountFor(expenseGroups.Count);
    var expensesPage = Math.Min(ReadPositivePage("expensesPage"), expensesPageCount);
    var pagedExpenseGroups = expenseGroups
        .Skip((expensesPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    // همان اسناد جدول مصارف، فقط به تفکیک حمل؛ حمل بدون مصرف نمایش داده نمی‌شود.
    var transportLegExpenseBreakdown = Model.InventoryTransportExpenseAllocations
        .Where(item => item.ExpenseCount > 0)
        .ToList();
    var lossesSearch = ReadListSearch("lossesQ");
    var filteredLossItems = Model.LossItems
        .Where(item => MatchesListSearch(lossesSearch, item.LossEventId, item.EventDate.ToDisplayDate(), item.StageName, item.VehicleNumber, item.TraceKind, item.RelatedMovementId))
        .ToList();
    var lossesPageCount = PageCountFor(filteredLossItems.Count);
    var lossesPage = Math.Min(ReadPositivePage("lossesPage"), lossesPageCount);
    var pagedLossItems = filteredLossItems
        .Skip((lossesPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();

    var paymentsSearch = ReadListSearch("paymentsQ");
    var filteredPaymentItems = Model.PaymentItems
        .Where(item => MatchesListSearch(paymentsSearch, item.PaymentTransactionId, item.PaymentDate.ToDisplayDate(), item.DirectionName, item.PaymentKindName, item.CashAccountName, item.Currency, item.Reference, item.LedgerEntryId))
        .ToList();
    var paymentsPageCount = PageCountFor(filteredPaymentItems.Count);
    var paymentsPage = Math.Min(ReadPositivePage("paymentsPage"), paymentsPageCount);
    var pagedPaymentItems = filteredPaymentItems
        .Skip((paymentsPage - 1) * journeyListPageSize)
        .Take(journeyListPageSize)
        .ToList();
    var settlementsSearch = ReadListSearch("settlementsQ");
    var filteredSarrafSettlements = Model.SarrafSettlementItems
        .Where(item => MatchesListSearch(settlementsSearch, item.SarrafSettlementId, item.SettlementDate.ToDisplayDate(), item.SarrafName, item.SupplierName, item.ReferenceNumber, item.Status, item.LedgerEntryId))
        .ToList();

    var loadingsTabModel = new ContractJourneyLoadingsTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        PageDirection = pageDirection,
        NoRecordsText = T("داده‌ای ثبت نشده است.", "No records yet."),
        PagerHtml = await DetailPager("loadingsPage", loadingPage, loadingPageCount),
        Pager = new ContractJourneyPagerViewModel
        {
            PageKey = "loadingsPage",
            CurrentPage = loadingPage,
            PageCount = loadingPageCount,
            Label = T("صفحه‌بندی بارگیری‌ها", "Loadings pagination")
        },
        Items = pagedLoadingItems
    };

    var receiptsTabModel = new ContractJourneyReceiptsTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        PageDirection = pageDirection,
        FirstLoadingId = firstLoading?.Id,
        BulkReceiptDefaultQuantityMt = pagedBulkReceiptCandidates.Sum(item => item.RemainingQuantityMt),
        PendingLoadingCount = bulkReceiptCandidates.Count,
        ReceiptCount = receiptCount,
        NoRecordsText = T("داده‌ای ثبت نشده است.", "No records yet."),
        PagerHtml = await DetailPager("receiptsPage", receiptPage, receiptPageCount),
        PendingPagerHtml = await DetailPager("pendingReceiptsPage", pendingReceiptPage, pendingReceiptPageCount),
        Pager = new ContractJourneyPagerViewModel
        {
            PageKey = "receiptsPage",
            CurrentPage = receiptPage,
            PageCount = receiptPageCount,
            Label = T("صفحه‌بندی رسیدها", "Receipts pagination")
        },
        BulkReceiptTerminals = bulkReceiptTerminals.ToList(),
        BulkReceiptStorageTanks = bulkReceiptStorageTanks.ToList(),
        BulkReceiptCandidates = pagedBulkReceiptCandidates,
        Items = pagedReceiptItems
    };

    var inventoryTabModel = new ContractJourneyInventoryTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        ProductName = Model.ProductName ?? string.Empty,
        ContractNumber = Model.ContractNumber ?? string.Empty,
        StockCardUrl = $"/Inventory/StockCard?Filter.ContractId={Model.ContractId}",
        NoRecordsText = T("داده‌ای ثبت نشده است.", "No records yet."),
        // وضعیت موجودی از کل حرکات جمع‌بندی می‌شود، پس فهرست کامل (بدون صفحه‌بندی) پاس داده می‌شود.
        Items = Model.InventoryMovementItems
    };

    var dispatchTabModel = new ContractJourneyDispatchTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        CreateUrl = Url.Action("Create", "Dispatch", new { contractId = Model.ContractId, returnUrl = ReturnUrl(ContractJourneyTabs.Details.Dispatch) }) ?? string.Empty,
        NoRecordsText = T("داده‌ای ثبت نشده است.", "No records yet."),
        PagerHtml = await DetailPager("dispatchPage", dispatchPage, dispatchPageCount),
        Pager = new ContractJourneyPagerViewModel
        {
            PageKey = "dispatchPage",
            CurrentPage = dispatchPage,
            PageCount = dispatchPageCount,
            Label = T("صفحه‌بندی نقل و انتقالات", "Transfers pagination")
        },
        Items = pagedDispatchItems
    };

    var salesTabModel = new ContractJourneySalesTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        IsPurchaseContract = Model.IsPurchaseContract,
        ReturnUrl = ReturnUrl(ContractJourneyTabs.Details.Sales),
        CreateUrl = Url.Action("Create", "Sales", new { contractId = Model.ContractId, returnUrl = ReturnUrl(ContractJourneyTabs.Details.Sales) }) ?? string.Empty,
        NoSalesText = T("داده‌ای ثبت نشده است.", "No records yet."),
        NoPreSalesText = T("داده‌ای ثبت نشده است.", "No records yet."),
        SalesPagerHtml = await DetailPager("salesPage", salesPage, salesPageCount),
        PreSalesPagerHtml = await DetailPager("preSalesPage", preSalesPage, preSalesPageCount),
        SalesPager = new ContractJourneyPagerViewModel
        {
            PageKey = "salesPage",
            CurrentPage = salesPage,
            PageCount = salesPageCount,
            Label = T("صفحه‌بندی فروش‌ها", "Sales pagination")
        },
        PreSalesPager = new ContractJourneyPagerViewModel
        {
            PageKey = "preSalesPage",
            CurrentPage = preSalesPage,
            PageCount = preSalesPageCount,
            Label = T("صفحه‌بندی پیش‌فروش", "Pre-sales pagination")
        },
        SalesItems = pagedSalesItems,
        PreSaleItems = pagedPreSaleItems
    };

    var financeTabModel = new ContractJourneyFinanceTabViewModel
    {
        ContractId = Model.ContractId,
        LockContract = Model.LockContract,
        CreateUrl = Url.Action("Create", "Payments", new { contractId = Model.ContractId, returnUrl = ReturnUrl(ContractJourneyTabs.Details.Finance) }) ?? string.Empty,
        SarrafSettlementCreateUrl = Url.Action("Create", "Payments", new { method = "sarraf", contractId = Model.ContractId, returnUrl = ReturnUrl(ContractJourneyTabs.Details.Finance) }) ?? string.Empty,
        SarrafSettlementIndexUrl = Url.Action("Index", "SarrafSettlements", new { contractId = Model.ContractId }) ?? string.Empty,
        BalanceTransferCreateUrl = Url.Action("Create", "ContractBalanceTransfers", new { fromContractId = Model.ContractId, returnUrl = ReturnUrl(ContractJourneyTabs.Details.Finance) }) ?? string.Empty,
        BalanceTransferIndexUrl = Url.Action("Index", "ContractBalanceTransfers", new { contractId = Model.ContractId }) ?? string.Empty,
        AccountStatementUrl = Url.Action("Contract", "AccountStatements", new { contractId = Model.ContractId }) ?? string.Empty,
        NoRecordsText = T("داده‌ای ثبت نشده است.", "No records yet."),
        PagerHtml = await DetailPager("paymentsPage", paymentsPage, paymentsPageCount),
        Pager = new ContractJourneyPagerViewModel
        {
            PageKey = "paymentsPage",
            CurrentPage = paymentsPage,
            PageCount = paymentsPageCount,
            Label = T("صفحه‌بندی پرداخت‌ها", "Payments pagination")
        },
        Summary = new ContractJourneyFinanceSummaryViewModel
        {
            DebitTotalText = $"{Model.LedgerSummary.DebitTotalUsd:N2} {UnitUsd()}",
            CreditTotalText = $"{Model.LedgerSummary.CreditTotalUsd:N2} {UnitUsd()}",
            BalanceText = $"{Model.LedgerSummary.BalanceUsd:N2} {UnitUsd()}",
            SupplierPayableTotalText = $"{supplierPayableTotalUsd:N2} {UnitUsd()}",
            SupplierPaidText = $"{supplierPaidNetUsd:N2} {UnitUsd()}",
            SupplierRemainingText = $"{supplierRemainingUsd:N2} {UnitUsd()}",
            SupplierRemainingToneClass = supplierRemainingToneClass,
            GrossMarginText = $"{Model.MiniPnl.GrossMarginUsd:N2} {UnitUsd()}",
            GrossMarginToneClass = pnlToneClass,
            // همان مفاد تحقق‌یافتهٔ کارت خلاصه (موتور مفاد قرارداد)؛ دو رقمِ مفاد در یک صفحه نمی‌آید.
            RealisedRevenueText = $"{Model.MiniPnl.TraceableSalesRevenueUsd:N2} {UnitUsd()}",
            RealisedCogsText = $"{Model.MiniPnl.CostOfGoodsSoldUsd + Model.MiniPnl.ExpensesForSoldUsd:N2} {UnitUsd()}",
            RealisedGrossProfitText = $"{pnlOperationalMarginUsd:N2} {UnitUsd()}",
            RealisedToneClass = pnlToneClass,
            RealisedConfidenceLabel = profitIsEstimate ? T("برآوردی", "Estimate") : T("قطعی", "Final"),
            RealisedConfidenceTone = profitIsEstimate ? "warning" : "success",
            RealisedUncostedWarning = null,
            RealisedVarianceText = null,
            RealisedVarianceReason = null,
            Note = LocalizeDisplay(Model.MiniPnl.Note)
        },
        Items = pagedPaymentItems,
        SarrafSettlements = filteredSarrafSettlements
    };
}

<div class="ak-form-page ak-detail-page" data-contract-journey-page data-ak-detail-v2="true" dir="@pageDirection">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"{T("قرارداد", "Contract")} {Model.ContractName}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)contractsListBackUrl))" />

    @if (contractIsClosed)
    {
        <div class="alert alert-info no-print" role="status" data-contract-closed-notice>
            <i class="bi bi-lock" aria-hidden="true"></i>
            @T("این قرارداد بسته شده است و فقط قابل مشاهده است؛ ثبت، ویرایش یا حذف عملیات روی آن قفل است.",
               "This contract is closed and read-only; recording, editing or deleting its operations is locked.")
        </div>
    }

    <div data-contract-journey-facts-host>
        @switch (activeTab)
        {
            case ContractJourneyTabs.Details.Loadings:
            <section class="ak-stat-grid" aria-label="@T("آمار بارگیری", "Loading statistics")">
                <vc:stat-card title="@T("تعداد بارگیری‌ها", "Loadings")" value="@loadingCount.ToString("N0")" unit="@T("بارگیری", "loadings")" avatar="loading-terminal"></vc:stat-card>
                <vc:stat-card title="@T("مقدار کل بارگیری‌شده", "Total loaded")" value="@NumberDisplay.Quantity(loadingQuantityMt)" unit="@UnitMt()" avatar="loading"></vc:stat-card>
                <vc:stat-card title="@T("مبلغ کل بارگیری", "Loading value")" value="@loadingValueUsd.ToString("N0")" unit="@UnitUsd()" avatar="purchase-value"></vc:stat-card>
                <vc:stat-card title="@T("ارزش روبلی بارگیری‌ها", "Loading value (RUB)")"
                              value="@(loadingValueRub.HasValue ? loadingValueRub.Value.ToString("N0") : "—")"
                              unit="@(loadingValueRub.HasValue ? (loadingValueRubIsEstimated ? T("روبل (تخمینی)", "RUB (estimated)") : T("روبل", "RUB")) : T("ثبت نشده", "not recorded"))"
                              avatar="purchase-value"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.Receipts:
            <section class="ak-stat-grid" aria-label="@T("آمار رسید بارگیری", "Receipt statistics")">
                @* تعداد بارگیری‌های منتظر و رسیدهای ثبت‌شده در عنوان دو بخش همین تب آمده است؛ کارت‌ها
                   تطبیق مقدار را نشان می‌دهند: بارگیری‌شده = رسیده + منتظر رسید + کسری رسید. *@
                <vc:stat-card title="@T("مقدار بارگیری‌شده", "Loaded quantity")" value="@NumberDisplay.Quantity(loadingQuantityMt)" unit="@UnitMt()" avatar="loading"></vc:stat-card>
                <vc:stat-card title="@T("مقدار رسیده", "Received quantity")" value="@NumberDisplay.Quantity(receiptQuantityMt)" unit="@UnitMt()" avatar="total-inventory"></vc:stat-card>
                <vc:stat-card title="@T("منتظر رسید", "Awaiting receipt")" value="@NumberDisplay.Quantity(bulkReceiptDefaultQuantityMt)" unit="@UnitMt()" avatar="transported" state="@(bulkReceiptDefaultQuantityMt > 0m ? "warning" : null)"></vc:stat-card>
                <vc:stat-card title="@T("کسری رسید", "Receipt shortage")" value="@NumberDisplay.Quantity(receiptShortageWastageMt)" unit="@UnitMt()" avatar="losses" state="@(receiptShortageWastageMt > 0m ? "warning" : null)"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.InventoryTransport:
            <section class="ak-stat-grid" aria-label="@T("آمار جریان حمل بار", "Cargo flow statistics")">
                <vc:stat-card title="@T("مقدار کل حمل", "Total transported")" value="@NumberDisplay.Quantity(transportLegQuantityMt)" unit="@UnitMt()" avatar="transported"></vc:stat-card>
                <vc:stat-card title="@T("مقدار در مسیر", "In transit")" value="@NumberDisplay.Quantity(transportLegInTransitMt)" unit="@UnitMt()" avatar="in-transit"></vc:stat-card>
                <vc:stat-card title="@T("مقدار رسیده", "Received")" value="@NumberDisplay.Quantity(transportLegReceivedMt)" unit="@UnitMt()" avatar="dispatch-station"></vc:stat-card>
                <vc:stat-card title="@T("کسری حمل", "Transport shortage")" value="@NumberDisplay.Quantity(transportLegShortageMt)" unit="@UnitMt()" avatar="losses" state="@(transportLegShortageMt > 0m ? "warning" : null)"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.Inventory:
            <section class="ak-stat-grid" aria-label="@T("آمار موجودی", "Inventory statistics")">
                @* هر سه رقم از همان حرکات موجودی این تب جمع می‌شود (مسیر سبک تب فقط حرکات را می‌خواند)،
                   پس با ستون‌های موجودی/ورودی/خروجی جدول همین تب یکی است. *@
                <vc:stat-card title="@T("موجودی دفتری", "Book stock")" value="@NumberDisplay.Quantity(inventoryBookBalanceMt)" unit="@UnitMt()" avatar="warehouse" state="@(inventoryBookBalanceMt < 0m ? "warning" : null)"></vc:stat-card>
                <vc:stat-card title="@T("مجموع ورودی", "Total in")" value="@NumberDisplay.Quantity(inventoryTotalInMt)" unit="@UnitMt()" avatar="total-inventory"></vc:stat-card>
                <vc:stat-card title="@T("مجموع خروجی", "Total out")" value="@NumberDisplay.Quantity(inventoryTotalOutMt)" unit="@UnitMt()" avatar="loading-terminal"></vc:stat-card>
                <vc:stat-card title="@T("تعداد حرکات موجودی", "Movements")" value="@inventoryMovementCount.ToString("N0")" unit="@T("حرکت", "moves")" avatar="ledger"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.Dispatch:
            <section class="ak-stat-grid" aria-label="@T("آمار نقل و انتقالات", "Transfer statistics")">
                <vc:stat-card title="@T("تعداد انتقال‌ها", "Transfers")" value="@dispatchCount.ToString("N0")" unit="@T("انتقال", "transfers")" avatar="transported"></vc:stat-card>
                <vc:stat-card title="@T("مقدار انتقال‌یافته", "Transferred quantity")" value="@NumberDisplay.Quantity(dispatchQuantityMt)" unit="@UnitMt()" avatar="total-inventory"></vc:stat-card>
                <vc:stat-card title="@T("تحویل‌شده", "Delivered")" value="@Model.DispatchItems.Count(d => string.Equals(d.StatusName, "Delivered", StringComparison.OrdinalIgnoreCase)).ToString("N0")" unit="@T("انتقال", "transfers")" avatar="dispatch-station"></vc:stat-card>
                @* کسری انتقال در تب «کسری و ضایعات» است؛ مسیر سبک این تب رویدادهای کسری را نمی‌خواند. *@
                <vc:stat-card title="@T("مقدار تخلیه‌شده", "Discharged quantity")" value="@NumberDisplay.Quantity(dispatchDischargedMt)" unit="@UnitMt()" avatar="warehouse"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.Sales:
            <section class="ak-stat-grid" aria-label="@T("آمار فروشات", "Sales statistics")">
                <vc:stat-card title="@T("مقدار فروخته‌شده", "Sold quantity")" value="@NumberDisplay.Quantity(soldQuantityMt)" unit="@UnitMt()" avatar="sold-quantity"></vc:stat-card>
                <vc:stat-card title="@T("مبلغ کل فروش", "Sales value")" value="@salesTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="sales-value"></vc:stat-card>
                @* مفاد تحقق‌یافته در تب خلاصه و پرداخت‌ها است؛ مسیر سبک این تب موتور مفاد و کسری‌ها را
                   نمی‌خواند، پس کارت‌ها فقط از ردیف‌های فروش همین تب ساخته می‌شوند. *@
                <vc:stat-card title="@T("اوسط نرخ فروش", "Average sale price")" value="@(salesAverageUsd.HasValue ? salesAverageUsd.Value.ToString("N2") : "—")" unit="@($"{UnitUsd()}/{UnitMt()}")" avatar="analysis"></vc:stat-card>
                <vc:stat-card title="@T("تعداد فروش‌ها", "Sales")" value="@salesCount.ToString("N0")" unit="@T("فروش", "sales")" avatar="documents"></vc:stat-card>
            </section>
                break;

            case ContractJourneyTabs.Details.Costs:
                @* مسیر سبک تب مصارف موتور مفاد و بارگیری‌ها را نمی‌خواند؛ کارت‌ها فقط از اسناد همین تب
                   جمع می‌شوند و با جمع جدول یکی‌اند. مجموع مصارفِ موتور مفاد در کارت ۴ خلاصه است. *@
                @if (isLossesView)
                {
            <section class="ak-stat-grid" aria-label="@T("آمار کسری و ضایعات", "Loss statistics")">
                <vc:stat-card title="@T("ضایعهٔ فزیکی", "Physical loss")" value="@NumberDisplay.Quantity(totalDisplayLossMt)" unit="@UnitMt()" avatar="losses" state="@(totalDisplayLossMt > 0m ? "warning" : null)"></vc:stat-card>
                <vc:stat-card title="@T("قابل‌جبران", "Chargeable")" value="@NumberDisplay.Quantity(summaryChargeableLossMt)" unit="@UnitMt()" avatar="statement"></vc:stat-card>
                <vc:stat-card title="@T("بخشیده‌شده", "Allowed")" value="@NumberDisplay.Quantity(summaryAllowedLossMt)" unit="@UnitMt()" avatar="rules-checklist"></vc:stat-card>
                <vc:stat-card title="@T("تعداد رویدادها", "Loss records")" value="@Model.LossItems.Count.ToString("N0")" unit="@T("مورد", "records")" avatar="documents"></vc:stat-card>
            </section>
                }
                else
                {
            <section class="ak-stat-grid" aria-label="@T("آمار مصارف", "Expense statistics")">
                <vc:stat-card title="@T("مجموع اسناد مصرف", "Expense documents total")" value="@expenseTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="expenses"></vc:stat-card>
                <vc:stat-card title="@T("مصارف عمومی قرارداد", "Contract-level expenses")" value="@contractLevelExpenseTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="analysis"></vc:stat-card>
                <vc:stat-card title="@T("مصارف جریان حمل بار", "Cargo flow expenses")" value="@inventoryTransportExpenseTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="transported"></vc:stat-card>
                <vc:stat-card title="@T("تعداد اسناد مصرف", "Expense documents")" value="@expenseCount.ToString("N0")" unit="@T("سند", "documents")" avatar="documents"></vc:stat-card>
            </section>
                }
                break;

            case ContractJourneyTabs.Details.Finance:
            <section class="ak-stat-grid" aria-label="@T("آمار پرداخت‌ها", "Payment statistics")">
                @if (Model.IsPurchaseContract)
                {
                    @* «قابل پرداخت» ارزش خرید قیمت‌دار قرارداد است، نه ارزش کل قرارداد. *@
                    <vc:stat-card title="@T("قابل پرداخت به تأمین‌کننده", "Payable to supplier")" value="@supplierPayableTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="contract-signed"></vc:stat-card>
                    <vc:stat-card title="@T("پرداخت/تسویه‌شده", "Paid or settled")" value="@supplierPaidNetUsd.ToString("N0")" unit="@UnitUsd()" avatar="payments-out"></vc:stat-card>
                    <vc:stat-card title="@T("مانده قابل پرداخت", "Remaining payable")" value="@supplierRemainingUsd.ToString("N0")" unit="@UnitUsd()" avatar="receivables" state="@(supplierRemainingUsd > 0m ? "warning" : null)"></vc:stat-card>
                }
                else
                {
                    <vc:stat-card title="@T("جمع اسناد ثبت‌شده", "Recorded documents total")" value="@paymentTotalUsd.ToString("N0")" unit="@UnitUsd()" avatar="cash-flow"></vc:stat-card>
                }
                <vc:stat-card title="@T("تعداد پرداخت‌ها", "Payments")" value="@paymentCount.ToString("N0")" unit="@T("پرداخت", "payments")" avatar="documents"></vc:stat-card>
            </section>
                break;
        }
    </div>

    <partial name="_ContractJourneyDetailTabsRail" model="detailTabsRailModel" />

    <div class="ak-tab-content ak-detail-content"
         data-contract-journey-tab-content="true"
         data-active-tab="@activeTab"
         data-loading-text="@T("در حال بارگذاری...", "Loading...")"
         data-error-text="@T("خطا در دریافت اطلاعات. دوباره تلاش کنید.", "Could not load this tab. Try again.")">

    @if (groupedSection.Tab is not null || isLossesView)
    {
        <header class="ak-section-head" data-contract-journey-section-title>
            <h2 class="ak-section-title">@primarySectionTitle</h2>
            @if (isLossesView)
            {
                <a href="@ReturnUrl(ContractJourneyTabs.Details.Summary)" data-contract-journey-tab-link="true" data-no-spa="true" class="ak-name">@T("بازگشت به خلاصه", "Back to summary")</a>
            }
        </header>
    }

    @if (activeTab == ContractJourneyTabs.Details.Summary)
    {
        <div id="journey-tab-lists" class="ak-summary-page">
            <section class="ak-form-section ak-detail-section ak-journey-section">
                @{
                    // چرخه قرارداد: هفت مرحله ثابت و هر مرحله دقیقاً دو آمار.
                    // وضعیت هر مرحله فقط نمایشی است و از همان اعدادِ موجود بالا مشتق
                    // می‌شود؛ هیچ محاسبهٔ مالی تازه‌ای اینجا انجام نمی‌شود.
                    const string StepDone = "is-done";
                    const string StepCurrent = "is-current";
                    const string StepPending = "is-pending";
                    const string StepWarn = "is-warn";
                    const string StepGain = "is-gain";
                    const string StepLoss = "is-loss";

                    var loadingState = loadingQuantityMt <= 0m
                        ? StepPending
                        : (remainingToLoadMt > 0m ? StepCurrent : StepDone);
                    var salesState = soldQuantityMt <= 0m
                        ? StepPending
                        : (lifecycleSaleableQuantityMt > 0m ? StepCurrent : StepDone);
                    var expenseState = summaryExpenseTotalUsd > 0m ? StepDone : StepPending;
                    var lossState = totalDisplayLossMt > 0m ? StepWarn : StepDone;
                    var paymentState = supplierRemainingUsd > 0m
                        ? StepWarn
                        : (supplierPaidNetUsd > 0m || supplierPayableTotalUsd > 0m ? StepDone : StepPending);
                    var resultState = soldQuantityMt <= 0m
                        ? StepPending
                        : (lifecycleProfitUsd < 0m ? StepLoss : StepGain);

                    string StepBadgeText(string state) => state switch
                    {
                        StepDone => T("تکمیل", "Done"),
                        StepCurrent => T("در جریان", "In progress"),
                        StepWarn => T("نیاز به توجه", "Needs attention"),
                        StepGain => T("سودده", "Profitable"),
                        StepLoss => T("زیان‌ده", "Loss"),
                        _ => T("در انتظار", "Pending")
                    };

                    string StepBadgeIcon(int number, string state) => state switch
                    {
                        StepDone => "bi-check-circle-fill",
                        StepCurrent => "bi-clock",
                        StepWarn => number == 5 ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill",
                        StepGain => "bi-arrow-up-circle-fill",
                        StepLoss => "bi-arrow-down-circle-fill",
                        _ => "bi-hourglass-split"
                    };

                    var journeySteps = new List<(int Number, string AvatarKey, string Title, string State, string FirstLabel, string FirstValue, string SecondLabel, string SecondValue)>
                    {
                        (1, "contract-document", T("قرارداد", "Contract"), StepDone,
                            T("مقدار کل قرارداد", "Contract quantity"), FormatLifecycleQuantity(Model.ContractQuantityMt),
                            T("ارزش قرارداد", "Contract value"), FormatHeaderValueUsd(contractDisplayValueUsd)),
                        (2, "products", T("بارگیری و موجودی", "Loading & stock"), loadingState,
                            T("بارگیری‌شده", "Loaded"), FormatLifecycleQuantity(loadingQuantityMt),
                            T("باقی‌مانده بارگیری", "Remaining to load"), FormatLifecycleQuantity(remainingToLoadMt)),
                        (3, "flow-truck", T("فروشات", "Sales"), salesState,
                            T("فروخته‌شده", "Sold"), FormatLifecycleQuantity(soldQuantityMt),
                            T("ارزش فروخته‌شده", "Sold value"), FormatLifecycleUsd(salesTotalUsd)),
                        (4, "flow-calculator", T("هزینه‌ها", "Expenses"), expenseState,
                            T("مجموع مصارف", "Total expenses"), FormatLifecycleUsd(summaryExpenseTotalUsd),
                            T("اوسط مصرف بر تن", "Expense per MT"), FormatLifecycleRate(summaryExpensePerLoadedMt)),
                        (5, "contract-losses", T("ضایعات", "Losses"), lossState,
                            T("مقدار ضایعات", "Loss quantity"), FormatLifecycleQuantity(totalDisplayLossMt),
                            T("ارزش کسری قابل‌جبران", "Chargeable loss cost"), FormatLifecycleUsd(summaryLossCostUsd)),
                        (6, "payments-out", T("پرداخت‌ها", "Payments"), paymentState,
                            T("پرداخت‌شده", "Paid"), FormatLifecycleUsd(supplierPaidNetUsd),
                            T("مانده قابل پرداخت", "Remaining payable"), FormatLifecycleUsd(supplierRemainingUsd)),
                        (7, "contract-profit", T("سود و زیان", "Profit & loss"), resultState,
                            T("سود کلی قرارداد", "Total contract profit"), FormatLifecycleUsd(lifecycleProfitUsd),
                            T("حاشیه سود", "Margin"), $"{NumberDisplay.Number(salesTotalUsd > 0m ? lifecycleProfitUsd / salesTotalUsd * 100m : 0m, 2)}%")
                    };

                    // جهت فلش‌ها: ردیف اول راست→چپ، ردیف دوم چپ→راست، ردیف سوم دوباره راست→چپ
                    // (در چیدمان LTR برعکس). مرحله‌های ۳ و ۶ مسیر را به ردیف بعد می‌سپارند.
                    var forwardArrowIcon = T("bi-chevron-left", "bi-chevron-right");
                    var backwardArrowIcon = T("bi-chevron-right", "bi-chevron-left");

                    // قرارداد شراکتی: سهم هر شریک کنار کارت سود و زیان می‌نشیند. کارت‌ها
                    // شماره و فلش ندارند چون مرحلهٔ چرخه نیستند؛ درصدِ ثبت‌شده در قرارداد
                    // ضربدر مقدار، ارزش و مفاد همین قرارداد است و هیچ عدد مالی تازه‌ای نمی‌سازد.
                    var partnerShareProfitLabel = pnlOperationalMarginUsd < 0m
                        ? T("سهم ضرر", "Share of loss")
                        : T("سهم مفاد", "Share of profit");
                    var partnerShareCards = Model.PartnerShareItems
                        .Where(_ => Model.IsPartnershipContract)
                        .Select(partner => new
                        {
                            partner.PartnerName,
                            partner.SharePercent,
                            ShareQuantityMt = Model.ContractQuantityMt * partner.SharePercent / 100m,
                            ShareValueUsd = contractDisplayValueUsd * partner.SharePercent / 100m,
                            ShareProfitUsd = pnlOperationalMarginUsd * partner.SharePercent / 100m
                        })
                        .ToList();
                }
                <header class="ak-section-head ak-journey-head">
                    <h2 class="ak-section-title"><i class="bi bi-diagram-2" aria-hidden="true"></i>@T("چرخه قرارداد", "Contract lifecycle")</h2>
                </header>
                <ol class="ak-journey-flow">
                    @foreach (var step in journeySteps)
                    {
                        var avatarCrop = ReferenceAvatarViewBox(step.Number).Split(' ');
                        var arrowIcon = step.Number is 3 or 6
                            ? "bi-chevron-down"
                            : (step.Number < 3 ? forwardArrowIcon : backwardArrowIcon);
                        <li class="ak-journey-step ak-journey-step--@step.Number @step.State">
                            <span class="ak-journey-step-num">@step.Number</span>
                            <svg class="ak-cycle-avatar" viewBox="@ReferenceAvatarViewBox(step.Number)" aria-hidden="true" focusable="false" width="140" height="140">
                                <defs><clipPath id="journey-cycle-art-@step.Number" clipPathUnits="userSpaceOnUse"><rect x="@avatarCrop[0]" y="@avatarCrop[1]" width="@avatarCrop[2]" height="@avatarCrop[3]" /></clipPath></defs>
                                <image href="@Url.Content("~/images/contract-journey/cycle-artwork.png")" width="1417" height="787" clip-path="url(#journey-cycle-art-@step.Number)" />
                            </svg>
                            <div class="ak-cycle-body">
                                <div class="ak-journey-step-head">
                                    <h3 class="ak-cycle-title">
                                        @if (step.Number == 5)
                                        {
                                            <a href="@ReturnUrl(LossesPresentationTab)" data-contract-journey-tab-link="true" data-no-spa="true">@step.Title</a>
                                        }
                                        else
                                        {
                                            @step.Title
                                        }
                                    </h3>
                                    <span class="ak-journey-badge"><i class="bi @StepBadgeIcon(step.Number, step.State)" aria-hidden="true"></i>@StepBadgeText(step.State)</span>
                                </div>
                                <div class="ak-cycle-row"><span class="ak-cycle-label">@step.FirstLabel</span><span class="ak-cycle-value @(step.Number is 1 or 2 or 3 or 5 ? "ak-cycle-quantity" : null)">@(step.Number is 1 or 2 or 3 or 5 ? LifecycleQuantityMarkup(step.FirstValue) : new Microsoft.AspNetCore.Html.HtmlContentBuilder().Append(step.FirstValue))</span></div>
                                <div class="ak-cycle-row"><span class="ak-cycle-label">@step.SecondLabel</span><span class="ak-cycle-value @(step.Number == 2 ? "ak-cycle-quantity" : null)">@(step.Number == 2 ? LifecycleQuantityMarkup(step.SecondValue) : new Microsoft.AspNetCore.Html.HtmlContentBuilder().Append(step.SecondValue))</span></div>
                            </div>
                            @if (step.Number < journeySteps.Count)
                            {
                                <span class="ak-journey-arrow" aria-hidden="true"><i class="bi @arrowIcon"></i></span>
                            }
                        </li>
                    }
                    @foreach (var partner in partnerShareCards)
                    {
                        var partnerAvatarCrop = ReferenceAvatarViewBox(0).Split(' ');
                        var partnerAvatarId = $"journey-partner-art-{partnerShareCards.IndexOf(partner)}";
                        @* کارت شریک: متن در ابتدای سطر و کاشی آواتار با درصد سهم در انتهای آن. *@
                        <li class="ak-journey-step ak-journey-partner" data-partner-share="true">
                            <div class="ak-cycle-body">
                                <div class="ak-journey-step-head">
                                    <h3 class="ak-cycle-title">@TextOrDash(partner.PartnerName)</h3>
                                </div>
                                <div class="ak-cycle-row"><span class="ak-cycle-label">@T("سهم مقدار", "Share quantity")</span><span class="ak-cycle-value ak-cycle-quantity">@LifecycleQuantityMarkup(FormatLifecycleQuantity(partner.ShareQuantityMt))</span></div>
                                <div class="ak-cycle-row"><span class="ak-cycle-label">@T("سهم ارزش", "Share value")</span><span class="ak-cycle-value">@FormatHeaderValueUsd(partner.ShareValueUsd)</span></div>
                                <div class="ak-cycle-row"><span class="ak-cycle-label">@partnerShareProfitLabel</span><span class="ak-cycle-value">@FormatLifecycleUsd(partner.ShareProfitUsd)</span></div>
                            </div>
                            <div class="ak-journey-partner-tile">
                                <svg class="ak-cycle-avatar" viewBox="@ReferenceAvatarViewBox(0)" aria-hidden="true" focusable="false" width="120" height="120">
                                    <defs><clipPath id="@partnerAvatarId" clipPathUnits="userSpaceOnUse"><rect x="@partnerAvatarCrop[0]" y="@partnerAvatarCrop[1]" width="@partnerAvatarCrop[2]" height="@partnerAvatarCrop[3]" /></clipPath></defs>
                                    <image href="@Url.Content("~/images/contract-journey/cycle-artwork.png")" width="1417" height="787" clip-path="url(#@partnerAvatarId)" />
                                </svg>
                                <span class="ak-journey-partner-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                                <span class="ak-journey-partner-share"><span class="visually-hidden">@T("سهم", "Share") </span>@NumberDisplay.Number(partner.SharePercent, 2)%</span>
                            </div>
                        </li>
                    }
                </ol>
            </section>

            @if (Model.SubContractItems.Any())
            {
                <section class="ak-form-section ak-detail-section" data-sub-contracts>
                    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                             model="@((T("زیرقراردادها", "Sub-contracts"), (string?)T("گزارش تجمیعی؛ بارگیری، پرداخت و دفتر کل روی همان زیرقرارداد باقی می‌ماند.", "Aggregated report only; loadings, payments and ledger stay on each sub-contract.")))" />
                    <partial name="_ContractJourneyListFilter"
                             model="@(("subContractsQ", (string?)subContractsSearch, T("جستجو در زیرقراردادها...", "Search sub-contracts..."), "subContractsPage"))" />
                    <div class="ak-table-wrap">
                        <table class="ak-table ak-detail-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-grow">@T("زیرقرارداد", "Sub-contract")</th>
                                    <th class="ak-col-num">@T("مقدار قرارداد", "Contract quantity")</th>
                                    <th class="ak-col-num">@T("بارگیری‌شده", "Loaded")</th>
                                    <th class="ak-col-num">@T("باقی‌مانده", "Remaining")</th>
                                    <th class="ak-col-num">@T("ارزش بارگیری‌ها", "Loadings value")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subContract in filteredSubContractItems)
                                {
                                    <tr>
                                        <td class="ak-col-grow">
                                            <a asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@subContract.ContractId">@subContract.DisplayLabel</a>
