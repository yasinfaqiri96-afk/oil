@model PTGOilSystem.Web.Models.Entities.CashAccount
@using PTGOilSystem.Web.Models.Payments
@using PTGOilSystem.Web.Models.Shared
@{
    var transactions = ViewBag.StatementRows as IReadOnlyList<CashAccountStatementRowViewModel> ?? Array.Empty<CashAccountStatementRowViewModel>();
    object? totalInObject = ViewBag.TotalIn;
    object? totalOutObject = ViewBag.TotalOut;
    object? closingBalanceObject = ViewBag.ClosingBalance;
    var totalIn = totalInObject is decimal totalInValue ? totalInValue : 0m;
    var totalOut = totalOutObject is decimal totalOutValue ? totalOutValue : 0m;
    var closingBalance = closingBalanceObject is decimal closingBalanceValue ? closingBalanceValue : 0m;
    // واحدِ جمع‌ها: ارزِ خودِ حساب، یا دالر وقتی اسنادِ ارزِ دیگری هم روی همین حساب ثبت شده باشد.
    var totalsCurrency = ViewBag.TotalsCurrency as string ?? Model.Currency;
    var missingUsdCount = ViewBag.MissingUsdEquivalentCount is int missingUsdValue ? missingUsdValue : 0;
    var closingUnit = missingUsdCount > 0 && totalsCurrency == "USD"
        ? $"USD · {missingUsdCount:N0} سند بدون معادل USD"
        : totalsCurrency;
    ViewData["Title"] = $"حساب {Model.Code}";
    ViewData["HideSectionTabs"] = true;

    var statusText = Model.IsActive ? "فعال" : "غیرفعال";
    var editUrl = Url.Action("Edit", new { id = Model.Id }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";
    var createPaymentUrl = Url.Action("Create", "Payments", new { cashAccountId = Model.Id, returnUrl = Context.Request.Path }) ?? "#";
    ViewData["AkHeaderStatus"] = statusText;
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = string.IsNullOrWhiteSpace(Model.BankName) ? Model.Name : $"{Model.Name} · {Model.BankName}";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = UiText.T(Context, "ویرایش", "Edit"), Href = editUrl, Icon = "bi-pencil" }
    };
    // مشخصات و تراکنش‌ها در یک صفحهٔ واحد: کارت‌های آماری، خلاصهٔ حساب، سپس جدول تراکنش‌ها.
    var accountKpis = new List<AkKpiItem>
    {
        new() { Title = "مانده آغاز", Value = "0.00", Unit = totalsCurrency, Avatar = "treasury" },
        new() { Title = "دریافت‌ها", Value = totalIn.ToString("N2"), Unit = totalsCurrency, Avatar = "receipts", State = "success" },
        new() { Title = "پرداخت‌ها", Value = totalOut.ToString("N2"), Unit = totalsCurrency, Avatar = "payments-out", State = "danger" },
        new() { Title = "مانده پایان", Value = closingBalance.ToString("N2"), Unit = closingUnit, Avatar = "statement" }
    };
    var accountInfo = new List<AkInfoItem>
    {
        new() { Label = "کد", Value = Model.Code },
        new() { Label = "نام", Value = Model.Name },
        new() { Label = "نوع حساب", Value = Model.AccountType.ToString() },
        new() { Label = "ارز", Value = Model.Currency },
        new() { Label = "شماره حساب", Value = Model.AccountNumber, IsNumeric = true },
        new() { Label = "نام بانک", Value = Model.BankName },
        new() { Label = "شعبه", Value = Model.Branch },
        new() { Label = "وضعیت", Value = statusText, Tone = Model.IsActive ? "success" : "warning" },
        new() { Label = "تاریخ ایجاد", Value = Model.CreatedAtUtc.ToDisplayDateTime() },
        new() { Label = "یادداشت", Value = Model.Notes, IsWide = true }
    };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(($"حساب {Model.Code}", false,
                       UiText.T(Context, "ثبت تراکنش", "Record transaction"), "bi-cash-coin", createPaymentUrl, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)accountKpis)" />

    <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
             model="@(("مشخصات حساب", (string?)null, (IReadOnlyList<AkInfoItem>)accountInfo))" />

    <section id="account-ledger" class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("تراکنش‌ها", (string?)transactions.Count.ToString("N0")))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>نوع</th>
                        <th class="ak-col-grow">طرف حساب</th>
                        <th class="ak-col-priority-2">قرارداد</th>
                        <th class="ak-col-num">مبلغ</th>
                        <th>مرجع</th>
                        <th class="ak-col-priority-3">دفتر کل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in transactions)
                    {
                        <tr>
                            <td>@row.EntryDate.ToDisplayDate()</td>
                            <td><span class="ak-status @(row.Direction == PaymentDirection.In ?"is-active" : "")">@row.KindName</span></td>
                            <td class="ak-col-grow">@row.CounterpartyName</td>
                            <td class="ak-col-priority-2">@(row.ContractNumber ?? "—")</td>
                            <td class="ak-col-num ak-num">@row.Amount.ToString("N2") @row.Currency</td>
                            @* مرجعِ سطر به سندِ خودش می‌رود: رزنامچه یا مصرفِ نقدی. *@
                            <td><a asp-controller="@(row.Source == "Expense" ? "Expenses" : "Payments")" asp-action="Details" asp-route-id="@row.Id">@(string.IsNullOrWhiteSpace(row.Reference) ? $"#{row.Id}" : row.Reference)</a></td>
                            <td class="ak-col-priority-3">
                                @if (row.LedgerEntryId.HasValue)
                                {
                                    <a asp-controller="Ledger" asp-action="Details" asp-route-id="@row.LedgerEntryId.Value">#@row.LedgerEntryId</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!transactions.Any())
                    {
                        <tr>
                            <td colspan="7"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-bank"></i> دریافت‌ها و پرداخت‌های رزنامچه و مصارفِ نقدیِ این صندوق/بانک اینجا دیده می‌شود.</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
