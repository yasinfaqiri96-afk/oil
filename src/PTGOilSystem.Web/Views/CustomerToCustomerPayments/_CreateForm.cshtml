@model CustomerToCustomerPayment

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

<div class="ctc-transfer-form" data-ctc-transfer dir="@(UiText.IsEn(Context) ? "ltr" : "rtl")">
    <div class="ctc-transfer-intro">
        <div>
            <span class="ak-section-desc">@UiText.T(Context, "ثبت و تصویب بین طرف‌حساب‌ها", "Direct customer transfer")</span>
            <h2 class="ak-section-title">@UiText.T(Context, "انتقال مستقیم پول بین مشتریان", "Direct transfer between customers")</h2>
            <p class="ak-section-desc">@UiText.T(Context, "فرستنده و گیرنده را انتخاب کنید، سپس مبلغ انتقال را یک‌بار ثبت نمایید.", "Choose the sender and recipient, then enter the transfer amount once.")</p>
        </div>
        <div class="ctc-info-note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>@UiText.T(Context, "این سند گزارش انتقال مستقیم است و صندوق، دفتر کل و سود و زیان شرکت را تغییر نمی‌دهد.", "This record reports a direct transfer and does not change company cash, ledger, or P&L.")</span>
        </div>
    </div>

    <div class="ctc-party-grid">
        <section class="ctc-party-card ctc-party-card--payee" aria-labelledby="ctc-payee-title">
            <header class="ctc-party-header">
                <div class="ctc-party-heading">
                    <span class="ctc-party-icon"><i class="bi bi-arrow-down-left" aria-hidden="true"></i></span>
                    <div>
                        <span class="ctc-party-kicker">@UiText.T(Context, "مقصد دریافت", "Payment destination")</span>
                        <h3 id="ctc-payee-title">@UiText.T(Context, "طرف گیرنده", "Recipient")</h3>
                    </div>
                </div>
                <button type="button" class="btn btn-light ak-secondary-action" data-ctc-clear="PayeeCustomerId">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                    @UiText.T(Context, "حذف", "Clear")
                </button>
            </header>
            <div class="ctc-party-body">
                <div class="ak-field ctc-field--wide">
                    <label asp-for="PayeeCustomerId" class="ak-label">@UiText.T(Context, "انتخاب مشتری دریافت‌کننده", "Select recipient customer") <span class="ak-req">*</span></label>
                    <select asp-for="PayeeCustomerId" asp-items="@(ViewBag.PayeeCustomers as SelectList)" class="ak-input">
                        <option value="">@UiText.T(Context, "انتخاب مشتری دریافت‌کننده", "Select recipient customer")</option>
                    </select>
                    <span asp-validation-for="PayeeCustomerId" class="ak-field-error"></span>
                </div>
                <div class="ak-field ctc-field--wide">
                    <label class="ak-label" for="ctc-payee-display">@UiText.T(Context, "نام طرف حساب", "Customer name")</label>
                    <input id="ctc-payee-display" class="ak-input ctc-display-control" value="@(Model.PayeeCustomer?.Name ?? "")" placeholder="@UiText.T(Context, "پس از انتخاب مشتری نمایش داده می‌شود", "Shown after choosing a customer")" readonly />
                </div>
                <div class="ctc-amount-row">
                    <div class="ak-field">
                        <label asp-for="Amount" class="ak-label">@UiText.T(Context, "مبلغ دریافت", "Amount received") <span class="ak-req">*</span></label>
                        <input asp-for="Amount" type="number" step="0.0001" min="0" class="ak-input ak-number" data-ctc-amount />
                        <span asp-validation-for="Amount" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field ctc-currency-field">
                        <label asp-for="Currency" class="ak-label">@UiText.T(Context, "ارز", "Currency")</label>
                        <select asp-for="Currency" asp-items="@(ViewBag.Currencies as SelectList)" class="ak-input" data-ctc-currency></select>
                        <span asp-validation-for="Currency" class="ak-field-error"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="ctc-party-card ctc-party-card--payer" aria-labelledby="ctc-payer-title">
            <header class="ctc-party-header">
                <div class="ctc-party-heading">
                    <span class="ctc-party-icon"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
                    <div>
                        <span class="ctc-party-kicker">@UiText.T(Context, "مبدأ پرداخت", "Payment source")</span>
                        <h3 id="ctc-payer-title">@UiText.T(Context, "طرف فرستنده", "Sender")</h3>
                    </div>
                </div>
                <button type="button" class="btn btn-light ak-secondary-action" data-ctc-clear="PayerCustomerId">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                    @UiText.T(Context, "حذف", "Clear")
                </button>
            </header>
            <div class="ctc-party-body">
                <div class="ak-field ctc-field--wide">
                    <label asp-for="PayerCustomerId" class="ak-label">@UiText.T(Context, "انتخاب مشتری پرداخت‌کننده", "Select payer customer") <span class="ak-req">*</span></label>
                    <select asp-for="PayerCustomerId" asp-items="@(ViewBag.PayerCustomers as SelectList)" class="ak-input">
                        <option value="">@UiText.T(Context, "انتخاب مشتری پرداخت‌کننده", "Select payer customer")</option>
                    </select>
                    <span asp-validation-for="PayerCustomerId" class="ak-field-error"></span>
                </div>
                <div class="ak-field ctc-field--wide">
                    <label class="ak-label" for="ctc-payer-display">@UiText.T(Context, "نام طرف حساب", "Customer name")</label>
                    <input id="ctc-payer-display" class="ak-input ctc-display-control" value="@(Model.PayerCustomer?.Name ?? "")" placeholder="@UiText.T(Context, "پس از انتخاب مشتری نمایش داده می‌شود", "Shown after choosing a customer")" readonly />
                </div>
                <div class="ctc-amount-row">
                    <div class="ak-field">
                        <label class="ak-label" for="ctc-payer-amount">@UiText.T(Context, "مبلغ پرداخت", "Amount paid")</label>
                        <input id="ctc-payer-amount" class="ak-input ak-number ctc-display-control" value="@Model.Amount.ToString("0.####")" data-ctc-amount-mirror readonly />
                    </div>
                    <div class="ak-field ctc-currency-field">
                        <label class="ak-label" for="ctc-payer-currency">@UiText.T(Context, "ارز", "Currency")</label>
                        <input id="ctc-payer-currency" class="ak-input ctc-display-control" value="@Model.Currency" data-ctc-currency-mirror readonly />
                    </div>
                </div>
            </div>
        </section>
    </div>

    <section class="ctc-details-card" aria-labelledby="ctc-details-title">
        <div class="ctc-details-heading">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            <div>
                <h3 id="ctc-details-title">@UiText.T(Context, "جزئیات ثبت", "Record details")</h3>
                <span>@UiText.T(Context, "اطلاعات سند برای پیگیری و چاپ رسید", "Document information for tracking and receipt printing")</span>
            </div>
        </div>
        <div class="ctc-details-grid">
            <div class="ak-field">
                <label asp-for="PaymentDate" class="ak-label">@UiText.T(Context, "تاریخ", "Date") <span class="ak-req">*</span></label>
                <input asp-for="PaymentDate" type="date" class="ak-input" />
                <span asp-validation-for="PaymentDate" class="ak-field-error"></span>
            </div>
            <div class="ak-field">
                <label asp-for="Reference" class="ak-label">@UiText.T(Context, "شماره مرجع", "Reference number")</label>
                <input asp-for="Reference" class="ak-input" placeholder="@UiText.T(Context, "اختیاری", "Optional")" />
                <span asp-validation-for="Reference" class="ak-field-error"></span>
            </div>
            <div class="ak-field ctc-field--wide">
                <label asp-for="Description" class="ak-label">@UiText.T(Context, "توضیحات", "Notes")</label>
                <textarea asp-for="Description" class="ak-input ctc-textarea" rows="3" placeholder="@UiText.T(Context, "توضیح اختیاری دربارهٔ انتقال", "Optional transfer notes")"></textarea>
                <span asp-validation-for="Description" class="ak-field-error"></span>
            </div>
        </div>
    </section>
</div>
