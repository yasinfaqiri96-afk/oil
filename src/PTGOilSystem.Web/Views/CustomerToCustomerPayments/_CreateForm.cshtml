@model CustomerToCustomerPayment

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

<div class="alert alert-info ak-form-alert">
    @UiText.T(Context,
        "این ثبت فقط برای گزارش است و روی صندوق، دفتر کل، ماندهٔ مشتریان نزد شرکت و سود و زیان اثری ندارد.",
        "Record only: it does not affect cash, ledger, customer balances with the company, or P&L.")
</div>

<section class="ak-form-section">
    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
             model="@((UiText.T(Context, "پرداخت بین مشتریان", "Customer-to-customer payment"), (string?)UiText.T(Context, "چه کسی به چه کسی، چه مبلغی داد.", "Who paid whom, and how much.")))" />
    <div class="ak-form-grid">
        <div class="ak-field">
            <label asp-for="PaymentDate" class="ak-label">@UiText.T(Context, "تاریخ", "Date") <span class="ak-req">*</span></label>
            <input asp-for="PaymentDate" type="date" class="ak-input" />
            <span asp-validation-for="PaymentDate" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="PayerCustomerId" class="ak-label">@UiText.T(Context, "مشتری پرداخت‌کننده", "Payer customer") <span class="ak-req">*</span></label>
            <select asp-for="PayerCustomerId" asp-items="@(ViewBag.PayerCustomers as SelectList)" class="ak-input">
                <option value="">@UiText.T(Context, "- انتخاب مشتری -", "- Select customer -")</option>
            </select>
            <span asp-validation-for="PayerCustomerId" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="PayeeCustomerId" class="ak-label">@UiText.T(Context, "مشتری دریافت‌کننده", "Payee customer") <span class="ak-req">*</span></label>
            <select asp-for="PayeeCustomerId" asp-items="@(ViewBag.PayeeCustomers as SelectList)" class="ak-input">
                <option value="">@UiText.T(Context, "- انتخاب مشتری -", "- Select customer -")</option>
            </select>
            <span asp-validation-for="PayeeCustomerId" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="Amount" class="ak-label">@UiText.T(Context, "مبلغ", "Amount") <span class="ak-req">*</span></label>
            <input asp-for="Amount" type="number" step="0.0001" min="0" class="ak-input" />
            <span asp-validation-for="Amount" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="Currency" class="ak-label">@UiText.T(Context, "ارز", "Currency") <span class="ak-req">*</span></label>
            <select asp-for="Currency" asp-items="@(ViewBag.Currencies as SelectList)" class="ak-input"></select>
            <span asp-validation-for="Currency" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="Reference" class="ak-label">@UiText.T(Context, "شماره مرجع", "Reference")</label>
            <input asp-for="Reference" class="ak-input" />
            <span asp-validation-for="Reference" class="ak-field-error"></span>
        </div>
        <div class="ak-field ak-col-full">
            <label asp-for="Description" class="ak-label">@UiText.T(Context, "توضیحات", "Description")</label>
            <textarea asp-for="Description" class="ak-input" rows="2"></textarea>
            <span asp-validation-for="Description" class="ak-field-error"></span>
        </div>
    </div>
</section>
