@model PTGOilSystem.Web.Models.Balance.ContractsBalanceViewModel
@{
    ViewData["Title"] = UiText.T(Context,"بیلانس قراردادها","Contract Balances");
    var totalSalesUsd = Model.FilteredTotalSalesUsd;
    var totalExpensesUsd = Model.FilteredTotalExpensesUsd;
    var totalBaseBalanceUsd = Model.FilteredBalanceUsd;
    var hasAdvancedFilter = Model.Filter.FromDate.HasValue || Model.Filter.ToDate.HasValue
        || Model.Filter.ProductId.Length > 0 || Model.Filter.CustomerId.Length > 0 || Model.Filter.SupplierId.Length > 0;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context,"بیلانس قراردادها","Contract Balances"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index", "Reports")))" />

    @* چهار کارت همان جمع ستون‌های پولی جدول است، روی همهٔ نتایج فیلتر. *@
    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار بیلانس قراردادها", "Contract balance metrics")">
        <vc:stat-card title="@UiText.T(Context,"ارزش خرید","Purchase value")" value="@Model.FilteredTotalPurchaseValueUsd.ToString("N2")" unit="USD" avatar="purchase-value"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مصارف","Expenses")" value="@totalExpensesUsd.ToString("N2")" unit="USD" avatar="expenses"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"فروشات","Sales")" value="@totalSalesUsd.ToString("N2")" unit="USD" avatar="sales-value"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مانده","Balance")" value="@totalBaseBalanceUsd.ToString("N2")" unit="USD" avatar="statement"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> BkOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            string? BkQ(string k) { var v = Context.Request.Query[k].ToString(); return string.IsNullOrEmpty(v) ? null : v; }
            var balContFilter = new AkSearchFilterModel("Filter.Search", Model.Filter.Search,
                "شماره قرارداد، مشتری، تأمین‌کننده یا جنس...",
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    AkFilterDefinition.MultiSelect("Filter.ContractType", UiText.T(Context, "نوع", "Type"), BkOpts(ViewBag.ContractTypes), AkFilterQuery.Values(Context, "Filter.ContractType")),
                    AkFilterDefinition.MultiSelect("Filter.Status", UiText.T(Context, "وضعیت", "Status"), BkOpts(ViewBag.ContractStatuses), AkFilterQuery.Values(Context, "Filter.Status")),
                    AkFilterDefinition.MultiSelect("Filter.ProductId", UiText.T(Context, "جنس", "Product"), BkOpts(ViewBag.Products), AkFilterQuery.Values(Context, "Filter.ProductId")),
                    AkFilterDefinition.MultiSelect("Filter.CustomerId", UiText.T(Context, "مشتری", "Customer"), BkOpts(ViewBag.Customers), AkFilterQuery.Values(Context, "Filter.CustomerId")),
                    AkFilterDefinition.MultiSelect("Filter.SupplierId", UiText.T(Context, "تأمین‌کننده", "Supplier"), BkOpts(ViewBag.Suppliers), AkFilterQuery.Values(Context, "Filter.SupplierId"))
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="balContFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("ContractsExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context,"قرارداد","Contract")</th>
                        <th>@UiText.T(Context,"جنس","Product")</th>
                        <th>@UiText.T(Context,"تأمین‌کننده","Supplier")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مقدار (MT)","Quantity (MT)")</th>
                        <th class="ak-col-num">@UiText.T(Context,"قیمت خرید (USD/MT)","Purchase price (USD/MT)")</th>
                        <th class="ak-col-num">@UiText.T(Context,"ارزش خرید (USD)","Purchase value (USD)")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مصارف (USD)","Expenses (USD)")</th>
                        <th class="ak-col-num">@UiText.T(Context,"فروشات (USD)","Sales (USD)")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مانده (USD)","Balance (USD)")</th>
                        <th class="ak-col-actions">@UiText.T(Context,"عملیات","Operations")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ak-col-grow">
                                <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@item.Id" asp-route-tab="finance">@item.ContractNumber</a>
                                <div class="ak-cell-note">@item.ContractTypeName · @item.StatusName</div>
                            </td>
                            <td>@(item.ProductName ?? "—")</td>
                            <td>@(item.SupplierName ?? "—")</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(item.QuantityMt)</td>
                            <td class="ak-col-num ak-num">
                                @if (item.PurchaseUnitPriceUsd.HasValue)
                                {
                                    @item.PurchaseUnitPriceUsd.Value.ToString("N2")
                                }
                                else if (item.IsPurchase)
                                {
                                    <span class="ak-cell-note">@UiText.T(Context,"قیمت قطعی نشده","Price not final")</span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td class="ak-col-num ak-num">@(item.PurchaseValueUsd?.ToString("N2") ?? "—")</td>
                            <td class="ak-col-num ak-num">@item.TotalExpensesUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@item.TotalSalesUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num fw-bold @(item.BaseBalanceUsd < 0m ? "ak-number--negative" : null)">@item.BaseBalanceUsd.ToString("N2")</td>
                            <td class="ak-col-actions"><a asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@item.Id" asp-route-tab="finance">@UiText.T(Context,"جزئیات","Details")</a></td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="10"><div class="ak-empty"><i class="bi bi-file-earmark-text"></i> @UiText.T(Context,"قراردادی برای نمایش بیلانس پیدا نشد","No contracts found for balance view")</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>

