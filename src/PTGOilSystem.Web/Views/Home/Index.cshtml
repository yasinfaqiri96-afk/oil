@using System.Globalization
@using System.Text.Json
@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = UiText.T(Context, "داشبورد", "Dashboard");
    ViewData["HideSectionTabs"] = true;
    ViewData["DashboardAssets"] = true;

    string T(string fa, string en) => UiText.T(Context, fa, en);
    var dbWarning = ViewData["DbWarning"] as string;

    var chartLabels = JsonSerializer.Serialize(Model.MarketLabels);
    var chartSales = JsonSerializer.Serialize(Model.MarketSalesSeries);
    var chartExpenses = JsonSerializer.Serialize(Model.MarketExpenseSeries);

    // Compact USD like the reference: "$5306.85k".
    string CompactUsd(decimal v) => "$" + (v / 1000m).ToString("0.##", CultureInfo.InvariantCulture) + "k";

    // ترکیب فروش — سه حلقه هم‌مرکز.
    var mixSegments = new[]
    {
        new { label = T("فروش", "Sales"),                  value = Model.SalesCount,             color = "#22c55e" },
        new { label = T("در انتظار پرداخت", "Pending"),     value = Model.SalesWithoutPaymentCount, color = "#f5a524" },
        new { label = T("کسری", "Shortage"),               value = Model.ShortageCount,          color = "#f4511e" }
    };
    var mixTotal = mixSegments.Sum(s => s.value);
    var mixJson = JsonSerializer.Serialize(mixSegments);
}

<div class="ak-form-page dashboard-page dashboard-ref">
    @if (!string.IsNullOrWhiteSpace(dbWarning))
    {
        <div class="ak-note dashboard-warning" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <strong>@T("اطلاعات داشبورد در دسترس نیست", "Dashboard data is unavailable")</strong>
                <span>@T("اتصال پایگاه داده را بررسی کنید و دوباره تلاش نمایید.", "Check the database connection and try again.")</span>
            </div>
        </div>
    }

    @* ===== ردیف کارت‌های خلاصه ===== *@
    <section class="ak-stat-grid" aria-label="@T("خلاصه امروز", "Today's summary")">
        <vc:stat-card title="@T("فروش امروز", "Today's sales")"
                      value="@StatCardFormatter.Number(Model.TodaySalesUsd, 0)"
                      unit="USD"
                      avatar="sales-value"></vc:stat-card>

        <vc:stat-card title="@T("موجودی کل", "Total inventory")"
                      value="@StatCardFormatter.Number(Model.TerminalStockMt, 2)"
                      unit="MT"
                      avatar="total-inventory"></vc:stat-card>

        <vc:stat-card title="@T("بارهای در جریان", "Loads in transit")"
                      value="@StatCardFormatter.Count(Model.ShipmentsInTransitCount)"
                      unit="@T("محموله", "loads")"
                      avatar="transported"></vc:stat-card>

        <vc:stat-card title="@T("قراردادهای فعال", "Active contracts")"
                      value="@StatCardFormatter.Count(Model.ActiveContractCount)"
                      unit="@T("قرارداد", "contracts")"
                      avatar="contract-signed"></vc:stat-card>
    </section>

    @* ===== نمودار روند + ترکیب فروش ===== *@
    <section class="dash-analytics" aria-label="@T("تحلیل درآمد و فروش", "Revenue and sales analytics")">
        <article class="dash-card dash-mix">
            <header class="dash-card-head">
                <h2>@T("ترکیب فروش", "Sales mix")</h2>
            </header>
            <div class="dash-donut"
                 data-dashboard-donut
                 data-segments="@mixJson"
                 data-total="@mixTotal"
                 data-total-label="@T("مجموع", "Total")">
            </div>
            <div class="dash-mix-legend">
                @foreach (var seg in mixSegments)
                {
                    <span class="dash-mix-item">
                        <i class="dash-dot" style="background:@seg.color" aria-hidden="true"></i>
                        <span class="dash-mix-name">@seg.label</span>
                        <strong class="dash-mix-count"><bdi>@StatCardFormatter.Count(seg.value)</bdi></strong>
                    </span>
                }
            </div>
        </article>

        <article class="dash-card dash-trend">
            <header class="dash-card-head dash-trend-head">
                <div class="dash-trend-title">
                    <h2>@T("روند درآمد و مصارف", "Revenue and expense trend")</h2>
                    <p>@T("نسبت به دوره قبل", "vs previous period") (<span>@StatCardFormatter.Trend(Model.TotalSalesWeekChangePercent)</span>)</p>
                </div>
                <div class="dash-trend-totals">
                    <div class="dash-total">
                        <span class="dash-total-value dash-total-value--green"><bdi>@CompactUsd(Model.TotalExpensesUsd)</bdi></span>
                        <span class="dash-total-label"><i class="dash-dot dash-dot--amber" aria-hidden="true"></i>@T("مصارف کل", "Total expenses")</span>
                    </div>
                    <div class="dash-total">
                        <span class="dash-total-value dash-total-value--green"><bdi>@CompactUsd(Model.TotalSalesUsd)</bdi></span>
                        <span class="dash-total-label"><i class="dash-dot dash-dot--green" aria-hidden="true"></i>@T("درآمد کل", "Total revenue")</span>
                    </div>
                </div>
            </header>
            <div class="dash-trend-chart"
                 data-dashboard-chart
                 data-labels="@chartLabels"
                 data-sales="@chartSales"
                 data-expenses="@chartExpenses"
                 data-sales-label="@T("درآمد", "Revenue")"
                 data-expenses-label="@T("مصارف", "Expenses")"
                 data-chart-label="@T("نمودار روند درآمد و مصارف", "Revenue and expense trend chart")"
                 data-empty-label="@T("برای این بازه داده‌ای ثبت نشده است.", "No data is recorded for this range.")">
                <div class="dash-chart-loading" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    @T("در حال آماده‌سازی نمودار", "Preparing chart")
                </div>
            </div>
        </article>
    </section>

    @* ===== کارت‌های بینش عملیاتی ===== *@
    <partial name="_DashboardInsights" model="Model" />
</div>
