@using System.Globalization
@using System.Text.Json
@using PTGOilSystem.Web.Models.StatCards
@using PTGOilSystem.Web.Security
@model PTGOilSystem.Web.Models.DashboardViewModel
@inject ClientModuleProfile ClientModules
@{
    ViewData["Title"] = UiText.T(Context, "داشبورد", "Dashboard");
    ViewData["HideSectionTabs"] = true;
    ViewData["DashboardAssets"] = true;

    string T(string fa, string en) => UiText.T(Context, fa, en);
    var dbWarning = ViewData["DbWarning"] as string;

    var chartLabels = JsonSerializer.Serialize(Model.MarketLabels);
    var chartSales = JsonSerializer.Serialize(Model.MarketSalesSeries);
    var chartExpenses = JsonSerializer.Serialize(Model.MarketExpenseSeries);

    // ترکیب فروش — سه حلقهٔ هم‌مرکز، هر حلقه یک محصول (مقدار فروش MT در بازهٔ نمودار روند).
    // بیش از سه محصول: حلقهٔ سوم جمع بقیهٔ محصولات است.
    var mixPalette = new[]
    {
        (Color: "var(--ptg-chart-positive)", Dot: "dash-dot--green"),
        (Color: "var(--ptg-chart-warning)", Dot: "dash-dot--amber"),
        (Color: "var(--ptg-chart-negative)", Dot: "dash-dot--red")
    };
    var mixProducts = Model.SalesMix.Count <= mixPalette.Length
        ? Model.SalesMix.Select(p => (Name: p.ProductName, Mt: p.QuantityMt)).ToList()
        : Model.SalesMix.Take(mixPalette.Length - 1)
            .Select(p => (Name: p.ProductName, Mt: p.QuantityMt))
            .Append((Name: T("سایر محصولات", "Other products"), Mt: Model.SalesMix.Skip(mixPalette.Length - 1).Sum(p => p.QuantityMt)))
            .ToList();
    var mixTotal = mixProducts.Sum(p => p.Mt);
    var mixSegments = mixProducts
        .Select((p, i) => new
        {
            label = p.Name,
            value = p.Mt,
            percent = mixTotal > 0m ? Math.Round(p.Mt / mixTotal * 100m, 0, MidpointRounding.AwayFromZero) : 0m,
            color = mixPalette[i].Color,
            dot = mixPalette[i].Dot
        })
        .ToList();
    var mixJson = JsonSerializer.Serialize(mixSegments.Select(s => new { s.label, s.value, s.color }));

    // فهرست ابزارک‌ها: شش ابزارک اصلی پیش‌فرض روشن‌اند؛ بقیه اختیاری‌اند و فقط برای کاربری دیده
    // می‌شوند که به صفحهٔ مرجع همان داده دسترسی دارد.
    bool Can(string navigationKey, string controller) =>
        RoleAccessRules.CanAccessNavigation(User, navigationKey) && ClientModules.IsControllerEnabled(controller);
    var widgets = new List<(string Id, string Label, string Icon, bool IsDefault)>
    {
        ("activities", T("آخرین فعالیت‌ها", "Recent activities"), "file-earmark-text-fill", true),
        ("tanks", T("موجودی مخازن", "Tank stock"), "database-fill", true),
        ("alerts", T("هشدارهای عملیات", "Operational alerts"), "exclamation-square-fill", true),
        ("summary", T("خلاصه امروز", "Today’s summary"), "bar-chart-fill", true),
        ("analytics", T("تحلیل درآمد و فروش", "Revenue and sales"), "pie-chart-fill", true),
        ("shipments", T("محموله‌های در جریان", "Active shipments"), "box-seam-fill", true)
    };
    if (Can(RoleNavigationKeys.Reports, "Reports"))
    {
        widgets.Add(("debtors", T("بدهکاران", "Debtors"), "arrow-down-circle-fill", false));
        widgets.Add(("creditors", T("بستانکاران", "Creditors"), "arrow-up-circle-fill", false));
        widgets.Add(("profit", T("سود و زیان امروز", "Today’s profit and loss"), "calculator-fill", false));
        widgets.Add(("reports", T("گزارش‌ها", "Reports"), "clipboard-data-fill", false));
    }
    if (Can(RoleNavigationKeys.CashAccounts, "CashAccounts"))
    {
        widgets.Add(("banking", T("صندوق و بانک", "Cash and bank"), "bank2", false));
    }
    if (Can(RoleNavigationKeys.BaseDefinitions, "DailyFxRates"))
    {
        widgets.Add(("fx", T("نرخ ارز", "Exchange rates"), "currency-exchange", false));
    }
    if (Can(RoleNavigationKeys.Sales, "Sales"))
    {
        widgets.Add(("sales", T("فروش‌های اخیر", "Recent sales"), "cart-check-fill", false));
    }
    if (Can(RoleNavigationKeys.Operations, "Loading"))
    {
        widgets.Add(("loadings", T("بارگیری‌های اخیر", "Recent loadings"), "truck-front-fill", false));
    }
    if (Can(RoleNavigationKeys.Operations, "Expenses"))
    {
        widgets.Add(("expenses", T("مصارف اخیر", "Recent expenses"), "receipt-cutoff", false));
    }
    bool Has(string id) => widgets.Any(w => w.Id == id);
}

<div class="ak-form-page dashboard-page dashboard-ref">
    @if (!string.IsNullOrWhiteSpace(dbWarning))
    {
        <div class="ak-note dashboard-warning" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <strong>@T("اطلاعات داشبورد در دسترس نیست", "Dashboard data is unavailable")</strong>
                <span>@T("اتصال پایگاه داده را بررسی کنید و دوباره تلاش نمایید.", "Check the database connection and try again.")</span>
            </div>
        </div>
    }

    @* ===== راهنمای شروع (فقط وقتی Onboarding:Enabled روشن است) ===== *@
    @if (ViewData["Onboarding"] is PTGOilSystem.Web.Models.OnboardingPanelViewModel onboarding)
    {
        <partial name="_OnboardingPanel" model="onboarding" />
    }

    <div class="mashal-dashboard-toolbar">
        <h1>@T("داشبورد", "Dashboard")</h1>
        <div><button type="button" class="mashal-dashboard-save" data-mashal-save><i class="bi bi-bookmark-fill" aria-hidden="true"></i> @T("ذخیره", "Save")</button><button type="button" class="mashal-widget-add" data-bs-toggle="modal" data-bs-target="#mashalWidgetPicker" aria-label="@T("افزودن ابزار", "Add widgets")"><i class="bi bi-plus-lg" aria-hidden="true"></i></button><span class="visually-hidden" data-mashal-save-status role="status"></span></div>
    </div>
    <div class="modal fade mashal-widget-picker" id="mashalWidgetPicker" tabindex="-1" aria-labelledby="mashalWidgetTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="mashal-widget-picker-head"><h2 id="mashalWidgetTitle">@T("افزودن ابزار", "Add widgets")</h2><label>@T("انتخاب همه", "Select all") <input type="checkbox" data-mashal-widgets-all /></label></div>
            <div class="mashal-widget-options">
            @foreach (var widget in widgets)
            {
                <label class="mashal-widget-option"><input type="checkbox" value="@widget.Id" data-mashal-widget-choice data-mashal-widget-default="@(widget.IsDefault ? "true" : null)" /><i class="bi bi-@widget.Icon" aria-hidden="true"></i><span>@widget.Label</span></label>
            }
            </div>
            <div class="mashal-widget-picker-actions"><button type="button" data-mashal-widgets-apply disabled>@T("تأیید", "Apply")</button><button type="button" data-bs-dismiss="modal">@T("لغو", "Cancel")</button></div>
        </div></div>
    </div>

    @* ===== ردیف کارت‌های خلاصه ===== *@
    <section data-mashal-widget="summary" class="ak-stat-grid" aria-label="@T("خلاصه امروز", "Today's summary")">
        <vc:stat-card title="@T("موجودی مخازن", "Tank stock")"
                      value="@StatCardFormatter.Number(Model.TerminalStockMt, 2)"
                      unit="MT"
                      avatar="storage-tanks"></vc:stat-card>

        <vc:stat-card title="@T("بارهای در راه", "Goods in transit")"
                      value="@StatCardFormatter.Number(Model.GoodsInTransitMt, 2)"
                      unit="MT"
                      avatar="in-transit"></vc:stat-card>

        <vc:stat-card title="@T("کل طلبات", "Total receivables")"
                      value="@StatCardFormatter.Number(Model.TotalReceivableUsd, 0)"
                      unit="USD"
                      avatar="receivables"></vc:stat-card>

        <vc:stat-card title="@T("کل بدهی‌ها", "Total payables")"
                      value="@StatCardFormatter.Number(Model.TotalPayableUsd, 0)"
                      unit="USD"
                      avatar="payments-out"></vc:stat-card>
    </section>

    @* ===== نمودار روند + ترکیب فروش ===== *@
    <section data-mashal-widget="analytics" class="dash-analytics" aria-label="@T("تحلیل درآمد و فروش", "Revenue and sales analytics")">
        <article class="dash-card dash-mix">
            <header class="dash-card-head">
                <h2>@T("ترکیب فروش", "Sales mix")</h2>
            </header>
            <div class="dash-donut"
                 data-dashboard-donut
                 data-segments="@mixJson"
                 data-total="@mixTotal.ToString(CultureInfo.InvariantCulture)"
                 data-total-label="@T("مجموع MT", "Total MT")">
            </div>
            <div class="dash-mix-legend">
                @foreach (var seg in mixSegments)
                {
                    <span class="dash-mix-item" title="@StatCardFormatter.Number(seg.value, 2) MT">
                        <i class="dash-dot @seg.dot" aria-hidden="true"></i>
                        <span class="dash-mix-name">@seg.label</span>
                        <strong class="dash-mix-count"><bdi>@StatCardFormatter.Number(seg.percent, 0)%</bdi></strong>
                    </span>
                }
            </div>
        </article>

        <article class="dash-card dash-trend">
            <header class="dash-card-head dash-trend-head">
                <div class="dash-trend-title">
                    <h2>@T("روند درآمد و مصارف", "Revenue and expense trend")</h2>
                </div>
                <div class="dash-mix-legend dash-trend-legend">
                    <span class="dash-mix-item">
                        <i class="dash-dot dash-dot--green" aria-hidden="true"></i>
                        <span class="dash-mix-name">@T("درآمد", "Revenue")</span>
                    </span>
                    <span class="dash-mix-item">
                        <i class="dash-dot dash-dot--amber" aria-hidden="true"></i>
                        <span class="dash-mix-name">@T("مصارف", "Expenses")</span>
                    </span>
                </div>
            </header>
            <div class="dash-trend-chart"
                 data-dashboard-chart
                 data-labels="@chartLabels"
                 data-sales="@chartSales"
                 data-expenses="@chartExpenses"
                 data-sales-label="@T("درآمد", "Revenue")"
                 data-expenses-label="@T("مصارف", "Expenses")"
                 data-chart-label="@T("نمودار روند درآمد و مصارف", "Revenue and expense trend chart")"
                 data-empty-label="@T("برای این بازه داده‌ای ثبت نشده است.", "No data is recorded for this range.")">
                <div class="dash-chart-loading" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    @T("در حال آماده‌سازی نمودار", "Preparing chart")
                </div>
            </div>
        </article>
    </section>

    @* ===== کارت‌های بینش عملیاتی ===== *@
    <partial name="_DashboardInsights" model="Model" />

    <section class="mashal-dashboard-lists" aria-label="خلاصه فعالیت‌ها">
        <article class="mashal-widget mashal-recent" data-mashal-widget="activities">
            <header><h2>@T("آخرین فعالیت‌ها", "Recent activities")</h2><span class="mashal-count">@Model.RecentActivities.Count</span></header>
            <div class="mashal-widget-rows">
            @foreach (var item in Model.RecentActivities.Take(3))
            {
                <div class="mashal-document-row"><div><span class="mashal-document-badge"><i class="bi @item.DirectionIcon" aria-hidden="true"></i></span><span class="mashal-document-status">@item.Status</span></div><div><span class="mashal-document-amount"><bdi>@item.Amount</bdi></span><span>@item.Name</span><small>@item.TimeText</small></div></div>
            }
            @if (Model.RecentActivities.Count == 0) { <p class="mashal-widget-empty">@T("فعالیتی ثبت نشده است.", "No activities yet.")</p> }
            </div>
        </article>
        <article class="mashal-widget mashal-tanks" data-mashal-widget="tanks">
            <header><h2>@T("موجودی مخازن", "Tank inventory")</h2><span class="mashal-count">@Model.TankCapacities.Count</span></header>
            <div class="mashal-widget-rows">
            @foreach (var tank in Model.TankCapacities.Take(5))
            {
                <a asp-controller="StorageTanks" asp-action="Details" asp-route-id="@tank.TankId" class="mashal-tank-row"><span>@tank.TankName</span><bdi>@StatCardFormatter.Number(tank.StockMt, 2) MT</bdi></a>
            }
            @if (Model.TankCapacities.Count == 0) { <p class="mashal-widget-empty">@T("مخزنی ثبت نشده است.", "No tanks yet.")</p> }
            </div>
        </article>
        <article class="mashal-widget mashal-alerts" data-mashal-widget="alerts">
            <header><h2>@T("هشدارهای عملیات", "Operational alerts")</h2><span class="mashal-count">@(Model.LowStockAlerts.Count + Model.ContractsEndingSoonAlerts.Count + Model.ShipmentsWithoutSalesAlerts.Count + Model.ShipmentsWithoutExpensesAlerts.Count)</span></header>
            <div class="mashal-widget-rows">
            @foreach (var alert in Model.LowStockAlerts.Concat(Model.ContractsEndingSoonAlerts).Concat(Model.ShipmentsWithoutSalesAlerts).Concat(Model.ShipmentsWithoutExpensesAlerts).Take(3))
            {
                <div class="mashal-alert-row"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><div><strong>@alert.Title</strong><small>@alert.Message</small></div></div>
            }
            @if (Model.LowStockAlerts.Count + Model.ContractsEndingSoonAlerts.Count + Model.ShipmentsWithoutSalesAlerts.Count + Model.ShipmentsWithoutExpensesAlerts.Count == 0) { <p class="mashal-widget-empty">@T("هشداری وجود ندارد.", "No alerts.")</p> }
            </div>
        </article>
    </section>

    @* ===== ابزارک‌های اختیاری؛ تا کاربر انتخاب نکند پنهان‌اند. ابزارک‌های data-mashal-widget-src جدا بارگذاری می‌شوند. ===== *@
    <section class="mashal-dashboard-lists mashal-dashboard-more" aria-label="@T("ابزارک‌های بیشتر", "More widgets")">
        @if (Has("debtors"))
        {
            <article class="mashal-widget" data-mashal-widget="debtors" hidden>
                <header><h2>@T("بدهکاران", "Debtors") <span class="mashal-count">@Model.DebtorCount</span></h2><a class="mashal-widget-more" asp-controller="Reports" asp-action="ReceivablesPayables">@T("مشاهده همه", "View all")</a></header>
                <partial name="_DashboardWidgetRows" model="@(((IReadOnlyList<DashboardWidgetRowViewModel>)Model.TopDebtors, T("بدهکاری وجود ندارد.", "No debtors.")))" />
            </article>
            <article class="mashal-widget" data-mashal-widget="creditors" hidden>
                <header><h2>@T("بستانکاران", "Creditors") <span class="mashal-count">@Model.CreditorCount</span></h2><a class="mashal-widget-more" asp-controller="Reports" asp-action="ReceivablesPayables">@T("مشاهده همه", "View all")</a></header>
                <partial name="_DashboardWidgetRows" model="@(((IReadOnlyList<DashboardWidgetRowViewModel>)Model.TopCreditors, T("بستانکاری وجود ندارد.", "No creditors.")))" />
            </article>
            <article class="mashal-widget" data-mashal-widget="profit" hidden>
                <header><h2>@T("سود و زیان امروز", "Today’s profit and loss")</h2><a class="mashal-widget-more" asp-controller="Reports" asp-action="CompanyBalance">@T("بیلانس کلی", "Balance sheet")</a></header>
                <div data-mashal-widget-src="@Url.Action("DashboardWidget", "Home", new { id = "profit" })"><p class="mashal-widget-empty" role="status">@T("در حال بارگذاری…", "Loading…")</p></div>
            </article>
            <article class="mashal-widget" data-mashal-widget="reports" hidden>
                <header><h2>@T("گزارش‌ها", "Reports")</h2><a class="mashal-widget-more" asp-controller="Reports" asp-action="Index">@T("همه گزارش‌ها", "All reports")</a></header>
                <nav class="mashal-widget-rows" aria-label="@T("گزارش‌ها", "Reports")">
                @foreach (var report in new[] { ("CompanyBalance", T("بیلانس کلی شرکت", "Company balance sheet"), "bi-journal-check"), ("ContractPnl", T("مفاد قراردادها", "Contract profit"), "bi-graph-up-arrow"), ("ReceivablesPayables", T("طلبات و بدهی‌ها", "Receivables and payables"), "bi-people"), ("CashFlow", T("گردش پول", "Cash movement"), "bi-cash-stack") })
                {
                    <a asp-controller="Reports" asp-action="@report.Item1" class="mashal-tank-row mashal-widget-item"><span><strong><i class="bi @report.Item3" aria-hidden="true"></i> @report.Item2</strong></span></a>
                }
                </nav>
            </article>
        }
        @if (Has("banking"))
        {
            <article class="mashal-widget" data-mashal-widget="banking" hidden>
                <header><h2>@T("صندوق و بانک", "Cash and bank")</h2><a class="mashal-widget-more" asp-controller="CashAccounts" asp-action="Index">@T("مشاهده همه", "View all")</a></header>
                <div data-mashal-widget-src="@Url.Action("DashboardWidget", "Home", new { id = "banking" })"><p class="mashal-widget-empty" role="status">@T("در حال بارگذاری…", "Loading…")</p></div>
            </article>
        }
        @if (Has("fx"))
        {
            <article class="mashal-widget" data-mashal-widget="fx" hidden>
                <header><h2>@T("نرخ ارز", "Exchange rates")</h2><a class="mashal-widget-more" asp-controller="DailyFxRates" asp-action="Index">@T("مشاهده همه", "View all")</a></header>
                <div data-mashal-widget-src="@Url.Action("DashboardWidget", "Home", new { id = "fx" })"><p class="mashal-widget-empty" role="status">@T("در حال بارگذاری…", "Loading…")</p></div>
            </article>
        }
        @if (Has("sales"))
        {
            <article class="mashal-widget" data-mashal-widget="sales" hidden>
                <header><h2>@T("فروش‌های اخیر", "Recent sales")</h2><a class="mashal-widget-more" asp-controller="Sales" asp-action="Index">@T("مشاهده همه", "View all")</a></header>
                <div class="mashal-widget-rows">
                @foreach (var row in Model.OutboundOrderPanel.Rows.Take(5))
                {
                    <div class="mashal-tank-row mashal-widget-item"><span><strong>@row.Reference</strong><small><bdi>@row.Amount MT</bdi></small></span><bdi>@row.Total</bdi></div>
                }
                @if (Model.OutboundOrderPanel.Rows.Count == 0) { <p class="mashal-widget-empty">@T("فروشی ثبت نشده است.", "No sales yet.")</p> }
                </div>
            </article>
        }
        @if (Has("loadings"))
        {
            <article class="mashal-widget" data-mashal-widget="loadings" hidden>
                <header><h2>@T("بارگیری‌های اخیر", "Recent loadings")</h2><a class="mashal-widget-more" asp-controller="Loading" asp-action="Index">@T("مشاهده همه", "View all")</a></header>
                <div class="mashal-widget-rows">
                @foreach (var row in Model.InboundOrderPanel.Rows.Take(5))
                {
                    <div class="mashal-tank-row mashal-widget-item"><span><strong>@row.Reference</strong><small><bdi>@row.Amount MT</bdi></small></span><bdi>@row.Total</bdi></div>
                }
                @if (Model.InboundOrderPanel.Rows.Count == 0) { <p class="mashal-widget-empty">@T("بارگیری ثبت نشده است.", "No loadings yet.")</p> }
                </div>
            </article>
        }
        @if (Has("expenses"))
        {
            <article class="mashal-widget" data-mashal-widget="expenses" hidden>
                <header><h2>@T("مصارف اخیر", "Recent expenses")</h2><a class="mashal-widget-more" asp-controller="Expenses" asp-action="Index">@T("مشاهده همه", "View all")</a></header>
                <div data-mashal-widget-src="@Url.Action("DashboardWidget", "Home", new { id = "expenses" })"><p class="mashal-widget-empty" role="status">@T("در حال بارگذاری…", "Loading…")</p></div>
            </article>
        }
    </section>
</div>
