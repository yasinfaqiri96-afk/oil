@using System.Globalization
@using System.Text.Json
@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = UiText.T(Context, "داشبورد", "Dashboard");
    ViewData["HideSectionTabs"] = true;
    ViewData["DashboardAssets"] = true;

    string T(string fa, string en) => UiText.T(Context, fa, en);
    var dbWarning = ViewData["DbWarning"] as string;

    var chartLabels = JsonSerializer.Serialize(Model.MarketLabels);
    var chartSales = JsonSerializer.Serialize(Model.MarketSalesSeries);
    var chartExpenses = JsonSerializer.Serialize(Model.MarketExpenseSeries);

    // Compact USD like the reference: "$5306.85k".
    string CompactUsd(decimal v) => "$" + (v / 1000m).ToString("0.##", CultureInfo.InvariantCulture) + "k";

    // ترکیب فروش — سه حلقه هم‌مرکز.
    var mixSegments = new[]
    {
        new { label = T("فروش", "Sales"),                  value = Model.SalesCount,             color = "#22c55e" },
        new { label = T("در انتظار پرداخت", "Pending"),     value = Model.SalesWithoutPaymentCount, color = "#f5a524" },
        new { label = T("کسری", "Shortage"),               value = Model.ShortageCount,          color = "#f4511e" }
    };
    var mixTotal = mixSegments.Sum(s => s.value);
    var mixJson = JsonSerializer.Serialize(mixSegments);
}

<div class="ak-form-page dashboard-page dashboard-ref">
    @if (!string.IsNullOrWhiteSpace(dbWarning))
    {
        <div class="ak-note dashboard-warning" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <strong>@T("اطلاعات داشبورد در دسترس نیست", "Dashboard data is unavailable")</strong>
                <span>@T("اتصال پایگاه داده را بررسی کنید و دوباره تلاش نمایید.", "Check the database connection and try again.")</span>
            </div>
        </div>
    }

    @* ===== ردیف کارت‌های خلاصه ===== *@
    <section class="ak-stat-grid" aria-label="@T("خلاصه امروز", "Today's summary")">
        <vc:stat-card title="@T("فروش امروز", "Today's sales")"
                      value="@StatCardFormatter.Number(Model.TodaySalesUsd, 0)"
                      unit="USD"
                      avatar="sales-value"></vc:stat-card>

        <vc:stat-card title="@T("موجودی کل", "Total inventory")"
                      value="@StatCardFormatter.Number(Model.TerminalStockMt, 2)"
                      unit="MT"
                      avatar="total-inventory"></vc:stat-card>

        <vc:stat-card title="@T("بارهای در جریان", "Loads in transit")"
                      value="@StatCardFormatter.Count(Model.ShipmentsInTransitCount)"
                      unit="@T("محموله", "loads")"
                      avatar="transported"></vc:stat-card>

        <vc:stat-card title="@T("قراردادهای فعال", "Active contracts")"
                      value="@StatCardFormatter.Count(Model.ActiveContractCount)"
                      unit="@T("قرارداد", "contracts")"
                      avatar="contract-signed"></vc:stat-card>
    </section>

    @* ===== نمودار روند + ترکیب فروش ===== *@
    <section class="dash-analytics" aria-label="@T("تحلیل درآمد و فروش", "Revenue and sales analytics")">
        <article class="dash-card dash-mix">
            <header class="dash-card-head">
                <h2>@T("ترکیب فروش", "Sales mix")</h2>
            </header>
            <div class="dash-donut"
                 data-dashboard-donut
                 data-segments="@mixJson"
                 data-total="@mixTotal"
                 data-total-label="@T("مجموع", "Total")">
            </div>
            <div class="dash-mix-legend">
                @foreach (var seg in mixSegments)
                {
                    <span class="dash-mix-item">
                        <i class="dash-dot" style="background:@seg.color" aria-hidden="true"></i>
                        <span class="dash-mix-name">@seg.label</span>
                        <strong class="dash-mix-count"><bdi>@StatCardFormatter.Count(seg.value)</bdi></strong>
                    </span>
                }
            </div>
        </article>

        <article class="dash-card dash-trend">
            <header class="dash-card-head dash-trend-head">
                <div class="dash-trend-title">
                    <h2>@T("روند درآمد و مصارف", "Revenue and expense trend")</h2>
                    <p>@T("نسبت به دوره قبل", "vs previous period") (<span>@StatCardFormatter.Trend(Model.TotalSalesWeekChangePercent)</span>)</p>
                </div>
                <div class="dash-trend-totals">
                    <div class="dash-total">
                        <span class="dash-total-value dash-total-value--green"><bdi>@CompactUsd(Model.TotalExpensesUsd)</bdi></span>
                        <span class="dash-total-label"><i class="dash-dot dash-dot--amber" aria-hidden="true"></i>@T("مصارف کل", "Total expenses")</span>
                    </div>
                    <div class="dash-total">
                        <span class="dash-total-value dash-total-value--green"><bdi>@CompactUsd(Model.TotalSalesUsd)</bdi></span>
                        <span class="dash-total-label"><i class="dash-dot dash-dot--green" aria-hidden="true"></i>@T("درآمد کل", "Total revenue")</span>
                    </div>
                </div>
            </header>
            <div class="dash-trend-chart"
                 data-dashboard-chart
                 data-labels="@chartLabels"
                 data-sales="@chartSales"
                 data-expenses="@chartExpenses"
                 data-sales-label="@T("درآمد", "Revenue")"
                 data-expenses-label="@T("مصارف", "Expenses")"
                 data-chart-label="@T("نمودار روند درآمد و مصارف", "Revenue and expense trend chart")"
                 data-empty-label="@T("برای این بازه داده‌ای ثبت نشده است.", "No data is recorded for this range.")">
                <div class="dash-chart-loading" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    @T("در حال آماده‌سازی نمودار", "Preparing chart")
                </div>
            </div>
        </article>
    </section>

    @* ===== نوار دسترسی سریع ===== *@
    @* Solar Icon Set — Bold Duotone by 480 Design, CC BY 4.0: https://github.com/480-Design/Solar-Icon-Set *@
    <section class="dash-quick" aria-label="@T("دسترسی سریع", "Quick access")">
        <a asp-controller="Sales" asp-action="Create" class="dash-quick-item dash-quick-item--primary">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg dash-quick-svg--plus" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 4v16M4 12h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
            </span>
            <strong>@T("ثبت فروش", "New sale")</strong>
        </a>
        <a asp-controller="Suppliers" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" d="M14 4h-4C6.229 4 4.343 4 3.172 5.172S2 8.229 2 12s0 5.657 1.172 6.828S6.229 20 10 20h4c3.771 0 5.657 0 6.828-1.172S22 15.771 22 12s0-5.657-1.172-6.828S17.771 4 14 4" opacity=".5" />
                    <path fill="currentColor" d="M13.25 9a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75m1 3a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75m1 3a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 0 1.5h-3a.75.75 0 0 1-.75-.75M9 11a2 2 0 1 0 0-4a2 2 0 0 0 0 4m0 6c4 0 4-.895 4-2s-1.79-2-4-2s-4 .895-4 2s0 2 4 2" />
                </svg>
            </span>
            <strong class="dash-quick-label--stacked"><span>@T("طرف", "Business")</span><span>@T("حساب‌ها", "parties")</span></strong>
        </a>
        <a asp-controller="Reports" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" d="M3.293 9.293C3 9.586 3 10.057 3 11v6c0 .943 0 1.414.293 1.707S4.057 19 5 19s1.414 0 1.707-.293S7 17.943 7 17v-6c0-.943 0-1.414-.293-1.707S5.943 9 5 9s-1.414 0-1.707.293" />
                    <path fill="currentColor" d="M17.293 2.293C17 2.586 17 3.057 17 4v13c0 .943 0 1.414.293 1.707S18.057 19 19 19s1.414 0 1.707-.293S21 17.943 21 17V4c0-.943 0-1.414-.293-1.707S19.943 2 19 2s-1.414 0-1.707.293" opacity=".4" />
                    <path fill="currentColor" d="M10 7c0-.943 0-1.414.293-1.707S11.057 5 12 5s1.414 0 1.707.293S14 6.057 14 7v10c0 .943 0 1.414-.293 1.707S12.943 19 12 19s-1.414 0-1.707-.293S10 17.943 10 17z" opacity=".7" />
                    <path fill="currentColor" d="M3 21.25a.75.75 0 0 0 0 1.5h18a.75.75 0 0 0 0-1.5z" />
                </svg>
            </span>
            <strong>@T("گزارشات", "Reports")</strong>
        </a>
        <a asp-controller="Payments" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" d="M5.75 7a.75.75 0 0 0 0 1.5h4a.75.75 0 0 0 0-1.5z" />
                    <path fill="currentColor" fill-rule="evenodd" d="M21.188 8.004q-.094-.005-.2-.004h-2.773C15.944 8 14 9.736 14 12s1.944 4 4.215 4h2.773q.106.001.2-.004c.923-.056 1.739-.757 1.808-1.737c.004-.064.004-.133.004-.197V9.938c0-.064 0-.133-.004-.197c-.069-.98-.885-1.68-1.808-1.737m-3.217 5.063c.584 0 1.058-.478 1.058-1.067c0-.59-.474-1.067-1.058-1.067s-1.06.478-1.06 1.067c0 .59.475 1.067 1.06 1.067" clip-rule="evenodd" />
                    <path fill="currentColor" d="M21.14 8.002c0-1.181-.044-2.448-.798-3.355a4 4 0 0 0-.233-.256c-.749-.748-1.698-1.08-2.87-1.238C16.099 3 14.644 3 12.806 3h-2.112C8.856 3 7.4 3 6.26 3.153c-1.172.158-2.121.49-2.87 1.238c-.748.749-1.08 1.698-1.238 2.87C2 8.401 2 9.856 2 11.694v.112c0 1.838 0 3.294.153 4.433c.158 1.172.49 2.121 1.238 2.87c.749.748 1.698 1.08 2.87 1.238c1.14.153 2.595.153 4.433.153h2.112c1.838 0 3.294 0 4.433-.153c1.172-.158 2.121-.49 2.87-1.238q.305-.308.526-.66c.45-.72.504-1.602.504-2.45l-.15.001h-2.774C15.944 16 14 14.264 14 12s1.944-4 4.215-4h2.773q.079 0 .151.002" opacity=".5" />
                </svg>
            </span>
            <strong>@T("مالی", "Finance")</strong>
        </a>
        <a asp-controller="Sales" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" fill-rule="evenodd" d="M1.289 2.763a.75.75 0 0 1 .948-.475l.265.089l.04.013c.626.209 1.155.385 1.572.579c.442.206.826.46 1.117.865c.291.403.412.848.467 1.333c.052.456.052 1.014.052 1.674V9.5c0 1.435.002 2.437.103 3.192c.099.734.28 1.122.556 1.399c.277.277.666.457 1.4.556c.755.101 1.756.103 3.191.103h7a.75.75 0 1 1 0 1.5h-7.055c-1.367 0-2.47 0-3.337-.117c-.9-.12-1.658-.38-2.26-.981c-.601-.602-.86-1.36-.981-2.26c-.117-.867-.117-1.97-.117-3.337V6.883c0-.713 0-1.185-.042-1.546c-.04-.342-.107-.507-.194-.626c-.086-.12-.221-.237-.533-.382c-.33-.153-.777-.304-1.453-.53l-.265-.088a.75.75 0 0 1-.474-.948" clip-rule="evenodd" />
                    <path fill="currentColor" d="M5.745 6q.006.39.005.841V9.5c0 1.435.002 2.437.103 3.192q.023.165.05.308h10.12c.959 0 1.438 0 1.814-.248s.565-.688.942-1.57l.43-1c.809-1.89 1.213-2.833.769-3.508S18.506 6 16.45 6z" opacity=".5" />
                    <path fill="currentColor" d="M7.5 18a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3M18 19.5a1.5 1.5 0 1 0-3 0a1.5 1.5 0 0 0 3 0" />
                </svg>
            </span>
            <strong>@T("فروش", "Sales")</strong>
        </a>
        <a asp-controller="Loading" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" d="M2.277 5.247a.75.75 0 0 1 .924-.522l1.703.472A2.71 2.71 0 0 1 6.8 7.075l2.151 7.786l.158.547a2.96 2.96 0 0 1 1.522 1.267l.31-.096l8.87-2.305a.75.75 0 1 1 .378 1.452l-8.837 2.296l-.33.102c-.006 1.27-.883 2.432-2.21 2.776c-1.59.414-3.225-.502-3.651-2.044s.518-3.129 2.108-3.542q.119-.03.237-.052L5.354 7.474a1.21 1.21 0 0 0-.85-.831L2.8 6.17a.75.75 0 0 1-.523-.923" />
                    <path fill="currentColor" d="m9.564 8.73l.515 1.863c.485 1.755.727 2.633 1.44 3.032c.713.4 1.618.164 3.428-.306l1.92-.5c1.81-.47 2.715-.705 3.127-1.396c.412-.692.17-1.57-.316-3.325l-.514-1.862c-.485-1.756-.728-2.634-1.44-3.033c-.714-.4-1.619-.164-3.429.307l-1.92.498c-1.81.47-2.715.706-3.126 1.398c-.412.691-.17 1.569.315 3.324" opacity=".5" />
                </svg>
            </span>
            <strong>@T("عملیات", "Operations")</strong>
        </a>
        <a asp-controller="Contracts" asp-action="Index" class="dash-quick-item">
            <span class="dash-quick-icon" aria-hidden="true">
                <svg class="dash-quick-svg" viewBox="0 0 24 24" focusable="false">
                    <path fill="currentColor" d="M3 10c0-3.771 0-5.657 1.172-6.828S7.229 2 11 2h2c3.771 0 5.657 0 6.828 1.172S21 6.229 21 10v4c0 3.771 0 5.657-1.172 6.828S16.771 22 13 22h-2c-3.771 0-5.657 0-6.828-1.172S3 17.771 3 14z" opacity=".5" />
                    <path fill="currentColor" fill-rule="evenodd" d="M7.25 12a.75.75 0 0 1 .75-.75h8a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75m0-4A.75.75 0 0 1 8 7.25h8a.75.75 0 0 1 0 1.5H8A.75.75 0 0 1 7.25 8m0 8a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5H8a.75.75 0 0 1-.75-.75" clip-rule="evenodd" />
                </svg>
            </span>
            <strong>@T("قراردادها", "Contracts")</strong>
        </a>
    </section>
</div>
