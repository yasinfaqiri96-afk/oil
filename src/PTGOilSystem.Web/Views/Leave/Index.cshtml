@model PTGOilSystem.Web.Models.HumanResources.LeaveIndexViewModel
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.HumanResources
@{
    ViewData["Title"] = UiText.T(Context, "رخصتی‌ها", "Leave");
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "رخصتی‌ها", "Leave"), false,
                       Model.CanManage ? UiText.T(Context, "درخواست رخصتی", "New leave request") : null, "bi-plus-lg",
                       Model.CanManage ? Url.Action("Create", new { employeeId = Model.EmployeeId }) : null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار رخصتی", "Leave statistics")">
        <vc:stat-card title="@UiText.T(Context, "در انتظار تأیید", "Awaiting approval")" value="@Model.PendingCount.ToString("N0")" unit="@UiText.T(Context, "درخواست", "requests")" avatar="rules-checklist"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "در رخصتیِ امروز", "On leave today")" value="@Model.OnLeaveToday.ToString("N0")" unit="@UiText.T(Context, "نفر", "people")" avatar="documents"></vc:stat-card>
    </section>

    @{
        var filter = new AkSearchFilterModel("q", null,
            UiText.T(Context, "فیلتر رخصتی‌ها", "Filter leave"),
            new List<AkFilterDefinition>
            {
                new("status", UiText.T(Context, "وضعیت", "Status"), "select",
                    new List<AkFilterOption>
                    {
                        new("pending", UiText.T(Context, "در انتظار", "Pending")),
                        new("approved", UiText.T(Context, "تأییدشده", "Approved")),
                        new("rejected", UiText.T(Context, "ردشده", "Rejected")),
                        new("cancelled", UiText.T(Context, "لغوشده", "Cancelled"))
                    }, Model.Status),
                new("employeeId", UiText.T(Context, "کارمند", "Employee"), "select",
                    ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Employees).Select(i => new AkFilterOption(i.Value, i.Text)).ToList(),
                    Model.EmployeeId?.ToString())
            });
    }
    <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="filter" />

    <div class="ak-list">
        <div class="ak-table-wrap">
            <table class="ak-table" aria-label="@UiText.T(Context, "فهرست رخصتی‌ها", "Leave requests")">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context, "کارمند", "Employee")</th>
                        <th>@UiText.T(Context, "نوع", "Type")</th>
                        <th>@UiText.T(Context, "از", "From")</th>
                        <th>@UiText.T(Context, "تا", "To")</th>
                        <th class="ak-col-num">@UiText.T(Context, "روز", "Days")</th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                        <th class="ak-col-actions">@UiText.T(Context, "عملیات", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ak-col-grow">
                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@item.EmployeeId" asp-route-tab="leave" class="ak-name">@item.EmployeeName</a>
                                @if (!string.IsNullOrWhiteSpace(item.Reason)) { <div class="ak-note">@item.Reason</div> }
                            </td>
                            <td>
                                @item.LeaveTypeName
                                @if (!item.IsPaid) { <div class="ak-note">@UiText.T(Context, "بدون معاش", "Unpaid")</div> }
                            </td>
                            <td>@item.FromDate.ToDisplayDate()</td>
                            <td>@item.ToDate.ToDisplayDate()</td>
                            <td class="ak-num ak-col-num">@item.TotalDays.ToString("0.#")@(item.IsHalfDay ? " ½" : "")</td>
                            <td>
                                <span class="ak-status @LeaveLabels.Css(item.Status)">@LeaveLabels.Status(item.Status)</span>
                                @if (!string.IsNullOrWhiteSpace(item.DecisionNote)) { <div class="ak-note">@item.DecisionNote</div> }
                            </td>
                            <td class="ak-col-actions">
                                @if (item.HasAttachment)
                                {
                                    <a class="btn btn-sm btn-light" asp-action="Attachment" asp-route-id="@item.Id"><i class="bi bi-paperclip" aria-hidden="true"></i></a>
                                }
                                @if (Model.CanManage && item.Status == LeaveRequestStatus.Pending)
                                {
                                    <form asp-action="Approve" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline-flex">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light ak-secondary-action">@UiText.T(Context, "تأیید", "Approve")</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input name="reason" class="ak-input" placeholder="@UiText.T(Context, "دلیل رد", "Reason")" required />
                                        <button type="submit" class="btn btn-sm btn-light ak-secondary-action text-danger">@UiText.T(Context, "رد", "Reject")</button>
                                    </form>
                                }
                                @if (Model.CanManage && item.Status is LeaveRequestStatus.Pending or LeaveRequestStatus.Approved)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" method="post" class="d-inline-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input name="reason" class="ak-input" placeholder="@UiText.T(Context, "دلیل لغو", "Reason")" required />
                                        <button type="submit" class="btn btn-sm btn-light ak-secondary-action">@UiText.T(Context, "لغو", "Cancel")</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7"><div class="ak-empty"><i class="bi bi-calendar-x" aria-hidden="true"></i>@UiText.T(Context, "رخصتی‌ای پیدا نشد.", "No leave requests found.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
