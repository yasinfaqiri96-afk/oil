@model SystemSettingsPageViewModel
@{
    ViewData["Title"] = UiText.T(Context, "تنظیمات سیستم", "System settings");
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@((UiText.T(Context, "تنظیمات سیستم", "System settings"), false,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           (string?)null, (string?)null, (string?)null))" />

        @* فرم بیرون از SPA فرستاده می‌شود تا بعد از ذخیره کل پوسته با تقویمِ تازه بارگذاری شود. *@
        <form asp-action="Save" method="post" class="ak-form" data-no-spa="true">
            @Html.AntiForgeryToken()
            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "تقویم", "Calendar"), (string?)UiText.T(Context, "تقویمِ نمایش و ورودِ تاریخ در همهٔ صفحه‌ها، گزارش‌ها و خروجی‌ها. تاریخ‌های ثبت‌شده در دیتابیس تغییر نمی‌کنند.", "Calendar used to display and enter dates across pages, reports and exports. Stored dates are never changed.")))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="Settings.CalendarType" class="ak-label"></label>
                        <select asp-for="Settings.CalendarType" class="ak-input">
                            @foreach (var option in SystemSettingsPageViewModel.CalendarOptions)
                            {
                                <option value="@option.Value" selected="@(Model.Settings.CalendarType == option.Value ? "selected" : null)">@option.Label</option>
                            }
                        </select>
                    </div>
                    <div class="ak-field">
                        <span class="ak-label">@UiText.T(Context, "امروز به میلادی", "Today (Gregorian)")</span>
                        <bdi class="ak-num" dir="ltr">@Model.TodayGregorian</bdi>
                    </div>
                    <div class="ak-field">
                        <span class="ak-label">@UiText.T(Context, "امروز به هجری شمسی افغانستان", "Today (Afghan Solar Hijri)")</span>
                        <bdi class="ak-num">@Model.TodaySolar</bdi>
                    </div>
                </div>
            </section>
            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ذخیرهٔ تنظیمات", "Save settings"), Url.Action("Index") ?? "#", UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>
