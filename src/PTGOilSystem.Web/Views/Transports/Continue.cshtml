@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.ExcelImport
@using PTGOilSystem.Web.Models.InventoryTransport
@model TransportContinueViewModel
@{
    ViewData["Title"] = "انتقال به وسیله دیگر";
    ViewData["HideSectionTabs"] = true;
    var targetVehicles = ViewBag.TargetVehicles as List<TransportTargetVehicleOption> ?? [];
    var excelImportOptions = new ExcelImportComponentOptions
    {
        InputId = "transportContinueExcelFile",
        FileFieldName = "file",
        Mode = "external",
        AcceptExtensions = ".xlsx,.xls",
        Title = "امپورت حمل‌ها از اکسل",
        Description = "ستون‌های «نمبر وسیله قبلی | نمبر وسیله جدید | وزن» و در صورت وجود «گروه ادغام» خوانده می‌شود و ردیف‌های جدول پر می‌گردد.",
        StartButtonText = "خواندن و پر کردن جدول",
        SuccessTitle = "ردیف‌ها از فایل خوانده شد",
        CreatedLabel = "ردیف واردشده",
        MaxFileSizeMb = 5,
        RequiresConfirmation = false,
        ShowResultDetails = false,
        Compact = true,
        ToggleText = "امپورت اکسل"
    };
}

<main class="ak-form-page" dir="rtl" data-transport-vehicle-form>
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(("انتقال به وسیله دیگر", false, (string?)null, (string?)null, (string?)null, (string?)null, "بازگشت به حمل‌ها", "bi-arrow-right", Url.Action("Index", "InventoryTransportLegs")))" />
    <form asp-action="Continue" method="post" class="ak-form" data-submit-lock>
                @* PTG-P3-B — محافظ سمت سرور: Refresh یا تلاش دوباره حمل دوم نمی‌سازد. *@
                @Html.FormToken()
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert" role="alert"></div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("بارهای مبدأ", (string?)"حمل‌های موردنظر را انتخاب کنید و برای هرکدام وسیلهٔ مقصد را مشخص کنید؛ هر ردیف یک حملِ مقصد جدا می‌سازد، مگر اینکه چند ردیف وسیلهٔ مقصد و «گروه ادغام» یکسان داشته باشند."))" />

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <button type="button" class="btn btn-light ak-secondary-action" data-select-all>انتخاب همه</button>
                <button type="button" class="btn btn-light ak-secondary-action" data-clear-all>لغو انتخاب همه</button>
                <div class="excel-import-inline" data-upload-box>
                    <partial name="~/Views/Shared/ExcelImport/_ExcelImport.cshtml" model="excelImportOptions" />
                </div>
                <span data-import-url="@Url.Action("ImportContinueExcel", "Transports")" class="d-none"></span>
                <a asp-action="CancelContinued" class="btn btn-light ak-secondary-action ms-auto">لغو گروهی انتقال‌ها</a>
            </div>

            @* خلاصهٔ زندهٔ انتخاب: کاربر پیش از ثبت می‌بیند چند حمل، چه مقدار و به چند وسیله می‌رود. *@
            <div class="d-flex flex-wrap gap-4 align-items-center p-3 mb-3 border rounded bg-body-tertiary" data-selection-summary>
                <div>
                    <span class="text-muted small d-block">حمل انتخاب‌شده</span>
                    <strong dir="ltr" data-summary-count>0</strong>
                    <span class="text-muted small">از @Model.Sources.Count</span>
                </div>
                <div>
                    <span class="text-muted small d-block">مجموع وزن انتقال</span>
                    <strong dir="ltr" class="ak-num" data-summary-quantity>0.0000 MT</strong>
                </div>
                <div>
                    <span class="text-muted small d-block">حمل مقصد</span>
                    <strong dir="ltr" data-summary-targets>0</strong>
                </div>
                <div class="ms-auto text-muted small" data-summary-hint></div>
            </div>

            <div class="ak-table-wrap">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" class="ak-check" data-select-toggle aria-label="انتخاب همه" /></th>
                            <th>حمل مبدأ</th>
                            <th>محصول</th>
                            <th class="text-end">باقیمانده</th>
                            <th class="text-end">مقدار انتقال</th>
                            <th>وسیله مقصد</th>
                            <th>گروه ادغام</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Sources.Count; i++)
                    {
                        var source = Model.Sources[i];
                        var hasManualTarget = !string.IsNullOrWhiteSpace(source.TargetVehicleNumber);
                        <tr data-source-row data-leg-id="@source.LegId">
                            <td><input asp-for="Sources[i].Selected" class="ak-check" data-source-check /><input asp-for="Sources[i].LegId" type="hidden" /></td>
                            <td><strong>@source.Label</strong><input asp-for="Sources[i].VehicleNumber" type="hidden" /></td>
                            <td>@source.ProductName</td>
                            <td class="ak-num text-end" dir="ltr">@source.RemainingQuantityMt.ToString("N4")<input asp-for="Sources[i].RemainingQuantityMt" type="hidden" /></td>
                            <td class="text-end"><input asp-for="Sources[i].QuantityMt" class="ak-input ak-num" type="number" min="0" max="@source.RemainingQuantityMt" step="0.0001" data-source-quantity /></td>
                            <td>
                                <select asp-for="Sources[i].TargetKey" class="ak-input" data-source-target>
                                    <option value="">— وسیله پیش‌فرض —</option>
                                    @foreach (var group in targetVehicles.GroupBy(v => v.Group))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var vehicle in group)
                                            {
                                                <option value="@vehicle.Key">@vehicle.Label</option>
                                            }
                                        </optgroup>
                                    }
                                    <option value="__new__">＋ وسیله جدید (نمبر دستی)</option>
                                </select>
                                @* موترِ جدید: نمبر می‌ماند و هنگام ثبت در داده‌های پایه ساخته می‌شود. *@
                                <input asp-for="Sources[i].TargetVehicleNumber" class="ak-input mt-1" data-source-target-number placeholder="نمبر موتر جدید" hidden="@(hasManualTarget ? null : "hidden")" />
                            </td>
                            @* خالی = حملِ مقصدِ جدا؛ مقدار یکسان در چند ردیفِ هم‌مقصد = ادغام در یک حمل. *@
                            <td><input asp-for="Sources[i].MergeGroup" class="ak-input" data-source-merge placeholder="بدون ادغام" /></td>
                        </tr>
                    }
                    @if (Model.Sources.Count == 0)
                    {
                        <tr><td colspan="7"><div class="ak-empty">حمل در جریانِ دارای باقیمانده وجود ندارد.</div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("مشخصات انتقال", (string?)"این انتقال از مرز مخزن عبور نمی‌کند و حرکت موجودی ندارد."))" />
            <div class="ak-form-grid">
                <div class="ak-field"><label asp-for="TransferDate">تاریخ <b>*</b></label><input asp-for="TransferDate" type="date" class="ak-input" /></div>
            </div>

            @* وسیلهٔ مقصد پیش‌فرض فقط وقتی لازم است که ردیفی بدون وسیلهٔ مقصد انتخاب شده باشد. *@
            <div data-default-target-block hidden>
                <div class="ak-form-grid">
                    <div class="ak-field is-full">
                        <span class="text-muted small">ردیف‌های انتخاب‌شده‌ای بدون وسیلهٔ مقصد وجود دارد؛ وسیلهٔ پیش‌فرض برای آن‌ها استفاده می‌شود.</span>
                    </div>
                    <div class="ak-field"><label asp-for="TargetTransportType">نوع وسیله <b>*</b></label><select asp-for="TargetTransportType" class="ak-input" data-transport-type><option value="3">موتر</option><option value="2">واگن</option><option value="1">کشتی</option></select></div>
                    <div class="ak-field" data-vehicle-field="3"><label asp-for="TargetTruckId">موتر <b>*</b></label><select asp-for="TargetTruckId" asp-items="ViewBag.Trucks" class="ak-input"><option value="">انتخاب کنید</option></select></div>
                    <div class="ak-field" data-vehicle-field="2"><label asp-for="TargetWagonId">واگن <b>*</b></label><select asp-for="TargetWagonId" asp-items="ViewBag.Wagons" class="ak-input"><option value="">انتخاب کنید</option></select></div>
                    <div class="ak-field" data-vehicle-field="1"><label asp-for="TargetVesselId">کشتی <b>*</b></label><select asp-for="TargetVesselId" asp-items="ViewBag.Vessels" class="ak-input"><option value="">انتخاب کنید</option></select></div>
                </div>
            </div>

            <details class="ak-advanced">
                <summary class="ak-advanced-summary">گزینه‌های بیشتر (اختیاری)</summary>
                <div class="ak-advanced-body">
                    <div class="ak-form-grid">
                        <div class="ak-field" data-truck-only><label asp-for="DriverId">راننده</label><select asp-for="DriverId" asp-items="ViewBag.Drivers" class="ak-input"><option value="">بدون انتخاب</option></select></div>
                        <div class="ak-field"><label asp-for="TicketSerialNumber">شماره تکت</label><input asp-for="TicketSerialNumber" class="ak-input" /></div>
                        <div class="ak-field is-full"><label asp-for="Notes">یادداشت</label><textarea asp-for="Notes" class="ak-input" rows="2"></textarea></div>
                    </div>
                </div>
            </details>
        </section>

        <div class="ak-footer-actions">
            <a asp-controller="InventoryTransportLegs" asp-action="Index" class="btn btn-light ak-secondary-action">انصراف</a>
            <button type="submit" class="btn btn-primary ak-primary-action" data-submit-button>ثبت انتقال</button>
        </div>
    </form>
</main>

<partial name="_VehicleTypeScript" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var page = document.querySelector('[data-transport-vehicle-form]');
            if (!page) return;
            var form = page.querySelector('form');
            var rows = Array.prototype.slice.call(page.querySelectorAll('[data-source-row]'));
            var manualValue = '__new__';

            var summaryCount = page.querySelector('[data-summary-count]');
            var summaryQuantity = page.querySelector('[data-summary-quantity]');
            var summaryTargets = page.querySelector('[data-summary-targets]');
            var summaryHint = page.querySelector('[data-summary-hint]');
            var defaultTargetBlock = page.querySelector('[data-default-target-block]');

            function normalize(value) {
                return (value || '').toString().trim().toLowerCase().replace(/[^a-z0-9؀-ۿ]/g, '');
            }

            // مقصدِ مؤثر یک ردیف: وسیلهٔ انتخاب‌شده، یا نمبر دستی، وگرنه خالی (= وسیلهٔ پیش‌فرض).
            function targetOf(row) {
                var target = row.querySelector('[data-source-target]');
                var targetNumber = row.querySelector('[data-source-target-number]');
                var selected = target ? target.value : '';
                if (selected && selected !== manualValue) return selected;
                var manual = targetNumber ? normalize(targetNumber.value) : '';
                return manual ? 'plate:' + manual : '';
            }

            // کلید حملِ مقصد = وسیله + گروه ادغام؛ گروهِ خالی یعنی این ردیف حمل جدا می‌سازد،
            // پس شمارندهٔ بالای فرم دقیقاً همان تعداد حملی را نشان می‌دهد که سرور می‌سازد.
            function legKeyOf(row, index) {
                var target = targetOf(row);
                if (!target) return '';
                var merge = row.querySelector('[data-source-merge]');
                var group = merge ? normalize(merge.value) : '';
                return group ? target + '|g:' + group : target + '|r:' + index;
            }

            function isManualMode(row) {
                var target = row.querySelector('[data-source-target]');
                return !!target && target.value === manualValue;
            }

            function syncTargetMode(row) {
                var targetNumber = row.querySelector('[data-source-target-number]');
                if (!targetNumber) return;
                var manual = isManualMode(row) || (!!targetNumber.value && !row.querySelector('[data-source-target]').value);
                targetNumber.hidden = !manual;
            }

            function syncRow(row) {
                var check = row.querySelector('[data-source-check]');
                var quantity = row.querySelector('[data-source-quantity]');
                var target = row.querySelector('[data-source-target]');
                var targetNumber = row.querySelector('[data-source-target-number]');
                var merge = row.querySelector('[data-source-merge]');
                if (!check || !quantity) return;
                quantity.disabled = !check.checked;
                if (target) target.disabled = !check.checked;
                if (targetNumber) targetNumber.disabled = !check.checked;
                if (merge) merge.disabled = !check.checked;
                syncTargetMode(row);
            }

            function refreshSummary() {
                var count = 0;
                var total = 0;
                var targets = {};
                var missingTarget = 0;
                rows.forEach(function (row, index) {
                    var check = row.querySelector('[data-source-check]');
                    if (!check || !check.checked) return;
                    count += 1;
                    var quantity = row.querySelector('[data-source-quantity]');
                    total += parseFloat(quantity && quantity.value) || 0;
                    var key = legKeyOf(row, index);
                    if (key) targets[key] = true;
                    else missingTarget += 1;
                });

                if (summaryCount) summaryCount.textContent = count;
                if (summaryQuantity) summaryQuantity.textContent = total.toFixed(4) + ' MT';
                if (summaryTargets) {
                    summaryTargets.textContent = Object.keys(targets).length + (missingTarget > 0 ? ' + پیش‌فرض' : '');
                }
                if (summaryHint) {
                    summaryHint.textContent = count === 0
                        ? 'هیچ حملی انتخاب نشده است.'
                        : missingTarget > 0
                            ? missingTarget + ' ردیف بدون وسیلهٔ مقصد است؛ وسیلهٔ پیش‌فرض پایین فرم استفاده می‌شود.'
                            : 'هر ردیف وسیلهٔ مقصد خودش را دارد؛ ردیف‌های با «گروه ادغام» یکسان در یک حمل ادغام می‌شوند.';
                }
                // بلوک وسیلهٔ پیش‌فرض فقط وقتی لازم است دیده شود.
                if (defaultTargetBlock) defaultTargetBlock.hidden = missingTarget === 0;
            }

            rows.forEach(function (row) {
                var check = row.querySelector('[data-source-check]');
                var quantity = row.querySelector('[data-source-quantity]');
                var target = row.querySelector('[data-source-target]');
                var targetNumber = row.querySelector('[data-source-target-number]');
                if (!check || !quantity) return;
                check.addEventListener('change', function () {
                    if (!check.checked) quantity.value = '0';
                    else if (!parseFloat(quantity.value)) quantity.value = quantity.getAttribute('max') || '0';
                    syncRow(row);
                    refreshSummary();
                });
                quantity.addEventListener('input', refreshSummary);
                if (target) {
                    target.addEventListener('change', function () {
                        if (target.value !== manualValue && targetNumber) targetNumber.value = '';
                        syncTargetMode(row);
                        if (target.value === manualValue && targetNumber) targetNumber.focus();
                        refreshSummary();
                    });
                }
                if (targetNumber) targetNumber.addEventListener('input', refreshSummary);
                var merge = row.querySelector('[data-source-merge]');
                if (merge) merge.addEventListener('input', refreshSummary);
                syncRow(row);
            });

            function setAll(checked) {
                rows.forEach(function (row) {
                    var check = row.querySelector('[data-source-check]');
                    if (!check) return;
                    if (check.checked === checked) { syncRow(row); return; }
                    check.checked = checked;
                    check.dispatchEvent(new Event('change', { bubbles: true }));
                });
                var toggle = page.querySelector('[data-select-toggle]');
                if (toggle) toggle.checked = checked;
                refreshSummary();
            }

            var selectAll = page.querySelector('[data-select-all]');
            if (selectAll) selectAll.addEventListener('click', function () { setAll(true); });
            var clearAll = page.querySelector('[data-clear-all]');
            if (clearAll) clearAll.addEventListener('click', function () { setAll(false); });
            var toggle = page.querySelector('[data-select-toggle]');
            if (toggle) toggle.addEventListener('change', function () { setAll(toggle.checked); });

            // «وسیله جدید» فقط یک حالتِ UI است؛ سرور کلید وسیله می‌خواهد، پس پیش از ارسال پاک می‌شود.
            if (form) {
                form.addEventListener('submit', function () {
                    rows.forEach(function (row) {
                        var target = row.querySelector('[data-source-target]');
                        if (target && target.value === manualValue) target.value = '';
                    });
                });
            }

            refreshSummary();

            // امپورت اکسل (همان کامپوننت مشترک، حالت external): فقط گرید را پر می‌کند؛
            // ثبت با دکمهٔ خود فرم انجام می‌شود.
            var uploadBox = page.querySelector('[data-upload-box]');
            var uploadComponent = uploadBox ? uploadBox.querySelector('[data-excel-import]') : null;
            var importEl = page.querySelector('[data-import-url]');
            var importUrl = importEl ? importEl.getAttribute('data-import-url') : '';
            if (!uploadComponent || !importUrl) return;

            function fillFromRows(items) {
                setAll(false);
                var applied = 0;
                items.forEach(function (item) {
                    var row = page.querySelector('[data-source-row][data-leg-id="' + item.legId + '"]');
                    if (!row) return;
                    var check = row.querySelector('[data-source-check]');
                    var quantity = row.querySelector('[data-source-quantity]');
                    var target = row.querySelector('[data-source-target]');
                    var targetNumber = row.querySelector('[data-source-target-number]');
                    var merge = row.querySelector('[data-source-merge]');
                    if (check) check.checked = true;
                    syncRow(row);
                    if (quantity) quantity.value = item.quantityMt;
                    if (target) target.value = item.targetKey || (item.targetVehicleNumber ? manualValue : '');
                    if (targetNumber) targetNumber.value = item.targetVehicleNumber || '';
                    if (merge) merge.value = item.mergeGroup || '';
                    syncTargetMode(row);
                    applied += 1;
                });
                var toggleBox = page.querySelector('[data-select-toggle]');
                if (toggleBox) toggleBox.checked = applied > 0 && applied === rows.length;
                refreshSummary();
                return applied;
            }

            uploadComponent.addEventListener('excel-import:start', function (event) {
                var api = event.detail;
                var data = new FormData();
                data.append('file', api.file);
                var token = page.querySelector('input[name="__RequestVerificationToken"]');
                if (token) data.append('__RequestVerificationToken', token.value);
                api.progress({ stage: 2, message: 'در حال خواندن نمبر وسیله‌ها و وزن…' });
                fetch(importUrl, { method: 'POST', body: data, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) { return response.json(); })
                    .then(function (result) {
                        var warnings = (result && result.warnings) || [];
                        if (!result || !result.ok) {
                            api.fail(((result && result.message) || 'خواندن فایل ناموفق بود.')
                                + (warnings.length ? ' — ' + warnings.join(' | ') : ''));
                            return;
                        }
                        var applied = fillFromRows(result.rows || []);
                        if (applied === 0) { api.fail('هیچ ردیفی با حمل‌های در جریان تطبیق نشد.'); return; }
                        api.complete({
                            message: applied + ' ردیف در جدول پر شد؛ مقدار و وسیلهٔ مقصد را بررسی کنید.'
                                + (warnings.length ? ' هشدار: ' + warnings.join(' | ') : ''),
                            createdRows: applied,
                            rejectedRows: warnings.length,
                            updatedRows: 0
                        });
                    })
                    .catch(function () { api.fail('خطا در ارتباط با سرور.'); });
            });
        })();
    </script>
}
