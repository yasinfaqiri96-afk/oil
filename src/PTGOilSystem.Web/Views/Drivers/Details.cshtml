@model Driver
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] = "جزئیات راننده";
    ViewData["HideSectionTabs"] = true;
    var profile = ViewData["ResourceProfile"] as TransportResourceProfileViewModel ?? TransportResourceProfileViewModel.Empty();
    var activeTab = Context.Request.Query["tab"].ToString().Trim().ToLowerInvariant();
    activeTab = activeTab is "docs" or "info" ? activeTab : "trips";
    var code = string.IsNullOrWhiteSpace(Model.LicenseNumber) ? $"DRV-{Model.Id:0000}" : Model.LicenseNumber;
    var docsReady = profile.Documents.Count > 0;
    var hasLedger = ViewData["DriverHasLedger"] as bool? ?? false;
    var freightCreditUsd = ViewData["DriverFreightCreditUsd"] as decimal? ?? 0m;
    var shortageDebitUsd = ViewData["DriverShortageDebitUsd"] as decimal? ?? 0m;
    var officialSummary = ViewData["PartyStatementSummary"] as PTGOilSystem.Web.Models.PartyStatements.PartyStatementSummary;
    var netOwedUsd = officialSummary?.ClosingBalance ?? (ViewData["DriverNetOwedUsd"] as decimal? ?? 0m);
    var netOwedMeaning = officialSummary?.ClosingBalanceMeaning
        ?? (netOwedUsd >= 0m ? "بدهی ما به راننده" : "بدهی راننده به ما");

    var editUrl = Url.Action("Edit", new { id = Model.Id }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";
    var statementUrl = Url.Action("Driver", "PartyStatements", new { id = Model.Id }) ?? "#";
    ViewData["AkHeaderStatus"] = Model.IsActive ? "فعال" : "غیرفعال";
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = $"{code} · {netOwedMeaning}";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = "ویرایش مشخصات", Href = editUrl, Icon = "bi-pencil" }
    };

    // شاخص‌های مالی راننده فقط وقتی دفتر حساب دارد؛ بدون دفتر، فقط شمار سفر می‌ماند.
    var kpis = new List<AkKpiItem>
    {
        new() { Title = "تعداد سفرها", Value = profile.Trips.Count.ToString("N0"), Avatar = "transported" }
    };
    if (hasLedger)
    {
        kpis.Add(new AkKpiItem { Title = "کرایهٔ بستانکار", Value = freightCreditUsd.ToString("N2"), Unit = "USD", Avatar = "payments-out" });
        if (shortageDebitUsd > 0m)
        {
            kpis.Add(new AkKpiItem { Title = "بدهی خسارت کسری", Value = shortageDebitUsd.ToString("N2"), Unit = "USD", Avatar = "losses", State = "warning" });
        }
        kpis.Add(new AkKpiItem { Title = "ماندهٔ خالص", Value = Math.Abs(netOwedUsd).ToString("N2"), Unit = "USD", Avatar = "receivables" });
    }

    // «مشخصات پایه» تب یک‌ردیفه بود؛ حالا کارت خلاصهٔ همیشه‌دیدنیِ صفحه است.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = "شماره جواز", Value = Model.LicenseNumber },
        new() { Label = "شناسه ملی", Value = Model.NationalId },
        new() { Label = "تلفن", Value = Model.Phone, IsNumeric = true },
        new()
        {
            Label = "وضعیت مدارک",
            Value = $"{(docsReady ? "تکمیل و معتبر" : "نیاز به بررسی")} ({profile.Documents.Count.ToString("N0")})",
            Tone = docsReady ? null : "warning"
        },
        new() { Label = "ماندهٔ خالص", Value = hasLedger ? $"{Math.Abs(netOwedUsd).ToString("N2")} USD — {netOwedMeaning}" : null, IsNumeric = false },
        new() { Label = "آدرس", Value = Model.Address, IsWide = true },
        new() { Label = "یادداشت", Value = Model.Notes, IsWide = true }
    };

    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = "شناسه داخلی", Value = $"#{Model.Id}", IsNumeric = true }
    };

    var driverTabs = new[]
    {
        $"trips|سوابق سفرها||{(activeTab == "trips" ? "active" : "")}",
        $"docs|اسناد و مدارک||{(activeTab == "docs" ? "active" : "")}"
    };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.FullName, false,
                       "صورت‌حساب رسمی", "bi-file-earmark-text", statementUrl, (string?)null,
                       "بازگشت به فهرست", "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

    <partial name="~/Views/Shared/Partials/_DetailSummaryCard.cshtml"
             model="@(("مشخصات راننده", (string?)null, (IReadOnlyList<AkInfoItem>)summaryItems))" />

    <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("بخش‌های پروفایل راننده", driverTabs)" />

    <section class="ak-form-section ak-detail-section">
        @if (activeTab == "docs")
        {
            @await Html.PartialAsync("_TransportResourceDocs", profile)
        }
        else
        {
            @await Html.PartialAsync("_TransportResourceTrips", profile)
        }
    </section>

    <partial name="~/Views/Shared/Partials/_DetailAdvancedSection.cshtml"
             model="@(((string?)null, (IReadOnlyList<AkInfoItem>)advancedItems))" />
</div>
