@model PTGOilSystem.Web.Models.Partners.PartnerProfileViewModel
@using PTGOilSystem.Web.Models.Partners
@using PTGOilSystem.Web.Services.PartyStatements
@{
    ViewData["Title"] = "پروفایل شریک";
    ViewData["HideSectionTabs"] = true;

    var statement = Model.Statement;
    var direction = statement?.Direction ?? PartnerBalanceDirection.Settled;
    var balanceAmount = statement?.AmountUsd ?? 0m;

    // جملهٔ مانده — جهت را سرویس تعیین کرده است؛ اینجا فقط به زبان کاربر نوشته می‌شود.
    // نام کاملِ شریک می‌آید، نه «این شریک»: صفحه همیشه پروفایل یک شریکِ مشخص است.
    var partnerFullName = statement?.PartnerName is { Length: > 0 } serviceName ? serviceName : Model.Name;
    var balanceSentence = direction switch
    {
        PartnerBalanceDirection.Creditor => $"{partnerFullName} {NumberDisplay.Money(balanceAmount)} USD طلبکار است",
        PartnerBalanceDirection.Debtor => $"{partnerFullName} باید {NumberDisplay.Money(balanceAmount)} USD پرداخت کند",
        _ => $"حساب {partnerFullName} تسویه است"
    };
    // طلبِ شریک یعنی بدهی ما (danger)، بدهیِ شریک یعنی طلب ما (success) — همان قاعدهٔ بقیهٔ طرف‌حساب‌ها.
    var balanceTone = direction switch
    {
        PartnerBalanceDirection.Creditor => "danger",
        PartnerBalanceDirection.Debtor => "success",
        _ => null
    };

    var showLedger = Model.ActiveTab == PartnerProfileTabs.Ledger;
    var showSummary = !showLedger;

    var contractsShown = DetailListPreview.Take(Context.Request, "partner-contracts", Model.Contracts);
    // گردش حساب کامل روی همان صفحه دیده می‌شود: نه سقف پیش‌نمایش، نه صفحه‌بندی سمت
    // مرورگر. دو شمارندهٔ متفاوت («۲۵ از ۴۳» و «۱-۲۰ از ۲۵») کاربر را به اشتباه می‌انداخت.
    var entriesShown = Model.Entries;

    var editUrl = Url.Action("Edit", new { id = Model.PartnerId }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";

    ViewData["AkHeaderStatus"] = Model.IsActive ? "فعال" : "غیرفعال";
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";

    var kebabItems = new List<AkHeaderMenuItem>
    {
        new() { Label = "ویرایش", Href = editUrl, Icon = "bi-pencil" }
    };
    foreach (var mate in Model.CoPartners)
    {
        kebabItems.Add(new AkHeaderMenuItem
        {
            Label = $"صورت‌حساب شراکت با {mate.PartnerName}",
            Href = Url.Action("Index", "PartnershipStatement",
                new { partnerAId = Model.PartnerId, partnerBId = mate.PartnerId }),
            Icon = "bi-arrow-left-right"
        });
    }
    ViewData["AkHeaderKebab"] = kebabItems;

    // خروجی Excel/PDF از همان منوی مشترک بقیهٔ صفحات مالی. فیلترهای گردش حساب از query
    // خودِ صفحه برداشته می‌شوند، پس خروجی همان چیزی است که روی صفحه دیده می‌شود.
    ViewData["AkHeaderExport"] = new PTGOilSystem.Web.Services.Exports.ExportMenuModel(
        "Export",
        "Partners",
        new Dictionary<string, string?> { ["id"] = Model.PartnerId.ToString() });

    var partnerTabs = new[]
    {
        $"{PartnerProfileTabs.Summary}|خلاصه حساب|bi-grid-1x2|{(showSummary ? "active" : "")}",
        $"{PartnerProfileTabs.Ledger}|گردش حساب|bi-journal-text|{(showLedger ? "active" : "")}"
    };

    // چهار عددِ تصمیم‌ساز — همان اجزای اصلی حساب، بدون هیچ اصطلاح حسابداری.
    var partnerKpis = new List<AkKpiItem>
    {
        new() { Title = "پرداخت و سرمایهٔ شریک", Value = NumberDisplay.Money(statement?.FundingUsd ?? 0m), Unit = "USD", Avatar = "payments" },
        new() { Title = "عواید فروش نزد شریک", Value = NumberDisplay.Money(statement?.ProceedsHeldUsd ?? 0m), Unit = "USD", Avatar = "sales-value" },
        new() { Title = "سهم مفاد/ضرر", Value = NumberDisplay.Money(statement?.ProfitShareUsd ?? 0m), Unit = "USD", Avatar = "receivables" },
        new() { Title = direction == PartnerBalanceDirection.Debtor ? "مانده نهایی — بدهی شریک" : direction == PartnerBalanceDirection.Creditor ? "مانده نهایی — طلب شریک" : "مانده نهایی", Value = NumberDisplay.Money(balanceAmount), Unit = "USD", Avatar = "receivables" }
    };

    // سه عددِ بالای گردش حساب. جمع‌ها از همان اثرهای ردیف‌ها می‌آید، پس
    // «مجموع بردگی − مجموع رسیدگی» دقیقاً همان ماندهٔ ستون «مانده» در آخرین ردیف است.
    var ledgerKpis = new List<AkKpiItem>
    {
        new() { Title = "مجموع بردگی", Value = NumberDisplay.Money(statement?.TotalCreditUsd ?? 0m), Unit = "USD", Avatar = "payments" },
        new() { Title = "مجموع رسیدگی", Value = NumberDisplay.Money(statement?.TotalDebitUsd ?? 0m), Unit = "USD", Avatar = "expenses" },
        new() { Title = direction == PartnerBalanceDirection.Debtor ? "مانده فعلی — بدهی شریک" : direction == PartnerBalanceDirection.Creditor ? "مانده فعلی — طلب شریک" : "مانده فعلی", Value = NumberDisplay.Money(balanceAmount), Unit = "USD", Avatar = "receivables" }
    };

    var partnerAccountCard = new AkPartyAccountCard
    {
        Meaning = string.Empty,
        MeaningTone = balanceTone,
        Facts = new List<AkInfoItem>
        {
            new() { Label = "آخرین حرکت مالی", Value = statement?.LastActivityDate?.ToDisplayDate() },
            new() { Label = "شریک مقابل", Value = Model.CoPartners.Count == 0 ? null : string.Join("، ", Model.CoPartners.Select(c => c.PartnerName)) }
        },
        Identity = new List<AkInfoItem>
        {
            new() { Label = "نام فارسی", Value = Model.NamePersian },
            new() { Label = "کد", Value = Model.Code },
            new() { Label = "کشور", Value = Model.Country },
            new() { Label = "شخص تماس", Value = Model.ContactPerson }
        }
    };

    // ردیفِ بدون قرارداد، تسویهٔ کلیِ حساب است — نه ردیف ناقص. با همین عنوان دیده می‌شود.
    var generalAccountLabel = "تسویه عمومی";

    string KindLabel(PartnershipStatementLineKind kind) => kind switch
    {
        PartnershipStatementLineKind.PartnerPurchase => "خرید توسط شریک",
        PartnershipStatementLineKind.PartnerExpense => "مصرف پرداخت‌شده توسط شریک",
        PartnershipStatementLineKind.SaleProceedsHeld => "عاید فروش نزد شریک",
        PartnershipStatementLineKind.ProfitShare => "سهم مفاد",
        PartnershipStatementLineKind.PartnerSettlement => "تسویه بین شرکا",
        PartnershipStatementLineKind.Adjustment => "اصلاح/برگشت",
        _ => "پرداخت شریک"
    };

    // ستون‌های بردگی/رسیدگی جای «اثر بر حساب» را گرفتند، پس مقدار خالی خط تیره می‌شود
    // و هرگز صفرِ ساختگی چاپ نمی‌شود.
    var noValue = "—";
    string Money(decimal value) => value == 0m ? noValue : value.ToString("N2");
    // مقدار و نرخ فقط وقتی چاپ می‌شوند که خودِ سند آن‌ها را دارد؛ صفرِ ساختگی بدتر از خالی است.
    string Optional(decimal? value, string format) => value.HasValue ? value.Value.ToString(format) : noValue;

    string? SourceUrl(PartnerAccountEntry entry) => entry.SourceType switch
    {
        "Payment" when entry.SourceId.HasValue => Url.Action("Details", "Payments", new { id = entry.SourceId.Value }),
        "Sale" when entry.SourceId.HasValue => Url.Action("Details", "Sales", new { id = entry.SourceId.Value }),
        "Contract" when entry.ContractId.HasValue => Url.Action("Details", "ContractJourney", new { contractId = entry.ContractId.Value }),
        // طرف مقابل از خودِ همان تسویه می‌آید، نه از اولین شریکِ فهرست؛ وگرنه شریکی که با
        // چند نفر حساب دارد به جفتِ اشتباه لینک می‌شد.
        "Settlement" when entry.CounterpartyPartnerId.HasValue => Url.Action("Index", "PartnershipStatement",
            new { partnerAId = Model.PartnerId, partnerBId = entry.CounterpartyPartnerId.Value }),
        _ => null
    };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.Name, false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       "بازگشت به فهرست", "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("بخش‌های پروفایل شریک", partnerTabs)" />

    @* ===== تب ۱: خلاصه حساب ===== *@
    <div class="ak-form-grid ak-overview-grid" hidden="@(!showSummary)">
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)partnerKpis)" />

        <partial name="~/Views/Shared/Components/Ak/_AkPartyAccountCard.cshtml" model="@partnerAccountCard" />

        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("قراردادهای شریک", $"{Model.ContractsCount:N0} قرارداد شراکتی — برای دیدن جریان هر قرارداد روی نام آن کلیک کنید."))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">قرارداد</th>
                            <th class="ak-col-num">پرداخت شریک</th>
                            <th class="ak-col-num">عاید نزد شریک</th>
                            <th class="ak-col-num">سهم مفاد/ضرر</th>
                            <th class="ak-col-num">اثر بر حساب شریک</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in contractsShown)
                    {
                        <tr>
                            <td class="ak-col-grow">
                                <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@row.ContractId">@row.ContractLabel</a>
                            </td>
                            <td class="ak-col-num ak-num">@row.FundingUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@row.ProceedsHeldUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@row.ProfitShareUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@row.NetPositionUsd.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.ContractsCount == 0)
                    {
                        <tr><td colspan="5"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-diagram-3"></i> برای این شریک هنوز قرارداد شراکتی ثبت نشده است.</div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="~/Views/Shared/Partials/_DetailMoreLink.cshtml" model="@(("partner-contracts", contractsShown.Count, Model.ContractsCount))" />

            <p class="ak-note">مانده مثبت یعنی طلب شریک و مانده منفی یعنی بدهی شریک.</p>
        </section>
    </div>

    @* ===== تب ۲: گردش حساب ===== *@
    <section id="partner-ledger" class="ak-form-section ak-detail-section" hidden="@(!showLedger)">
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)ledgerKpis)" />

        <form asp-action="Details" asp-route-id="@Model.PartnerId" method="get" class="ak-detail-toolbar">
            <input type="hidden" name="tab" value="@PartnerProfileTabs.Ledger" />
            <div class="ak-field">
                <label class="ak-label" for="partnerLedgerContract">قرارداد</label>
                <select id="partnerLedgerContract" name="contractId" class="ak-input">
                    <option value="">همه قراردادها</option>
                    @foreach (var option in Model.ContractOptions)
                    {
                        <option value="@option.ContractId" selected="@(Model.FilterContractId == option.ContractId)">@option.ContractLabel</option>
                    }
                </select>
            </div>
            <div class="ak-field">
                <label class="ak-label" for="partnerLedgerFrom">از تاریخ</label>
                <input id="partnerLedgerFrom" class="ak-input" type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="ak-field">
                <label class="ak-label" for="partnerLedgerTo">تا تاریخ</label>
                <input id="partnerLedgerTo" class="ak-input" type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>اعمال</span>
            </button>
            <a asp-action="Details" asp-route-id="@Model.PartnerId" asp-route-tab="@PartnerProfileTabs.Ledger" class="btn btn-light">حذف فیلتر</a>
        </form>

        <div class="ak-table-wrap" data-disable-client-pagination="true">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>قرارداد</th>
                        <th class="ak-col-grow">شرح</th>
                        <th class="ak-col-num">مقدار MT</th>
                        <th class="ak-col-num">نرخ</th>
                        <th class="ak-col-num">بردگی</th>
                        <th class="ak-col-num">رسیدگی</th>
                        <th class="ak-col-num">مانده</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in entriesShown)
                {
                    var url = SourceUrl(entry);
                    <tr>
                        <td>@(entry.Date?.ToDisplayDate() ?? noValue)</td>
                        <td>@(entry.ContractLabel ?? generalAccountLabel)</td>
                        <td class="ak-col-grow">
                            @if (!string.IsNullOrWhiteSpace(url))
                            {
                                <a href="@url">@entry.Description</a>
                            }
                            else
                            {
                                <span>@entry.Description</span>
                            }
                            <span class="ak-cell-note">
                                @KindLabel(entry.Kind)@(string.IsNullOrWhiteSpace(entry.Reference) ? "" : $" · {entry.Reference}")
                            </span>
                        </td>
                        <td class="ak-col-num ak-num">@Optional(entry.QuantityMt, "N3")</td>
                        <td class="ak-col-num ak-num">@Optional(entry.UnitPriceUsd, "N2")</td>
                        <td class="ak-col-num ak-num @(entry.CreditUsd == 0m ? null : "ak-number--negative")">@Money(entry.CreditUsd)</td>
                        <td class="ak-col-num ak-num @(entry.DebitUsd == 0m ? null : "ak-number--positive")">@Money(entry.DebitUsd)</td>
                        <td class="ak-col-num ak-num">@entry.AccountantBalanceUsd.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="8"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-cash-stack"></i> برای این بازه و قرارداد، حرکتی ثبت نشده است.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
