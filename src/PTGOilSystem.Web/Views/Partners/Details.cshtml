@model PTGOilSystem.Web.Models.Partners.PartnerProfileViewModel
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] = "پروفایل شریک";
    ViewData["HideSectionTabs"] = true;
    var notRecorded = "ثبت نشده";

    var officialSummary = ViewData["PartyStatementSummary"] as PTGOilSystem.Web.Models.PartyStatements.PartyStatementSummary;
    var settlementUsd = officialSummary?.ClosingBalance ?? Model.PartnerGrossProfitUsd;
    var balanceLabel = officialSummary?.ClosingBalanceMeaningFor(UiText.IsEn(Context))
        ?? (settlementUsd > 0m ? "سهم سود شریک — قابل تسویه" : settlementUsd < 0m ? "سهم زیان شریک — قابل دریافت" : "بدون مانده قابل تسویه");
    // tone فقط جهت مالی را نشان می‌دهد: بدهی شرکت به شریک سرخ، طلب شرکت سبز، بدون مانده خنثی.
    var balanceTone = settlementUsd > 0m ? "danger" : settlementUsd < 0m ? "success" : null;

    var showAccount = Model.ActiveTab == "account";
    var showContracts = Model.ActiveTab == "contracts";
    var showOverview = !showAccount && !showContracts;

    var filteredPayments = Model.SelectedContractId.HasValue
        ? Model.Payments.Where(p => p.ContractId == Model.SelectedContractId.Value).ToList()
        : Model.Payments.ToList();

    var editUrl = Url.Action("Edit", new { id = Model.PartnerId }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";
    var statementUrl = Url.Action("Partner", "PartyStatements", new { id = Model.PartnerId }) ?? "#";
    ViewData["AkHeaderStatus"] = Model.IsActive ? "فعال" : "غیرفعال";
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = $"میانگین سهم: {Model.AverageSharePercent:N2}٪ · {balanceLabel}";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = "ویرایش", Href = editUrl, Icon = "bi-pencil" }
    };

    var partnerTabs = new[]
    {
        $"overview|خلاصه حساب|bi-grid-1x2|{(showOverview ? "active" : "")}",
        $"account|حساب شریک|bi-journal-text|{(showAccount ? "active" : "")}",
        $"contracts|معاملات و سود/زیان|bi-diagram-3|{(showContracts ? "active" : "")}"
    };

    // کارت‌های آماری تب خلاصه — همان اعداد کارت قبلی، بدون هیچ محاسبهٔ تازه.
    var partnerKpis = new List<AkKpiItem>
    {
        new() { Title = "مانده قابل تسویه", Value = NumberDisplay.Money(Math.Abs(settlementUsd)), Unit = "USD", Avatar = "receivables" },
        new() { Title = "سهم درآمد فروش", Value = NumberDisplay.Money(Model.PartnerSalesRevenueUsd), Unit = "USD", Avatar = "sales-value" },
        new() { Title = "سهم مصرف و خرید", Value = NumberDisplay.Money(Model.PartnerTotalCostUsd), Unit = "USD", Avatar = "expenses" }
    };

    // کارت وضعیت حساب تب خلاصه — فقط چیدمان نمایشی روی همان اعداد مدل.
    var partnerAccountCard = new AkPartyAccountCard
    {
        Meaning = balanceLabel,
        MeaningTone = balanceTone,
        Facts = new List<AkInfoItem>
        {
            new() { Label = "میانگین سهم", Value = Model.AverageSharePercent.ToString("N2"), Unit = "٪", IsNumeric = true },
            new() { Label = "قرارداد شراکتی", Value = Model.ContractsCount.ToString("N0"), IsNumeric = true },
            new() { Label = "آخرین حرکت مالی", Value = Model.LastFinancialDate?.ToDisplayDate() }
        },
        Identity = new List<AkInfoItem>
        {
            new() { Label = "نام فارسی", Value = string.IsNullOrWhiteSpace(Model.NamePersian) ? notRecorded : Model.NamePersian },
            new() { Label = "کد", Value = string.IsNullOrWhiteSpace(Model.Code) ? notRecorded : Model.Code },
            new() { Label = "کشور", Value = string.IsNullOrWhiteSpace(Model.Country) ? notRecorded : Model.Country },
            new() { Label = "شخص تماس", Value = string.IsNullOrWhiteSpace(Model.ContactPerson) ? notRecorded : Model.ContactPerson },
            new() { Label = "تلفن", Value = string.IsNullOrWhiteSpace(Model.Phone) ? notRecorded : Model.Phone },
            new() { Label = "ایمیل", Value = string.IsNullOrWhiteSpace(Model.Email) ? notRecorded : Model.Email },
            new() { Label = "آدرس", Value = string.IsNullOrWhiteSpace(Model.Address) ? notRecorded : Model.Address, IsWide = true },
            new() { Label = "یادداشت", Value = string.IsNullOrWhiteSpace(Model.Notes) ? notRecorded : Model.Notes, IsWide = true }
        }
    };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.Name, false,
                       "صورت‌حساب رسمی", "bi-file-earmark-text", statementUrl, (string?)null,
                       "بازگشت به فهرست", "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("بخش‌های پروفایل شریک", partnerTabs)" />

    @* ===== تب خلاصه: کارت‌های آماری، بعد یک کارت واحدِ وضعیت حساب + هویت ===== *@
    <div class="ak-form-grid ak-overview-grid" hidden="@(!showOverview)">
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)partnerKpis)" />

        <partial name="~/Views/Shared/Components/Ak/_AkPartyAccountCard.cshtml" model="@partnerAccountCard" />
    </div>

    @* ===== تب ۱: حساب شریک ===== *@
    <section id="partner-account" class="ak-form-section ak-detail-section" hidden="@(!showAccount)">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("صورت‌حساب سهم شریک", "فقط اثر سهم این شریک از اسناد قراردادهای شراکتی."))" />

        <form asp-action="Details" asp-route-id="@Model.PartnerId" method="get" class="ak-detail-toolbar">
            <input type="hidden" name="tab" value="account" />
            <div class="ak-field">
                <label class="ak-label" for="partnerStatementContract">نمایش بر اساس قرارداد</label>
                <select id="partnerStatementContract" name="contractId" class="ak-input">
                    <option value="">همه قراردادهای شریک</option>
                    @foreach (var option in Model.StatementContractOptions)
                    {
                        <option value="@option.ContractId" selected="@(Model.SelectedContractId == option.ContractId)">@option.DisplayLabel</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-light">نمایش</button>
            @if (Model.SelectedContractId.HasValue)
            {
                <a asp-action="Details" asp-route-id="@Model.PartnerId" asp-route-tab="account" class="btn btn-light">نمایش همه</a>
            }
        </form>

        @if (Model.SelectedContract is not null)
        {
            var sc = Model.SelectedContract;
            var scClass = sc.PartnerGrossProfitUsd > 0m ? "ak-num" : sc.PartnerGrossProfitUsd < 0m ? "ak-num" : "";
            <dl class="ak-list">
                <div class="ak-list-row"><dt>درصد سهم</dt><dd class="ak-num">@sc.SharePercent.ToString("N2")٪</dd></div>
                <div class="ak-list-row"><dt>سهم درآمد USD</dt><dd class="ak-num">@sc.SalesRevenueUsd.ToString("N2")</dd></div>
                <div class="ak-list-row"><dt>کل مصرف USD</dt><dd class="ak-num">@sc.TotalCostUsd.ToString("N2")</dd></div>
                <div class="ak-list-row"><dt>سهم سود/زیان USD</dt><dd class="ak-num @scClass">@sc.PartnerGrossProfitUsd.ToString("N2")</dd></div>
            </dl>
        }

        <div class="ak-party-statement-embed" data-party-statement-embed="@(Url.Action("Partner", "PartyStatements", new { id = Model.PartnerId, ContractId = Model.SelectedContractId }))">
            <div class="ak-empty ak-detail-empty-state">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <p>در حال بارگذاری صورت‌حساب…</p>
            </div>
        </div>

        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("حرکات نقدی سهم شریک", $"{filteredPayments.Count:N0} مورد"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th class="ak-col-grow">نوع</th>
                        <th>حساب</th>
                        <th>قرارداد</th>
                        <th class="ak-col-num">سهم شریک USD</th>
                        <th>مرجع</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in filteredPayments)
                {
                    <tr>
                        <td>@row.PaymentDate.ToDisplayDate()</td>
                        <td class="ak-col-grow">@row.PaymentKindName</td>
                        <td>@row.CashAccount</td>
                        <td>@(row.ContractNumber ?? "-")</td>
                        <td class="ak-col-num ak-num">@row.PartnerAmountUsd.ToString("N2")</td>
                        <td><a asp-controller="Payments" asp-action="Details" asp-route-id="@row.PaymentId">@(row.Reference ?? $"#{row.PaymentId}")</a></td>
                    </tr>
                }
                @if (filteredPayments.Count == 0)
                {
                    <tr><td colspan="6"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-cash-stack"></i> پرداخت/دریافت‌های قراردادهای این شریک اینجا دیده می‌شوند.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    @* ===== تب ۳: معاملات و سود/زیان ===== *@
    <section id="partner-contracts" class="ak-form-section ak-detail-section" hidden="@(!showContracts)">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("قراردادهای شراکتی", $"{Model.Contracts.Count:N0} قرارداد"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">قرارداد</th>
                        <th>نوع</th>
                        <th>طرف معامله</th>
                        <th>محصول</th>
                        <th class="ak-col-num">سهم٪</th>
                        <th class="ak-col-num">سهم درآمد USD</th>
                        <th class="ak-col-num">سهم مصرف USD</th>
                        <th class="ak-col-num">سهم سود/زیان USD</th>
                        <th>وضعیت</th>
                        <th class="ak-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Contracts)
                {
                    var rowClass = row.PartnerGrossProfitUsd > 0m ? "ak-num" : row.PartnerGrossProfitUsd < 0m ? "ak-num" : "";
                    var partnerCost = row.TotalCostUsd * row.SharePercent / 100m;
                    <tr>
                        <td class="ak-col-grow"><a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@row.ContractId">@row.DisplayLabel</a></td>
                        <td>@row.ContractTypeName</td>
                        <td>@row.CounterpartyName</td>
                        <td>@row.Product</td>
                        <td class="ak-col-num ak-num">@row.SharePercent.ToString("N2")٪</td>
                        <td class="ak-col-num ak-num">@row.SalesRevenueUsd.ToString("N2")</td>
                        <td class="ak-col-num ak-num">@partnerCost.ToString("N2")</td>
                        <td class="ak-col-num ak-num @rowClass">@row.PartnerGrossProfitUsd.ToString("N2")</td>
                        <td><span class="ak-status">@row.StatusName</span></td>
                        <td class="ak-col-actions"><a asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@row.ContractId">جریان</a></td>
                    </tr>
                }
                @if (!Model.Contracts.Any())
                {
                    <tr><td colspan="10"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-diagram-3"></i> برای این شریک هنوز قرارداد شراکتی ثبت نشده است.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
