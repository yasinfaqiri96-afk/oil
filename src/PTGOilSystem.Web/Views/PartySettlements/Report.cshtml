@model PTGOilSystem.Web.Models.Finance.PartySettlementReportViewModel
@using PTGOilSystem.Web.Models.Finance
@{
    ViewData["Title"] = UiText.T(Context, "گزارش تسویه بین طرف‌حساب‌ها", "Party Settlement Report");
    var f = Model.Filter;
    var hasPair = Model.HasPartyA || Model.HasPartyB;
    var a = Model.PartyAName ?? UiText.T(Context, "الف", "A");
    var b = Model.PartyBName ?? UiText.T(Context, "ب", "B");

    // عنوان جهت‌ها: با یک طرف‌حساب، «الف ← ب» یعنی پرداختی‌های همان طرف‌حساب.
    var aToBLabel = Model.HasPartyA && Model.HasPartyB
        ? $"{a} ← {b}"
        : Model.HasPartyA ? UiText.T(Context, $"پرداختی {a}", $"Paid by {a}") : UiText.T(Context, $"دریافتی {b}", $"Received by {b}");
    var bToALabel = Model.HasPartyA && Model.HasPartyB
        ? $"{b} ← {a}"
        : Model.HasPartyA ? UiText.T(Context, $"دریافتی {a}", $"Received by {a}") : UiText.T(Context, $"پرداختی {b}", $"Paid by {b}");

    var partyOptions = new List<AkFilterOption>();
    if (ViewBag.PartyGroups is List<(string Label, List<(string Key, string Name)> Items)> groups)
    {
        foreach (var group in groups)
        {
            partyOptions.AddRange(group.Items.Select(i => new AkFilterOption(i.Key, $"{i.Name} ({group.Label})")));
        }
    }
    var currencyOptions = ((IEnumerable<string>?)ViewBag.Currencies ?? Enumerable.Empty<string>())
        .Select(c => new AkFilterOption(c, c)).ToList();

    // مقدار پیش‌فرض (هر دو جهت / فعال) چیپ فیلتر نمی‌سازد.
    var filterModel = new AkSearchFilterModel("Search", f.Search,
        UiText.T(Context, "جست‌وجوی شماره (PS-…) یا یادداشت...", "Search number (PS-…) or notes..."),
        new List<AkFilterDefinition>
        {
            new("PartyA", UiText.T(Context, "طرف‌حساب الف (پرداخت‌کننده)", "Party A (payer)"), "select", partyOptions, f.PartyA),
            new("PartyB", UiText.T(Context, "طرف‌حساب ب (دریافت‌کننده)", "Party B (receiver)"), "select", partyOptions, f.PartyB),
            new("Direction", UiText.T(Context, "جهت", "Direction"), "select",
                new List<AkFilterOption>
                {
                    new(nameof(PartySettlementReportDirection.AToB), UiText.T(Context, "الف ← ب", "A → B")),
                    new(nameof(PartySettlementReportDirection.BToA), UiText.T(Context, "ب ← الف", "B → A")),
                    new(nameof(PartySettlementReportDirection.Both), UiText.T(Context, "هر دو جهت", "Both directions"))
                }, f.Direction == PartySettlementReportDirection.Both ? null : f.Direction.ToString()),
            new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                f.FromDate?.ToString("yyyy-MM-dd"), "ToDate", f.ToDate?.ToString("yyyy-MM-dd")),
            new("Currency", UiText.T(Context, "ارز", "Currency"), "select", currencyOptions, f.Currency),
            new("Status", UiText.T(Context, "وضعیت", "Status"), "select",
                new List<AkFilterOption>
                {
                    new(nameof(PartySettlementReportStatus.Active), UiText.T(Context, "فعال", "Active")),
                    new(nameof(PartySettlementReportStatus.Cancelled), UiText.T(Context, "لغو شده", "Cancelled")),
                    new(nameof(PartySettlementReportStatus.All), UiText.T(Context, "همه", "All"))
                }, f.Status == PartySettlementReportStatus.Active ? null : f.Status.ToString())
        });

    // کارت فقط وقتی عدد نشان می‌دهد که یک ارز باشد؛ چند ارز با هم جمع نمی‌شوند.
    (string Value, string Unit) CardValue(IReadOnlyList<PartySettlementCurrencyTotal> totals) => totals.Count switch
    {
        0 => ("0", ""),
        1 => (totals[0].Amount.ToString("N2"), totals[0].Currency),
        _ => (totals.Count.ToString("N0"), UiText.T(Context, "ارز — جدول زیر", "currencies — see table"))
    };
    decimal AmountOf(IReadOnlyList<PartySettlementCurrencyTotal> totals, string currency)
        => totals.FirstOrDefault(t => t.Currency == currency)?.Amount ?? 0m;

    var total = CardValue(Model.Totals);
    var aToB = CardValue(Model.AToBTotals);
    var bToA = CardValue(Model.BToATotals);
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "گزارش تسویه بین طرف‌حساب‌ها", "Party Settlement Report"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "تسویه‌ها", "Settlements"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="ak-note">
        @UiText.T(Context,
            "چه کسی به چه کسی، چه مبلغی، در چه تاریخی پرداخت کرده است. گزارش فقط‌خواندنی است؛ جمع‌ها فقط از تسویه‌های فعال و به تفکیک ارز هستند.",
            "Who paid whom, how much and when. Read-only; totals include active settlements only and are grouped by currency.")
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@error.ErrorMessage</div> }
        </div>
    }

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "خلاصه تسویه‌ها", "Settlement summary")">
        @await Component.InvokeAsync("StatCard", new
        {
            title = UiText.T(Context, "تعداد تسویه‌ها", "Settlements"),
            value = Model.TotalCount.ToString("N0"),
            unit = Model.CancelledCount > 0 ? $"{Model.CancelledCount:N0} " + UiText.T(Context, "لغو شده", "cancelled") : "",
            avatar = "purchase-contracts"
        })
        @if (hasPair)
        {
            @await Component.InvokeAsync("StatCard", new { title = aToBLabel, value = aToB.Value, unit = aToB.Unit, avatar = "payments" })
            @await Component.InvokeAsync("StatCard", new { title = bToALabel, value = bToA.Value, unit = bToA.Unit, avatar = "receivables" })
        }
        @await Component.InvokeAsync("StatCard", new
        {
            title = UiText.T(Context, "مجموع انتقالات", "Total transferred"),
            value = total.Value,
            unit = total.Unit,
            avatar = "payments"
        })
    </section>

    @if (Model.Totals.Count > 0)
    {
        <div class="ak-list">
            <div class="ak-table-wrap">
                <table class="ak-table" aria-label="@UiText.T(Context, "جمع به تفکیک ارز", "Totals by currency")">
                    <thead><tr>
                        <th>@UiText.T(Context, "ارز", "Currency")</th>
                        @if (hasPair)
                        {
                            <th class="ak-col-num">@aToBLabel</th>
                            <th class="ak-col-num">@bToALabel</th>
                        }
                        <th class="ak-col-num">@UiText.T(Context, "مجموع انتقالات", "Total transferred")</th>
                        <th class="ak-col-num">@UiText.T(Context, "تعداد", "Count")</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var t in Model.Totals)
                        {
                            <tr>
                                <td>@t.Currency</td>
                                @if (hasPair)
                                {
                                    <td class="ak-col-num ak-num">@AmountOf(Model.AToBTotals, t.Currency).ToString("N2")</td>
                                    <td class="ak-col-num ak-num">@AmountOf(Model.BToATotals, t.Currency).ToString("N2")</td>
                                }
                                <td class="ak-col-num ak-num"><strong>@t.Amount.ToString("N2")</strong></td>
                                <td class="ak-col-num ak-num">@t.Count.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="ak-list">
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="filterModel" />
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table" aria-label="@UiText.T(Context, "لیست تسویه‌ها", "Settlement list")">
                <thead><tr>
                    <th>@UiText.T(Context, "تاریخ", "Date")</th>
                    <th>@UiText.T(Context, "شماره", "Number")</th>
                    <th>@UiText.T(Context, "پرداخت‌کننده", "From")</th>
                    <th>@UiText.T(Context, "دریافت‌کننده", "To")</th>
                    <th class="ak-col-num">@UiText.T(Context, "مبلغ", "Amount")</th>
                    <th>@UiText.T(Context, "ارز", "Currency")</th>
                    <th class="ak-col-num">@UiText.T(Context, "نرخ (۱ دالر)", "Rate (1 USD)")</th>
                    <th class="ak-col-grow">@UiText.T(Context, "یادداشت", "Notes")</th>
                    <th>@UiText.T(Context, "ثبت‌کننده", "Created by")</th>
                    <th>@UiText.T(Context, "وضعیت", "Status")</th>
                    <th>@UiText.T(Context, "جزئیات", "Details")</th>
                </tr></thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var cancelled = r.Status == PTGOilSystem.Web.Models.Entities.PartySettlementStatus.Cancelled;
                        <tr>
                            <td>@r.SettlementDate.ToDisplayDate()</td>
                            <td><bdi>@r.Number</bdi></td>
                            <td><strong>@r.FromName</strong> <small class="text-muted">(@r.FromTypeLabel)</small></td>
                            <td><strong>@r.ToName</strong> <small class="text-muted">(@r.ToTypeLabel)</small></td>
                            <td class="ak-col-num ak-num">@r.Amount.ToString("N2")</td>
                            <td>@r.Currency</td>
                            <td class="ak-col-num ak-num">@(r.CurrencyPerUsdRate?.ToString("N4") ?? "—")</td>
                            <td class="ak-col-grow">@(r.Description ?? "—")</td>
                            <td>@(r.CreatedByUserName ?? "—")</td>
                            <td>
                                @if (cancelled)
                                {
                                    <span class="badge text-bg-secondary">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                    <div class="small text-muted">
                                        @(r.CancelledAtUtc?.ToDisplayDate() ?? "")
                                        @(string.IsNullOrWhiteSpace(r.CancelledByUserName) ? "" : $" · {r.CancelledByUserName}")
                                        @if (!string.IsNullOrWhiteSpace(r.CancellationReason))
                                        {
                                            <div>@r.CancellationReason</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">@UiText.T(Context, "فعال", "Active")</span>
                                }
                            </td>
                            <td><a asp-action="Details" asp-route-id="@r.Id">@UiText.T(Context, "مشاهده", "Open")</a></td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="11"><div class="ak-empty"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>@UiText.T(Context, "تسویه‌ای با این فیلترها پیدا نشد", "No settlements match these filters")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{ ViewData["ShownCount"] = Model.Rows.Count; }
        <div class="ak-pager">@await Html.PartialAsync("_PagedListFooter")</div>
    </div>
</div>
