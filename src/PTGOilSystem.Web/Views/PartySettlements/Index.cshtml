@model List<PTGOilSystem.Web.Models.Finance.PartySettlementListRow>
@{
    ViewData["Title"] = UiText.T(Context, "تسویه بین طرف‌حساب‌ها", "Party-to-Party Settlements");
    var canManage = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User);
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "تسویه بین طرف‌حساب‌ها", "Party-to-Party Settlements"), true,
                       canManage ? UiText.T(Context, "تسویه جدید", "New settlement") : (string?)null, "bi-plus-lg",
                       canManage ? (string?)Url.Action("Create") : (string?)null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <p class="text-muted small">
        @UiText.T(Context,
            "وقتی بدهکارِ شرکت مستقیماً به طلبکارِ شرکت پول می‌دهد. بدهی یکی و طلب دیگری کم می‌شود؛ صندوق و بانک تغییر نمی‌کند.",
            "When someone who owes the company pays someone the company owes directly. One debt and one credit drop; cash and bank do not change.")
    </p>

    <div class="ak-list">
        <div class="ak-list-toolbar">
            <div class="ak-list-toolbar-actions">
                <a class="btn btn-sm btn-light ak-secondary-action" asp-action="Report">
                    <i class="bi bi-clipboard-data" aria-hidden="true"></i> @UiText.T(Context, "گزارش تسویه‌ها", "Settlement report")
                </a>
            </div>
        </div>
        <div class="ak-table-wrap">
            <table class="ak-table" aria-label="@UiText.T(Context, "لیست تسویه‌ها", "Settlement list")">
                <thead><tr>
                    <th>@UiText.T(Context, "تاریخ", "Date")</th>
                    <th class="ak-col-grow">@UiText.T(Context, "چه کسی به چه کسی", "Who paid whom")</th>
                    <th class="text-end">@UiText.T(Context, "مبلغ", "Amount")</th>
                    <th>@UiText.T(Context, "وضعیت", "Status")</th>
                </tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var cancelled = r.Status == PartySettlementStatus.Cancelled;
                        <tr>
                            <td>@r.SettlementDate.ToString("yyyy-MM-dd")</td>
                            <td class="ak-col-grow">
                                <a asp-action="Details" asp-route-id="@r.Id">
                                    <strong>@r.FromName</strong> <small class="text-muted">(@r.FromTypeLabel)</small>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                    <strong>@r.ToName</strong> <small class="text-muted">(@r.ToTypeLabel)</small>
                                </a>
                            </td>
                            <td class="text-end ak-num">@NumberDisplay.Money(r.Amount, r.Currency)</td>
                            <td>
                                @if (cancelled)
                                {
                                    <span class="badge text-bg-secondary">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">@UiText.T(Context, "ثبت شده", "Posted")</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4"><div class="ak-empty"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>@UiText.T(Context, "هنوز تسویه‌ای ثبت نشده", "No settlements yet")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{ ViewData["ShownCount"] = Model.Count; }
        <div class="ak-pager">@await Html.PartialAsync("_PagedListFooter")</div>
    </div>
</div>
