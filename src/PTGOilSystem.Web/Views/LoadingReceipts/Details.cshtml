@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.LossEvents
@model PTGOilSystem.Web.Models.Loading.LoadingReceiptDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);
    var returnUrl = ViewBag.ReturnUrl as string;
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var loadingDetailsUrl = Url.Action("Details", "Loading", new { id = Model.LoadingRegisterId }) ?? "/Loading";
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : loadingDetailsUrl;

    string ToDestinationText(LoadingReceiptDestination destination) => destination switch
    {
        LoadingReceiptDestination.ToInventory => "ورود به موجودی / تانک",
        LoadingReceiptDestination.DirectDispatch => "تخلیه مستقیم / بدون ورود به موجودی",
        LoadingReceiptDestination.Mixed => "ترکیبی / بر اساس خط تخصیص",
        _ => "نامشخص"
    };

    string? CompactText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        var normalized = string.Join(" ", value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return normalized.Length <= maxLength
            ? normalized
            : normalized[..maxLength].TrimEnd() + "…";
    }

    string? ToReceiptReferenceText(string? value)
    {
        var normalized = CompactText(value, 28);
        if (string.IsNullOrWhiteSpace(normalized)) return null;

        return normalized.StartsWith("BULK-RCPT-", StringComparison.OrdinalIgnoreCase)
            ? T("رسید گروهی", "Bulk receipt")
            : normalized;
    }

    var receiptDestinationText = ToDestinationText(Model.ReceiptDestination);
    var isDirectDispatchReceipt = Model.ReceiptDestination == LoadingReceiptDestination.DirectDispatch;
    var isMixedReceipt = Model.ReceiptDestination == LoadingReceiptDestination.Mixed;
    var pageTitle = isMixedReceipt
        ? "جزئیات رسید ترکیبی"
        : isDirectDispatchReceipt ? "جزئیات رسید تخلیه مستقیم" : "جزئیات رسید ورود به موجودی";

    var lossDifferenceTotal = Model.LossItems.Sum(l => l.DifferenceQuantityMt);
    var completedInventoryQuantityMt = Model.Allocations
        .Where(allocation => allocation.Destination == LoadingReceiptAllocationDestination.ToInventory
            && allocation.Status == LoadingReceiptAllocationStatus.Completed)
        .Sum(allocation => allocation.QuantityMt);
    var actualDiffMt = Model.ActualArrivedQuantityMt.HasValue
        ? Model.ActualArrivedQuantityMt.Value - Model.ReceivedQuantityMt
        : (decimal?)null;
    var allocBalanced = Model.AllocationDifferenceMt == 0;
    var receiptJourneyUrl = Url.Action("Index", "ContractJourney", new { contractId = Model.ContractId }) ?? "#";
    var receiptEditUrl = Url.Action("Edit", new { id = Model.Id, returnUrl = currentReturnUrl }) ?? "#";
    var newReceiptUrl = Url.Action("Create", new { loadingId = Model.LoadingRegisterId, returnUrl = backUrl });

    ViewData["AkHeaderStatus"] = Model.IsCancelled
        ? T("لغوشده", "Cancelled")
        : allocBalanced ? T("تخصیص متوازن", "Allocation balanced") : T("اختلاف تخصیص", "Allocation mismatch");
    ViewData["AkHeaderStatusState"] = Model.IsCancelled ? "is-danger" : allocBalanced ? "is-active" : "is-warning";
    // Kebab: side routes and destructive actions only. Editing and correcting this
    // receipt are its own operations and live in the action bar instead.
    var headerKebab = new List<AkHeaderMenuItem>
    {
        new() { Label = T("نمای قرارداد", "Contract journey"), Href = Model.ContractId > 0 ? receiptJourneyUrl : null, Icon = "bi-diagram-3" },
        new() { Label = T("رسید جدید", "New receipt"), Href = Model.RemainingToReceiveMt > 0 ? newReceiptUrl : null, Icon = "bi-box-arrow-in-down" }
    };
    if (!Model.IsCancelled)
    {
        headerKebab.Add(new AkHeaderMenuItem
        {
            Label = T("لغو رسید", "Cancel receipt"),
            ModalTarget = "loadingReceiptCancelModal",
            Icon = "bi-x-octagon"
        });
    }
    ViewData["AkHeaderKebab"] = headerKebab;

    var quantityMetrics = new List<AkKpiItem>
    {
        new() { Title = T("مقدار این رسید", "Receipt quantity"), Value = NumberDisplay.Quantity(Model.ReceivedQuantityMt), Unit = "MT", State = "accent" },
        new() { Title = T("جمع دریافت", "Total received"), Value = NumberDisplay.Quantity(Model.TotalReceivedQuantityMt), Unit = "MT" },
        new() { Title = T("باقی‌مانده", "Remaining"), Value = NumberDisplay.Quantity(Model.RemainingToReceiveMt), Unit = "MT" },
        new() { Title = T("اختلاف تخصیص", "Allocation difference"), Value = NumberDisplay.Quantity(Model.AllocationDifferenceMt), Unit = "MT", State = allocBalanced ? null : "warning" }
    };

    // قرارداد/جنس/تاریخ رسید در خط زمینهٔ سربرگ‌اند و اینجا تکرار نمی‌شوند.
    var receiptItems = new List<AkInfoItem>
    {
        new() { Label = T("مقصد رسید", "Receipt destination"), Value = receiptDestinationText },
        new() { Label = T("ترمینال", "Terminal"), Value = Model.TerminalName },
        new()
        {
            Label = T("مخزن", "Tank"),
            Value = isDirectDispatchReceipt ? T("وارد تانک نشده", "Not stored") : isMixedReceipt ? T("بر اساس خط تخصیص", "Per allocation line") : Model.StorageTankCode
        },
        new() { Label = T("ورود واقعی", "Arrival date"), Value = Model.ArrivalDate?.ToDisplayDate() },
        new()
        {
            Label = T("مقدار واقعی", "Actual quantity"),
            Value = Model.ActualArrivedQuantityMt.HasValue
                ? NumberDisplay.Quantity(Model.ActualArrivedQuantityMt) + (actualDiffMt is { } diff && diff != 0 ? $" ({(diff > 0 ? "+" : "")}{NumberDisplay.Quantity(diff)})" : string.Empty)
                : null,
            Unit = "MT",
            IsNumeric = true,
            Tone = actualDiffMt is < 0 ? "danger" : null
        },
        new() { Label = T("نشت / خرابی", "Leak date"), Value = Model.LeakDate?.ToDisplayDate(), Tone = Model.LeakDate.HasValue ? "warning" : null },
        new() { Label = T("شماره مرجع", "Reference number"), Value = ToReceiptReferenceText(Model.ReferenceDocument) },
        new()
        {
            Label = T("ورود تکمیل‌شده به موجودی", "Completed to inventory"),
            Value = NumberDisplay.Quantity(completedInventoryQuantityMt),
            Unit = "MT",
            IsNumeric = true
        }
    };

    var loadingItems = new List<AkInfoItem>
    {
        new() { Label = T("تاریخ بارگیری", "Loading date"), Value = Model.LoadingDate.ToDisplayDate() },
        new() { Label = T("مقدار بارگیری", "Loaded quantity"), Value = NumberDisplay.Quantity(Model.LoadedQuantityMt), Unit = "MT", IsNumeric = true },
        new() { Label = T("بارنامه", "Bill of lading"), Value = Model.BillOfLadingNumber },
        new() { Label = T("واگن", "Wagon"), Value = Model.WagonNumber },
        new() { Label = T("گیرنده", "Consignee"), Value = Model.ConsigneeName },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName }
    };


    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = T("ثبت بارگیری", "Loading register id"), Value = $"#{Model.LoadingRegisterId}", IsNumeric = true },
        new()
        {
            Label = T("حرکت موجودی", "Inventory movement"),
            Value = Model.InventoryMovementId == 0
                ? (isDirectDispatchReceipt ? T("ندارد — تخلیه مستقیم", "None — direct dispatch") : null)
                : $"#{Model.InventoryMovementId}",
            IsNumeric = Model.InventoryMovementId != 0
        }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("بارگیری ثبت شد", "Loading registered"), Date = Model.LoadingDate.ToDisplayDate(), Timestamp = Model.LoadingDate, Icon = "bi-box-arrow-up", Meta = $"{NumberDisplay.Quantity(Model.LoadedQuantityMt)} MT" },
        new() { Title = T("رسید ثبت شد", "Receipt recorded"), Date = Model.ReceiptDate.ToDisplayDate(), Timestamp = Model.ReceiptDate, Icon = "bi-box-arrow-in-down", State = "is-current", Meta = $"{NumberDisplay.Quantity(Model.ReceivedQuantityMt)} MT" }
    };
    if (Model.ArrivalDate.HasValue) timelineItems.Add(new AkTimelineItem { Title = T("رسیدن ثبت شد", "Arrival recorded"), Date = Model.ArrivalDate.Value.ToDisplayDate(), Timestamp = Model.ArrivalDate.Value, Icon = "bi-geo-alt" });
    if (Model.LeakDate.HasValue) timelineItems.Add(new AkTimelineItem { Title = T("نشتی ثبت شد", "Leak recorded"), Date = Model.LeakDate.Value.ToDisplayDate(), Timestamp = Model.LeakDate.Value, Icon = "bi-droplet" });
    timelineItems.AddRange(Model.LossItems.Select(item => new AkTimelineItem { Title = T("کسری ثبت شد", "Loss recorded"), Date = item.EventDate.ToDisplayDate(), Timestamp = item.EventDate, Icon = "bi-exclamation-diamond", Href = Url.Action("Details", "LossEvents", new { id = item.Id, returnUrl = currentReturnUrl }), Meta = $"{NumberDisplay.Quantity(item.ChargeableLossMt)} MT" }));

    var relatedRecords = new List<AkRelatedRecord>
    {
        new() { TypeLabel = T("بارگیری", "Loading"), Label = $"LD-{Model.LoadingRegisterId:0000}", Href = loadingDetailsUrl, KeyValue = Model.ProductName, Icon = "bi-box-arrow-up" },
        new() { TypeLabel = T("قرارداد", "Contract"), Label = Model.ContractNumber, Href = receiptJourneyUrl, Icon = "bi-file-earmark-text" }
    };
    foreach (var allocation in Model.Allocations.Where(item => item.TruckDispatchId.HasValue || item.SalesTransactionId.HasValue))
    {
        if (allocation.TruckDispatchId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("ارسال با موتر", "Truck dispatch"), Label = $"DSP-{allocation.TruckDispatchId.Value:0000}", Href = Url.Action("Details", "Dispatch", new { id = allocation.TruckDispatchId.Value, returnUrl = currentReturnUrl }), KeyValue = $"{NumberDisplay.Quantity(allocation.QuantityMt)} MT", Icon = "bi-truck" });
        if (allocation.SalesTransactionId.HasValue) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("فروش", "Sale"), Label = $"#{allocation.SalesTransactionId.Value}", Href = Url.Action("Details", "Sales", new { id = allocation.SalesTransactionId.Value, returnUrl = currentReturnUrl }), KeyValue = $"{NumberDisplay.Quantity(allocation.QuantityMt)} MT", Icon = "bi-receipt" });
    }

    // Operations of this receipt. A cancelled receipt has none.
    var nextActions = new List<AkHeaderMenuItem>();
    if (!Model.IsCancelled)
    {
        // «ویرایش رسید» به نوار شناسه منتقل شده و اینجا تکرار نمی‌شود.
        nextActions.Add(new AkHeaderMenuItem { Label = T("اصلاح مقدار", "Correct quantity"), Href = Url.Action("Correct", new { id = Model.Id, returnUrl = currentReturnUrl }), Icon = "bi-arrow-repeat" });
    }
    var linkedSalesCount = Model.Allocations.Count(item => item.SalesTransactionId.HasValue);
    var linkedDispatchCount = Model.Allocations.Count(item => item.TruckDispatchId.HasValue);
    var activityRows = new List<AkDetailActivityRow>
    {
        new() { Label = T("تخصیص‌ها", "Allocations"), Value = Model.Allocations.Count > 0 ? Model.Allocations.Count.ToString("N0") : null, Meta = Model.Allocations.Count > 0 ? (allocBalanced ? T("مقدار متوازن", "Balanced quantity") : T("اختلاف تخصیص", "Allocation mismatch")) : null, Status = Model.Allocations.Count > 0 ? (allocBalanced ? T("تکمیل", "Complete") : T("نیاز به بررسی", "Review")) : null, StatusTone = Model.Allocations.Count > 0 ? (allocBalanced ? "success" : "warning") : null, Icon = "bi-diagram-3" },
        new() { Label = T("کسری", "Loss"), Value = Model.LossItems.Count > 0 ? Model.LossItems.Count.ToString("N0") : null, Meta = Model.LossItems.Count > 0 ? $"{NumberDisplay.Quantity(lossDifferenceTotal)} MT" : null, Status = Model.LossItems.Count > 0 ? T("ثبت شده", "Recorded") : null, StatusTone = Model.LossItems.Count > 0 ? "warning" : null, Href = Model.LossItems.Count > 0 ? "#receipt-losses" : null, Icon = "bi-exclamation-diamond" },
        new() { Label = T("فروش‌ها", "Sales"), Value = linkedSalesCount > 0 ? linkedSalesCount.ToString("N0") : null, Status = linkedSalesCount > 0 ? T("متصل", "Linked") : null, StatusTone = linkedSalesCount > 0 ? "success" : null, Icon = "bi-receipt" },
        new() { Label = T("ارسال‌ها", "Dispatches"), Value = linkedDispatchCount > 0 ? linkedDispatchCount.ToString("N0") : null, Status = linkedDispatchCount > 0 ? T("متصل", "Linked") : null, StatusTone = linkedDispatchCount > 0 ? "success" : null, Icon = "bi-truck" }
    };

    var statusText = Model.IsCancelled
        ? T("لغوشده", "Cancelled")
        : allocBalanced ? T("تخصیص متوازن", "Allocation balanced") : T("اختلاف تخصیص", "Allocation mismatch");
    var statusState = Model.IsCancelled ? "is-danger" : allocBalanced ? "is-active" : "is-warning";

    var cardsModel = new AkDetailCardsModel
    {
        Code = $"#{Model.Id}",
        CodeLabel = T("شماره رسید", "Receipt no."),
        Status = statusText,
        StatusState = statusState,
        StripItems = new List<AkInfoItem>
        {
            new() { Label = T("قرارداد", "Contract"), Value = Model.ContractNumber, IsNumeric = true },
            new() { Label = T("محصول", "Product"), Value = Model.ProductName },
            new() { Label = T("مقدار", "Quantity"), Value = $"{NumberDisplay.Quantity(Model.ReceivedQuantityMt)} MT", IsNumeric = true },
            new() { Label = T("تاریخ رسید", "Receipt date"), Value = Model.ReceiptDate.ToDisplayDate(), IsNumeric = true }
        },
        PrimaryLabel = T("ویرایش رسید", "Edit receipt"),
        PrimaryHref = Model.IsCancelled ? null : receiptEditUrl,
        Cards = new List<AkDetailCard>
        {
            new() { Title = T("اطلاعات رسید", "Receipt information"), Icon = "bi-box-arrow-in-down", Rows = receiptItems },
            new() { Title = T("مقادیر", "Quantities"), Icon = "bi-rulers", Metrics = quantityMetrics },
            new() { Title = T("بارگیری مبدأ", "Source loading"), Icon = "bi-box-arrow-up", Rows = loadingItems }
        }
    };

    var moreModel = new AkDetailMoreModel
    {
        Activity = activityRows,
        Secondary = new AkDetailSecondaryModel
        {
            TimelineTitle = T("آخرین فعالیت‌ها", "Latest activities"),
            TimelineLimit = 4,
            Timeline = timelineItems,
            Related = relatedRecords,
            Technical = advancedItems
        },
        NextActions = nextActions
    };

    ViewData["Title"] = pageTitle;
    ViewData["HideSectionTabs"] = true;
    ViewData["ModalDesignSystemAssets"] = true;
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ptg-record-detail" dir="rtl" data-loading-receipt-details data-ak-detail-v2="true" data-ak-operations-detail="true">

    @if (Model.IsCancelled)
    {
        <div class="alert alert-danger">
            <strong>@T("این رسید لغو شده است.", "This receipt has been cancelled.")</strong>
            <div class="ak-section-desc">
                @T("دلیل", "Reason"): @Model.CancellationReason
                @if (Model.CancelledAtUtc.HasValue)
                {
                    @($" · {T("تاریخ لغو", "Cancelled at")}: {Model.CancelledAtUtc.Value.ToDisplayDate()}")
                }
                @if (!string.IsNullOrWhiteSpace(Model.CancelledByUserName))
                {
                    @($" · {T("کاربر", "User")}: {Model.CancelledByUserName}")
                }
            </div>
            <div class="ak-section-desc">
                @T("موجودی، کسری، فروش، دیسپچ و اسناد مالی این رسید با سند معکوس برگشته‌اند و در هیچ گزارشی شمرده نمی‌شوند.",
                   "Inventory, loss, sale, dispatch and financial documents of this receipt were reversed and are excluded from every report.")
            </div>
        </div>
    }
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = $"{T("رسید", "Receipt")} #{Model.Id} · {Model.ProductName}",
           Eyebrow = receiptDestinationText,
           Meta = Model.ReceiptDate.ToDisplayDate(),
           Icon = "bi-box-arrow-in-down"
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
         model="@(($"{T("رسید", "Receipt")} #{Model.Id}", false,
                    (string?)null, (string?)null, (string?)null, (string?)null,
                   T("بازگشت", "Back"), "bi-arrow-right", backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailCards.cshtml" model="@cardsModel" />

    @if (Model.LossItems.Count > 0)
    {
        <div class="ak-form-grid" id="receipt-losses">
            <section class="ak-form-section ak-detail-section ak-col-full" data-loading-receipt-losses>
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">@T("کسری رسید", "Receipt shortage")</h2>
                    <span class="ak-status">@NumberDisplay.Quantity(lossDifferenceTotal) @T("تن", "MT")</span>
                </header>
                <div class="ak-list">
                    @foreach (var loss in Model.LossItems)
                    {
                        <div class="ak-list-row">
                            <div class="ak-col-grow">
                                <span>@loss.EventDate.ToDisplayDate()</span>
                                <strong>@LossEventStageLabels.ToPersian(loss.Stage)</strong>
                                @{ var lossReference = ToReceiptReferenceText(loss.Reference); }
                                @if (!string.IsNullOrWhiteSpace(lossReference))
                                {
                                    <span>@T("مرجع", "Reference"): @lossReference</span>
                                }
                            </div>
                            <div class="ak-num">
                                <strong class="text-danger">@T("اختلاف", "Difference"): @NumberDisplay.Quantity(loss.DifferenceQuantityMt) @T("تن", "MT")</strong>
                                <span>@T("قابل‌حساب", "Chargeable"): @NumberDisplay.Quantity(loss.ChargeableLossMt) @T("تن", "MT")</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    <partial name="~/Views/Shared/Partials/_DetailMore.cshtml" model="@moreModel" />

    @if (!Model.IsCancelled)
    {
        <div class="modal fade" id="loadingReceiptCancelModal" tabindex="-1" aria-labelledby="loadingReceiptCancelModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="modal-content" data-loading-receipt-cancel-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                    <div class="modal-header">
                        <h2 class="modal-title" id="loadingReceiptCancelModalLabel">@T("لغو رسید", "Cancel receipt")</h2>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                    </div>
                    <div class="modal-body">
                        <div class="ak-field">
                            <label class="ak-label" for="receiptCancelReason">@T("دلیل لغو رسید", "Receipt cancellation reason")</label>
                            <input class="ak-input" id="receiptCancelReason" name="reason" maxlength="500" required
                                   placeholder="@T("مثلاً مقدار اشتباه ثبت شده بود", "e.g. wrong quantity registered")" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">@T("انصراف", "Cancel")</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-octagon" aria-hidden="true"></i> @T("لغو رسید", "Cancel receipt")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

</div>
