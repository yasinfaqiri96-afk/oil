@model PTGOilSystem.Web.Models.HumanResources.EmploymentContractIndexViewModel
@using PTGOilSystem.Web.Models.HumanResources
@{
    ViewData["Title"] = UiText.T(Context, "قراردادهای کاری", "Employment contracts");
    var canEdit = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User);
    var columnCount = Model.CanViewSalary ? 8 : 7;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "قراردادهای کاری", "Employment contracts"), false,
                       canEdit ? UiText.T(Context, "قرارداد جدید", "New contract") : null, "bi-plus-lg",
                       canEdit ? Url.Action("Create") : null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار قراردادها", "Contract statistics")">
        <vc:stat-card title="@UiText.T(Context, "قرارداد فعال", "Active contracts")" value="@Model.ActiveCount.ToString("N0")" unit="@UiText.T(Context, "قرارداد", "contracts")" avatar="documents"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "رو به انقضا (۳۰ روز)", "Expiring in 30 days")" value="@Model.ExpiringSoonCount.ToString("N0")" unit="@UiText.T(Context, "قرارداد", "contracts")" avatar="rules-checklist"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کارمند فعالِ بدون قرارداد", "Active employees without contract")" value="@Model.ActiveEmployeesWithoutContract.ToString("N0")" unit="@UiText.T(Context, "کارمند", "employees")" avatar="ledger"></vc:stat-card>
    </section>

    @{
        var filter = new AkSearchFilterModel("q", Model.Query,
            UiText.T(Context, "شمارهٔ قرارداد، نام یا کد کارمند...", "Contract number, employee name or code..."),
            new List<AkFilterDefinition>
            {
                new("status", UiText.T(Context, "وضعیت", "Status"), "select",
                    new List<AkFilterOption>
                    {
                        new("active", UiText.T(Context, "فعال", "Active")),
                        new("expired", UiText.T(Context, "منقضی", "Expired")),
                        new("terminated", UiText.T(Context, "فسخ‌شده", "Terminated"))
                    }, Model.Status),
                new("expiring", UiText.T(Context, "رو به انقضا", "Expiring soon"), "bool",
                    new List<AkFilterOption> { new("true", UiText.T(Context, "بلی", "Yes")) },
                    Model.ExpiringOnly ? "true" : null)
            });
    }
    <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="filter" />

    <div class="ak-list">
        <div class="ak-table-wrap">
            <table class="ak-table" aria-label="@UiText.T(Context, "فهرست قراردادها", "Contract list")">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context, "کارمند", "Employee")</th>
                        <th>@UiText.T(Context, "شماره", "Number")</th>
                        <th>@UiText.T(Context, "نوع", "Type")</th>
                        <th>@UiText.T(Context, "بخش / بست", "Department / Position")</th>
                        <th>@UiText.T(Context, "شروع", "Start")</th>
                        <th>@UiText.T(Context, "پایان", "End")</th>
                        @if (Model.CanViewSalary)
                        {
                            <th class="ak-col-num">@UiText.T(Context, "معاش", "Salary")</th>
                        }
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ak-col-grow">
                                <a asp-action="Details" asp-route-id="@item.Id" class="ak-name">@item.EmployeeName</a>
                                <div class="ak-note">@item.EmployeeCode</div>
                            </td>
                            <td>@item.ContractNumber</td>
                            <td>@EmploymentContractLabels.Type(item.ContractType)</td>
                            <td>@(item.DepartmentName ?? "—") / @(item.PositionName ?? "—")</td>
                            <td>@item.StartDate.ToDisplayDate()</td>
                            <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToDisplayDate() : UiText.T(Context, "نامحدود", "Open-ended"))</td>
                            @if (Model.CanViewSalary)
                            {
                                <td class="ak-num ak-col-num">@item.BaseSalary?.ToString("N2") @item.Currency</td>
                            }
                            <td>
                                <span class="ak-status @EmploymentContractLabels.StatusCss(item.Status)">@EmploymentContractLabels.Status(item.Status)</span>
                                @if (item.IsExpiringSoon)
                                {
                                    <span class="ak-status is-warning">@UiText.T(Context, "رو به انقضا", "Expiring")</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@columnCount"><div class="ak-empty"><i class="bi bi-file-earmark-text" aria-hidden="true"></i>@UiText.T(Context, "قراردادی پیدا نشد.", "No contracts found.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
