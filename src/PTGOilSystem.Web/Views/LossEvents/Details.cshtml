@model PTGOilSystem.Web.Models.LossEvents.LossEventDetailsViewModel
@using PTGOilSystem.Web.Models.LossEvents
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "LossEvents") ?? "/LossEvents";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var inventoryStatus = Model.AffectsInventory ? T("اثر دارد", "Affects inventory") : T("اثر ندارد", "No impact");
    var hasChargeable = Model.ChargeableLossMt > 0m;

    ViewData["AkHeaderStatus"] = hasChargeable ? T("قابل محاسبه", "Chargeable") : T("داخل حد مجاز", "Within tolerance");
    ViewData["AkHeaderStatusState"] = hasChargeable ? "is-warning" : "is-active";
    // Kebab keeps the side route only; the record's own action lives in the bar.
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = T("کسری جدید", "New loss"), Href = Url.Action("Create", new { returnUrl = backUrl }), Icon = "bi-plus-lg" }
    };

    // شاخص‌های اصلی: چهار عدد تصمیم‌ساز. حد تحمل و کسری مجاز عدد پشتیبان‌اند و
    // در کارت خلاصه می‌مانند، نه در نوار KPI.
    var kpis = new List<AkKpiItem>
    {
        new() { Title = T("مورد انتظار", "Expected"), Value = Model.ExpectedQuantityMt.ToString("N4"), Unit = "MT", Avatar = "analysis" },
        new() { Title = T("واقعی", "Actual"), Value = Model.ActualQuantityMt.ToString("N4"), Unit = "MT", Avatar = "quality" },
        new() { Title = T("تفاوت", "Difference"), Value = Model.DifferenceQuantityMt.ToString("N4"), Unit = "MT", Avatar = "losses" },
        new() { Title = T("قابل محاسبه", "Chargeable"), Value = Model.ChargeableLossMt.ToString("N4"), Unit = "MT", Avatar = "statement", State = hasChargeable ? "warning" : null }
    };

    // مرحله/جنس/تاریخ در خط زمینهٔ سربرگ آمده‌اند و اینجا تکرار نمی‌شوند.
    // بارگیری/رسید/ارسال/فروش/قرارداد/محموله فقط در «رکوردهای مرتبط» می‌آیند.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = T("حد تحمل", "Tolerance"), Value = Model.ToleranceQuantityMt.ToString("N4"), Unit = "MT", IsNumeric = true },
        new() { Label = T("کسری مجاز", "Allowable"), Value = Model.AllowableLossMt.ToString("N4"), Unit = "MT", IsNumeric = true },
        new() { Label = T("ترمینال", "Terminal"), Value = Model.TerminalName },
        new() { Label = T("مخزن", "Tank"), Value = Model.StorageTankCode },
        new() { Label = T("نوع مسئول", "Responsible type"), Value = Model.ResponsiblePartyType },
        new() { Label = T("مسئول", "Responsible party"), Value = Model.ResponsiblePartyName },
        new() { Label = T("برخورد مالی", "Financial treatment"), Value = Model.FinancialTreatment },
        new() { Label = T("اثر بر موجودی", "Inventory impact"), Value = inventoryStatus, Tone = Model.AffectsInventory ? "warning" : null },
        new() { Label = T("یادداشت", "Notes"), Value = Model.Notes, IsWide = true }
    };
    var overviewItems = summaryItems;

    // شناسه‌های داخلی و سیستمی — پشت آکاردئون بسته.
    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = T("مرجع", "Reference"), Value = Model.Reference },
        new() { Label = T("حرکت موجودی", "Inventory movement"), Value = Model.InventoryMovementId.HasValue ? $"#{Model.InventoryMovementId}" : null, IsNumeric = true }
    };

    var relatedRecords = new List<AkRelatedRecord>();
    if (!string.IsNullOrWhiteSpace(Model.ContractDisplayLabel)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("قرارداد", "Contract"), Label = Model.ContractDisplayLabel, Icon = "bi-file-earmark-text" });
    if (!string.IsNullOrWhiteSpace(Model.ShipmentCode)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("محموله", "Shipment"), Label = Model.ShipmentCode, Icon = "bi-box-seam" });
    if (!string.IsNullOrWhiteSpace(Model.LoadingRegisterLabel)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("بارگیری", "Loading"), Label = Model.LoadingRegisterLabel, Icon = "bi-box-arrow-up" });
    if (!string.IsNullOrWhiteSpace(Model.LoadingReceiptLabel)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("رسید بارگیری", "Loading receipt"), Label = Model.LoadingReceiptLabel, Icon = "bi-box-arrow-in-down" });
    if (!string.IsNullOrWhiteSpace(Model.TruckDispatchLabel)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("ارسال با موتر", "Truck dispatch"), Label = Model.TruckDispatchLabel, Icon = "bi-truck" });
    if (!string.IsNullOrWhiteSpace(Model.SalesLabel)) relatedRecords.Add(new AkRelatedRecord { TypeLabel = T("فروش", "Sale"), Label = Model.SalesLabel, Icon = "bi-receipt" });

    // A recorded loss has no forward operation, so correcting it is the single CTA.
    var nextActions = new List<AkHeaderMenuItem>
    {
        new() { Label = T("ویرایش کسری", "Edit loss"), Href = Url.Action("Edit", new { id = Model.Id, returnUrl = currentReturnUrl }), Icon = "bi-pencil-square" }
    };
    var activityRows = new List<AkDetailActivityRow>
    {
        new() { Label = T("اثر موجودی", "Inventory impact"), Value = Model.ChargeableLossMt.ToString("N4"), Unit = "MT", Meta = inventoryStatus, Status = Model.AffectsInventory ? T("ثبت شده", "Recorded") : T("بدون اثر", "No impact"), StatusTone = Model.AffectsInventory ? "warning" : "success", Icon = "bi-box-seam" },
        new() { Label = T("برخورد مالی", "Financial treatment"), Value = Model.FinancialTreatment, Meta = Model.ResponsiblePartyName, Status = hasChargeable ? T("قابل محاسبه", "Chargeable") : T("حد مجاز", "Within tolerance"), StatusTone = hasChargeable ? "warning" : "success", Icon = "bi-cash-coin" },
        new() { Label = T("رکوردهای مرتبط", "Related records"), Value = relatedRecords.Count > 0 ? relatedRecords.Count.ToString("N0") : null, Status = relatedRecords.Count > 0 ? T("متصل", "Linked") : null, StatusTone = relatedRecords.Count > 0 ? "success" : null, Icon = "bi-link-45deg" }
    };
    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("کسری ثبت شد", "Loss recorded"), Date = Model.EventDate.ToDisplayDate(), Timestamp = Model.EventDate, Icon = "bi-exclamation-diamond", State = "is-current", Meta = $"{Model.ChargeableLossMt:N4} MT" }
    };

    ViewData["Title"] = T("جزئیات کسری", "Loss Event Details");
    ViewData["HideSectionTabs"] = true;
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ak-detail-reference-layout" dir="rtl" data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = $"{T("کسری", "Loss")} · {Model.ProductName}",
           Eyebrow = Model.Stage.ToString(),
           Meta = $"#{Model.Id} · {Model.EventDate.ToDisplayDate()}",
           Icon = "bi-exclamation-diamond",
           Status = ViewData["AkHeaderStatus"]?.ToString(),
           StatusState = ViewData["AkHeaderStatusState"]?.ToString()
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("کسری", "Loss") + $" #{Model.Id}", false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                        T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailOverview.cshtml"
             model="@(new AkDetailOverviewModel { Title = T("خلاصه اطلاعات کسری", "Loss summary"), AriaLabel = T("نمای اصلی کسری", "Loss overview"), Metrics = kpis, Facts = overviewItems })" />

    <partial name="~/Views/Shared/Partials/_DetailActivityList.cshtml" model="@((IReadOnlyList<AkDetailActivityRow>)activityRows)" />

    <partial name="~/Views/Shared/Partials/_DetailSecondary.cshtml"
             model="@(new AkDetailSecondaryModel { TimelineTitle = T("آخرین فعالیت‌ها", "Latest activities"), TimelineLimit = 4, Timeline = timelineItems, Related = relatedRecords, Technical = advancedItems })" />
    <partial name="~/Views/Shared/Partials/_DetailActionBar.cshtml" model="@((IReadOnlyList<AkHeaderMenuItem>)nextActions)" />

</div>
