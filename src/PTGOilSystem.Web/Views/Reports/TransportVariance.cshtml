@using PTGOilSystem.Web.Models.Reports
@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.Reports.TransportVarianceReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "راپور کسری و اضافه‌بار حمل", "Transport Shortage & Surplus Report");
    var f = Model.Filter;
    var t = Model.Totals;

    // کسری سرخ، اضافه‌بار سبز — نشانهٔ رنگی و متنی هر دو، تا فقط با رنگ تشخیص داده نشود.
    string KindTone(TransportVarianceKind kind)
        => kind == TransportVarianceKind.Surplus ? "finance-positive" : "finance-negative";
    string KindBadge(TransportVarianceKind kind)
        => kind == TransportVarianceKind.Surplus ? "ak-status is-active" : "ak-status is-pending";
    string KindIcon(TransportVarianceKind kind)
        => kind == TransportVarianceKind.Surplus ? "bi-arrow-up-circle" : "bi-arrow-down-circle";
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "راپور کسری و اضافه‌بار حمل", "Transport Shortage & Surplus Report"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="ak-note">
        @UiText.T(Context,
            "فرق وزن بارگیری و تخلیهٔ هر حمل. کم‌رسیدن «کسری» و بیشتر‌رسیدن «اضافه‌بار» است؛ اضافه‌بار جریمه نمی‌شود.",
            "Loaded vs unloaded weight per transport. Arriving short is shortage, arriving over is surplus; surplus is never charged.")
    </p>

    @* چهار جواب اصلی. ریز اضافه‌بار (فروخته/نفروخته، عاید، مصارف) در خروجی Excel همین صفحه می‌ماند. *@
    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "خلاصه کسری و اضافه‌بار", "Shortage and surplus summary")">
        <vc:stat-card title="@UiText.T(Context, "مجموع کسری", "Total shortage")"
                      value="@NumberDisplay.Quantity(t.TotalShortageMt)"
                      unit="MT"
                      avatar="shortage"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مجموع اضافه‌بار", "Total surplus")"
                      value="@NumberDisplay.Quantity(t.TotalSurplusMt)"
                      unit="MT"
                      avatar="total-inventory"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کسری قابل جریمه", "Chargeable shortage")"
                      value="@NumberDisplay.Quantity(t.TotalChargeableShortageMt)"
                      unit="MT" avatar="contract-losses"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "منفعت خالص اضافه‌بار", "Surplus net profit")"
                      value="@StatCardFormatter.Number(t.TotalSurplusNetProfitUsd, 0)"
                      unit="USD"
                      state="@(t.TotalSurplusNetProfitUsd < 0m ? "warning" : null)"
                      avatar="profit-loss"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> VarianceOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            // «همه» مقدار پیش‌فرض است و فیلتر به حساب نمی‌آید، پس چیپ نمی‌سازد.
            var varianceKindValue = f.Kind == TransportVarianceFilterKind.All ? null : f.Kind.ToString();
            var varianceFilter = new AkSearchFilterModel("Search", f.Search,
                UiText.T(Context, "جست‌وجوی موتر یا راننده...", "Search vehicle or driver..."),
                new List<AkFilterDefinition>
                {
                    new("Kind", UiText.T(Context, "نوع تفاوت", "Variance type"), "select",
                        new List<AkFilterOption>
                        {
                            new("ShortageOnly", UiText.T(Context, "فقط کسری", "Shortage only")),
                            new("SurplusOnly", UiText.T(Context, "فقط اضافه‌بار", "Surplus only"))
                        }, varianceKindValue),
                    new("Source", UiText.T(Context, "مسیر ثبت", "Source"), "select",
                        new List<AkFilterOption>
                        {
                            new("TruckDispatch", UiText.T(Context, "تخلیه موتر", "Truck unload")),
                            new("InventoryTransfer", UiText.T(Context, "انتقال داخلی", "Internal transfer"))
                        }, f.Source?.ToString()),
                    new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        f.FromDate?.ToString("yyyy-MM-dd"), "ToDate", f.ToDate?.ToString("yyyy-MM-dd")),
                    AkFilterDefinition.MultiSelect("ProductId", UiText.T(Context, "جنس", "Product"), VarianceOpts(ViewBag.TransportVarianceProducts), AkFilterQuery.Values(Context, "ProductId")),
                    AkFilterDefinition.MultiSelect("ContractId", UiText.T(Context, "قرارداد", "Contract"), VarianceOpts(ViewBag.TransportVarianceContracts), AkFilterQuery.Values(Context, "ContractId"))
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="varianceFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("TransportVarianceExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th>@UiText.T(Context, "تاریخ", "Date")</th>
                        <th>@UiText.T(Context, "موتر / راننده", "Vehicle / driver")</th>
                        <th class="ak-col-grow">@UiText.T(Context, "جنس / قرارداد", "Product / contract")</th>
                        <th>@UiText.T(Context, "مسیر", "Route")</th>
                        <th class="ak-col-num">@UiText.T(Context, "بارگیری MT", "Loaded MT")</th>
                        <th class="ak-col-num">@UiText.T(Context, "تخلیه MT", "Unloaded MT")</th>
                        <th class="ak-col-num">@UiText.T(Context, "تفاوت MT", "Difference MT")</th>
                        <th class="ak-col-num">@UiText.T(Context, "قابل جریمه MT", "Chargeable MT")</th>
                        <th class="ak-col-num">@UiText.T(Context, "منفعت اضافه‌بار USD", "Surplus profit USD")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                @row.EventDate.ToDisplayDate()
                                <div class="ak-cell-note">@PTGOilSystem.Web.Controllers.ReportsController.TransportVarianceSourceLabel(row.Source)</div>
                            </td>
                            <td>
                                @if (row.TruckDispatchId.HasValue)
                                {
                                    <a asp-controller="Dispatch" asp-action="Details" asp-route-id="@row.TruckDispatchId">@(row.VehicleNumber ?? "—")</a>
                                }
                                else if (row.TransportLegId.HasValue)
                                {
                                    <a asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@row.TransportLegId">@(row.VehicleNumber ?? "—")</a>
                                }
                                else
                                {
                                    @(row.VehicleNumber ?? "—")
                                }
                                @if (!string.IsNullOrWhiteSpace(row.DriverName))
                                {
                                    <div class="ak-cell-note">@row.DriverName</div>
                                }
                            </td>
                            <td class="ak-col-grow">
                                @row.ProductName
                                @if (!string.IsNullOrWhiteSpace(row.ContractNumber))
                                {
                                    <div class="ak-cell-note">@row.ContractNumber</div>
                                }
                            </td>
                            <td>@(row.RouteText ?? "—")</td>
                            <td class="ak-col-num ak-num">@row.LoadedQuantityMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">@row.UnloadedQuantityMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">
                                <span class="@KindTone(row.Kind)">@row.AbsoluteDifferenceMt.ToString("N4")</span>
                                <div class="ak-cell-note">
                                    <span class="@KindBadge(row.Kind)">
                                        <i class="bi @KindIcon(row.Kind)" aria-hidden="true"></i>
                                        @PTGOilSystem.Web.Controllers.ReportsController.TransportVarianceKindLabel(row.Kind)
                                    </span>
                                    <span class="col-ltr">@row.DifferencePercent.ToString("N2")%</span>
                                </div>
                            </td>
                            <td class="ak-col-num ak-num">@(row.ChargeableShortageMt > 0m ? row.ChargeableShortageMt.ToString("N4") : "—")</td>
                            <td class="ak-col-num ak-num @(row.SurplusNetProfitUsd > 0m ? "finance-positive" : row.SurplusNetProfitUsd < 0m ? "finance-negative" : null)">
                                @(row.Kind == TransportVarianceKind.Surplus ? row.SurplusNetProfitUsd.ToString("N2") : "—")
                                @if (row.Kind == TransportVarianceKind.Surplus && row.SurplusUnsoldMt > 0m)
                                {
                                    <div class="ak-cell-note">@UiText.T(Context, "فروخته‌نشده", "Unsold"): <span class="col-ltr">@row.SurplusUnsoldMt.ToString("N4") MT</span></div>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="ak-empty">
                                    <i class="bi bi-truck"></i>
                                    @UiText.T(Context, "حملی با کسری یا اضافه‌بار پیدا نشد؛ فیلترها را تغییر دهید.", "No transport with shortage or surplus found; change the filters.")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Rows.Count > 0)
                {
                    <tfoot>
                        <tr class="ak-table-total">
                            <td colspan="4">@UiText.T(Context, "جمع کل نتایج فیلترشده", "Total of filtered results")</td>
                            <td class="ak-col-num ak-num">@t.TotalLoadedMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">@t.TotalUnloadedMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">
                                @t.NetDifferenceMt.ToString("N4")
                                <div class="ak-cell-note">
                                    @(t.NetDifferenceMt > 0m
                                        ? UiText.T(Context, "خالص کسری", "Net shortage")
                                        : t.NetDifferenceMt < 0m
                                            ? UiText.T(Context, "خالص اضافه‌بار", "Net surplus")
                                            : UiText.T(Context, "بدون تفاوت خالص", "No net difference"))
                                </div>
                            </td>
                            <td class="ak-col-num ak-num">@t.TotalChargeableShortageMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">@t.TotalSurplusNetProfitUsd.ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
    </div>
</div>
