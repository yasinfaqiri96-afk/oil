@model PTGOilSystem.Web.Models.Reports.ReportHubViewModel
@inject PTGOilSystem.Web.Security.ClientModuleProfile ClientModules
@{
    ViewData["Title"] = UiText.T(Context, "گزارش‌ها", "Reports");

    bool CanOpen(string controller)
        => PTGOilSystem.Web.Security.RoleAccessRules.CanAccessController(User, controller, ClientModules);

    // مرکز گزارشات: فقط پیوند. هیچ محاسبه‌ای در این صفحه انجام نمی‌شود و دسته‌بندی
    // فقط از کنترلر می‌آید — این صفحه دستهٔ دوم و موازی نمی‌سازد.

    // نگاشت آواتار سه‌بعدی هر گزارش. کلید = "Controller|Action" همان مسیری که کنترلر
    // می‌دهد. اینجا نگهداری می‌شود تا کنترلر، مدل و منطق گزارش‌ها دست‌نخورده بماند.
    var avatarMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Reports|CompanyBalance"] = "/images/stat-cards/ref-reports/rep-analysis.webp",
        ["Reports|ContractPnl"] = "/images/stat-cards/ref-contract/contract-profit.webp",

        ["Reports|PartyAging"] = "/images/stat-cards/ref-reconciliation/recon-documents.webp",
        ["Reports|CashFlow"] = "/images/stat-cards/ref-blue/party-payment.webp",
        ["Balance|Customers"] = "/images/stat-cards/ref-people/customers.webp",
        ["Balance|Suppliers"] = "/images/stat-cards/ref-people/suppliers.webp",
        ["Balance|Contracts"] = "/images/stat-cards/ref-reconciliation/recon-ledger.webp",
        ["Reports|FxDifference"] = "/images/stat-cards/ref-people/exchange-rate.webp",
        ["Reports|ExpenseReport"] = "/images/stat-cards/ref-blue/sale-expense.webp",

        ["Reports|InventorySales"] = "/images/stat-cards/ref-reports/rep-inventory.webp",
        ["Reports|NegativeStock"] = "/images/stat-cards/ref-shipment/losses.webp",
        ["Sales|PreSales"] = "/images/stat-cards/ref-contracts/contracts-total.webp",
        ["Reports|PreSaleDiscrepancies"] = "/images/stat-cards/ref-reconciliation/recon-documents.webp",
        ["Reports|GoodsInTransit"] = "/images/stat-cards/ref-blue/ops-transport.webp",
        ["Reports|TransportVariance"] = "/images/stat-cards/ref-blue/ops-transport.webp",
        ["Reports|LossReport"] = "/images/stat-cards/ref-shipment/loss.webp",
        ["Reports|VesselVoyages"] = "/images/stat-cards/ref-shipment/loaded.webp",

        ["Reconciliation|Index"] = "/images/stat-cards/ref-reconciliation/recon-operations.webp",
        ["CustomsPermitTurnover|Index"] = "/images/stat-cards/ref-icons/documents.webp",
        ["QualityInspections|Index"] = "/images/stat-cards/ref-icons/quality.webp",
        ["Ledger|Index"] = "/images/stat-cards/ref-icons/ledger.webp",
        ["AccountStatements|Index"] = "/images/stat-cards/ref-icons/security.webp",
        ["AuditLogs|Index"] = "/images/stat-cards/ref-reconciliation/recon-audit.webp",
        ["Reconciliation|SuspenseMoney"] = "/images/stat-cards/ref-reconciliation/recon-operations.webp",
        ["PartySettlements|Report"] = "/images/stat-cards/ref-reconciliation/recon-ledger.webp",
        ["CustomerToCustomerPayments|Index"] = "/images/stat-cards/ref-blue/party-payment.webp",
        ["ChartOfAccounts|Index"] = "/images/stat-cards/ref-icons/ledger.webp",
        ["ChartOfAccounts|Mapping"] = "/images/stat-cards/ref-reconciliation/recon-ledger.webp",
        ["FiscalYears|Index"] = "/images/stat-cards/ref-reports/rep-analysis.webp"
    };
    const string fallbackAvatar = "/images/stat-cards/ref-reports/rep-analysis.webp";

    // دسته‌بندی کنترلر حفظ می‌شود؛ فقط گزارش حذف‌شده از مرکز گزارش‌ها نمایش داده نمی‌شود.
    var financeCards = new[]
    {
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "Reconciliation", Action = "SuspenseMoney",
            TitleFa = "پول‌های معلق", TitleEn = "Suspense Money",
            DescriptionFa = "پول‌هایی که هنوز به طرف‌حساب وصل نشده‌اند.", DescriptionEn = "Money not yet linked to a party.",
            Icon = "bi-hourglass-split", ToneClass = "tone-amber"
        },
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "PartySettlements", Action = "Report",
            TitleFa = "گزارش تسویه بین طرف‌حساب‌ها", TitleEn = "Party Settlement Report",
            DescriptionFa = "چه کسی به چه کسی، چه مبلغی و چه زمانی؛ جمع به تفکیک ارز.", DescriptionEn = "Who paid whom, how much and when; totals per currency.",
            Icon = "bi-clipboard-data", ToneClass = "tone-blue"
        },
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "CustomerToCustomerPayments", Action = "Index",
            TitleFa = "پرداخت بین مشتریان", TitleEn = "Customer-to-Customer Payments",
            DescriptionFa = "ثبت پرداخت مستقیم مشتریان به یکدیگر؛ بدون اثر روی حساب شرکت.", DescriptionEn = "Record direct payments between customers; no effect on company accounts.",
            Icon = "bi-people-fill", ToneClass = "tone-lavender"
        },
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "ChartOfAccounts", Action = "Index",
            TitleFa = "سرفصل حساب‌ها", TitleEn = "Chart of Accounts",
            DescriptionFa = "ساختار سرفصل‌های حساب‌داری.", DescriptionEn = "Accounting chart-of-accounts structure.",
            Icon = "bi-diagram-3", ToneClass = "tone-blue"
        },
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "ChartOfAccounts", Action = "Mapping",
            TitleFa = "تنظیمات حسابداری", TitleEn = "Accounting Settings",
            DescriptionFa = "تعیین سرفصل‌های مورد استفاده در ثبت‌های خودکار حسابداری.", DescriptionEn = "Choose the accounts used by automatic accounting entries.",
            Icon = "bi-gear", ToneClass = "tone-amber"
        },
        new PTGOilSystem.Web.Models.Reports.ReportHubCardViewModel
        {
            Controller = "FiscalYears", Action = "Index",
            TitleFa = "سال مالی و بستن سال", TitleEn = "Fiscal Year & Closing",
            DescriptionFa = "مدیریت سال مالی و مراحل بستن سال.", DescriptionEn = "Manage the fiscal year and the closing steps.",
            Icon = "bi-calendar-check", ToneClass = "tone-teal"
        }
    }.Where(card => CanOpen(card.Controller)).ToList();

    var tabs = Model.Groups
        .Select((g, index) => new
        {
            Id = $"rep-group-{index + 1}",
            Label = UiText.T(Context, g.TitleFa, g.TitleEn),
            Cards = g.Cards
                .Where(c => !(string.Equals(c.Controller, "ContractJourney", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(c.Action, "Index", StringComparison.OrdinalIgnoreCase)))
                .ToList()
        })
        .Where(g => g.Cards.Count > 0)
        .ToList();

    if (financeCards.Count > 0)
    {
        var financeGroup = new PTGOilSystem.Web.Models.Reports.ReportHubGroupViewModel
        {
            TitleFa = "امور مالی و حسابداری",
            TitleEn = "Finance & Accounting",
            Icon = "bi-wallet2",
            Cards = financeCards
        };
        tabs.Add(new
        {
            Id = "rep-group-finance",
            Label = UiText.T(Context, financeGroup.TitleFa, financeGroup.TitleEn),
            Cards = financeGroup.Cards.ToList()
        });
    }
}

<div class="rephub-page finance-workspace-page" dir="@(UiText.IsEn(Context) ? "ltr" : "rtl")">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "گزارش‌ها", "Reports"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    @* موتور تب همان ptg-tabs.js مشترک سیستم است: هر تب با href="#id" پنل خودش را
       باز می‌کند، ARIA و کیبورد و hash را خودش می‌بندد. *@
    <div class="rephub-tabs" data-section-tabs="true">
        <div data-section-tabs-scroll="true">
            <nav class="ptg-tabs-rail" role="tablist" aria-label="@UiText.T(Context, "دسته‌های گزارش", "Report groups")">
                @foreach (var tab in tabs)
                {
                    <a class="ptg-tab-item @(tab == tabs[0] ? "is-active" : null)"
                       href="#@tab.Id"
                       role="tab"
                       aria-controls="@tab.Id"
                       aria-selected="@(tab == tabs[0] ? "true" : "false")">
                        <span data-tab-label="@tab.Label">@tab.Label</span>
                    </a>
                }
            </nav>
        </div>
    </div>

    @foreach (var tab in tabs)
    {
        var gridModifier = tab.Cards.Count == 1 ? "rephub-grid--single"
            : tab.Cards.Count == 2 ? "rephub-grid--compact" : string.Empty;
        <div id="@tab.Id" class="rephub-panel" role="tabpanel" aria-label="@tab.Label" hidden="@(tab == tabs[0] ? null : "hidden")">
            <div class="rephub-grid @gridModifier">
                @foreach (var item in tab.Cards)
                {
                    var controller = string.IsNullOrEmpty(item.Controller) ? "Reports" : item.Controller;
                    var key = $"{controller}|{item.Action}";
                    var avatar = avatarMap.TryGetValue(key, out var mapped) ? mapped : fallbackAvatar;
                    var optimizedAvatar = avatar.Replace("/images/stat-cards/", "/images/stat-cards/report-hub/", StringComparison.Ordinal);
                    var title = UiText.T(Context, item.TitleFa, item.TitleEn);
                    <a class="rephub-card"
                       asp-controller="@controller"
                       asp-action="@item.Action">
                        <span class="rephub-card-art">
                            <img src="@optimizedAvatar" alt="" aria-hidden="true" width="128" height="128" loading="eager" decoding="async" />
                        </span>
                        <span class="rephub-card-title">@title</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // برگشت از یک گزارش به مرکز گزارش‌ها همان تبی را باز می‌کند که کاربر در آن بود.
        // ptg-tabs.js تب را در hash نگه می‌دارد، ولی لینک «گزارش‌ها» در سربرگ صفحات گزارش
        // hash ندارد؛ پس آخرین تب در sessionStorage همین زبانه هم نگه داشته می‌شود.
        (function () {
            "use strict";
            var KEY = "ptg-rephub-tab";

            function remember(id) {
                try { sessionStorage.setItem(KEY, id); } catch (_) { /* حافظهٔ مرورگر اختیاری است */ }
            }

            function restore() {
                var rail = document.querySelector(".rephub-page .ptg-tabs-rail");
                if (!rail || rail.hasAttribute("data-rephub-memory")) {
                    return;
                }
                rail.setAttribute("data-rephub-memory", "true");
                rail.addEventListener("click", function (event) {
                    var tab = event.target.closest(".ptg-tab-item");
                    var href = tab && tab.getAttribute("href");
                    if (href && href.charAt(0) === "#") {
                        remember(href.slice(1));
                    }
                });

                var id = (location.hash || "").slice(1);
                if (!id) {
                    try { id = sessionStorage.getItem(KEY) || ""; } catch (_) { id = ""; }
                }
                var target = id ? rail.querySelector('.ptg-tab-item[href="#' + id + '"]') : null;
                if (target && target.getAttribute("aria-selected") !== "true") {
                    target.click();
                }
            }

            // پس از راه‌اندازی موتور تب (DOMContentLoaded یا ptg:page-ready در ناوبری SPA).
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", function () { setTimeout(restore, 0); }, { once: true });
            } else {
                setTimeout(restore, 0);
            }
        })();
    </script>
}
