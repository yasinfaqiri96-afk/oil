@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.Reports.CashFlowReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "گردش پول", "Cash Movement");

    string T(string fa, string en) => UiText.T(Context, fa, en);
    string Num(decimal value) => value.ToString("N2");
    string? Tone(decimal value) => value < 0m ? "ak-number--negative" : null;

    // صفحه فقط چیدمانِ دیگری از همان ارقام کنترلر است؛ هیچ عددی اینجا دوباره حساب نمی‌شود.
    // هر «بابت» در کنترلر رسیدکی و بردکی خودش را دارد؛ اینجا فقط به دو فهرست جدا تقسیم می‌شود.
    var inflowRows = Model.Rows.Where(r => r.InflowUsd > 0m).OrderByDescending(r => r.InflowUsd).ToList();
    var outflowRows = Model.Rows.Where(r => r.OutflowUsd > 0m).OrderByDescending(r => r.OutflowUsd).ToList();
}

@*
    خواندن صفحه به ترتیب یک جمله است:
    «اول دوره این‌قدر پول داشتیم، این‌قدر آمد، این‌قدر رفت، حالا این‌قدر داریم.»
    بعد: پول از کجا آمد و به کجا رفت، الان در کدام صندوق/بانک است، و روند ماهانه.
*@
<div class="ak-list-page cashflow-report-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("گردش پول", "Cash Movement"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <section class="ak-stat-grid" aria-label="@T("خلاصهٔ گردش پول", "Cash movement summary")">
        <vc:stat-card title="@T("پول اول دوره", "Cash at start")"
                      value="@StatCardFormatter.Number(Model.OpeningBalanceUsd, 0)"
                      unit="USD" avatar="treasury"></vc:stat-card>
        <vc:stat-card title="@T("پول آمده", "Money in")"
                      value="@StatCardFormatter.Number(Model.TotalInflowUsd, 0)"
                      unit="USD" avatar="receipts"></vc:stat-card>
        <vc:stat-card title="@T("پول رفته", "Money out")"
                      value="@StatCardFormatter.Number(Model.TotalOutflowUsd, 0)"
                      unit="USD" avatar="payments-out"></vc:stat-card>
        <vc:stat-card title="@T("پول آخر دوره", "Cash at end")"
                      value="@StatCardFormatter.Number(Model.ClosingBalanceUsd, 0)"
                      unit="USD"
                      state="@(Model.ClosingBalanceUsd < 0m ? "warning" : null)"
                      avatar="cash-flow"></vc:stat-card>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ScopeWarning))
    {
        <p class="ak-note">@Model.ScopeWarning</p>
    }

    @if (Model.PartnerFundedCount > 0)
    {
        <p class="ak-note">
            @string.Format(
                T("{0} پرداخت ({1} USD) را شریک از جیب خودش داده و از صندوق شرکت خارج نشده؛ در این ارقام نیست.",
                  "{0} payment(s) ({1} USD) were paid by a partner, not from company cash; they are not in these figures."),
                Model.PartnerFundedCount.ToString("N0"),
                Num(Model.PartnerFundedOutflowUsd))
        </p>
    }

    <div class="ak-list">
        @{
            List<AkFilterOption> CashFlowOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var cashFlowFilter = new AkSearchFilterModel("", null,
                T("بازه تاریخ، صندوق یا بانک...", "Date range, cash or bank..."),
                new List<AkFilterDefinition>
                {
                    new("FromDate", T("بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("CashAccountId", T("صندوق / بانک", "Cash / Bank"), "select", CashFlowOpts(ViewBag.CashAccounts),
                        Model.Filter.CashAccountId?.ToString()),
                    new("CompanyId", T("شرکت", "Company"), "select", CashFlowOpts(ViewBag.Companies),
                        Model.Filter.CompanyId?.ToString()),
                    new("PaymentKind", T("بابت", "Purpose"), "select", CashFlowOpts(ViewBag.PaymentKinds),
                        Model.Filter.PaymentKind.HasValue ? ((int)Model.Filter.PaymentKind.Value).ToString() : null),
                    new("ProductId", T("جنس", "Product"), "select", CashFlowOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("ContractId", T("قرارداد", "Contract"), "select", CashFlowOpts(ViewBag.Contracts),
                        Model.Filter.ContractId?.ToString()),
                    new("CustomerId", T("مشتری", "Customer"), "select", CashFlowOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString()),
                    new("SupplierId", T("تأمین‌کننده", "Supplier"), "select", CashFlowOpts(ViewBag.Suppliers),
                        Model.Filter.SupplierId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="cashFlowFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("CashFlowExport"))" />
            </div>
        </div>

        @* ۱) پول از کجا آمد / به کجا رفت — دو فهرست کنار هم، سبز و سرخ فقط در عنوان. *@
        <div class="row g-4 company-overview-balances">
            <div class="col-12 col-lg-6">
                <section class="ak-form-section company-overview-balances__side company-overview-balances__side--receivable">
                    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                             model="@((T("پول از کجا آمد", "Where money came from"), (string?)null))" />
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-grow">@T("بابت", "Purpose")</th>
                                    <th class="ak-col-num">@T("مبلغ (USD)", "Amount (USD)")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in inflowRows)
                                {
                                    <tr>
                                        <td class="ak-col-grow">@row.GroupName</td>
                                        <td class="ak-col-num ak-num">@Num(row.InflowUsd)</td>
                                    </tr>
                                }
                                @if (inflowRows.Count == 0)
                                {
                                    <tr><td colspan="2"><div class="ak-empty"><i class="bi bi-arrow-down-circle"></i> @T("در این بازه پولی وارد نشده است.", "No money came in during this range.")</div></td></tr>
                                }
                            </tbody>
                            @if (inflowRows.Count > 0)
                            {
                                <tfoot>
                                    <tr class="ak-table-total">
                                        <td class="ak-col-grow">@T("جمع پول آمده", "Total in")</td>
                                        <td class="ak-col-num ak-num">@Num(Model.TotalInflowUsd)</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </section>
            </div>

            <div class="col-12 col-lg-6">
                <section class="ak-form-section company-overview-balances__side company-overview-balances__side--payable">
                    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                             model="@((T("پول به کجا رفت", "Where money went"), (string?)null))" />
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-grow">@T("بابت", "Purpose")</th>
                                    <th class="ak-col-num">@T("مبلغ (USD)", "Amount (USD)")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in outflowRows)
                                {
                                    <tr>
                                        <td class="ak-col-grow">@row.GroupName</td>
                                        <td class="ak-col-num ak-num">@Num(row.OutflowUsd)</td>
                                    </tr>
                                }
                                @if (outflowRows.Count == 0)
                                {
                                    <tr><td colspan="2"><div class="ak-empty"><i class="bi bi-arrow-up-circle"></i> @T("در این بازه پولی خارج نشده است.", "No money went out during this range.")</div></td></tr>
                                }
                            </tbody>
                            @if (outflowRows.Count > 0)
                            {
                                <tfoot>
                                    <tr class="ak-table-total">
                                        <td class="ak-col-grow">@T("جمع پول رفته", "Total out")</td>
                                        <td class="ak-col-num ak-num">@Num(Model.TotalOutflowUsd)</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </section>
            </div>
        </div>

        @* ۲) دو جواب کوتاه کنار هم: پول الان در کدام صندوق/بانک است، و هر ماه چقدر آمد و رفت.
           ریز اول دوره/آمده/رفتهٔ هر حساب و ماندهٔ پایان هر ماه در خروجی Excel همین صفحه است. *@
        <div class="row g-4 cashflow-section">
            <div class="col-12 col-lg-6">
                <section id="cashflow-accounts" class="ak-form-section">
                    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                             model="@((T("پول الان کجاست", "Where the cash is now"), (string?)null))" />
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-grow">@T("صندوق / بانک", "Cash / Bank")</th>
                                    <th class="ak-col-num">@T("مبلغ (USD)", "Amount (USD)")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.AccountRows.OrderByDescending(r => r.ClosingUsd))
                                {
                                    <tr>
                                        <td class="ak-col-grow">
                                            @row.CashAccountName
                                            <div class="ak-cell-note">@row.Currency</div>
                                        </td>
                                        <td class="ak-col-num ak-num @Tone(row.ClosingUsd)">@Num(row.ClosingUsd)</td>
                                    </tr>
                                }
                                @if (!Model.AccountRows.Any())
                                {
                                    <tr><td colspan="2"><div class="ak-empty"><i class="bi bi-bank"></i> @T("در این بازه هیچ صندوق یا بانکی گردش نداشته است.", "No cash or bank account moved in this range.")</div></td></tr>
                                }
                            </tbody>
                            @if (Model.AccountRows.Any())
                            {
                                <tfoot>
                                    <tr class="ak-table-total">
                                        <td class="ak-col-grow">@T("جمع = پول آخر دوره", "Total = cash at end")</td>
                                        <td class="ak-col-num ak-num @Tone(Model.ClosingBalanceUsd)">@Num(Model.ClosingBalanceUsd)</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </section>
            </div>

            <div class="col-12 col-lg-6">
                <section id="cashflow-months" class="ak-form-section">
                    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                             model="@((T("ماه به ماه", "Month by month"), (string?)null))" />
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-grow">@T("ماه", "Month")</th>
                                    <th class="ak-col-num">@T("آمده", "In")</th>
                                    <th class="ak-col-num">@T("رفته", "Out")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.PeriodRows)
                                {
                                    <tr>
                                        <td class="ak-col-grow ak-num">@row.Label</td>
                                        <td class="ak-col-num ak-num">@Num(row.InflowUsd)</td>
                                        <td class="ak-col-num ak-num">@Num(row.OutflowUsd)</td>
                                    </tr>
                                }
                                @if (!Model.PeriodRows.Any())
                                {
                                    <tr><td colspan="3"><div class="ak-empty"><i class="bi bi-calendar3"></i> @T("در این بازه ماهی با گردش پول وجود ندارد.", "No month in this range has cash movement.")</div></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
