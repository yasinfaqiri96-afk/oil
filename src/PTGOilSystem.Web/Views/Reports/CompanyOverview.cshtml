@model PTGOilSystem.Web.Models.Reports.CompanyFinancialOverviewViewModel
@{
    ViewData["Title"] = UiText.T(Context, "نمای کلی مالی", "Company Financial Overview");
}

<div class="ak-list-page finance-workspace-page" dir="@(UiText.IsEn(Context) ? "ltr" : "rtl")">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "نمای کلی مالی", "Company Financial Overview"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارشات", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="finance-page-lead">@UiText.T(Context, "شش عدد اصلی برای دیدن وضعیت مالی؛ همه مستقیماً از فروش، مصارف، روزنامه و دفتر سیستم خوانده می‌شوند.", "Six essential figures read directly from sales, expenses, journal and ledger records.")</p>

    <section class="ak-stat-grid finance-overview-metrics" aria-label="@UiText.T(Context, "خلاصهٔ مالی", "Financial summary")">
        <vc:stat-card title="@UiText.T(Context, "نقدینگی (خالص حرکت)", "Liquidity (net movement)")" value="@Model.NetCashMovementUsd.ToString("N2")" unit="USD" avatar="report-payments"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "دریافتنی مشتریان", "Customer receivables")" value="@Model.CustomerReceivableUsd.ToString("N2")" unit="USD" avatar="report-settlements"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "پرداختنی تأمین‌کنندگان", "Supplier payables")" value="@Model.SupplierPayableUsd.ToString("N2")" unit="USD" avatar="report-purchase"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "درآمد", "Revenue")" value="@Model.RevenueUsd.ToString("N2")" unit="USD" avatar="report-sales"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مصرف و ضایعات", "Expenses and losses")" value="@((Model.ExpenseUsd + Model.LossCostUsd).ToString("N2"))" unit="USD" avatar="report-inventory"></vc:stat-card>
        @* سود فقط وقتی عدد نشان داده می‌شود که بهای تمام‌شدهٔ همهٔ فروش‌ها ثبت شده باشد؛
           در غیر این صورت COGS نبود = سود ساختگی، پس عدد منتشر نمی‌شود. *@
        <vc:stat-card title="@UiText.T(Context, "سود / زیان", "Profit / loss")"
                      value="@(Model.IsProfitPublishable ? Model.NetProfitUsd.ToString("N2") : "—")"
                      unit="@(Model.IsProfitPublishable ? "USD" : "")"
                      avatar="report-finance"></vc:stat-card>
    </section>

    @if (!Model.IsProfitPublishable)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-octagon"></i>
            @UiText.T(Context, Model.ProfitUnavailableNoteFa, Model.ProfitUnavailableNoteEn)
        </div>
    }

    <div class="ak-list">
        @{
            List<AkFilterOption> OverviewOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var overviewFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر نمای کلی مالی...", "Filter company overview..."),
                new List<AkFilterDefinition>
                {
                    new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("ProductId", UiText.T(Context, "جنس", "Product"), "select", OverviewOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("ContractId", UiText.T(Context, "قرارداد", "Contract"), "select", OverviewOpts(ViewBag.Contracts),
                        Model.Filter.ContractId?.ToString()),
                    new("CustomerId", UiText.T(Context, "مشتری", "Customer"), "select", OverviewOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString()),
                    new("SupplierId", UiText.T(Context, "تأمین‌کننده", "Supplier"), "select", OverviewOpts(ViewBag.Suppliers),
                        Model.Filter.SupplierId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="overviewFilter" />
            <div class="ak-list-toolbar-actions">
                @* خروجی همان فیلترهای صفحه را می‌گیرد و همان BuildCompanyFinancialOverviewAsync را می‌خواند. *@
                <partial name="~/Views/Shared/_ExportMenu.cshtml"
                         model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("CompanyOverviewExport"))" />
            </div>
        </div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context, "قراردادهای مهم", "Key contracts"), UiText.T(Context, "قراردادهایی که بیشترین اثر مالی را دارند.", "Contracts with the largest financial impact.")))" />
            <div class="ak-table-wrap">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">@UiText.T(Context, "قرارداد", "Contract")</th>
                            <th>@UiText.T(Context, "جنس", "Product")</th>
                            <th>@UiText.T(Context, "طرف حساب", "Counterparty")</th>
                            <th class="ak-col-num">@UiText.T(Context, "مصرف (USD)", "Cost (USD)")</th>
                            <th class="ak-col-num">@UiText.T(Context, "فروش (USD)", "Revenue (USD)")</th>
                            <th class="ak-col-num">@UiText.T(Context, "سود (USD)", "Profit (USD)")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.TopContracts)
                        {
                            <tr>
                                <td class="ak-col-grow"><a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-id="@row.ContractId">@row.ContractNumber</a></td>
                                <td>@row.ProductName</td>
                                <td>@(row.CounterpartyName ?? "-")</td>
                                <td class="ak-col-num ak-num">@row.TotalCostUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num">@row.TotalRevenueUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num @(row.GrossMarginUsd >= 0 ?"ak-num" : "ak-num")">@row.GrossMarginUsd.ToString("N2")</td>
                            </tr>
                        }
                        @if (!Model.TopContracts.Any())
                        {
                            <tr>
                                <td colspan="6"><div class="ak-empty"><i class="bi bi-graph-up"></i> @UiText.T(Context, "فیلترها را تغییر دهید یا بازه تاریخ را گسترده‌تر بگیرید.", "Change the filters or widen the date range.")</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
