@using PTGOilSystem.Web.Services.Reporting
@model PTGOilSystem.Web.Models.Reports.NegativeStockReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "موجودی منفی", "Negative Stock");
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "موجودی منفی", "Negative Stock"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="ak-note">@UiText.T(Context, "هر ترکیب جنس/قرارداد/ترمینال/مخزن که مانده‌اش در یک تاریخ زیر صفر رفته است. این گزارش فقط تشخیص می‌دهد و هیچ داده‌ای را اصلاح نمی‌کند.", "Every product/contract/terminal/tank scope whose running balance went below zero. Read-only: nothing is repaired here.")</p>

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار موجودی منفی", "Negative stock metrics")">
        @foreach (var metric in Model.Metrics.Take(4))
        {
            @await Html.PartialAsync("_ReferenceMetricCard", ("", metric.Icon, metric.Label, metric.Value, metric.Detail ?? "", metric.ToneClass))
        }
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> NegStockOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var negStockFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر موجودی منفی...", "Filter negative stock..."),
                new List<AkFilterDefinition>
                {
                    new("ToDate", UiText.T(Context, "تا تاریخ", "As of"), "date", null,
                        Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("ProductId", UiText.T(Context, "جنس", "Product"), "select", NegStockOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("ContractId", UiText.T(Context, "قرارداد", "Contract"), "select", NegStockOpts(ViewBag.Contracts),
                        Model.Filter.ContractId?.ToString()),
                    new("TerminalId", UiText.T(Context, "ترمینال", "Terminal"), "select", NegStockOpts(ViewBag.Terminals),
                        Model.Filter.TerminalId?.ToString()),
                    new("StorageTankId", UiText.T(Context, "مخزن", "Tank"), "select", NegStockOpts(ViewBag.StorageTanks),
                        Model.Filter.StorageTankId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="negStockFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("NegativeStockExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context, "جنس", "Product")</th>
                        <th>@UiText.T(Context, "جواز", "Company")</th>
                        <th>@UiText.T(Context, "قرارداد", "Contract")</th>
                        <th>@UiText.T(Context, "ترمینال", "Terminal")</th>
                        <th>@UiText.T(Context, "مخزن", "Tank")</th>
                        <th>@UiText.T(Context, "اولین منفی‌شدن", "First negative")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مانده آن تاریخ", "Balance then")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مانده فعلی", "Closing")</th>
                        <th class="ak-col-grow">@UiText.T(Context, "علت احتمالی", "Probable cause")</th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ak-col-grow">@row.ProductName</td>
                            <td>@row.CompanyName</td>
                            <td>@row.ContractNumber</td>
                            <td>@row.TerminalName</td>
                            <td>@row.StorageTankCode</td>
                            <td>@row.FirstNegativeDate.ToDisplayDate()</td>
                            <td class="ak-col-num ak-num">@row.FirstNegativeBalanceMt.ToString("N4")</td>
                            <td class="ak-col-num ak-num">@row.ClosingBalanceMt.ToString("N4")</td>
                            <td class="ak-col-grow">@row.ProbableCause</td>
                            <td>
                                @if (row.Status == NegativeStockStatus.Open)
                                {
                                    <span class="ak-badge ak-badge-danger">@UiText.T(Context, "کسری باز", "Open")</span>
                                }
                                else
                                {
                                    <span class="ak-badge ak-badge-warning">@UiText.T(Context, "ترتیب تاریخ (Legacy)", "Legacy ordering")</span>
                                }
                            </td>
                            <td>
                                @if (row.CausingSalesTransactionId.HasValue)
                                {
                                    <a class="btn btn-sm btn-light" asp-controller="Sales" asp-action="Details" asp-route-id="@row.CausingSalesTransactionId.Value"
                                       title="@UiText.T(Context, "سند فروش ایجادکننده", "Causing sale")"><i class="bi bi-box-arrow-up-left"></i></a>
                                }
                                else
                                {
                                    @* کارت موجودی همان scope؛ حرکت ایجادکننده صفحهٔ جزئیات مستقل ندارد. *@
                                    <a class="btn btn-sm btn-light" asp-controller="Inventory" asp-action="StockCard"
                                       asp-route-Filter.ProductId="@row.ProductId"
                                       asp-route-Filter.ContractId="@row.ContractId"
                                       asp-route-Filter.TerminalId="@row.TerminalId"
                                       title="@UiText.T(Context, "کارت موجودی این ترکیب", "Stock card for this scope")"><i class="bi bi-box-arrow-up-left"></i></a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="11"><div class="ak-empty"><i class="bi bi-check2-circle"></i> @UiText.T(Context, "هیچ موجودی منفی‌ای پیدا نشد.", "No negative stock found.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
