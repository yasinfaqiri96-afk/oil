@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.Reports.ContractPnlReportViewModel
@{
    ViewData["Title"] = UiText.T(Context,"مفاد قراردادها","Contract Profit");

    string T(string fa, string en) => UiText.T(Context, fa, en);

    // برچسب و لحن وضعیت قرارداد، دقیقاً مثل صفحهٔ «قراردادها» تا یک وضعیت در دو صفحه
    // دو اسم نداشته باشد.
    string StatusText(ContractStatus status) => status switch
    {
        ContractStatus.Draft => T("جدید", "New"),
        ContractStatus.Active => T("فعال", "Active"),
        ContractStatus.Closed => T("در حال اجرا", "In progress"),
        ContractStatus.Cancelled => T("منقضی شده", "Expired"),
        _ => status.ToString()
    };

    string StatusTone(ContractStatus status) => status switch
    {
        ContractStatus.Active => "is-active",
        ContractStatus.Draft => "is-pending",
        ContractStatus.Cancelled => "is-inactive",
        _ => string.Empty
    };

    // عدد پولی جدول: بدون عدد یعنی «ثبت نشده»، نه صفر.
    string Money(decimal value) => value != 0m ? value.ToString("N2") : "—";
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("مفاد قراردادها","Contract Profit"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       T("گزارش‌ها","Reports"), "bi-arrow-right", Url.Action("Index")))" />

    @* کارت‌ها همان چیزی را جمع می‌زنند که جدول پایین نشان می‌دهد (قراردادهای خرید و فروش
       مستقیم از آن‌ها). پیش از این کارت‌ها از قراردادهای «فروش» خوانده می‌شدند که در این
       صفحه اصلاً فهرست نمی‌شوند — به همین دلیل صفر می‌ماندند. *@
    <section class="ak-stat-grid" aria-label="@T("آمار مفاد قراردادها", "Contract profit metrics")">
        <vc:stat-card title="@T("جمع مصارف قراردادها", "Total contract cost")"
                      value="@StatCardFormatter.Number(Model.TotalPurchaseCostUsd, 0)"
                      unit="USD" avatar="report-purchase"></vc:stat-card>
        <vc:stat-card title="@T("درآمد فروش", "Sales revenue")"
                      value="@StatCardFormatter.Number(Model.TotalDirectSaleRevenueUsd, 0)"
                      unit="USD" avatar="report-sales"></vc:stat-card>
        <vc:stat-card title="@T("مفاد ناخالص", "Gross profit")"
                      value="@StatCardFormatter.Number(Model.TotalDirectSaleGrossMarginUsd, 0)"
                      unit="USD"
                      state="@(Model.TotalDirectSaleGrossMarginUsd < 0m ? "warning" : null)"
                      avatar="report-finance"></vc:stat-card>
        <vc:stat-card title="@T("فیصدی مفاد", "Profit margin")"
                      value="@StatCardFormatter.Number(Model.DirectSaleMarginPercent, 1)"
                      unit="@(Model.DirectSaleMarginPercent.HasValue ? "%" : "")"
                      avatar="report-analysis"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> PnlOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var pnlFilter = new AkSearchFilterModel("", null,
                T("فیلتر مفاد قراردادها...", "Filter contract profit..."),
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", T("بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("Filter.ProductId", T("جنس", "Product"), "select", PnlOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("Filter.SupplierId", T("تأمین‌کننده", "Supplier"), "select", PnlOpts(ViewBag.Suppliers),
                        Model.Filter.SupplierId?.ToString()),
                    new("Filter.CustomerId", T("مشتری", "Customer"), "select", PnlOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="pnlFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("ContractPnlExport"))" />
            </div>
        </div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((T("قراردادهای خرید — مصرف و مفاد","Purchase Contracts — Cost and Profit"), (string?)null))" />
            <div class="ak-table-wrap">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">@T("قرارداد","Contract")</th>
                            <th class="ak-col-w-sm">@T("تأمین‌کننده","Supplier")</th>
                            <th class="ak-col-w-md">@T("وضعیت","Status")</th>
                            <th class="ak-col-num">@T("بارگیری MT","Loaded MT")</th>
                            <th class="ak-col-num">@T("جمع مصارف (USD)","Total cost (USD)")</th>
                            <th class="ak-col-num">@T("درآمد (USD)","Revenue (USD)")</th>
                            <th class="ak-col-num">@T("مفاد (USD)","Profit (USD)")</th>
                            <th class="ak-col-num">@T("فیصدی","Margin")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.PurchaseRows.Any())
                        {
                            <tr><td colspan="8"><div class="ak-empty"><i class="bi bi-file-earmark-x"></i> @T("قراردادی یافت نشد.","No contracts found.")</div></td></tr>
                        }
                        @foreach (var row in Model.PurchaseRows)
                        {
                            <tr>
                                <td class="ak-col-grow">
                                    <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-id="@row.ContractId">@row.DisplayLabel</a>
                                    <div class="ak-cell-note">@row.ProductName</div>
                                </td>
                                <td class="ak-col-w-sm">@(row.CounterpartyName ?? "—")</td>
                                @* همهٔ نشانه‌ها یک‌جا کنار وضعیت می‌نشینند تا ستون‌های عددی فقط عدد باشند. *@
                                <td class="ak-col-w-md">
                                    @{
                                        var flags = new List<string>();
                                        if (row.HasPendingTankSettlement) { flags.Add(T("موقت", "provisional")); }
                                        if (row.TotalLoadedMt > 0m && row.TotalSoldMt < row.TotalLoadedMt) { flags.Add(T("فروش ناتمام", "partly sold")); }
                                        if (row.NeedsReview || row.UnvaluedLossCount > 0) { flags.Add(T("نیازمند بررسی", "needs review")); }
                                    }
                                    <span class="ak-status @StatusTone(row.Status)">@StatusText(row.Status)</span>
                                    @if (flags.Count > 0)
                                    {
                                        <div class="ak-cell-note">@string.Join(UiText.IsEn(Context) ? ", " : "، ", flags)</div>
                                    }
                                </td>
                                <td class="ak-col-num ak-num">@NumberDisplay.Quantity(row.TotalLoadedMt)</td>
                                <td class="ak-col-num ak-num fw-bold">@Money(row.TotalCostUsd)</td>
                                <td class="ak-col-num ak-num">@Money(row.TotalRevenueUsd)</td>
                                <td class="ak-col-num ak-num @(row.GrossMarginUsd < 0m ? "ak-number--negative" : null)">
                                    @(row.TotalRevenueUsd > 0m ? row.GrossMarginUsd.ToString("N2") : "—")
                                </td>
                                <td class="ak-col-num ak-num @(row.MarginPercent < 0m ? "ak-number--negative" : null)">
                                    @(row.MarginPercent.HasValue ? row.MarginPercent.Value.ToString("N1") + "%" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.PurchaseRows.Any())
                    {
                        <tfoot>
                            <tr>
                                <td colspan="3" class="fw-bold">@T("مجموع","Total")</td>
                                <td class="ak-col-num ak-num fw-bold">@NumberDisplay.Quantity(Model.PurchaseRows.Sum(r => r.TotalLoadedMt))</td>
                                <td class="ak-col-num ak-num fw-bold">@Model.TotalPurchaseCostUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num fw-bold">@Model.TotalDirectSaleRevenueUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num fw-bold @(Model.TotalDirectSaleGrossMarginUsd < 0m ? "ak-number--negative" : null)">@Model.TotalDirectSaleGrossMarginUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num fw-bold @(Model.DirectSaleMarginPercent < 0m ? "ak-number--negative" : null)">@(Model.DirectSaleMarginPercent.HasValue ? Model.DirectSaleMarginPercent.Value.ToString("N1") + "%" : "—")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </section>
    </div>
</div>
