@model PTGOilSystem.Web.Models.Reports.ContractPnlReportViewModel
@{
    ViewData["Title"] = UiText.T(Context,"مفاد قراردادها","Contract Profit");
    var marginPct = Model.TotalSalesRevenueUsd > 0
        ? Math.Round((Model.TotalGrossMarginUsd / Model.TotalSalesRevenueUsd) * 100m, 1)
        : 0m;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context,"مفاد قراردادها","Contract Profit"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context,"گزارش‌ها","Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار مفاد قراردادها", "Contract profit metrics")">
        <vc:stat-card title="@UiText.T(Context, "درآمد فروش", "Sales Revenue")" value="@Model.TotalSalesRevenueUsd.ToString("N2")" unit="USD" avatar="report-sales"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "بهای تمام‌شدهٔ فروش", "Cost of Goods Sold")" value="@Model.TotalRealisedSalesCostUsd.ToString("N2")" unit="USD" avatar="report-purchase"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مفاد ناخالص فروش", "Gross Profit on Sales")" value="@Model.TotalGrossMarginUsd.ToString("N2")" unit="USD" avatar="report-finance"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "فیصدی مفاد", "Profit Margin")" value="@marginPct.ToString("N1")" unit="%" avatar="report-analysis"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> PnlOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var pnlFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر مفاد قراردادها...", "Filter contract profit..."),
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("Filter.ProductId", UiText.T(Context, "جنس", "Product"), "select", PnlOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("Filter.SupplierId", UiText.T(Context, "تأمین‌کننده", "Supplier"), "select", PnlOpts(ViewBag.Suppliers),
                        Model.Filter.SupplierId?.ToString()),
                    new("Filter.CustomerId", UiText.T(Context, "مشتری", "Customer"), "select", PnlOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="pnlFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("ContractPnlExport"))" />
            </div>
        </div>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context,"قراردادهای خرید — تحلیل مصرف","Purchase Contracts — Cost Analysis"), (string?)null))" />
            <div class="ak-table-wrap">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">@UiText.T(Context,"قرارداد","Contract")</th>
                            <th>@UiText.T(Context,"تأمین‌کننده","Supplier")</th>
                            <th>@UiText.T(Context,"وضعیت","Status")</th>
                            <th class="ak-col-num">@UiText.T(Context,"بارگیری MT","Loaded MT")</th>
                            <th class="ak-col-num">@UiText.T(Context,"ارزش خرید (USD)","Purchase (USD)")</th>
                            <th class="ak-col-num">@UiText.T(Context,"جمع مصارف","Total Cost")</th>
                            <th class="ak-col-num">@UiText.T(Context,"درآمد (USD)","Revenue (USD)")</th>
                            <th class="ak-col-num">@UiText.T(Context,"مفاد (USD)","Profit (USD)")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.PurchaseRows.Any())
                        {
                            <tr><td colspan="8"><div class="ak-empty"><i class="bi bi-file-earmark-x"></i> @UiText.T(Context,"قراردادی یافت نشد.","No contracts found.")</div></td></tr>
                        }
                        @foreach (var row in Model.PurchaseRows)
                        {
                            <tr>
                                <td class="ak-col-grow">
                                    <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-id="@row.ContractId">@row.DisplayLabel</a>
                                    <small class="d-block text-muted">@row.ProductName</small>
                                    @if (row.HasPendingTankSettlement)
                                    {
                                        <span class="ak-status">@UiText.T(Context, "موقت", "Provisional")</span>
                                    }
                                </td>
                                <td>@(row.CounterpartyName ?? "—")</td>
                                <td><span class="ak-status">@row.Status</span></td>
                                <td class="ak-col-num ak-num">@NumberDisplay.Quantity(row.TotalLoadedMt)</td>
                                <td class="ak-col-num ak-num">@(row.PurchaseValueUsd > 0 ? row.PurchaseValueUsd.ToString("N2") : "—")</td>
                                <td class="ak-col-num ak-num fw-bold">@row.TotalCostUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num">@(row.TotalRevenueUsd > 0 ? row.TotalRevenueUsd.ToString("N2") : "—")</td>
                                <td class="ak-col-num ak-num @(row.GrossMarginUsd < 0m ? "ak-number--negative" : null)">
                                    @(row.TotalRevenueUsd > 0 ? row.GrossMarginUsd.ToString("N2") : "—")
                                    @if (row.TotalLoadedMt > 0m && row.TotalSoldMt < row.TotalLoadedMt)
                                    {
                                        <span class="ak-status is-pending">@UiText.T(Context, "فروش ناتمام", "Partly sold")</span>
                                    }
                                    @if (row.DirectSaleQuantityMismatchCount > 0)
                                    {
                                        <span class="ak-status">@UiText.T(Context, "کنترل مقدار", "Qty review")</span>
                                    }
                                </td>
                            </tr>
                            <tr class="ak-row-muted">
                                <td colspan="8">
                                    <details class="ak-advanced m-0">
                                        <summary class="ak-advanced-summary">@UiText.T(Context, "جزئیات مقدار و مصارف", "Quantity and cost details")</summary>
                                        <div class="ak-advanced-body">
                                            <dl class="ak-summary-list">
                                                <div><dt>@UiText.T(Context,"مقدار قرارداد (MT)","Contract quantity (MT)")</dt><dd class="ak-num">@NumberDisplay.Quantity(row.ContractQuantityMt)</dd></div>
                                                <div><dt>@UiText.T(Context,"فروش مستقیم (MT)","Direct sales (MT)")</dt><dd class="ak-num">@(row.TotalSoldMt > 0 ? NumberDisplay.Quantity(row.TotalSoldMt) : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"حمل (USD)","Transport (USD)")</dt><dd class="ak-num">@(row.TransportCostUsd > 0 ? row.TransportCostUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"گدام (USD)","Warehouse (USD)")</dt><dd class="ak-num">@(row.WarehouseCostUsd > 0 ? row.WarehouseCostUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"خط آهن (USD)","Railway (USD)")</dt><dd class="ak-num">@(row.RailwayCostUsd > 0 ? row.RailwayCostUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"گمرک (USD)","Customs (USD)")</dt><dd class="ak-num">@(row.CustomsCostUsd > 0 ? row.CustomsCostUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"مصارف عمومی (USD)","General expenses (USD)")</dt><dd class="ak-num">@(row.GeneralExpenseCostUsd > 0 ? row.GeneralExpenseCostUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"سایر (USD)","Other (USD)")</dt><dd class="ak-num">@(row.OtherCostUsd > 0 ? row.OtherCostUsd.ToString("N2") : "—")</dd></div>
                                                <div>
                                                    <dt>@UiText.T(Context,"کسری (USD)","Loss cost (USD)")</dt>
                                                    <dd class="ak-num">
                                                        @(row.LossCostUsd > 0 ? row.LossCostUsd.ToString("N2") : "—")
                                                        @if (row.UnvaluedLossCount > 0)
                                                        {
                                                            <span class="ak-status">@row.UnvaluedLossCount @UiText.T(Context, "بدون قیمت", "unvalued")</span>
                                                        }
                                                    </dd>
                                                </div>
                                                <div><dt>@UiText.T(Context,"کسری صراف (USD)","Sarraf shortfall (USD)")</dt><dd class="ak-num">@(row.SarrafSupplierShortfallUsd > 0 ? row.SarrafSupplierShortfallUsd.ToString("N2") : "—")</dd></div>
                                                <div><dt>@UiText.T(Context,"خالص تفاوت نرخ (USD)","Net FX (USD)")</dt><dd class="ak-num @(row.NetExchangeDifferenceUsd < 0m ? "ak-number--negative" : null)">@(row.NetExchangeDifferenceUsd != 0 ? row.NetExchangeDifferenceUsd.ToString("N2") : "—")</dd></div>
                                            </dl>
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.PurchaseRows.Any())
                    {
                        <tfoot>
                            <tr>
                                <td colspan="3" class="fw-bold">@UiText.T(Context,"مجموع","Total")</td>
                                <td class="ak-col-num ak-num fw-bold">@NumberDisplay.Quantity(Model.PurchaseRows.Sum(r => r.TotalLoadedMt))</td>
                                <td class="ak-col-num ak-num fw-bold">@Model.PurchaseRows.Sum(r => r.PurchaseValueUsd).ToString("N2")</td>
                                <td class="ak-col-num ak-num fw-bold">@Model.TotalPurchaseCostUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num">@Model.TotalDirectSaleRevenueUsd.ToString("N2")</td>
                                <td class="ak-col-num ak-num @(Model.PurchaseRows.Sum(r => r.GrossMarginUsd) < 0m ? "ak-number--negative" : null)">@Model.PurchaseRows.Sum(r => r.GrossMarginUsd).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </section>
    </div>
</div>
