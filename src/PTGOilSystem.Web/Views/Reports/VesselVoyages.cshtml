@using PTGOilSystem.Web.Models.Reports
@using PTGOilSystem.Web.Models.StatCards
@model PTGOilSystem.Web.Models.Reports.VesselVoyageReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "گزارش کشتی‌ها", "Vessel Voyages Report");
    var f = Model.Filter;
    var t = Model.Totals;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "گزارش کشتی‌ها", "Vessel Voyages Report"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="ak-note">
        @UiText.T(Context,
            "هر سطر یک سفر کشتی است. کرایه فقط کرایهٔ خود کشتی است (بدون دیمرج و کرایهٔ خشکی). Shipperها و ریز کرایه با دکمهٔ کنار هر سطر باز می‌شوند.",
            "Each row is one vessel voyage. Freight is vessel freight only (no demurrage or inland freight). Shippers and freight lines open from the toggle beside each row.")
    </p>

    @* چهار جواب اصلی؛ جمع دیزل و بنزین با فیلتر «محصول» و در خروجی همین صفحه دیده می‌شود. *@
    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "خلاصه سفرهای کشتی", "Vessel voyages summary")">
        <vc:stat-card title="@UiText.T(Context, "تعداد سفرها", "Voyages")"
                      value="@t.VoyageCount.ToString("N0")"
                      unit="@UiText.T(Context, "سفر", "voyages")" avatar="vessel"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کشتی‌های مختلف", "Distinct vessels")"
                      value="@t.VesselCount.ToString("N0")"
                      unit="@UiText.T(Context, "کشتی", "vessels")" avatar="shipment-loaded"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مجموع مقدار", "Total quantity")"
                      value="@NumberDisplay.Quantity(t.TotalQuantityMt)"
                      unit="MT" avatar="total-inventory"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مجموع کرایه کشتی", "Total vessel freight")"
                      value="@StatCardFormatter.Number(t.TotalFreightUsd, 0)"
                      unit="USD" avatar="transported"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> VoyageOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var voyageFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر سفرهای کشتی...", "Filter vessel voyages..."),
                new List<AkFilterDefinition>
                {
                    new("FiscalYearId", UiText.T(Context, "سال مالی", "Fiscal year"), "select", VoyageOpts(ViewBag.VesselVoyageFiscalYears),
                        f.FiscalYearId?.ToString()),
                    new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        f.FromDate?.ToString("yyyy-MM-dd"), "ToDate", f.ToDate?.ToString("yyyy-MM-dd")),
                    AkFilterDefinition.MultiSelect("VesselId", UiText.T(Context, "کشتی", "Vessel"), VoyageOpts(ViewBag.VesselVoyageVessels), AkFilterQuery.Values(Context, "VesselId")),
                    AkFilterDefinition.MultiSelect("ProductId", UiText.T(Context, "محصول", "Product"), VoyageOpts(ViewBag.VesselVoyageProducts), AkFilterQuery.Values(Context, "ProductId")),
                    AkFilterDefinition.MultiSelect("CustomerId", UiText.T(Context, "مشتری", "Customer"), VoyageOpts(ViewBag.VesselVoyageCustomers), AkFilterQuery.Values(Context, "CustomerId")),
                    AkFilterDefinition.MultiSelect("SupplierId", UiText.T(Context, "تأمین‌کننده / Shipper", "Supplier / Shipper"), VoyageOpts(ViewBag.VesselVoyageSuppliers), AkFilterQuery.Values(Context, "SupplierId")),
                    AkFilterDefinition.MultiSelect("DestinationLocationId", UiText.T(Context, "مقصد", "Destination"), VoyageOpts(ViewBag.VesselVoyageDestinations), AkFilterQuery.Values(Context, "DestinationLocationId")),
                    new("ServiceProviderId", UiText.T(Context, "کمپنی ترانسپورتی", "Transport company"), "select", VoyageOpts(ViewBag.VesselVoyageServiceProviders),
                        f.ServiceProviderId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="voyageFilter" />
            <div class="ak-list-toolbar-actions">
                @* چاپ از راه «خروجی PDF» همین منو انجام می‌شود؛ دکمهٔ چاپ مستقل طبق قرارداد پروژه ممنوع است. *@
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("VesselVoyagesExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-check"></th>
                        <th>@UiText.T(Context, "تاریخ", "Date")</th>
                        <th>@UiText.T(Context, "کد سفر", "Code No")</th>
                        <th>@UiText.T(Context, "کشتی", "Vessel")</th>
                        <th>@UiText.T(Context, "محصول", "Kind - Cargo")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مقدار MT", "Quantity MT")</th>
                        <th>@UiText.T(Context, "بندر بارگیری ← مقصد", "Loading port → destination")</th>
                        <th>@UiText.T(Context, "مشتری", "Customer")</th>
                        <th>@UiText.T(Context, "تأمین‌کننده / Shipper", "Shipper")</th>
                        <th class="ak-col-num">@UiText.T(Context, "کرایه کشتی USD", "Vessel freight USD")</th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var detailId = $"vv-detail-{row.ShipmentId}";
                        <tr>
                            <td>
                                @if (row.HasDetails)
                                {
                                    <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId" aria-expanded="false" aria-controls="@detailId" title="@UiText.T(Context, "جزئیات", "Details")">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                }
                            </td>
                            <td>@(row.VoyageDate?.ToDisplayDate() ?? "—")</td>
                            <td>
                                <a asp-controller="ShipmentPnl" asp-action="Details" asp-route-id="@row.ShipmentId">@row.ShipmentCode</a>
                                @if (!string.IsNullOrWhiteSpace(row.Notes))
                                {
                                    <div class="ak-cell-note">@row.Notes</div>
                                }
                            </td>
                            <td>@(row.VesselName ?? "—")</td>
                            <td>@(row.ProductText ?? "—")</td>
                            <td class="ak-col-num ak-num">
                                @row.QuantityMt.ToString("N4")
                                @if (row.HasAllocationMismatch)
                                {
                                    <span class="ak-status is-danger"
                                          title="@UiText.T(Context, "جمع تخصیص Shipperها با مقدار کل سفر نمی‌خواند.", "Total shipper allocation does not match the voyage quantity.")">
                                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                        @UiText.T(Context, "مغایرت تخصیص", "Allocation mismatch")
                                        <span class="col-ltr">@row.AllocationDifferenceMt.ToString("N4") MT</span>
                                    </span>
                                }
                            </td>
                            <td>@(row.LoadingPortName ?? "—") @(UiText.IsEn(Context) ? "→" : "←") @(row.DestinationName ?? "—")</td>
                            <td>
                                @(row.CustomerText ?? "—")
                                @if (!string.IsNullOrWhiteSpace(row.ConsigneeText))
                                {
                                    <div class="ak-cell-note">Consignee: @row.ConsigneeText</div>
                                }
                            </td>
                            <td>@(row.ShipperText ?? "—")</td>
                            <td class="ak-col-num ak-num">
                                @row.FreightTotalUsd.ToString("N2")
                                @if (row.FreightRateUsdPerMt.HasValue)
                                {
                                    <div class="ak-cell-note">@row.FreightRateUsdPerMt.Value.ToString("N2") USD/MT</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.TransportCompanyText))
                                {
                                    <div class="ak-cell-note">@row.TransportCompanyText</div>
                                }
                            </td>
                            <td>
                                <span class="@PTGOilSystem.Web.Controllers.ReportsController.VesselVoyageStatusCss(row.Status)">
                                    @PTGOilSystem.Web.Controllers.ReportsController.VesselVoyageStatusLabel(row.Status)
                                </span>
                            </td>
                        </tr>
                        @if (row.HasDetails)
                        {
                            <tr class="collapse" id="@detailId">
                                <td colspan="11">
                                    <div class="row g-3">
                                        @if (row.ShipperLines.Count > 0)
                                        {
                                            <div class="col-md-6">
                                                <h6>@UiText.T(Context, "تخصیص Shipperها", "Shipper allocation")</h6>
                                                <table class="ak-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@UiText.T(Context, "قرارداد", "Contract")</th>
                                                            <th>@UiText.T(Context, "تأمین‌کننده", "Supplier")</th>
                                                            <th>@UiText.T(Context, "محصول", "Product")</th>
                                                            <th>@UiText.T(Context, "جواز", "Company")</th>
                                                            <th class="ak-col-num">@UiText.T(Context, "مقدار MT", "Quantity MT")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in row.ShipperLines)
                                                        {
                                                            <tr>
                                                                <td>@line.ContractNumber</td>
                                                                <td>@(line.SupplierName ?? "—")</td>
                                                                <td>@(line.ProductName ?? "—")</td>
                                                                <td>@(line.CompanyName ?? "—")</td>
                                                                <td class="ak-col-num ak-num">@line.AllocatedQuantityMt.ToString("N4")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="4"><strong>@UiText.T(Context, "جمع تخصیص", "Allocated total")</strong></td>
                                                            <td class="ak-col-num ak-num @(row.HasAllocationMismatch ? "finance-negative" : null)">
                                                                <strong>@row.AllocatedQuantityMt.ToString("N4")</strong>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        }
                                        @if (row.FreightLines.Count > 0)
                                        {
                                            <div class="col-md-6">
                                                <h6>@UiText.T(Context, "کرایه کشتی ثبت‌شده", "Recorded vessel freight")</h6>
                                                <table class="ak-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@UiText.T(Context, "تاریخ", "Date")</th>
                                                            <th>@UiText.T(Context, "نوع کرایه کشتی", "Vessel freight type")</th>
                                                            <th>@UiText.T(Context, "کمپنی ترانسپورتی", "Transport company")</th>
                                                            <th class="ak-col-num">@UiText.T(Context, "مبلغ USD", "Amount USD")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in row.FreightLines)
                                                        {
                                                            <tr>
                                                                <td>@line.ExpenseDate.ToDisplayDate()</td>
                                                                <td>@line.ExpenseTypeName</td>
                                                                <td>@(line.ServiceProviderName ?? "—")</td>
                                                                <td class="ak-col-num ak-num">@line.AmountUsd.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="3"><strong>@UiText.T(Context, "جمع کرایه کشتی", "Vessel freight total")</strong></td>
                                                            <td class="ak-col-num ak-num"><strong>@row.FreightTotalUsd.ToString("N2")</strong></td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="11">
                                <div class="ak-empty">
                                    <i class="bi bi-water"></i>
                                    @UiText.T(Context, "سفر کشتی‌ای پیدا نشد؛ فیلترها را تغییر دهید.", "No vessel voyage found; change the filters.")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Rows.Count > 0)
                {
                    <tfoot>
                        <tr class="ak-table-total">
                            <td colspan="5">@UiText.T(Context, "جمع کل نتایج فیلترشده", "Total of filtered results")</td>
                            <td class="ak-col-num ak-num">@t.TotalQuantityMt.ToString("N4")</td>
                            <td colspan="3"></td>
                            <td class="ak-col-num ak-num">@t.TotalFreightUsd.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
    </div>
</div>
