@using PTGOilSystem.Web.Services.Reporting
@model PTGOilSystem.Web.Models.Reports.PreSaleDiscrepancyReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "مغایرت‌های پیش‌فروش", "Pre-sale Discrepancies");
    Dictionary<string, string?> RouteFor(PreSaleDiscrepancyKind kind, int page) => new()
    {
        ["kind"] = kind.ToString(),
        ["page"] = page.ToString(),
        ["FromDate"] = Model.Filter.FromDate?.ToString("yyyy-MM-dd"),
        ["ToDate"] = Model.Filter.ToDate?.ToString("yyyy-MM-dd"),
        ["ProductId"] = Model.Filter.ProductId?.ToString(),
        ["CustomerId"] = Model.Filter.CustomerId?.ToString()
    };
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "مغایرت‌های پیش‌فروش", "Pre-sale Discrepancies"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <p class="ak-note">@UiText.T(Context, "مواردی که بین تعهد پیش‌فروش، تحویل، موجودی و پول ناهماهنگ هستند. با کلیک روی هر ردیف به سند اصلی می‌روید.", "Items where commitment, delivery, stock and money disagree. Click a row to open the source document.")</p>

    <nav class="ak-chip-group mb-3" aria-label="@UiText.T(Context, "دسته‌های مغایرت", "Discrepancy categories")">
        @foreach (var item in Model.Summary)
        {
            <a class="btn btn-sm @(item.Kind == Model.SelectedKind ? "btn-primary" : "ak-secondary-action")"
               asp-action="PreSaleDiscrepancies" asp-all-route-data="RouteFor(item.Kind, 1)"
               aria-current="@(item.Kind == Model.SelectedKind ? "page" : null)">
                @item.Title
                <span class="ak-badge @(item.Count > 0 ? "ak-badge-danger" : "ak-badge-success")">@item.Count.ToString("N0")</span>
            </a>
        }
    </nav>

    <div class="ak-list">
        @{
            List<AkFilterOption> DiscrepancyOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var discrepancyFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر مغایرت‌ها...", "Filter discrepancies..."),
                new List<AkFilterDefinition>
                {
                    new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("ProductId", UiText.T(Context, "جنس", "Product"), "select", DiscrepancyOpts(ViewBag.Products),
                        Model.Filter.ProductId?.ToString()),
                    new("CustomerId", UiText.T(Context, "مشتری", "Customer"), "select", DiscrepancyOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString())
                },
                // دستهٔ انتخاب‌شده جزو فیلترهای نواری نیست؛ فقط باید در هر جست‌وجو حفظ شود.
                new Dictionary<string, string> { ["kind"] = Model.SelectedKind.ToString() });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="discrepancyFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("PreSaleDiscrepanciesExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context, "مورد", "Item")</th>
                        <th class="ak-col-grow">@UiText.T(Context, "شرح", "Detail")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مقدار MT", "Quantity MT")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مبلغ USD", "Amount USD")</th>
                        <th>@UiText.T(Context, "تاریخ سند", "Document date")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ak-col-grow">@row.Title</td>
                            <td class="ak-col-grow">@row.Detail</td>
                            <td class="ak-col-num ak-num">@(row.QuantityMt.HasValue ? row.QuantityMt.Value.ToString("N4") : "-")</td>
                            <td class="ak-col-num ak-num">@(row.AmountUsd.HasValue ? row.AmountUsd.Value.ToString("N2") : "-")</td>
                            <td>@(row.DocumentDate?.ToDisplayDate() ?? "-")</td>
                            <td>
                                @if (row.DocumentId > 0)
                                {
                                    <a class="btn btn-sm btn-light"
                                       asp-controller="@row.DocumentController"
                                       asp-action="@row.DocumentAction"
                                       asp-route-id="@row.DocumentId"
                                       title="@UiText.T(Context, "مشاهده سند", "Open document")">
                                        <i class="bi bi-box-arrow-up-left"></i>
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-light"
                                       asp-controller="@row.DocumentController"
                                       asp-action="@row.DocumentAction"
                                       title="@UiText.T(Context, "مشاهده فهرست", "Open list")">
                                        <i class="bi bi-list"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="6"><div class="ak-empty"><i class="bi bi-check2-circle"></i> @UiText.T(Context, "در این دسته مغایرتی وجود ندارد.", "No discrepancy in this category.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="ak-pagination">
                @for (var p = 1; p <= Model.PageCount; p++)
                {
                    <a asp-action="PreSaleDiscrepancies" asp-all-route-data="RouteFor(Model.SelectedKind, p)"
                       class="btn btn-sm @(p == Model.Page ? "btn-primary" : "ak-secondary-action")">@p</a>
                }
            </div>
        }
    </div>
</div>
