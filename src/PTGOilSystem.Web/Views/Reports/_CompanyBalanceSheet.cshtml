@model PTGOilSystem.Web.Models.Reports.CompanyBalanceReportViewModel
@using PTGOilSystem.Web.Models.Reports
@using Txt = PTGOilSystem.Web.Models.Reports.CompanyBalanceReportText
@{
    // نسخهٔ صفحه‌نمایشِ بیلانس. برچسب‌ها و ارقام همان CompanyBalancePdfDocument است، ولی اجزای چاپی
    // (لوگو، تاریخ چاپ، شمارهٔ صفحه، عنوان دوم و جمع‌بندی تکراری) فقط در PDF می‌آیند. هیچ محاسبه‌ای اینجا نیست.
    var currency = Model.CurrencyCode;
    var rowCount = Math.Max(Model.AssetLines.Count, Model.LiabilityLines.Count);
    var from = Model.ReportFromDate.ToString("yyyy-MM-dd");
    var to = Model.ReportToDate.ToString("yyyy-MM-dd");
    string DetailsUrl(CompanyBalanceSection section)
        => Url.Action("CompanyBalanceDetails", "Reports", new { section, FromDate = from, ToDate = to, Currency = currency }) ?? "#";

    var netProfitLoss = Model.NetProfitLoss;
    var performance = new List<(string Label, decimal Value, CompanyBalanceSection? Section)>
    {
        (Txt.Sales, Model.SalesRevenue, CompanyBalanceSection.SalesRevenue),
        (Txt.CostOfSales, Model.CostOfSales, null),
        (Model.GrossProfit < 0m ? Txt.GrossLoss : Txt.GrossProfit, Math.Abs(Model.GrossProfit), null),
        (Txt.PeriodExpenses, Model.PeriodExpenses, CompanyBalanceSection.PeriodExpenses)
    };
    if (Model.NetExchangeResult != 0m)
    {
        performance.Add((Txt.ExchangeResult, Model.NetExchangeResult, null));
    }
    if (Model.CustodyIncome != 0m)
    {
        performance.Add((Txt.CustodyIncome, Model.CustodyIncome, null));
    }
}

<article class="cbr-sheet" dir="rtl" lang="fa" aria-label="@Txt.Title">
    <p class="cbr-scope">
        @Txt.Period(Model.ReportFromDate, Model.ReportToDate)
        <span aria-hidden="true">·</span>
        @Txt.AmountHeader(currency)
    </p>

    @* جواب اصلی در یک ردیف: دارایی‌ها − تعهدات = خالص وضعیت. *@
    <section class="cbr-hero" aria-label="@Txt.HeroLabel">
        <div class="cbr-hero__item">
            <span class="cbr-hero__label">@Txt.TotalAssets</span>
            <bdi class="cbr-hero__value">@Txt.Money(Model.TotalAssets, currency)</bdi>
        </div>
        <div class="cbr-hero__item">
            <span class="cbr-hero__label">@Txt.TotalLiabilities</span>
            <bdi class="cbr-hero__value">@Txt.Money(Model.TotalLiabilities, currency)</bdi>
        </div>
        <div class="cbr-hero__item cbr-hero__item--net @(Model.NetCompanyBalance < 0m ? "is-negative" : null)">
            <span class="cbr-hero__label">@Txt.HeroLabel</span>
            <bdi class="cbr-hero__value">@Txt.Money(Model.NetCompanyBalance, currency)</bdi>
        </div>
    </section>

    <div class="cbr-tables">
        @foreach (var block in new[]
        {
            (Title: Txt.AssetsTitle, Lines: Model.AssetLines, TotalLabel: Txt.TotalAssets, Total: Model.TotalAssets),
            (Title: Txt.LiabilitiesTitle, Lines: Model.LiabilityLines, TotalLabel: Txt.TotalLiabilities, Total: Model.TotalLiabilities)
        })
        {
            <section class="cbr-block">
                <h2 class="cbr-block__title">@block.Title</h2>
                <table class="cbr-table">
                    <thead>
                        <tr>
                            <th scope="col">@Txt.DescriptionHeader</th>
                            <th scope="col" class="cbr-num">@Txt.AmountHeader(currency)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < rowCount; index++)
                        {
                            if (index < block.Lines.Count)
                            {
                                var line = block.Lines[index];
                                <tr>
                                    <td>
                                        <a class="cbr-link" href="@DetailsUrl(line.Section)">
                                            @line.LabelFa
                                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    <td class="cbr-num @(line.Amount < 0m ? "is-negative" : null)"><bdi>@Txt.Amount(line.Amount)</bdi></td>
                                </tr>
                            }
                            else
                            {
                                <tr class="cbr-table__spacer" aria-hidden="true"><td></td><td></td></tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">@block.TotalLabel</th>
                            <td class="cbr-num"><bdi>@Txt.Amount(block.Total)</bdi></td>
                        </tr>
                    </tfoot>
                </table>
            </section>
        }
    </div>

    <section class="cbr-block cbr-performance" aria-label="@Txt.PerformanceTitle">
        <h2 class="cbr-block__title">@Txt.PerformanceTitle</h2>
        <table class="cbr-table">
            <thead>
                <tr>
                    <th scope="col">@Txt.DescriptionHeader</th>
                    <th scope="col" class="cbr-num">@Txt.AmountHeader(currency)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cell in performance)
                {
                    <tr>
                        <td>
                            @if (cell.Section.HasValue)
                            {
                                <a class="cbr-link" href="@DetailsUrl(cell.Section.Value)">
                                    @cell.Label
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </a>
                            }
                            else
                            {
                                @cell.Label
                            }
                        </td>
                        <td class="cbr-num"><bdi>@Txt.Amount(cell.Value)</bdi></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="@(netProfitLoss < 0m ? "is-negative" : "is-result")">
                    <th scope="row">@Txt.NetResultLabel(netProfitLoss)</th>
                    <td class="cbr-num"><bdi>@Txt.Amount(Math.Abs(netProfitLoss))</bdi></td>
                </tr>
            </tfoot>
        </table>
    </section>

    @if (Model.NotesFa.Count > 0)
    {
        <ul class="cbr-notes">
            @foreach (var note in Model.NotesFa)
            {
                <li>@note</li>
            }
        </ul>
    }
</article>
