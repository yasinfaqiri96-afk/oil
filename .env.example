# PTG Oil System — نمونه متغیرهای محیطی
# این فایل فقط نمونه است. هیچ مقدار واقعی و هیچ کلید واقعی در آن نگذارید.
# فایل .env واقعی نباید در Git ثبت شود.

# ---- دیتابیس ----------------------------------------------------------------
# یکی از این دو کافی است.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ptg_oil_system
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Username=postgres;Password=YOUR_PASSWORD;Database=ptg_oil_system;SSL Mode=Prefer;Trust Server Certificate=true

# ---- راهنمای هوشمند ---------------------------------------------------------
# کلیدها فقط در Backend خوانده می‌شوند و هرگز در Frontend، JavaScript یا appsettings قرار نمی‌گیرند.
# کلید واقعی را اینجا ننویسید؛ در محیط اجرا تنظیم کنید.
# فقط کلیدِ Provider انتخاب‌شده لازم است.

# Provider = Gemini  (پیش‌فرض فعلی). کلید از https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Provider = Groq  (رایگان، API سازگار با OpenAI). فعلاً Provider جایگزین است.
GROQ_API_KEY=

# Provider = Anthropic
ANTHROPIC_API_KEY=

# انتخاب Provider و مدل‌ها در appsettings.json بخش "Assistant" است و بدون تغییر کد قابل تعویض است:
#   Assistant__Enabled=true
#   Assistant__Provider=Gemini                 # یا Groq یا Anthropic
#   Assistant__Gemini__Model=gemini-3.6-flash
#   Assistant__Groq__BaseUrl=https://api.groq.com/openai/v1
#   Assistant__Groq__Model=llama-3.3-70b-versatile
#   Assistant__Model=claude-opus-5             # مدل Anthropic
#   Assistant__MaxOutputTokens=2000
#   Assistant__EnableTools=true
#
# Provider جایگزین فقط برای خطای گذرا (Timeout، 429، 5xx) به کار می‌رود.
# خطای مجوز یا کلید نامعتبر عمداً جایگزین نمی‌شود تا پنهان نماند.
#   Assistant__FallbackProvider=Groq
#   Assistant__FallbackModel=qwen/qwen3.6-27b
